{
  "name": "caradvance-offers",
  "version": "0.1.0-test",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply caradvance-offers-test --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ext:zip": "cd extension && zip -qr ../dist/caradvance-sourcing-extension.zip . -x 'fixtures/*' -x package.json",
    "db:migrate:remote": "wrangler d1 migrations apply caradvance-offers-test --remote",
    "deploy": "wrangler d1 migrations apply caradvance-offers-test --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "postal-mime": "^4.1.4"
  },
  "devDependencies": {
    "wrangler": "^4.153.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@cloudflare/workers-types": "^5.20261026.1"
  }
}