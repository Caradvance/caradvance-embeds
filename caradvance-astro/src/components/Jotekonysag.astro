---
import '../styles/eladom.css';
import { localizedPath, type Locale } from '../i18n/utils';
import { eladomContent } from '../data/eladom';

const { lang } = Astro.props as { lang: Locale };
const c = eladomContent(lang);
const sell = `${localizedPath(lang, '/eladom')}#ertekbecsles`;

const heart = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.4C.4 8.3 2 5 5.3 5c2 0 3.3 1.1 4.7 3 1.4-1.9 2.7-3 4.7-3C18.7 5 20.3 8.3 22 11.6 19.5 16.3 12 21 12 21z"/></svg>`;
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const ft = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' Ft';

// Extra per-organisation content for the page (parallel to c.charity.orgs order):
// SOS · Élelmiszerbank · Bátor Tábor · Máltai · Rex · Heim Pál · PATENT
const detail = [
  {
    accent: '#009DE0',
    long: 'Az SOS Gyermekfalvak Magyarország több mint hat évtizede dolgozik azért, hogy egyetlen gyermek se maradjon család és szeretet nélkül. Stabil, szerető otthont adnak azoknak a gyerekeknek, akik vér szerinti családjukban nem nevelkedhetnek — hivatásos nevelőszülők, gyermekházak és utógondozás révén.',
    long2: 'Emellett családmegtartó programokkal segítik a nehéz helyzetbe került szülőket, hogy a gyerekek otthon, biztonságban maradhassanak. Minden támogatás közvetlenül egy gyermek stabilabb, kiszámíthatóbb jövőjét építi.',
    impact: 'Egy hónap otthon, meleg étel és iskolakezdés egy gyermeknek.',
    project: { title: 'Egy gyermekház téli felújítása', goal: 2500000, raised: 640000 },
  },
  {
    accent: '#3a9d4b',
    long: 'A Magyar Élelmiszerbank Egyesület Magyarország legnagyobb hatású élelmiszermentő szervezete. Felkutatják a kereskedők és gyártók még jó minőségű, de feleslegessé vált termékeit, és eljuttatják a rászorulókhoz — így az étel nem a kukába, hanem terített asztalra kerül.',
    long2: 'A mozgalom páratlan hatékonysággal működik: egyetlen forint adományból akár 30 forint értékű élelmiszert juttatnak célba. Húsz év alatt több mint 130 millió kiló élelmiszert mentettek meg a pazarlástól.',
    impact: '10 000 Ft adományból 300 000 Ft értékű élelmiszer jut a nélkülözőkhöz.',
    project: { title: '50 000 adag étel a téli hónapokra', goal: 1500000, raised: 980000 },
  },
  {
    accent: '#2f5aa8',
    long: 'A Bátor Tábor 2001 óta nyújt ingyenes, élményterápiás táborokat súlyosan vagy krónikusan beteg gyerekeknek és családjaiknak. Hiszik, hogy a gyógyulás nemcsak a kórházban történik: a tábor élményei önbizalmat, bátorságot és gondtalan gyerekkori pillanatokat adnak vissza.',
    long2: 'A táborok, a kórházi és online programok minden résztvevő számára teljesen ingyenesek. Egy hét a Bátor Táborban sok gyerek életében fordulópontot jelent.',
    impact: 'Egy hét sorsfordító tábori élmény egy súlyos beteg gyermeknek.',
    project: { title: '5 gyermek nyári tábori részvétele', goal: 1750000, raised: 1120000 },
  },
  {
    accent: '#c0392b',
    long: 'A Magyar Máltai Szeretetszolgálat az ország egyik legnagyobb karitatív szervezete, amely intézményeiben és programjaiban naponta több tízezer emberről gondoskodik. Hajléktalanellátás, családsegítés, katasztrófahelyzeti segítségnyújtás, felzárkózó települések támogatása — ahol baj van, ők ott vannak.',
    long2: 'Segítségük a legnehezebb élethelyzetekben is emberi méltóságot és új esélyt ad. A támogatás meleg ételt, szállást és biztonságot jelent azoknak, akiknek a legnagyobb szükségük van rá.',
    impact: 'Meleg étel, szállás és emberi szó egy bajba jutott embernek.',
    project: { title: 'Téli krízisellátás hajléktalan embereknek', goal: 2000000, raised: 720000 },
  },
  {
    accent: '#8a6a3a',
    long: 'A Rex Kutyaotthon Alapítvány bajba jutott, kóbor és bántalmazott kutyák menedéke. Ellátják, gyógyítják és felkészítik őket az örökbefogadásra, majd szerető gazdit keresnek nekik. Minden befogadott kutya egy második esélyt kap.',
    long2: 'A támogatás eledelt, oltást és gyógykezelést jelent azoknak, akik maguk nem tudnak szólni magukért. Az otthon a nap 24 órájában gondoskodik a rábízott állatokról.',
    impact: 'Egy hónap ellátás, oltás és gyógykezelés egy megmentett kutyának.',
    project: { title: 'Kennelek felújítása és téli felkészítés', goal: 1200000, raised: 430000 },
  },
  {
    accent: '#c24d6e',
    long: 'A Heim Pál Országos Gyermekgyógyászati Intézet Magyarország vezető gyermekkórháza, ahol évente több százezer kis beteget látnak el. A támogatás korszerűbb orvosi eszközöket, gyermekbarát kórtermeket és jobb gyógyulási esélyt jelent a legkisebbeknek.',
    long2: 'Itt minden fejlesztés közvetlenül a gyerekek gyógyulását szolgálja — a babamentő inkubátortól a legmodernebb diagnosztikai műszerekig.',
    impact: 'Modern gyógyászati eszköz, amely gyerekek életét mentheti.',
    project: { title: 'Új gyermekgyógyászati műszer beszerzése', goal: 3000000, raised: 1340000 },
  },
  {
    accent: '#5b6472',
    long: 'A PATENT Egyesület Magyarország egyetlen olyan civil szervezete, amely kifejezetten a nők elleni erőszak áldozatainak nyújt ingyenes jogi segítséget. Jogsegély-szolgálatuk, lelki támogatásuk és megelőző programjaik révén bántalmazást átélt nőknek és gyerekeknek adnak esélyt a biztonságos újrakezdésre.',
    long2: 'Munkájuk sokszor szó szerint életeket ment: jogi útmutatást, védelmet és emberi támaszt nyújtanak a legkiszolgáltatottabb helyzetben lévőknek.',
    impact: 'Ingyenes jogi segítség egy bántalmazást átélt nőnek az újrakezdéshez.',
    project: { title: 'Ingyenes jogsegély-szolgálat egy évig', goal: 1500000, raised: 560000 },
  },
];

const orgs = c.charity.orgs.map((o, i) => ({ ...o, ...detail[i] }));
const logoOf = (o: typeof orgs[number]) => (o.name.startsWith('SOS') ? '/sos-badge.png' : o.logo);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Jótékonyság — CarAdvance',
  description: 'A CarAdvance minden autóeladás jutalékának jelentős részét magyar jótékony szervezeteknek ajánlja fel. Ismerd meg a támogatott szervezeteket és a céljainkat.',
  inLanguage: 'hu',
  about: orgs.map((o) => ({ '@type': 'NGO', name: o.name, url: o.url })),
};
---

<!-- HERO -->
<section class="hero jot-hero">
  <video autoplay muted loop playsinline preload="auto" poster="https://caradvance.hu/caradvance-hero-x5-poster.jpg">
    <source src="https://caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
  </video>
  <div class="scrim"></div>
  <div class="inner">
    <div class="hero-ngos">
      {orgs.map((o) => (
        <span class={`hn-chip${o.name.startsWith('SOS') ? ' hn-sos' : ''}`}><img src={logoOf(o)} alt={o.name} loading="eager" /></span>
      ))}
    </div>
    <h1>Minden eladott autó<br /><span class="accent">egy jó ügyet szolgál</span></h1>
    <p class="sub sub-wide">Amikor ránk bízod az autód eladását, a jutalékunk jelentős részét magyar jótékony szervezeteknek adjuk tovább. Nézd meg, milyen valódi célokért dolgozunk — és légy részese te is.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={sell}>Eladnám az autóm</a>
      <a class="btn btn-white" href="#projektek">Nézd meg a projekteket</a>
    </div>
  </div>
  <button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<!-- MIÉRT -->
<section class="section" id="miert">
  <div class="wrap jot-why">
    <div>
      <span class="eyebrow">Miért csináljuk?</span>
      <h2 class="sec-title">Az autóeladás nem csak rólad — és nem csak rólunk szól</h2>
      <p>A Caradvance 2003 óta van jelen az autós világban, és az évek alatt megtanultuk, hogy a bizalom a legértékesebb, amit egy ügyféltől kaphatunk. Amikor valaki ránk bízza az autója eladását, egy darab közös történetet is ránk bíz — és mi azt szeretnénk, ha ennek a történetnek jó vége lenne. Nemcsak a te számodra, hanem valaki más számára is.</p>
      <p>Ezért döntöttünk úgy, hogy nem tartjuk meg a teljes hasznunkat. A jutalékunk egy meghatározott, jelentős részét minden sikeres eladás után magyar jótékony szervezeteknek ajánljuk fel — gyerekeknek, családoknak, betegeknek, rászorulóknak és állatoknak, akiknek a segítség valódi, mérhető különbséget jelent. Így válik egy hétköznapi ügyintézésből valami sokkal fontosabb: egy jó ügy, ami mögött ott állsz te is.</p>
      <p>Hisszük, hogy egy felelős vállalkozásnak nem csak a nyereség a mércéje. A jótékonyság nálunk nem marketingfogás, hanem beépített része a működésünknek — átláthatóan, kimutathatóan, minden egyes eladásnál.</p>
    </div>
    <aside class="jot-stat" style="--c:#E2001A">
      <div class="jot-big">{c.charity.bigNum}<span>{c.charity.bigUnit}</span></div>
      <div class="jot-statlbl">a jutalékunkból jótékony célra</div>
      <p>A felajánlás a mi jutalékunkból történik — nem a te pénzedből. Neked nem kerül semmibe, a hatás mégis közös.</p>
    </aside>
  </div>
</section>

<!-- HOGYAN -->
<section class="section jot-alt" id="hogyan">
  <div class="wrap center">
    <span class="eyebrow">Hogyan működik?</span>
    <h2 class="sec-title">Átlátható felajánlás, valódi hatás</h2>
    <p class="sec-intro" style="margin:0 auto">Nem homályos ígéret, hanem a folyamatunk beépített része. Így néz ki a gyakorlatban:</p>
  </div>
  <div class="wrap jot-steps">
    <div class="jot-step"><div class="jot-num">1</div><h3>Minden eladásból felajánlunk</h3><p>A sikeres eladás után járó jutalékunk egy meghatározott, jelentős részét egy magyar jótékony szervezetnek adjuk tovább.</p></div>
    <div class="jot-step"><div class="jot-num">2</div><h3>Átláthatóan rögzítjük</h3><p>A támogatás összegét minden eladásnál egyedileg, írásban rögzítjük. Nincs rejtett feltétel — pontosan látod, mekkora felajánlás áll az autód eladása mögött.</p></div>
    <div class="jot-step"><div class="jot-num">3</div><h3>Megmutatjuk, kihez jut</h3><p>A profi bemutatóvideóban és itt az oldalon is látod, melyik szervezetet és melyik célt támogatja épp a te eladásod. A jó ügy nemcsak megtörténik — látszik is.</p></div>
  </div>
</section>

<!-- PROJEKTEK / CÉLOK -->
<section class="section" id="projektek">
  <div class="wrap center">
    <span class="eyebrow">Céljaink</span>
    <h2 class="sec-title">Projektek, amikért közösen dolgozunk</h2>
    <p class="sec-intro" style="margin:0 auto">Minden támogatott szervezetnél van egy konkrét cél, amit el szeretnénk érni — és minden eladott autó közelebb visz hozzá. Válaszd ki, melyik ügy áll hozzád a legközelebb.</p>
  </div>
  <div class="wrap pj-grid">
    {orgs.map((o) => {
      const pct = Math.min(100, Math.round((o.project.raised / o.project.goal) * 100));
      return (
        <article class="pj-card" style={`--c:${o.accent}`}>
          <div class="pj-img">
            <img src={o.photo} alt={o.project.title} loading="lazy" />
            <span class="pj-tag">{o.tag}</span>
            <span class={`pj-badge${o.name.startsWith('SOS') ? ' pj-badge-sos' : ''}`}><img src={logoOf(o)} alt={o.name} /></span>
          </div>
          <div class="pj-body">
            <div class="pj-org">{o.name}</div>
            <h3>{o.project.title}</h3>
            <div class="pj-bar"><span style={`width:${pct}%`}></span></div>
            <div class="pj-nums"><strong>{ft(o.project.raised)}</strong><span>cél: {ft(o.project.goal)}</span></div>
            <div class="pj-pct">{pct}% teljesült</div>
            <a class="pj-link" href={sell}>Támogatom egy autó eladásával <Fragment set:html={arrow} /></a>
          </div>
        </article>
      );
    })}
  </div>
  <p class="pj-note">A feltüntetett célok és összegek a program aktuális állását tükrözik, és minden sikeres eladással növekednek. A pontos, eladásonkénti felajánlást átláthatóan, egyedileg rögzítjük.</p>
</section>

<!-- SZERVEZETEK -->
<section class="section jot-alt" id="szervezetek">
  <div class="wrap center">
    <span class="eyebrow">A szervezetek</span>
    <h2 class="sec-title">Hét magyar szervezet, hét valódi ügy</h2>
    <p class="sec-intro" style="margin:0 auto">Olyan szervezeteket választottunk, amelyek átláthatóan és bizonyítottan segítenek — gyerekeken, családokon, betegeken, rászorulókon és állatokon. Ismerd meg őket közelebbről.</p>
  </div>
  <div class="wrap jot-orglist">
    {orgs.map((o) => (
      <article class="ol-item" style={`--c:${o.accent}`} id={`szervezet-${o.icon}`}>
        <div class="ol-media" style={`background:${o.color}`}>
          <img class="ol-photo" src={o.photo} alt={o.name} loading="lazy" />
          <span class="ol-scrim" style={`background:${o.color}`}></span>
          <span class="ol-logo"><img src={logoOf(o)} alt={o.name} /></span>
        </div>
        <div class="ol-body">
          <span class="ol-tag">{o.tag}</span>
          <h3>{o.name}</h3>
          <p>{o.long}</p>
          <p>{o.long2}</p>
          <div class="ol-impact"><Fragment set:html={heart} /> {o.impact}</div>
          <div class="ol-foot">
            <div class="ol-goal"><span class="ol-goal-lbl">Aktuális célunk</span><b>{o.project.title}</b><span class="ol-goal-sum">{ft(o.project.raised)} / {ft(o.project.goal)}</span></div>
            <a class="ol-link" href={o.url} target="_blank" rel="noopener noreferrer">A szervezet oldala <Fragment set:html={arrow} /></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- SEO / ZÁRÓ SZÖVEG -->
<section class="section">
  <div class="wrap jot-seo">
    <h2 class="sec-title">Jótékonyság és autóeladás — egy jó ügyért, együtt</h2>
    <p>A CarAdvance bizományos autóértékesítés egyszerre praktikus és értékteremtő döntés. Miközben profin, gyorsan és a lehető legjobb áron adjuk el az autódat a Használtautó.hu-n, a mobile.de-n és saját közösségi csatornáinkon, minden sikeres eladás egy jó ügyet is szolgál. A jutalékunk jelentős részét olyan magyar jótékony szervezeteknek ajánljuk fel, mint az SOS Gyermekfalvak Magyarország, a Magyar Élelmiszerbank Egyesület, a Bátor Tábor Alapítvány, a Magyar Máltai Szeretetszolgálat, a Rex Kutyaotthon Alapítvány, a Heim Pál Országos Gyermekgyógyászati Intézet és a PATENT Egyesület.</p>
    <p>Ha arra gondolsz, hogy „eladnám az autóm”, de fontos számodra, hogy a döntésednek pozitív hatása is legyen, jó helyen jársz. A jótékony célú autóeladás lényege egyszerű: te eladod az autót, mi intézünk mindent a fotózástól a szerződésig, és a hasznunk egy részéből valaki más élete is jobbá válik. Átláthatóan, kiszámíthatóan, minden egyes eladásnál — mert hisszük, hogy egy autó eladása lehet több is, mint egy tranzakció.</p>
  </div>
</section>

<!-- CTA -->
<section class="section jot-cta">
  <div class="wrap center">
    <h2>Add el az autód — tegyünk jót együtt</h2>
    <p>Küldd el pár adatát, és jelentkezünk egy reális árajánlattal. A többit mi intézzük — profin, gyorsan, egy jó ügyért.</p>
    <a class="jot-cta-btn" href={sell}><Fragment set:html={heart} /> Eladnám az autóm</a>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonld)}></script>

<style>
  /* Hero NGO logo chips */
  .jot-hero .inner{margin-top:56px}
  .hero-ngos{display:flex;flex-wrap:wrap;gap:9px;justify-content:center;margin:0 auto 26px;max-width:720px}
  .hn-chip{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:6px 12px;background:#fff;border-radius:11px;box-shadow:0 6px 16px rgba(0,0,0,.25)}
  .hn-chip img{max-height:100%;max-width:96px;width:auto;object-fit:contain;display:block}
  .hn-sos{background:#009DE0;padding:5px 10px}
  .hn-sos img{max-width:120px}
  @media(max-width:640px){.hn-chip{height:32px}.hn-chip img{max-width:76px}}

  .jot-why{display:grid;grid-template-columns:1.6fr 1fr;gap:44px;align-items:start}
  .jot-why p{font-size:16.5px;line-height:1.65;color:var(--muted);margin:16px 0 0}
  .jot-stat{position:sticky;top:100px;background:linear-gradient(160deg,var(--c),#B80015);color:#fff;border-radius:24px;padding:38px 32px;text-align:center;box-shadow:0 20px 50px rgba(226,0,26,.28)}
  .jot-big{font-size:84px;font-weight:800;line-height:1;letter-spacing:-.03em}
  .jot-big span{font-size:38px;margin-left:4px}
  .jot-statlbl{font-size:16px;font-weight:700;margin-top:6px}
  .jot-stat p{font-size:14px;line-height:1.55;color:rgba(255,255,255,.9);margin:16px 0 0}

  .jot-alt{background:var(--page)}
  .jot-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:40px}
  .jot-step{background:#fff;border:1px solid var(--line);border-radius:20px;padding:30px 26px;box-shadow:0 14px 32px rgba(8,8,10,.05)}
  .jot-num{width:44px;height:44px;border-radius:12px;background:#FBE9EC;color:var(--red);font-weight:800;font-size:19px;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
  .jot-step h3{font-size:18px;font-weight:800;margin:0 0 10px;letter-spacing:-.01em}
  .jot-step p{font-size:14.5px;line-height:1.6;color:var(--muted);margin:0}

  /* Project (crowdfunding) cards */
  .pj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:40px}
  .pj-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 14px 32px rgba(8,8,10,.06)}
  .pj-img{position:relative;height:170px;overflow:hidden}
  .pj-img img{width:100%;height:100%;object-fit:cover;display:block}
  .pj-tag{position:absolute;top:12px;left:12px;background:rgba(0,0,0,.55);color:#fff;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:6px 12px;border-radius:999px;backdrop-filter:blur(3px)}
  .pj-badge{position:absolute;bottom:-18px;right:16px;width:56px;height:56px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:0 8px 20px rgba(8,8,10,.16);display:flex;align-items:center;justify-content:center;overflow:hidden;padding:6px}
  .pj-badge img{max-width:100%;max-height:100%;object-fit:contain}
  .pj-badge-sos{background:#009DE0;border-color:#009DE0;padding:0}
  .pj-badge-sos img{max-width:none;height:100%;width:auto}
  .pj-body{padding:24px 22px 22px;flex:1;display:flex;flex-direction:column}
  .pj-org{font-size:12.5px;font-weight:700;color:var(--c);text-transform:uppercase;letter-spacing:.04em}
  .pj-body h3{font-size:18px;font-weight:800;letter-spacing:-.01em;margin:6px 0 16px;line-height:1.25}
  .pj-bar{height:9px;border-radius:999px;background:#EEF1F6;overflow:hidden}
  .pj-bar span{display:block;height:100%;border-radius:999px;background:var(--c)}
