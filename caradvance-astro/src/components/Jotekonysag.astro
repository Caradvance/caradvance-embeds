---
import '../styles/eladom.css';
import { localizedPath, type Locale } from '../i18n/utils';
import { eladomContent } from '../data/eladom';

const { lang } = Astro.props as { lang: Locale };
const c = eladomContent(lang);

const heart = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.4C.4 8.3 2 5 5.3 5c2 0 3.3 1.1 4.7 3 1.4-1.9 2.7-3 4.7-3C18.7 5 20.3 8.3 22 11.6 19.5 16.3 12 21 12 21z"/></svg>`;
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const steps = [
  { title: 'Minden eladásból felajánlunk', text: 'Amikor ránk bízod az autód értékesítését, a sikeres eladás után járó jutalékunk egy meghatározott, jelentős részét egy magyar jótékony szervezetnek adjuk tovább.' },
  { title: 'Átláthatóan, nyomon követhetően', text: 'A támogatás összegét minden eladásnál egyedileg, írásban rögzítjük. Nincs rejtett feltétel — pontosan látod, hogy az autód eladása mögött mekkora felajánlás áll.' },
  { title: 'A bemutatóvideóban is megmutatjuk', text: 'A profi bemutatóvideóban azt is elmondjuk, melyik szervezetet támogatja épp a Te autód eladása — így a jó ügy nemcsak megtörténik, hanem látszik is.' },
];
---

<section class="jot-hero">
  <div class="wrap">
    <span class="eyebrow eyebrow-light">Egy jó ügyért</span>
    <h1>Miért adunk vissza?</h1>
    <p>Nálunk egy autó eladása több, mint üzlet. Hisszük, hogy egy jól működő vállalkozásnak felelőssége van a közösség felé is — ezért minden sikeres eladás mögött ott áll egy magyar jótékony szervezet támogatása is.</p>
  </div>
</section>

<section class="section">
  <div class="wrap jot-grid">
    <div>
      <span class="eyebrow">A történetünk</span>
      <h2 class="sec-title">Az eladás nem csak rólad — és nem csak rólunk szól</h2>
      <p>A Caradvance 2003 óta van jelen az autós világban. Az évek alatt megtanultuk, hogy a bizalom a legfontosabb, amit egy ügyféltől kaphatunk. Amikor valaki ránk bízza az autója eladását, egy darab közös történetet is ránk bíz — és mi szeretnénk, ha ennek a történetnek jó vége lenne. Nem csak a Te számodra, hanem valaki más számára is.</p>
      <p>Ezért döntöttünk úgy, hogy nem tartjuk meg a teljes hasznunkat. A jutalékunk egy jelentős részét minden eladás után magyar jótékony szervezeteknek ajánljuk fel — gyerekeknek, családoknak, betegeknek, rászorulóknak és állatoknak, akiknek a segítség valódi különbséget jelent.</p>
    </div>
    <aside class="jot-stat">
      <div class="jot-big">{c.charity.bigNum}<span>{c.charity.bigUnit}</span></div>
      <div class="jot-statlbl">{c.charity.bigLabel}</div>
      <p>A jutalékunkból — nem a Te pénzedből. Neked ez nem kerül semmibe, a hatás mégis közös.</p>
    </aside>
  </div>
</section>

<section class="section jot-alt">
  <div class="wrap center">
    <span class="eyebrow">Hogyan működik?</span>
    <h2 class="sec-title">Átlátható felajánlás, valódi hatás</h2>
    <p class="sec-intro" style="margin:0 auto">Nem homályos ígéret, hanem beépített része a folyamatunknak. Így néz ki a gyakorlatban:</p>
  </div>
  <div class="wrap jot-steps">
    {steps.map((s, i) => (
      <div class="jot-step">
        <div class="jot-num">{i + 1}</div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
</section>

<section class="section">
  <div class="wrap center">
    <span class="eyebrow">Kiket támogatunk?</span>
    <h2 class="sec-title">Magyar szervezetek, valódi ügyek</h2>
    <p class="sec-intro" style="margin:0 auto">Olyan szervezeteket választunk, amelyek átláthatóan és bizonyítottan segítenek. Ismerd meg őket:</p>
  </div>
  <div class="wrap jot-orgs">
    {c.charity.orgs.map((o) => (
      <a class="jot-org" href={o.url} target="_blank" rel="noopener noreferrer">
        <span class="jot-org-tag">{o.tag}</span>
        <strong>{o.name}</strong>
        <span class="jot-org-text">{o.text}</span>
        <span class="jot-org-link">{c.charity.orgLink} <Fragment set:html={arrow} /></span>
      </a>
    ))}
  </div>
</section>

<section class="section jot-cta">
  <div class="wrap center">
    <h2>Add el az autód — tegyünk jót együtt</h2>
    <p>Küldd el pár adatát, és jelentkezünk egy reális árajánlattal. A többit mi intézzük — profin, gyorsan, egy jó ügyért.</p>
    <a class="jot-cta-btn" href={`${localizedPath(lang, '/eladom')}#ertekbecsles`}><Fragment set:html={heart} /> Eladnám az autóm</a>
  </div>
</section>

<style>
  .jot-hero{background:linear-gradient(180deg,#17181C,#0B0B0D 70%);color:#fff;text-align:center;padding:112px 24px 84px;margin-top:calc(6px - var(--navh));padding-top:calc(112px + var(--navh))}
  .jot-hero .wrap{max-width:820px}
  .eyebrow-light{background:rgba(255,255,255,.1);color:#fff}
  .jot-hero h1{font-size:clamp(34px,5vw,56px);line-height:1.08;font-weight:800;letter-spacing:-.025em;margin:18px 0 18px}
  .jot-hero p{font-size:clamp(16px,1.8vw,19px);line-height:1.6;color:#E7EAF0;max-width:660px;margin:0 auto}
  .jot-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:44px;align-items:center}
  .jot-grid p{font-size:16.5px;line-height:1.65;color:var(--muted);margin:16px 0 0}
  .jot-stat{background:linear-gradient(160deg,#E2001A,#B80015);color:#fff;border-radius:24px;padding:38px 32px;text-align:center;box-shadow:0 20px 50px rgba(226,0,26,.28)}
  .jot-big{font-size:88px;font-weight:800;line-height:1;letter-spacing:-.03em}
  .jot-big span{font-size:40px;margin-left:4px}
  .jot-statlbl{font-size:17px;font-weight:700;margin-top:6px}
  .jot-stat p{font-size:14px;line-height:1.55;color:rgba(255,255,255,.9);margin:16px 0 0}
  .jot-alt{background:var(--page)}
  .jot-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:40px}
  .jot-step{background:#fff;border:1px solid var(--line);border-radius:20px;padding:30px 26px;box-shadow:0 14px 32px rgba(8,8,10,.05)}
  .jot-num{width:44px;height:44px;border-radius:12px;background:#FBE9EC;color:var(--red);font-weight:800;font-size:19px;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
  .jot-step h3{font-size:18px;font-weight:800;margin:0 0 10px;letter-spacing:-.01em}
  .jot-step p{font-size:14.5px;line-height:1.6;color:var(--muted);margin:0}
  .jot-orgs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:38px}
  .jot-org{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;text-decoration:none;color:var(--ink);box-shadow:0 10px 26px rgba(8,8,10,.05);transition:transform .15s,box-shadow .15s}
  .jot-org:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(8,8,10,.1)}
  .jot-org-tag{align-self:flex-start;background:#F4F7FB;color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:6px 12px;border-radius:999px;margin-bottom:12px}
  .jot-org strong{font-size:17px;letter-spacing:-.01em}
  .jot-org-text{font-size:14px;line-height:1.55;color:var(--muted);margin:8px 0 16px;flex:1}
  .jot-org-link{display:inline-flex;align-items:center;gap:6px;color:var(--red);font-weight:700;font-size:13.5px}
  .jot-org-link svg{width:13px;height:13px}
  .jot-cta{background:var(--navy);color:#fff;text-align:center}
  .jot-cta h2{font-size:clamp(26px,3.4vw,38px);font-weight:800;letter-spacing:-.02em;margin:0 0 12px}
  .jot-cta p{font-size:17px;line-height:1.6;color:#cfd4de;max-width:560px;margin:0 auto 26px}
  .jot-cta-btn{display:inline-flex;align-items:center;gap:10px;background:var(--red);color:#fff;font-weight:700;font-size:16px;text-decoration:none;padding:16px 32px;border-radius:999px;box-shadow:0 10px 30px rgba(226,0,26,.38);transition:background .15s,transform .15s}
  .jot-cta-btn:hover{background:#B80015;transform:translateY(-2px)}
  .jot-cta-btn svg{width:18px;height:18px}
  @media(max-width:860px){.jot-grid{grid-template-columns:1fr;gap:28px}.jot-steps,.jot-orgs{grid-template-columns:1fr}}
</style>
