---
import '../styles/eladom.css';
import LizingKalkulator from './LizingKalkulator.astro';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const vehicles = [
  { t: 'Személygépkocsi', d: 'Új és használt személyautó egyaránt. Magánszemélynél a szerződéskötéskor max. 16 év, a futamidő végén max. 20 év; jogi személynél 14, illetve 15 év.' },
  { t: 'Kishaszongépjármű', d: 'Szerződéskötéskor max. 14 év, a futamidő lejártakor max. 15 év lehet a jármű kora.' },
  { t: 'Motorkerékpár', d: 'Szerződéskötéskor max. 12 év, a futamidő végén max. 15 év — magánszemélynek és jogi személynek egyaránt.' },
];

const steps = [
  { t: 'Ajánlat', d: 'A kalkulátorral vagy telefonos ügyintéző segítségével elkészül a személyre szabott ajánlat, amelyet e-mailben is megkapsz.' },
  { t: 'Igénylés', d: 'Kereskedőnél a kereskedő indítja az igénylést; egyébként a kitöltött dokumentumokat kell benyújtani.' },
  { t: 'Bírálat', d: 'A bank ellenőrzi a hitelképességet, az eredményről SMS-ben értesít.' },
  { t: 'Szerződéskötés', d: 'A szerződés aláírható a banknál, vagy mobil ügyintéző, illetve kereskedői partner segítségével külső helyszínen is.' },
  { t: 'Folyósítás', d: 'A bank átutalja a finanszírozás összegét az eladó bankszámlájára.' },
];

const docs = [
  { g: 'Magánszemélyeknek', items: ['Lízingkérelmi adatlap', 'Munkáltatói jövedelemigazolás vagy az utolsó 3 havi bankszámlakivonat'] },
  { g: 'Gazdálkodó- és egyéb szervezetek', items: ['Lízingkérelmi adatlap', '30 napnál nem régebbi NAV folyószámla-kivonat (köztartozásmentesnél nem szükséges)', 'Aláírási címpéldány'] },
  { g: 'Egyéni vállalkozók, őstermelők', items: ['Lízingkérelmi adatlap', '30 napnál nem régebbi NAV folyószámla-kivonat (köztartozásmentesnél nem szükséges)', 'Személyi igazolvány másolat'] },
];

const faqs: [string, string][] = [
  ['Milyen gépjárművet finanszíroznak?', 'Új és használt személygépkocsit, kishaszongépjárművet és motorkerékpárt egyaránt, a járműtípusra és az igénylő típusára vonatkozó korhatárokon belül.'],
  ['Vásárolhatok közvetlenül az eladótól?', 'Igen, zártvégű pénzügyi lízing esetén akkor is elérhető a finanszírozás, ha a járművet nem autókereskedésben, hanem közvetlenül az eladótól veszed meg.'],
  ['Milyen dokumentumok kellenek magánszemélyként?', 'Kitöltött lízingkérelmi adatlap, valamint munkáltatói jövedelemigazolás vagy az utolsó 3 havi bankszámlakivonat.'],
  ['Fix vagy változó a kamat, forint vagy euró?', 'A Merkantilnál elérhető fix és változó kamatozású, forint alapú gépjárműlízing is. A pontos kamatot és THM-et az egyedi ajánlat rögzíti.'],
];
const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<section class="fp">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<span class="fp-crumb"><a href="/finanszirozas-lizing">Finanszírozás – lízing</a> / Merkantil Bank</span>
<h1>Merkantil Bank —<br /><span class="accent">gépjárműlízing partnerünk</span></h1>
<p class="sub sub-wide" style="max-width:900px">A Merkantil Bank (OTP Bankcsoport) egyik finanszírozó partnerünk, akin keresztül személyre szabott gépjárműlízinget tudunk biztosítani — új és használt autóra, gyors bírálattal, az igényléstől a folyósításig.</p>
<div class="cta-row">
<a class="btn btn-primary" href="#kalkulator">Havi részlet kiszámítása</a>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap center">
<span class="eyebrow">Finanszírozott járművek</span>
<h2 class="sec-title">Milyen gépjárművet finanszíroznak?</h2>
<p class="sec-intro">Új és használt járművek egyaránt, típusonként eltérő korhatárokkal.</p>
</div>
<div class="wrap fp-cards">
{vehicles.map((c) => (
<div class="fp-card">
<h3>{c.t}</h3>
<p>{c.d}</p>
</div>
))}
</div>
</section>

<section class="section" id="kalkulator" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Kalkulátor</span>
<h2 class="sec-title">Számold ki a lízingdíjad</h2>
<p class="sec-intro">Néhány kattintással megbecsülöd a havi törlesztőrészletet. A becslés tájékoztató jellegű, rögzített kamatozású példa alapján.</p>
</div>
<div class="wrap">
<LizingKalkulator title="Merkantil lízingkalkulátor" partner="Merkantil Bank" rate={9.59} />
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Folyamat</span>
<h2 class="sec-title">Az igénylés lépései</h2>
</div>
<div class="wrap fp-steps">
{steps.map((s, i) => (
<div class="fp-step">
<div class="fp-sn">{i + 1}</div>
<h3>{s.t}</h3>
<p>{s.d}</p>
</div>
))}
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Dokumentumok</span>
<h2 class="sec-title">Mit kell benyújtani az igényléshez?</h2>
</div>
<div class="wrap fp-docs">
{docs.map((d) => (
<div class="fp-doc">
<h3>{d.g}</h3>
<ul>{d.items.map((x) => (<li>{x}</li>))}</ul>
</div>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="fp-cta">
<div>
<h2>A Merkantil Bankkal finanszíroznád az autód?</h2>
<p>Segítünk összeállítani az igénylést és összekötünk a partnerrel a pontos, személyre szabott ajánlathoz.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek →</a>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések</h2>
</div>
<div class="wrap fp-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
<div class="wrap center"><a class="fp-back" href="/finanszirozas-lizing">← Vissza a finanszírozás áttekintéshez</a></div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
</section>

<style>
.fp{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.fp .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.fp-crumb{display:inline-block;font-size:13px;font-weight:700;color:rgba(255,255,255,.85);margin-bottom:10px}
.fp-crumb a{color:#fff;text-decoration:underline}
.fp-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
@media(max-width:900px){.fp-cards{grid-template-columns:1fr}}
.fp-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
.fp-card h3{font-size:18px;font-weight:800;color:var(--ink);margin:0 0 8px}
.fp-card p{color:var(--muted);font-size:14px;line-height:1.6;margin:0}
.fp-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:22px}
@media(max-width:900px){.fp-steps{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.fp-steps{grid-template-columns:1fr}}
.fp-step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 8px 24px rgba(8,8,10,.04)}
.fp-sn{width:36px;height:36px;border-radius:11px;background:var(--navy);color:#fff;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.fp-step:last-child .fp-sn{background:var(--red)}
.fp-step h3{font-size:15px;font-weight:800;color:var(--ink);margin:0 0 6px}
.fp-step p{color:var(--muted);font-size:13px;line-height:1.55;margin:0}
.fp-docs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
@media(max-width:900px){.fp-docs{grid-template-columns:1fr}}
.fp-doc{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 24px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
.fp-doc h3{font-size:16px;font-weight:800;color:var(--ink);margin:0 0 12px}
.fp-doc ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.fp-doc li{position:relative;padding-left:24px;color:var(--muted);font-size:14px;line-height:1.5}
.fp-doc li::before{content:"›";position:absolute;left:6px;top:-1px;color:var(--red);font-weight:800;font-size:16px}
.fp-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.fp-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.fp-cta p{color:#cfd6e2;margin:0;font-size:15px;max-width:560px}
.fp-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.fp-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.fp-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.fp-faq summary::-webkit-details-marker{display:none}
.fp-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.fp-faq details[open] .pl{transform:rotate(45deg)}
.fp-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.fp-back{display:inline-block;margin-top:22px;font-weight:800;font-size:14.5px;color:var(--red);text-decoration:none}
.fp-back:hover{text-decoration:underline}
</style>
