---
// /tartos-berlet/ — EGYETLEN tartós bérlet információs oldal (2026-10).
// Általános tudnivalók + cégeknek / magánszemélyeknek / elektromos szekció + linkek az autókhoz.
// Az autókártyák (szűrők, foglaló ablak) csak az /autoink/#berelheto oldalon vannak.
import '../styles/eladom.css';
import { allRentals, getVariant, fmt } from '../data/tartosBerlet';

const v = getVariant('main');
const vc = getVariant('cegeknek');
const vm = getVariant('maganszemelyeknek');
const ve = getVariant('elektromos');
const cars = allRentals();
const evs = cars.filter(ve.filter);
const SITE = 'https://www.caradvance.hu';
const url = SITE + '/tartos-berlet/';
const TB_MIN = 6;

const min = cars.length ? cars[0].huf : 0;
const max = cars.length ? Math.max(...cars.map((c) => c.huf)) : 0;
const depMin = cars.length ? Math.min(...cars.map((c) => c.dep)) : 0;
const depMax = cars.length ? Math.max(...cars.map((c) => c.dep)) : 0;
const sp = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const mk = (list: any[]) => (s: string) => {
  const mn = list.length ? list[0].huf : 0, mx = list.length ? Math.max(...list.map((c) => c.huf)) : 0;
  const dn = list.length ? Math.min(...list.map((c) => c.dep)) : 0, dx = list.length ? Math.max(...list.map((c) => c.dep)) : 0;
  return s.replace(/\{min\}/g, fmt(mn)).replace(/\{max\}/g, fmt(mx)).replace(/\{n\}/g, String(list.length))
    .replace(/\{depmin\}/g, sp(dn)).replace(/\{depmax\}/g, sp(dx)).replace(/\{dep\}/g, sp(dn))
    .replace(/\{cheapest\}/g, list.length ? list[0].name : '').replace(/\{minp\}/g, fmt(Math.ceil(mn * 1.19 / 10000) * 10000));
};
const fill = mk(cars);
const fillEv = mk(evs);
const href = (c: any) => `/berelheto-auto/${c.slug}-berles/`;

// márkák → szűrt kártyalista az /autoink oldalon
const BR: Record<string, [string, string, string]> = {
  BMW: ['BMW', 'bmw', 'bmw'], 'Mercedes-Benz': ['Mercedes-Benz', 'mercedes', 'mercedes'], Audi: ['Audi', 'audi', 'audi'],
  MINI: ['MINI', 'mini', 'mini'], VW: ['Volkswagen', 'volkswagen', 'vw'], CUPRA: ['CUPRA', 'cupra', 'cupra'], Seat: ['SEAT', 'seat', 'seat'],
  SEAT: ['SEAT', 'seat', 'seat'], Hyundai: ['Hyundai', 'hyundai', 'hyundai'], Kia: ['Kia', 'kia', 'kia'], Volvo: ['Volvo', 'volvo', 'volvo'], MAN: ['MAN', 'man', 'man'],
};
const PICK: Record<string, string> = { bmw: 'BMW X3', volkswagen: 'Volkswagen Tiguan', audi: 'Audi Q5 Sportback', mercedes: 'Mercedes-Benz GLC', hyundai: 'Hyundai Tucson', mini: 'MINI Countryman', kia: 'Kia EV4', cupra: 'CUPRA Tavascan', seat: 'Seat Leon Sportstourer', volvo: 'Volvo XC40', man: 'MAN TGE Kombi Basic' };
const brands: { name: string; marka: string; logo: string; n: number; min: number; img: string; car: string }[] = [];
for (const c of cars) {
  const b = BR[c.brand]; if (!b) continue;
  let x = brands.find((y) => y.marka === b[1]);
  if (!x) { x = { name: b[0], marka: b[1], logo: `/bl-${b[2]}-dark.webp`, n: 0, min: c.huf, img: '', car: '' }; brands.push(x); }
  x.n++; x.min = Math.min(x.min, c.huf);
  if (c.photo && (!x.img || PICK[b[1]] === c.name)) { x.img = c.photo; x.car = c.name; }
}
brands.sort((a, b) => b.n - a.n);

const INCL: [string, string][] = [
  ['Casco és kötelező biztosítás', 'Teljes körű biztosítás a havidíjban; káresetnél csak az önrész a tiéd.'],
  ['Szerviz és karbantartás', 'Minden kötelező szerviz és karbantartás a gyártó előírásai szerint.'],
  ['Gépjárműadó', 'A német rendszámos autó adóját mi fizetjük.'],
  ['Nyári és téli gumi', 'Mindkét gumiszett, a szezonális cserével együtt.'],
  ['Német rendszám, forgalomba helyezés', 'Az autó a Caradvance GmbH (München) nevén fut, minden papír rendben.'],
  ['Havi 2 000–4 000 km futáskeret', 'Autótól függően 2 000 és 4 000 km között; a keret a teljes bérleti időre összeadódik, ha több kell, előre megbeszéljük.'],
];
const EXCL: [string, string][] = [
  ['Üzemanyag vagy töltés', 'A tankolás, illetve elektromos autónál a töltés a bérlőé.'],
  ['Útdíjak, parkolás, bírságok', 'Autópálya-matrica, parkolási díj és a bérlet alatti bírságok.'],
  ['Túlfutott kilométer', 'A kereten felüli kilométereket visszaadáskor számoljuk el.'],
  ['Önrész káresetnél', 'A biztosítás önrésze — a pontos összeget a szerződés rögzíti.'],
];
const STEPS: [string, string][] = [
  ['Válassz autót', 'Nézd meg a <a href="/autoink/#berelheto">bérelhető autóinkat</a> — változat, szín, futáskeret, elérhetőség.'],
  ['Kérj ajánlatot', 'Pár perc online; visszahívunk, egyeztetjük a futamidőt és az átadás időpontját.'],
  ['Szerződés és kaució', 'A szerződést a Caradvance GmbH-val kötöd, a kaució a bérlet végén visszajár.'],
  ['Átveszed és vezetsz', 'Legalább 6 hónapig a tiéd; a havidíjon kívül csak az üzemanyag vagy a töltés a tiéd.'],
  ['6 hónap után', 'Hosszabbítasz (30 napos felmondással), visszaadod, vagy új modellre váltasz.'],
];
const CMP: [string, string, string, string][] = [
  ['Futamidő', 'jellemzően 24–60 hónap', 'jellemzően 12–84 hónap', 'nálunk 6 hónaptól'],
  ['Önerő', 'gyakran van', 'jellemzően 10–30%', 'nincs, csak visszajáró kaució'],
  ['Kié az autó a végén?', 'a lízingcégé', 'a tiéd lehet', 'visszaadod'],
  ['Szerviz, gumi, biztosítás', 'full service-nél benne', 'külön fizeted', 'a díjban benne'],
  ['Értékvesztés kockázata', 'a lízingcégé', 'részben a tiéd', 'nincs'],
];

// GYIK: fő + céges + magán + elektromos, ismétlés nélkül
const faqs: [string, string][] = [];
const seen = new Set<string>();
const addF = (list: [string, string][], f: (s: string) => string) => { for (const [q, a] of list) { const k = q.toLowerCase(); if (seen.has(k)) continue; seen.add(k); faqs.push([f(q), f(a)]); } };
addF([['Lehet nálatok napra vagy hétre autót bérelni?', 'Nem. Napi vagy heti autókölcsönzéssel nem foglalkozunk — nálunk minden bérlet tartós bérlet, legalább 6 hónapos futamidővel.']], fill);
addF(v.faqs, fill); addF(vc.faqs, fill); addF(vm.faqs, fill); addF(ve.faqs, fillEv);

const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const faqJson = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: strip(q), acceptedAnswer: { '@type': 'Answer', text: strip(a) } })) };
const crumbJson = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Főoldal', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Tartós bérlet', item: url }] };
const serviceJson = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Tartós bérlet', serviceType: 'Tartós autóbérlés (minimum 6 hónap)', url,
  areaServed: { '@type': 'Country', name: 'Magyarország' },
  provider: { '@type': 'AutoRental', name: 'CarAdvance', url: SITE + '/', telephone: '+36 30 233 6060' },
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Tartós bérlet — bérelhető autók', itemListElement: cars.slice(0, 40).map((c) => ({
    '@type': 'Offer', url: SITE + href(c), itemOffered: { '@type': 'Car', name: c.name, brand: { '@type': 'Brand', name: c.brand } },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: c.huf, priceCurrency: 'HUF', unitCode: 'MON', valueAddedTaxIncluded: false } })) },
};
const calc = cars.map((c) => ({ n: c.name, h: c.huf, d: c.depHuf, m: TB_MIN }));
const RB_CSS = '\n.tb .rb-wrap{margin:0 0 26px}\n.tb .rb-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}\n@media(max-width:1100px){.tb .rb-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:560px){.tb .rb-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;padding:2px 2px 10px;scrollbar-width:none}.tb .rb-grid::-webkit-scrollbar{display:none}.tb .rb-card{flex:0 0 72%;scroll-snap-align:start}}\n.tb .rb-card{background:#fff;border:1px solid #eceff4;border-radius:22px;box-shadow:0 10px 30px rgba(11,15,30,.05);padding:22px 20px 18px;display:flex;flex-direction:column;align-items:center;text-align:center}\n.tb .rb-h{font-size:26px;line-height:1.1;font-weight:800;letter-spacing:-.02em;color:#0b0b0d;margin:0}\n.tb .rb-h em{font-style:normal;color:#e2001a}\n.tb .rb-p{font-size:14.5px;line-height:1.45;color:#5b6475;font-weight:600;margin:10px 0 0;min-height:42px}\n.tb .rb-v{margin-top:auto;padding-top:14px;border-top:1px solid #eceff4;width:100%;display:flex;align-items:center;justify-content:center;gap:12px;min-height:58px;margin-top:14px}\n.tb .rb-v svg{width:38px;height:38px;flex:0 0 38px}\n.tb .rb-pill{white-space:nowrap;font-weight:800;font-size:17px;color:#0b0b0d;background:#f3f5f9;border:1px solid #e6eaf1;border-radius:12px;padding:7px 13px;letter-spacing:.02em}\n.tb .rb-odo{font-family:ui-monospace,Menlo,monospace;font-weight:800;font-size:17px;background:#0b0b0d;color:#fff;border-radius:8px;padding:6px 10px;letter-spacing:.18em}\n.tb .rb-plate{display:inline-flex;align-items:stretch;border:2px solid #0b0b0d;border-radius:7px;overflow:hidden;background:#fff;height:38px}\n.tb .rb-plate i{background:#1d4ed8;color:#fff;font-style:normal;font-weight:800;font-size:11px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:3px 6px 4px;line-height:1}\n.tb .rb-plate i:before{content:"★";color:#facc15;font-size:9px;margin-bottom:3px}\n.tb .rb-plate b{font-family:"Arial Narrow",Arial,sans-serif;font-weight:800;font-size:21px;letter-spacing:.06em;color:#0b0b0d;display:flex;align-items:center;padding:0 10px}\n/* asztali: cím – szöveg – ikon soronként egy vonalban (subgrid) */\n@supports (grid-template-rows:subgrid){@media(min-width:561px){.tb .rb-card{display:grid;grid-row:span 3;grid-template-rows:subgrid;row-gap:0;justify-items:center;align-items:start}.tb .rb-h{align-self:start}.tb .rb-p{min-height:0;align-self:start}.tb .rb-v{align-self:end;margin-top:16px}}}\n@supports not (grid-template-rows:subgrid){.tb .rb-card .rb-v{margin-top:auto}.tb .rb-p{margin-bottom:14px}.tb .rb-h{min-height:2.2em}}\n@media(max-width:560px){.tb .rb-card{padding:16px 12px 12px;border-radius:18px}.tb .rb-h{font-size:19px}.tb .rb-p{font-size:12.5px;min-height:0}.tb .rb-v{min-height:44px;gap:8px}.tb .rb-v svg{width:30px;height:30px;flex-basis:30px}.tb .rb-pill,.tb .rb-odo{font-size:14px}.tb .rb-plate{height:30px}.tb .rb-plate b{font-size:15px;padding:0 6px}}\n';
const RB_HTML = '<div class="rb-wrap"><div class="rb-grid">\n<div class="rb-card"><p class="rb-h">0 km <em>új autó</em></p><p class="rb-p">Vadonatúj, gyári garanciás autó — nem használt flottaautó.</p><div class="rb-v"><span class="rb-odo">000000</span><span class="rb-pill">km</span></div></div>\n<div class="rb-card"><p class="rb-h">Alacsony <em>kaució</em></p><p class="rb-p">Egyszeri, 2 500 €-tól — a bérlés végén visszajár.</p><div class="rb-v"><span class="rb-pill">2 500 €-tól</span><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="m9 12 2 2 4-4"/></svg></div></div>\n<div class="rb-card"><p class="rb-h">Casco <em>biztosítás</em></p><p class="rb-p">A casco benne van a havidíjban — nyugodtan vezethetsz.</p><div class="rb-v"><svg viewBox="0 0 24 24" fill="none" stroke="#0b0b0d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.3 7.5 9.5 4.4-1.2 7.5-4.9 7.5-9.5V6L12 3z"/><path d="m8.8 12.2 2.3 2.3 4.4-4.6" stroke="#e2001a" stroke-width="2.2"/></svg><span class="rb-pill">a díjban</span></div></div>\n<div class="rb-card"><p class="rb-h">Nyári + téli <em>gumi</em></p><p class="rb-p">Mindkét gumiszett jár, a szezonális cserével együtt.</p><div class="rb-v"><svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round"><path d="M12 2v20M4 6.5l16 11M4 17.5l16-11M9.5 3.5 12 6l2.5-2.5M9.5 20.5 12 18l2.5 2.5"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="#0b0b0d" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 3v4.5M12 16.5V21M3 12h4.5M16.5 12H21"/></svg></div></div>\n<div class="rb-card"><p class="rb-h">Német <em>rendszám</em></p><p class="rb-p">Az autó a Caradvance GmbH (München) nevén fut, német rendszámmal.</p><div class="rb-v"><span class="rb-plate"><i>D</i><b>M · CA 2026</b></span></div></div>\n<div class="rb-card"><p class="rb-h">Szerviz + <em>adó</em></p><p class="rb-p">Karbantartás, szerviz és gépjárműadó — mind a havidíjban.</p><div class="rb-v"><svg viewBox="0 0 24 24" fill="none" stroke="#0b0b0d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3.5 17.3a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.2-5.4l-2.4 2.4-2.1-.4-.4-2.1 2.6-2.2z"/></svg><span class="rb-pill">0 Ft extra</span></div></div>\n<div class="rb-card"><p class="rb-h">Rugalmas <em>futamidő</em></p><p class="rb-p">6 hónaptól, havi 2 000–4 000 km kerettel (autótól függően) — utána új modellre válthatsz.</p><div class="rb-v"><svg viewBox="0 0 24 24" fill="none" stroke="#0b0b0d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="m9 14.5 2 2 4-4" stroke="#e2001a" stroke-width="2.2"/></svg><span class="rb-pill">2 000–4 000 km/hó</span></div></div>\n<div class="rb-card"><p class="rb-h">Nincs <em>önerő</em></p><p class="rb-p">Nincs önerő, nincs értékvesztés, nincs eladási gond.</p><div class="rb-v"><span class="rb-pill">0 Ft önerő</span><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16.5 9.5"/></svg></div></div>\n</div></div>'.split('2 500 €-tól').join(String(depMin).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' €-tól');
---
<section class="tb">
<section class="hero">
<video autoplay muted loop playsinline preload="metadata" poster="/caradvance-hero-beszerzesi-poster.jpg"><source src="/caradvance-hero-beszerzesi.mp4" type="video/mp4" /></video>
<div class="scrim"></div>
<div class="inner">
<h1>Tartós bérlet —<br /><span class="accent">új prémium autó 6 hónaptól</span></h1>
<p class="sub sub-wide">Egy fix havidíj, amelyben a casco, a szerviz, az adó és a gumi is benne van — önerő nélkül, cégeknek és magánszemélyeknek. Napi bérléssel nem foglalkozunk: minden bérletünk legalább 6 hónapos.</p>
<div class="tb-chips"><span><b>{cars.length}</b> bérelhető modell</span><span><b>{fmt(min)} Ft</b>/hó-tól (nettó)</span><span><b>{sp(depMin)} €</b> kaució-tól</span><span><b>{TB_MIN} hónaptól</b></span></div>
<div class="cta-row">
<a class="btn btn-primary" href="/autoink/#berelheto">Bérelhető autóink →</a>
<a class="btn btn-white" href="#kalkulator">Költség kalkulátor</a>
</div>
</div>
</section>

<nav class="tb-crumb wrap" aria-label="Morzsamenü"><a href="/">Főoldal</a><span>›</span><span aria-current="page">Tartós bérlet</span></nav>

<nav class="wrap tb-toc" aria-label="Tartalom">
<a href="#mi-ez">Mi a tartós bérlet?</a><a href="#havidij">Mit tartalmaz?</a><a href="#menete">Menete</a><a href="#cegeknek">Cégeknek</a><a href="#maganszemelyeknek">Magánszemélyeknek</a><a href="#elektromos">Elektromos</a><a href="#autok">Autók és árak</a><a href="#kalkulator">Kalkulátor</a><a href="#gyik">GYIK</a>
</nav>

<section class="section tb-bensec">
<div class="wrap center"><span class="eyebrow">Minden benne van</span><h2 class="sec-title">Egy fix havidíj — {TB_MIN} hónaptól</h2>
<p class="sec-intro">Új autó, casco, szerviz, gépjárműadó és nyári-téli gumi a havidíjban. Neked csak az üzemanyag vagy a töltés marad.</p></div>
<div class="wrap tb-ben"><Fragment set:html={RB_HTML} /></div>
</section>

<section class="section tb-sec" id="mi-ez"><div class="wrap">
<div class="tb-introbox">
<span class="eyebrow">{v.eyebrow}</span>
<h2>Mi a tartós bérlet?</h2>
{v.intro.map((p) => <p set:html={fill(p)} />)}
<p class="tb-note2"><strong>Fontos:</strong> napi vagy heti autókölcsönzéssel nem foglalkozunk. Minden bérletünk legalább {TB_MIN} hónapos — utána 30 napos felmondással hosszabbítható.</p>
</div>
</div></section>

<section class="section tb-sec" id="havidij">
<div class="wrap center"><span class="eyebrow">Havidíj</span><h2 class="sec-title">Mit tartalmaz a havidíj — és mit nem?</h2></div>
<div class="wrap tb-two">
<div class="tb-col tb-yes"><h3>Benne van</h3><ul>{INCL.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ul></div>
<div class="tb-col tb-no"><h3>Nincs benne</h3><ul>{EXCL.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ul>
<p class="tb-mini">Részletek: <a href="/berlesi-feltetelek/">Feltételek és kaució</a></p></div>
</div>
</section>

<section class="section tb-sec" id="menete">
<div class="wrap center"><span class="eyebrow">Menete</span><h2 class="sec-title">Így működik a tartós bérlet</h2></div>
<div class="wrap tb-steps">{STEPS.map(([t, d], i) => (<div class="tb-step"><span class="tb-n">{i + 1}</span><h3>{t}</h3><p set:html={d} /></div>))}</div>
<div class="wrap center tb-more"><a class="btn btn-white tb-btn-o" href="/berlesi-folyamat/">A teljes bérlési folyamat →</a></div>
</section>

<section class="section tb-sec" id="cegeknek">
<div class="wrap tb-split">
<div class="tb-split-t">
<span class="eyebrow">Cégeknek</span>
<h2>Tartós bérlet cégeknek</h2>
{vc.intro.map((p) => <p set:html={fill(p)} />)}
{(vc.extra || []).map((x) => (<><h3>{x.h}</h3>{x.p.map((p) => <p set:html={p} />)}</>))}
</div>
<div class="tb-split-c">{(vc.points || []).map(([t, d]) => (<div class="tb-pt"><h4>{t}</h4><p>{d}</p></div>))}</div>
</div>
</section>

<section class="section tb-sec" id="maganszemelyeknek">
<div class="wrap tb-split tb-split-r">
<div class="tb-split-t">
<span class="eyebrow">Magánszemélyeknek</span>
<h2>Tartós bérlet magánszemélyeknek</h2>
{vm.intro.map((p) => <p set:html={fill(p)} />)}
</div>
<div class="tb-split-c">{(vm.points || []).map(([t, d]) => (<div class="tb-pt"><h4>{t}</h4><p>{d}</p></div>))}</div>
</div>
</section>

<section class="section tb-sec" id="elektromos">
<div class="wrap tb-text">
<span class="eyebrow">Elektromos autók</span>
<h2>Elektromos autó tartós bérletben</h2>
{ve.intro.map((p) => <p set:html={fillEv(p)} />)}
