// Tartós bérlet céloldal — adatvezérelt (src/data/tartosBerlet.ts + src/data/rental.ts)
import '../styles/eladom.css';
import { allRentals, getVariant, fmt, VARIANT_LABEL, VARIANTS } from '../data/tartosBerlet';
import { CONTENT } from '../data/rentalContent';

const { vkey } = Astro.props as { vkey: string };
const v = getVariant(vkey);
const cars = allRentals().filter(v.filter);
const SITE = 'https://www.caradvance.hu';
const url = SITE + v.path + '/';

const min = cars.length ? cars[0].huf : 0;
const max = cars.length ? Math.max(...cars.map((c) => c.huf)) : 0;
const depMin = cars.length ? Math.min(...cars.map((c) => c.dep)) : 0;
const depMax = cars.length ? Math.max(...cars.map((c) => c.dep)) : 0;
const TB_MIN = 6; // tartós bérlet: 6 hónapos vagy hosszabb futamidő
const monthsMin = TB_MIN;
const cheapest = cars.length ? cars[0].name : '';
const fill = (s: string) => s
  .replace(/\{min\}/g, fmt(min)).replace(/\{max\}/g, fmt(max)).replace(/\{n\}/g, String(cars.length))
  .replace(/\{depmin\}/g, fmt(depMin)).replace(/\{depmax\}/g, fmt(depMax)).replace(/\{dep\}/g, fmt(depMin))
  .replace(/\{cheapest\}/g, cheapest).replace(/\{minp\}/g, fmt(Math.ceil(min * 1.19 / 10000) * 10000));


// ---- kártyák: ugyanaz a dizájn, mint az /autoink bérelhető kártyáin ----
const LK: Record<string, string> = { VW: 'vw', BMW: 'bmw', Audi: 'audi', 'Mercedes-Benz': 'mercedes', MINI: 'mini', Hyundai: 'hyundai', CUPRA: 'cupra', Kia: 'kia', MAN: 'man', Seat: 'seat', SEAT: 'seat', Volvo: 'volvo' };
const FC: Record<string, string> = { Benzin: '#e8820c', 'Dízel': '#6b7280', PHEV: '#00997E', Hibrid: '#00997E', Elektromos: '#0D79FF', EV: '#0D79FF' };
const FL: Record<string, string> = { PHEV: 'Hibrid' };
const FO: Record<string, number> = { Benzin: 1, Hibrid: 2, PHEV: 2, Elektromos: 3, EV: 3, 'Dízel': 4 };
const logoOf = (c: any) => (LK[c.brand] ? '/bl-' + LK[c.brand] + '.webp' : '');
const galOf = (c: any) => {
  const g = ((CONTENT as any)[c.key]?.gallery || []).map((x: any) => x.img).filter((u: string) => u && !u.startsWith('/berles/') && u !== c.photo);
  return g.slice(0, 8);
};
const fuelsOf = (c: any) => (c.fuels || []).slice().sort((a: string, b: string) => (FO[a] || 9) - (FO[b] || 9));
const specsOf = (c: any) => [c.cat].concat(c.gears || []).filter(Boolean).join(' · ');
const availOf = (c: any) => (c.now > 0 ? { cls: 'now', t: c.now + ' elérhető' } : { cls: 'pre', t: (c.later && c.later[0] && c.later[0].d) || 'Hamarosan' });
const tipOf = (c: any) => `A forintár a napi árfolyammal számolt (1 € ≈ ${fmt(c.rate)} Ft). A feltüntetett ár nettó havidíj: ${fmt(c.eur)} €/hó + áfa (cégeknek). Magánszemélyek 19% német áfát fizetnek felette. A „-tól” a legkedvezőbb felszereltségre vonatkozik. Tartós bérlet: legalább ${TB_MIN} hónap.`;
const CARDS_CSS = '.tb-cards .sub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n@media(max-width:920px){.tb-cards .sub-grid{grid-template-columns:1fr 1fr}}\n@media(max-width:600px){.tb-cards .sub-grid{grid-template-columns:1fr}}\n.tb-cards .sub-card{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s}\n.tb-cards .sub-card:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(8,8,10,.12);border-color:#d6deea}\n.tb-cards .sub-media{position:relative;aspect-ratio:49/26;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.tb-cards .sub-media .sub-photo{width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block;padding:14px 8% 0;box-sizing:border-box;transform:translateY(6%)}\n.tb-cards .sub-media .car{width:66%;height:auto}\n.tb-cards .sub-avail{position:absolute;top:10px;right:11px;font-size:10.5px;font-weight:800;padding:4px 9px;border-radius:999px}\n.tb-cards .sub-avail.now{background:#1DA851;color:#fff}\n.tb-cards .sub-avail.pre{background:rgba(255,255,255,.92);color:var(--navy)}\n.tb-cards .sub-body{padding:14px 16px 16px;display:flex;flex-direction:column;flex:1}\n.tb-cards .sub-title{font-size:17px;font-weight:800;letter-spacing:-.01em;margin:0 0 6px;color:var(--ink)}\n.tb-cards .sub-btn{margin-top:auto;display:block;text-align:center;background:var(--navy);color:#fff;font-weight:700;font-size:13.5px;padding:11px;border-radius:999px;text-decoration:none;transition:background .15s}\n.tb-cards .sub-btn:hover{background:var(--red)}\n.tb-cards .sub-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:visible;display:flex;flex-direction:column}\n.tb-cards .sub-card:hover{box-shadow:0 14px 34px rgba(15,27,45,.10);transform:translateY(-3px)}\n.tb-cards .sub-media{position:relative;background:#fff;aspect-ratio:49/26;display:flex;align-items:center;justify-content:center;padding:10px;border-radius:20px 20px 0 0;overflow:hidden}\n.tb-cards .sub-fuels{position:absolute;top:12px;right:12px;display:flex;flex-direction:column;gap:6px;align-items:flex-end}\n.tb-cards .sub-fuel{color:#fff;font-size:12px;font-weight:700;padding:5px 12px;border-radius:100px;box-shadow:0 2px 6px rgba(0,0,0,.12)}\n.tb-cards .sub-avail{position:absolute;left:12px;top:12px;right:auto;bottom:auto;width:auto;max-width:none;font-size:12px;font-weight:800;padding:5px 11px;border-radius:999px;z-index:3;box-shadow:0 2px 8px rgba(0,0,0,.18)}\n.tb-cards .sub-avail.now{background:#00997E;color:#fff}\n.tb-cards .sub-avail.pre{background:#6b7280;color:#fff}\n.tb-cards .sub-body{padding:16px 20px 14px}\n.tb-cards .sub-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:10px}\n.tb-cards .sub-brand2{display:inline-flex;align-items:center}\n.tb-cards .sub-sbadge{height:22px;width:auto;margin-left:12px;display:block}\n.tb-cards .sub-mlogo2{height:auto;max-height:22px;width:auto;max-width:52px;object-fit:contain;filter:brightness(0)}\n.tb-cards .sub-year{font-size:13px;color:var(--muted);text-align:right}\n.tb-cards .sub-title{font-size:22px;font-weight:800;color:var(--navy);margin:0 0 6px;line-height:1.2}\n.tb-cards .sub-specs{font-size:14px;color:var(--muted);margin:0 0 4px}\n.tb-cards .sub-info{position:relative;display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;background:#c9d2e0;color:#fff;font-size:11px;font-weight:700;font-style:normal;line-height:1;cursor:help;flex:0 0 auto}\n.tb-cards .sub-info .sub-tip{position:absolute;bottom:150%;right:0;width:min(290px,80vw);white-space:normal;background:var(--navy);color:#fff;font-size:12px;font-weight:500;font-style:normal;line-height:1.5;padding:11px 13px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.2);opacity:0;visibility:hidden;transition:opacity .15s;z-index:40;text-align:left}\n.tb-cards .sub-info:hover .sub-tip,.tb-cards .sub-info:focus .sub-tip{opacity:1;visibility:visible}\n.tb-cards .sub-price .sub-info{position:static}\n.tb-cards .sub-price .sub-info .sub-tip{left:0;right:0;width:auto;bottom:calc(100% + 8px)}\n.tb-cards .sub-info .sub-tip::after{content:"";position:absolute;left:0;right:0;top:100%;height:14px}\n.tb-cards .sub-info:focus-within .sub-tip{opacity:1;visibility:visible}\n.tb-cards .sub-info .sub-tip{transition:opacity .15s .25s,visibility 0s .4s}\n.tb-cards .sub-info:hover .sub-tip,.tb-cards .sub-info:focus-within .sub-tip{transition:opacity .15s,visibility 0s}\n.tb-cards .sub-tip a{pointer-events:auto}\n.tb-cards .sub-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:8px}\n.tb-cards .sub-btn{display:block;width:100%;box-sizing:border-box;text-align:center;background:#eef2f8;color:var(--navy);font-weight:700;font-size:15px;padding:14px;border:0;border-radius:12px;text-decoration:none;font-family:inherit;cursor:pointer;-webkit-appearance:none;appearance:none;transition:.15s}\n.tb-cards .sub-det{display:block;text-align:center;background:#eef2f8;color:var(--navy);font-weight:700;font-size:15px;padding:14px;border-radius:12px;text-decoration:none;transition:.15s}\n.tb-cards .sub-card:hover .sub-det,.tb-cards .sub-det:hover{background:var(--navy);color:#fff}\n.tb-cards .sub-card:hover .sub-btn,.tb-cards .sub-btn:hover{background:#e2001a;color:#fff}\n@media(hover:hover){.tb-cards .sub-fuels{opacity:0;transition:opacity .18s}.tb-cards .sub-card:hover .sub-fuels{opacity:1}}\n.tb-cards .sub-media .sub-gal{position:absolute;inset:0;display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}\n.tb-cards .sub-media .sub-gal::-webkit-scrollbar{display:none}\n.tb-cards .sub-media .sub-slide{flex:0 0 100%;scroll-snap-align:start;scroll-snap-stop:always;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff}\n.tb-cards .sub-media .sub-slide .sub-gimg{width:100%;height:100%;object-fit:cover;display:block;background:#eef1f5}\n.tb-cards .sub-media .sub-gbtn{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;border:0;background:rgba(255,255,255,.94);box-shadow:0 2px 10px rgba(0,0,0,.18);font-size:22px;line-height:32px;padding:0;color:#0b0b0d;cursor:pointer;opacity:0;transition:opacity .15s;z-index:5}\n.tb-cards .sub-media .sub-gprev{left:10px}\n.tb-cards .sub-media .sub-gnext{right:10px}\n.tb-cards .sub-card:hover .sub-gbtn{opacity:1}\n@media(hover:none){.tb-cards .sub-media .sub-gbtn{opacity:.92;width:30px;height:30px;line-height:28px;font-size:19px}}\n.tb-cards .sub-media:has(.sub-gdots) .sub-gal{bottom:22px}\n.tb-cards .sub-media:has(.sub-gdots) .sub-gbtn{top:calc(50% - 11px)}\n.tb-cards .sub-media .sub-gdots{position:absolute;left:0;right:0;bottom:7px;display:flex;justify-content:center;gap:5px;z-index:5;pointer-events:none}\n.tb-cards .sub-media .sub-gdots i{width:6px;height:6px;border-radius:3px;background:rgba(11,11,13,.28);transition:width .15s,background .15s}\n.tb-cards .sub-media .sub-gdots i.on{background:#e2001a;width:16px}\n.tb-cards .sub-media .sub-fuels,.tb-cards .sub-media .sub-avail{z-index:6}';
const RB_CSS = '\n.tb .rb-wrap{margin:0 0 26px}\n.tb .rb-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}\n@media(max-width:1100px){.tb .rb-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:560px){.tb .rb-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;padding:2px 2px 10px;scrollbar-width:none}.tb .rb-grid::-webkit-scrollbar{display:none}.tb .rb-card{flex:0 0 72%;scroll-snap-align:start}}\n.tb .rb-card{background:#fff;border:1px solid #eceff4;border-radius:22px;box-shadow:0 10px 30px rgba(11,15,30,.05);padding:22px 20px 18px;display:flex;flex-direction:column;align-items:center;text-align:center}\n.tb .rb-h{font-size:26px;line-height:1.1;font-weight:800;letter-spacing:-.02em;color:#0b0b0d;margin:0}\n.tb .rb-h em{font-style:normal;color:#e2001a}\n.tb .rb-p{font-size:14.5px;line-height:1.45;color:#5b6475;font-weight:600;margin:10px 0 0;min-height:42px}\n.tb .rb-v{margin-top:auto;padding-top:14px;border-top:1px solid #eceff4;width:100%;display:flex;align-items:center;justify-content:center;gap:12px;min-height:58px;margin-top:14px}\n.tb .rb-v svg{width:38px;height:38px;flex:0 0 38px}\n.tb .rb-pill{white-space:nowrap;font-weight:800;font-size:17px;color:#0b0b0d;background:#f3f5f9;border:1px solid #e6eaf1;border-radius:12px;padding:7px 13px;letter-spacing:.02em}\n.tb .rb-odo{font-family:ui-monospace,Menlo,monospace;font-weight:800;font-size:17px;background:#0b0b0d;color:#fff;border-radius:8px;padding:6px 10px;letter-spacing:.18em}\n.tb .rb-plate{display:inline-flex;align-items:stretch;border:2px solid #0b0b0d;border-radius:7px;overflow:hidden;background:#fff;height:38px}\n.tb .rb-plate i{background:#1d4ed8;color:#fff;font-style:normal;font-weight:800;font-size:11px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:3px 6px 4px;line-height:1}\n.tb .rb-plate i:before{content:"★";color:#facc15;font-size:9px;margin-bottom:3px}\n.tb .rb-plate b{font-family:"Arial Narrow",Arial,sans-serif;font-weight:800;font-size:21px;letter-spacing:.06em;color:#0b0b0d;display:flex;align-items:center;padding:0 10px}\n/* asztali: cím – szöveg – ikon soronként egy vonalban (subgrid) */\n@supports (grid-template-rows:subgrid){@media(min-width:561px){.tb .rb-card{display:grid;grid-row:span 3;grid-template-rows:subgrid;row-gap:0;justify-items:center;align-items:start}.tb .rb-h{align-self:start}.tb .rb-p{min-height:0;align-self:start}.tb .rb-v{align-self:end;margin-top:16px}}}\n@supports not (grid-template-rows:subgrid){.tb .rb-card .rb-v{margin-top:auto}.tb .rb-p{margin-bottom:14px}.tb .rb-h{min-height:2.2em}}\n@media(max-width:560px){.tb .rb-card{padding:16px 12px 12px;border-radius:18px}.tb .rb-h{font-size:19px}.tb .rb-p{font-size:12.5px;min-height:0}.tb .rb-v{min-height:44px;gap:8px}.tb .rb-v svg{width:30px;height:30px;flex-basis:30px}.tb .rb-pill,.tb .rb-odo{font-size:14px}.tb .rb-plate{height:30px}.tb .rb-plate b{font-size:15px;padding:0 6px}}\n';
const RB_HTML = '<div class="rb-wrap"><div class="rb-grid">\n<div class="rb-card"><p class="rb-h">0 km <em>új autó</em></p><p class="rb-p">Vadonatúj, gyári garanciás autó — nem használt flottaautó.</p><div class="rb-v"><span class="rb-odo">000000</span><span class="rb-pill">km</span></div></div>\n<div class="rb-card"><p class="rb-h">Alacsony <em>kaució</em></p><p class="rb-p">Egyszeri, 2 500 €-tól — a bérlés végén visszajár.</p><div class="rb-v"><span class="rb-pill">2 500 €-tól</span><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="m9 12 2 2 4-4"/></svg></div></div>\n<div class="rb-card"><p class="rb-h">Casco <em>biztosítás</em></p><p class="rb-p">A casco benne van a havidíjban — nyugodtan vezethetsz.</p><div class="rb-v"><svg viewBox="0 0 24 24" fill="none" stroke="#0b0b0d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.3 7.5 9.5 4.4-1.2 7.5-4.9 7.5-9.5V6L12 3z"/><path d="m8.8 12.2 2.3 2.3 4.4-4.6" stroke="#e2001a" stroke-width="2.2"/></svg><span class="rb-pill">a díjban</span></div></div>\n<div class="rb-card"><p class="rb-h">Nyári + téli <em>gumi</em></p><p class="rb-p">Mindkét gumiszett jár, a szezonális cserével együtt.</p><div class="rb-v"><svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round"><path d="M12 2v20M4 6.5l16 11M4 17.5l16-11M9.5 3.5 12 6l2.5-2.5M9.5 20.5 12 18l2.5 2.5"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="#0b0b0d" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 3v4.5M12 16.5V21M3 12h4.5M16.5 12H21"/></svg></div></div>\n<div clas