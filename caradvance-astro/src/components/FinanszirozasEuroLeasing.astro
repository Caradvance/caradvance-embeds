---
import '../styles/eladom.css';
import LizingKalkulator from './LizingKalkulator.astro';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const constructions = [
  {
    t: 'Nyíltvégű pénzügyi lízing',
    d: 'A futamidő végén az ügyfél megvásárolhatja, harmadik felet jelölhet ki, vagy visszaadhatja a lízingtárgyat. Maradványértékes konstrukcióként a havi részletek mértéke tovább csökkenthető. Vállalkozásként a lízingdíjak tőkerészének áfája – jogszabályi feltételekkel, akár személygépjárműnél is – visszaigényelhető.',
    tags: ['Rugalmas lezárás', 'Maradványérték 20–30%', 'Áfa-visszaigénylés (cégnek)'],
  },
  {
    t: 'Zártvégű pénzügyi lízing',
    d: 'Adásvételhez kapcsolódó konstrukció: az összes lízingdíj rendezése után a tulajdonjog automatikusan az ügyfélre száll. Biztonságos forma, hiszen a futamidő alatt a finanszírozó a tulajdonos, így az autót nem terhelheti az ügyfél más jellegű tartozása (pl. NAV, végrehajtás).',
    tags: ['Automatikus tulajdonszerzés', 'Nincs maradványérték', 'Kereskedésen kívüli vételnél is'],
  },
  {
    t: 'Euró finanszírozás',
    d: 'Euró árbevétellel rendelkező vállalkozásoknak kínált konstrukció, a forint kamatokhoz képest jellemzően jelentősen alacsonyabb kamatszint mellett. Nyíltvégű és zártvégű formában egyaránt elérhető, fix vagy változó kamatozással.',
    tags: ['Alacsonyabb kamatszint', 'Csak igazolt EUR bevétellel', 'Fix vagy változó kamat'],
  },
];

const benefits = [
  'A lízingdíj kamatrésze költségként elszámolható.',
  'Nyíltvégűnél a beszerzési ár áfája nem része a lízingtőkének, így a kamatszámítás alapjának sem — a fizetendő kamat kevesebb, mint hasonló ütemezésű zártvégűnél.',
  'A lízingbevevő vállalkozások jogosultak az értékcsökkenés elszámolására.',
  'Maradványértékes konstrukcióval csökkenthető a havi törlesztőrészlet.',
  'Új és használt eszköz finanszírozásához is igénybe vehető.',
  'Meghatározott feltételek mellett a szerződés biztosításmentesen is megköthető.',
];

const faqs: [string, string][] = [
  ['Kinek elérhető a nyíltvégű lízing?', 'Magánszemélyeknek (személygépjármű és motorkerékpár finanszírozására), valamint egyéni és társas vállalkozásoknak. Kizárólag teljes áfás számla esetén alkalmazható — áfa-mentes vagy különbözeti áfás értékesítésnél nem.'],
  ['Mi a különbség nyíltvégű és zártvégű között?', 'Nyíltvégűnél a futamidő végén te döntesz a tulajdonjogról (megveszed, kijelölsz vagy visszaadod), és maradványértékkel csökken a részlet. Zártvégűnél a záró díjfizetés után automatikusan a tiéd lesz az autó, maradványérték nélkül.'],
  ['Van EUR alapú finanszírozás?', 'Igen, az Euró finanszírozás igazolt euró bevétellel rendelkező vállalkozásoknak, a forint kamatoknál jellemzően kedvezőbb kamatszinttel. Magánszemélyeknek forint alapú konstrukció érhető el.'],
  ['Köthető-e casco és GAP biztosítás?', 'Igen. Elérhető a finanszírozásba beépített (integrált) casco, valamint választható GAP vételár-biztosítás, amely lopás vagy totálkár esetén a kárkori érték és az egykori vételár különbözetét is megtéríti a casco önrésszel együtt.'],
];
const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<section class="fp">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<span class="fp-crumb"><a href="/finanszirozas-lizing">Finanszírozás – lízing</a> / Euro Leasing</span>
<h1>Euro Leasing —<br /><span class="accent">pénzügyi lízing partnerünk</span></h1>
<p class="sub sub-wide" style="max-width:900px">Az Euro Leasing (MBH Bankcsoport) egyik finanszírozó partnerünk, akin keresztül nyíltvégű és zártvégű pénzügyi lízinget tudunk biztosítani — forint és euró alapon, magánszemélyeknek és vállalkozásoknak egyaránt.</p>
<div class="cta-row">
<a class="btn btn-primary" href="#kalkulator">Havi részlet kiszámítása</a>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap center">
<span class="eyebrow">Konstrukciók</span>
<h2 class="sec-title">Milyen konstrukciók érhetők el?</h2>
<p class="sec-intro">Három fő lízingforma, mindegyik forint és euró alapon, fix vagy változó kamatozással.</p>
</div>
<div class="wrap fp-cards">
{constructions.map((c) => (
<div class="fp-card">
<h3>{c.t}</h3>
<p>{c.d}</p>
<div class="fp-tags">{c.tags.map((x) => (<span>{x}</span>))}</div>
</div>
))}
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Előnyök</span>
<h2 class="sec-title">Miért jó választás a pénzügyi lízing?</h2>
</div>
<div class="wrap fp-benefits">
{benefits.map((b) => (<div class="fp-b"><span class="fp-check">✓</span><p>{b}</p></div>))}
</div>
</section>

<section class="section" id="kalkulator" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Kalkulátor</span>
<h2 class="sec-title">Számold ki a havi részleted</h2>
<p class="sec-intro">Állítsd be a paramétereket — a becslés az Euro Leasing reprezentatív, rögzített kamatozású példái alapján készül.</p>
</div>
<div class="wrap">
<LizingKalkulator title="Euro Leasing lízingkalkulátor" partner="Euro Leasing" rate={9.59} />
</div>
</section>

<section class="section">
<div class="wrap">
<div class="fp-cta">
<div>
<h2>Az Euro Leasinggel finanszíroznád az autód?</h2>
<p>Segítünk kiválasztani a megfelelő konstrukciót, és összekötünk a partnerrel a pontos, személyre szabott ajánlathoz.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek →</a>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések</h2>
</div>
<div class="wrap fp-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
<div class="wrap center"><a class="fp-back" href="/finanszirozas-lizing">← Vissza a finanszírozás áttekintéshez</a></div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
</section>

<style>
.fp{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.fp .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.fp-crumb{display:inline-block;font-size:13px;font-weight:700;color:rgba(255,255,255,.85);margin-bottom:10px}
.fp-crumb a{color:#fff;text-decoration:underline}
.fp-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
@media(max-width:900px){.fp-cards{grid-template-columns:1fr}}
.fp-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
.fp-card h3{font-size:18px;font-weight:800;color:var(--ink);margin:0 0 8px}
.fp-card p{color:var(--muted);font-size:14px;line-height:1.6;margin:0 0 14px}
.fp-tags{display:flex;flex-wrap:wrap;gap:7px}
.fp-tags span{background:#f1f4f9;color:var(--navy);font-size:12px;font-weight:700;padding:5px 10px;border-radius:999px}
.fp-benefits{display:grid;grid-template-columns:1fr 1fr;gap:14px 24px;margin-top:20px}
@media(max-width:720px){.fp-benefits{grid-template-columns:1fr}}
.fp-b{display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.fp-check{flex:0 0 auto;width:24px;height:24px;border-radius:50%;background:#e8f7ee;color:#16a34a;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}
.fp-b p{color:var(--ink);font-size:14.5px;line-height:1.55;margin:0;font-weight:600}
.fp-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.fp-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.fp-cta p{color:#cfd6e2;margin:0;font-size:15px;max-width:560px}
.fp-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.fp-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.fp-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.fp-faq summary::-webkit-details-marker{display:none}
.fp-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.fp-faq details[open] .pl{transform:rotate(45deg)}
.fp-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.fp-back{display:inline-block;margin-top:22px;font-weight:800;font-size:14.5px;color:var(--red);text-decoration:none}
.fp-back:hover{text-decoration:underline}
</style>
