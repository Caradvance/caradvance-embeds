  var makeSel = document.getElementById('b-make');
  var modelSel = document.getElementById('b-model');
  var fillModels = function(){
    var data = MODELS[makeSel.value];
    var has = !!data && (Array.isArray(data) ? data.length : Object.keys(data).length);
    modelSel.innerHTML = '';
    var ph = document.createElement('option');
    ph.value=''; ph.disabled=true; ph.selected=true;
    ph.textContent = has ? 'Válassz modellt…' : 'Nincs lista — írd a Típusjelbe';
    modelSel.appendChild(ph);
    var addOpt = function(parent,m){ var o=document.createElement('option'); o.textContent=m; parent.appendChild(o); };
    if(Array.isArray(data)){ data.forEach(function(m){ addOpt(modelSel,m); }); }
    else if(data){ Object.keys(data).forEach(function(grp){ var og=document.createElement('optgroup'); og.label=grp; data[grp].forEach(function(m){ addOpt(og,m); }); modelSel.appendChild(og); }); }
    var other=document.createElement('option'); other.textContent='Egyéb (nincs a listában)'; modelSel.appendChild(other);
    modelSel.disabled=false;
  };

  var EURHUF = 400;
  var toEur = function(amountStr, cur){
    var n = parseInt((amountStr||'').replace(/\D/g,''),10)||0;
    if(!n) return 0;
    return cur === '€' ? n : Math.round(n / EURHUF);
  };
  var updateCompare = function(){
    var mk = val('b-make'); if(mk==='Egyéb') mk='';
    var md = val('b-model'); if(md.indexOf('Egyéb')===0) md='';
    var yf = val('b-year-from'), yt = val('b-year-to');
    var kf = (val('b-km-from')||'').replace(/\D/g,''), kt = (val('b-km-to')||'').replace(/\D/g,'');
    var fuel = val('b-fuel');
    var budgetEur = toEur(val('b-budget'), val('b-cur'));

    // mobile.de
    var mo = document.getElementById('cmp-mobile');
    if(mo){
      var mp = 'https://suchen.mobile.de/fahrzeuge/search.html?dam=false&isSearchRequest=true&ref=quickSearch&s=Car&sb=rel&vc=Car';
      var q = ((mk?mk:'')+' '+(md?md:'')).trim();
      if(q) mp += '&q=' + encodeURIComponent(q);
      if(yf) mp += '&minFirstRegistrationDate=' + yf + '-01-01';
      if(yt) mp += '&maxFirstRegistrationDate=' + yt + '-12-31';
      if(kf) mp += '&minMileage=' + kf;
      if(kt) mp += '&maxMileage=' + kt;
      if(budgetEur) mp += '&maxPrice=' + budgetEur;
      var fm = {'Benzin':'PETROL','Dízel':'DIESEL','Hibrid':'HYBRID','Plug-in hibrid':'HYBRID_PLUGIN','Elektromos':'ELECTRICITY','LPG/Benzin':'LPG'};
      if(fm[fuel]) mp += '&fuels=' + fm[fuel];
      mo.href = mp;
    }
    // AutoScout24
    var as = document.getElementById('cmp-as24');
    if(as){
      var base = 'https://www.autoscout24.de/lst';
      if(mk) base += '/' + slug(mk);
      if(mk && md) base += '/' + slug(md);
      var p = [];
      p.push('sort=standard'); p.push('desc=0'); p.push('cy=D'); p.push('atype=C');
      if(yf) p.push('fregfrom=' + yf);
      if(yt) p.push('fregto=' + yt);
      if(kf) p.push('kmfrom=' + kf);
      if(kt) p.push('kmto=' + kt);
      if(budgetEur) p.push('priceto=' + budgetEur);
      var af = {'Benzin':'B','Dízel':'D','Elektromos':'E','LPG/Benzin':'2','Hibrid':'3','Plug-in hibrid':'3'};
      if(af[fuel]) p.push('fuel=' + af[fuel]);
      as.href = base + '?' + p.join('&');
    }
  };

  makeSel.addEventListener('change', function(){ fillModels(); updateCompare(); });
  ['b-model','b-year-from','b-year-to','b-km-from','b-km-to','b-fuel','b-budget','b-cur'].forEach(function(id){
    var e=document.getElementById(id); if(e) e.addEventListener('input', updateCompare); if(e) e.addEventListener('change', updateCompare);
  });
  fetch('https://open.er-api.com/v6/latest/EUR').then(function(r){return r.json();}).then(function(d){ if(d&&d.rates&&d.rates.HUF) EURHUF=d.rates.HUF; updateCompare(); }).catch(function(){ updateCompare(); });

  // thousand separators
  var groupInput = function(id){
    var e=document.getElementById(id); if(!e) return;
    e.addEventListener('input', function(){
      var d=(e.value||'').replace(/\D/g,'');
      e.value = d ? d.replace(/\B(?=(\d{3})+(?!\d))/g,' ') : '';
      if(id==='b-budget') updateCompare();
    });
  };
  groupInput('b-budget');

  // financing show/hide
  form.querySelectorAll('input[name="pay"]').forEach(function(r){
    r.addEventListener('change', function(){
      var cash = radioVal('pay') === 'Készpénz / önerőből';
      document.getElementById('finBox').hidden = cash;
    });
  });
  // private/company toggle
  form.querySelectorAll('input[name="who"]').forEach(function(r){
    r.addEventListener('change', function(){
      var comp = radioVal('who') === 'Cég';
      document.getElementById('privBox').hidden = comp;
      document.getElementById('compBox').hidden = !comp;
    });
  });

  // wizard nav
  var panels = form.querySelectorAll('.kw-panel');
  var dots = form.querySelectorAll('.kw-dot');
  var bar = document.getElementById('kwBar');
  var prevBtn = document.getElementById('kwPrev');
  var nextBtn = document.getElementById('kwNext');
  var subBtn = document.getElementById('kwSubmit');
  var count = document.getElementById('kwCount');
  var render = function(){
    panels.forEach(function(p){ p.hidden = (parseInt(p.getAttribute('data-step'),10) !== step); });
    dots.forEach(function(d){ var n=parseInt(d.getAttribute('data-dot'),10); d.classList.toggle('active', n===step); d.classList.toggle('done', n<step); });
    bar.style.width = (step/TOTAL*100) + '%';
    count.textContent = step + ' / ' + TOTAL;
    prevBtn.style.visibility = step===1 ? 'hidden' : 'visible';
    nextBtn.hidden = step===TOTAL;
    subBtn.hidden = step!==TOTAL;
    var top = form.getBoundingClientRect().top + window.pageYOffset - 90;
    window.scrollTo({ top: top, behavior: 'smooth' });
  };
  var validateStep = function(){
    if(step===1 && !val('b-make')){ alert('Kérlek, válaszd ki legalább a márkát.'); return false; }
    if(step===5){
      var comp = radioVal('who')==='Cég';
      if(comp){ if(!val('b-cname') || !(val('b-cemail')||val('b-cphone'))){ alert('Kérlek add meg a cégnevet és egy elérhetőséget (e-mail vagy telefon).'); return false; } }
      else { if(!val('b-name') || !(val('b-email')||val('b-phone'))){ alert('Kérlek add meg a neved és egy elérhetőséget (e-mail vagy telefon).'); return false; } }
    }
    return true;
  };
  nextBtn.addEventListener('click', function(){ if(!validateStep()) return; if(step<TOTAL){ step++; render(); } });
  prevBtn.addEventListener('click', function(){ if(step>1){ step--; render(); } });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(!validateStep()) return;
    var comp = radioVal('who')==='Cég';
    var yrs = (val('b-year-from')||val('b-year-to')) ? ((val('b-year-from')||'?')+' – '+(val('b-year-to')||'?')) : '';
    var kms = (val('b-km-from')||val('b-km-to')) ? ((val('b-km-from')||'0')+' – '+(val('b-km-to')||'?')+' km') : '';
    var rows = [
      ['Márka', val('b-make')], ['Modell', val('b-model')], ['Típusjel', val('b-type')],
      ['Évjárat', yrs], ['Futásteljesítmény', kms], ['Üzemanyag', val('b-fuel')], ['Váltó', val('b-gear')],
      ['Karosszéria', val('b-body')], ['Külső szín', val('b-color')], ['Belső szín', val('b-int')],
      ['Megjegyzés', val('b-notes')],
      ['Költségkeret (max)', val('b-budget') ? (val('b-budget')+' '+val('b-cur')) : ''], ['Ár rugalmassága', val('b-flex')],
      ['Mikorra kell', val('b-when')], ['Meddig keressünk', val('b-howlong')],
      ['Vásárlás módja (ÁFA)', radioVal('vat')],
      ['Fizetés', radioVal('pay')], ['Finanszírozás konstrukció', val('b-fin-type')], ['Futamidő (hó)', val('b-fin-term')],
      ['Önerő', val('b-fin-down')], ['Havi keret', val('b-fin-monthly')],
      ['Vásárló típusa', radioVal('who')]
    ];
    if(comp){
      rows.push(['Cégnév', val('b-cname')], ['Adószám', val('b-tax')], ['Kapcsolattartó', val('b-contact')], ['E-mail', val('b-cemail')], ['Telefon', val('b-cphone')], ['Székhely', val('b-caddr')]);
    } else {
      rows.push(['Név', val('b-name')], ['E-mail', val('b-email')], ['Telefon', val('b-phone')], ['Város', val('b-city')]);
    }
    var clean = rows.filter(function(r){ return r[1]; });
    var payload = {};
    clean.forEach(function(r){ payload[r[0]] = r[1]; });

    if(SEARCH_ENDPOINT){
      fetch(SEARCH_ENDPOINT, {method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body:JSON.stringify(payload)})
        .then(function(){ alert('Köszönjük! A keresésed megérkezett — hamarosan jelentkezünk személyre szabott ajánlattal.'); form.reset(); step=1; render(); })
        .catch(function(){ alert('Küldés sikertelen — kérjük írj a sales@caradvance.hu címre.'); });
      return;
    }
    var title = (val('b-make')+' '+val('b-model')).trim() || 'autókeresés';
    var subject = 'Autót keresek – ' + title;
    var body = 'Szeretnék autót vásárolni a CarAdvance-en keresztül. A keresési adataim:\n\n'
      + clean.map(function(r){ return r[0]+': '+r[1]; }).join('\n')
      + '\n\nKérlek, keressetek nekem a fentiek alapján, és küldjetek ajánlatot. Köszönöm!';
    window.location.href = 'mailto:sales@caradvance.hu?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
  });

  render();
})();
</script>
