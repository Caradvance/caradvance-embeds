  var fillModels = function(){
    var data = MODELS[makeSel.value];
    var has = !!data && (Array.isArray(data) ? data.length : Object.keys(data).length);
    modelSel.innerHTML = '';
    var ph = document.createElement('option');
    ph.value=''; ph.disabled=true; ph.selected=true;
    ph.textContent = has ? 'Válassz modellt…' : 'Nincs lista — írd a Típusjelbe';
    modelSel.appendChild(ph);
    var addOpt = function(parent,m){ var o=document.createElement('option'); o.textContent=m; parent.appendChild(o); };
    if(Array.isArray(data)){ data.forEach(function(m){ addOpt(modelSel,m); }); }
    else if(data){ Object.keys(data).forEach(function(grp){ var og=document.createElement('optgroup'); og.label=grp; data[grp].forEach(function(m){ addOpt(og,m); }); modelSel.appendChild(og); }); }
    var other=document.createElement('option'); other.textContent='Egyéb (nincs a listában)'; modelSel.appendChild(other);
    modelSel.disabled=false;
  };

