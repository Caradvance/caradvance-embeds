---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';

const { lang } = Astro.props as { lang: Locale };

const makes = ['Abarth','Alfa Romeo','Aston Martin','Audi','Bentley','BMW','BYD','Cadillac','Chevrolet','Chrysler','Citroën','Cupra','Dacia','Dodge','DS','Ferrari','Fiat','Ford','Honda','Hyundai','Infiniti','Isuzu','Jaguar','Jeep','Kia','Lada','Lamborghini','Lancia','Land Rover','Lexus','Maserati','Mazda','Mercedes-Benz','MG','Mini','Mitsubishi','Nissan','Opel','Peugeot','Porsche','Range Rover','Renault','Rover','Saab','SEAT','Škoda','Smart','SsangYong','Subaru','Suzuki','Tesla','Toyota','Volkswagen','Volvo','Egyéb'];
const years = Array.from({ length: 2026 - 2000 + 1 }, (_, i) => 2026 - i);
const fuels = ['Mindegy','Benzin','Dízel','Hibrid','Plug-in hibrid','Elektromos','LPG/Benzin'];
const gears = ['Mindegy','Automata','Manuális'];
const bodies = ['Mindegy','Ferdehátú','Sedan/Limuzin','Kombi','Coupé','Kabrió','SUV/Terepjáró','Egyterű','Pickup'];
const intColors = ['Mindegy','Fekete','Bézs','Barna','Szürke','Fehér','Piros','Kék'];
const terms = ['12','24','36','48','60','72','84','96'];

const faqJsonld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Autókeresés és beszerzés — Caradvance',
  serviceType: 'Személyre szabott autókeresés és import Németországból',
  areaServed: { '@type': 'Country', name: 'Magyarország' },
  url: 'https://www.caradvance.hu/autot-keresek/',
  provider: {
    '@type': 'AutoDealer',
    name: 'Caradvance Hungary (BH Group Zrt.)',
    telephone: '+36 30 233 6060',
    email: 'sales@caradvance.hu',
  },
};
---
<!-- WIZARD -->
<section class="section" id="rendeles" style="padding-top:8px">
  <div class="wrap center">
    <span class="eyebrow">Ingyenes &amp; kötelezettségmentes</span>
    <h2 class="sec-title">Keressük meg együtt a tökéletes autót</h2>
    <p class="sec-intro">Néhány lépésben elmondod, mit keresel és milyen feltételekkel — mi pedig személyre szabott ajánlattal keresünk rá a teljes piacon.</p>
  </div>
  <div class="wrap">
    <form class="sf kw" id="buyForm" novalidate>
      <!-- progress -->
      <div class="kw-head">
        <div class="kw-steps">
          <span class="kw-dot active" data-dot="1"><b>1</b><i>Az autó</i></span>
          <span class="kw-dot" data-dot="2"><b>2</b><i>Ár &amp; időzítés</i></span>
          <span class="kw-dot" data-dot="3"><b>3</b><i>Vásárlás módja</i></span>
          <span class="kw-dot" data-dot="4"><b>4</b><i>Finanszírozás</i></span>
          <span class="kw-dot" data-dot="5"><b>5</b><i>Kapcsolat</i></span>
        </div>
        <div class="kw-bar"><i id="kwBar" style="width:20%"></i></div>
      </div>

      <!-- STEP 1 -->
      <div class="kw-panel" data-step="1">
        <div class="sf-blocktitle">1. Az autó, amit keresel</div>
        <div class="sf-grid">
          <label class="sf-field"><span>Márka</span>
            <select id="b-make"><option value="" disabled selected>Válassz…</option>{makes.map((m) => <option>{m}</option>)}</select>
          </label>
          <label class="sf-field"><span>Modell</span>
            <select id="b-model" disabled><option value="" disabled selected>Előbb válassz márkát…</option></select>
          </label>
          <label class="sf-field"><span>Típusjel <small style="font-weight:600;color:var(--muted)">(opcionális)</small></span>
            <input id="b-type" type="text" placeholder="pl. G05, W205, 8V" />
          </label>
          <label class="sf-field"><span>Üzemanyag</span>
            <select id="b-fuel">{fuels.map((x) => <option>{x}</option>)}</select>
          </label>
        </div>
        <div class="sf-grid">
          <label class="sf-field"><span>Évjárat — tól</span>
            <select id="b-year-from"><option value="" selected>Mindegy</option>{years.map((y) => <option>{y}</option>)}</select>
          </label>
          <label class="sf-field"><span>Évjárat — ig</span>
            <select id="b-year-to"><option value="" selected>Mindegy</option>{years.map((y) => <option>{y}</option>)}</select>
          </label>
          <label class="sf-field"><span>Futásteljesítmény — tól (km)</span>
            <input id="b-km-from" type="number" min="0" step="1000" placeholder="pl. 0" />
          </label>
          <label class="sf-field"><span>Futásteljesítmény — ig (km)</span>
            <input id="b-km-to" type="number" min="0" step="1000" placeholder="pl. 60000" />
          </label>
        </div>
        <div class="sf-grid">
          <label class="sf-field"><span>Váltó</span>
            <select id="b-gear">{gears.map((x) => <option>{x}</option>)}</select>
          </label>
          <label class="sf-field"><span>Karosszéria</span>
            <select id="b-body">{bodies.map((x) => <option>{x}</option>)}</select>
          </label>
          <label class="sf-field"><span>Külső szín</span>
            <select id="b-color">
              <option value="" selected>Mindegy</option>
              <optgroup label="Fehér"><option>Fehér</option><option>Törtfehér</option></optgroup>
              <option>Fekete</option>
              <option>Ezüst</option>
              <optgroup label="Szürke"><option>Szürke</option><option>Világosszürke</option><option>Sötétszürke</option></optgroup>
              <optgroup label="Kék"><option>Kék</option><option>Világoskék</option><option>Sötétkék</option></optgroup>
              <option>Piros</option>
              <option>Bordó</option>
              <optgroup label="Zöld"><option>Zöld</option><option>Sötétzöld</option></optgroup>
              <option>Barna</option>
              <option>Bézs</option>
              <option>Arany</option>
            </select>
          </label>
          <label class="sf-field"><span>Belső (kárpit) szín</span>
            <select id="b-int">{intColors.map((x) => <option>{x}</option>)}</select>
          </label>
        </div>
        <label class="sf-field sf-full"><span>Mi még fontos? (felszereltség, extrák, kizárt dolgok)</span>
          <textarea id="b-notes" rows="3" placeholder="pl. vonóhorog, panoráma tető, ülésfűtés, head-up, csak sérülésmentes, magyar papírok…"></textarea>
        </label>

        <div class="kw-compare">
          <div class="kw-compare-t">Nézz körül hasonló autók között</div>
          <div class="kw-compare-links">
            <a id="cmp-mobile" class="kw-cmp" href="https://suchen.mobile.de/fahrzeuge/search.html?s=Car&vc=Car" target="_blank" rel="noopener"><img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" />Hasonló autók a mobile.de-n →</a>
            <a id="cmp-as24" class="kw-cmp" href="https://www.autoscout24.de/lst" target="_blank" rel="noopener"><img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" />Hasonló autók az AutoScout24-en →</a>
          </div>
          <p class="kw-note">A linkek a fenti adataid alapján frissülnek — kattints, és máris a szűrt találatokat látod. Ha megtetszik valami, csak illeszd be a linkjét a Megjegyzésbe.</p>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="kw-panel" data-step="2" hidden>
        <div class="sf-blocktitle">2. Ár és időzítés</div>
        <div class="sf-grid sf-3">
          <label class="sf-field"><span>Költségkeret — max</span>
            <input id="b-budget" type="text" inputmode="numeric" autocomplete="off" placeholder="pl. 15 000 000" />
          </label>
          <label class="sf-field"><span>Pénznem</span>
            <select id="b-cur"><option>Ft</option><option>€</option></select>
          </label>
          <label class="sf-field"><span>Ár rugalmassága</span>
            <select id="b-flex">
              <option value="" disabled selected>Válassz…</option>
              <option>Fix keret</option>
              <option>Kicsit rugalmas</option>
              <option>Rugalmas a megfelelő autóért</option>
            </select>
          </label>
        </div>
        <div class="sf-grid sf-2">
          <label class="sf-field"><span>Mikorra kell?</span>
            <select id="b-when">
              <option value="" disabled selected>Válassz…</option>
              <option>Nagyon sürgős (2 héten belül)</option>
              <option>Mielőbb</option>
              <option>1–2 hónapon belül</option>
              <option>Ráérek — a tökéletes autóra várok</option>
            </select>
          </label>
          <label class="sf-field"><span>Meddig keressünk neked?</span>
            <select id="b-howlong">
              <option value="" disabled selected>Válassz…</option>
              <option>2 hét</option>
              <option>1 hónap</option>
              <option>2–3 hónap</option>
              <option>Ameddig meg nem találjuk a tökéleteset</option>
            </select>
          </label>
        </div>
        <p class="kw-hint">Tipp: minél rugalmasabb a keret és az időzítés, annál jobb ár-érték arányú autót tudunk találni.</p>
      </div>

      <!-- STEP 3 -->
      <div class="kw-panel" data-step="3" hidden>
        <div class="sf-blocktitle">3. Hogyan vásárolnál? (ÁFA)</div>
        <div class="kw-opts">
          <label class="kw-opt"><input type="radio" name="vat" value="Magánszemély — 19% áfa (Caradvance GmbH, Németország)" checked /><span class="kw-opt-b"><b>Magánszemélyként — 19% áfa</b><small>A német Caradvance GmbH-tól. Kedvezőbb ár, ez a leggyakoribb választás.</small></span></label>
          <label class="kw-opt"><input type="radio" name="vat" value="Magánszemély — 27% áfa (BH Group Zrt., Magyarország)" /><span class="kw-opt-b"><b>Magánszemélyként — 27% áfa</b><small>A magyar BH Group Zrt.-től — pl. ha finanszírozáshoz/lízinghez magyar számla kell.</small></span></label>
          <label class="kw-opt"><input type="radio" name="vat" value="Cég — nettó, Németországból" /><span class="kw-opt-b"><b>Cégként — nettó, Németországból</b><small>Áfa-visszaigénylés lehetőségével, német számlával.</small></span></label>
          <label class="kw-opt"><input type="radio" name="vat" value="Cég — 27% áfás magyar számla" /><span class="kw-opt-b"><b>Cégként — 27% áfás magyar számla</b><small>Magyar céges számla — pl. lízing/finanszírozás miatt.</small></span></label>
        </div>
      </div>

      <!-- STEP 4 -->
      <div class="kw-panel" data-step="4" hidden>
        <div class="sf-blocktitle">4. Finanszírozás</div>
        <div class="kw-opts kw-opts-3">
          <label class="kw-opt"><input type="radio" name="pay" value="Készpénz / önerőből" checked /><span class="kw-opt-b"><b>Készpénz / önerőből</b><small>Nincs szükség finanszírozásra.</small></span></label>
          <label class="kw-opt"><input type="radio" name="pay" value="Finanszírozás (hitel)" /><span class="kw-opt-b"><b>Finanszírozás</b><small>Autóhitel részletre.</small></span></label>
          <label class="kw-opt"><input type="radio" name="pay" value="Lízing" /><span class="kw-opt-b"><b>Lízing</b><small>Nyílt vagy zárt végű lízing.</small></span></label>
        </div>
        <div id="finBox" hidden>
          <div class="sf-grid sf-2" style="margin-top:18px">
            <label class="sf-field"><span>Konstrukció</span>
              <select id="b-fin-type">
                <option value="" disabled selected>Válassz…</option>
                <option>Zárt végű lízing</option>
                <option>Nyílt végű lízing</option>
                <option>Autóhitel</option>
                <option>Még nem tudom — segítsetek</option>
              </select>
            </label>
            <label class="sf-field"><span>Futamidő (hónap)</span>
              <select id="b-fin-term"><option value="" disabled selected>Válassz…</option>{terms.map((x) => <option>{x}</option>)}</select>
            </label>
          </div>
          <div class="sf-grid sf-2">
            <label class="sf-field"><span>Önerő (kezdő befizetés)</span>
              <input id="b-fin-down" type="text" inputmode="numeric" autocomplete="off" placeholder="pl. 3 000 000 Ft vagy 20%" />
            </label>
            <label class="sf-field"><span>Havi törlesztő keret <small style="font-weight:600;color:var(--muted)">(opcionális)</small></span>
              <input id="b-fin-monthly" type="text" inputmode="numeric" autocomplete="off" placeholder="pl. 150 000 Ft/hó" />
            </label>
          </div>
        </div>
      </div>

      <!-- STEP 5 -->
      <div class="kw-panel" data-step="5" hidden>
        <div class="sf-blocktitle">5. Kapcsolat</div>
        <div class="kw-opts kw-opts-2">
          <label class="kw-opt"><input type="radio" name="who" value="Magánszemély" checked /><span class="kw-opt-b"><b>Magánszemély</b></span></label>
          <label class="kw-opt"><input type="radio" name="who" value="Cég" /><span class="kw-opt-b"><b>Cég</b></span></label>
        </div>

        <div id="privBox" class="sf-grid" style="margin-top:18px">
          <label class="sf-field"><span>Neved</span><input id="b-name" type="text" placeholder="Teljes név" /></label>
          <label class="sf-field"><span>E-mail</span><input id="b-email" type="email" placeholder="pelda@email.hu" /></label>
          <label class="sf-field"><span>Telefonszám</span><input id="b-phone" type="tel" placeholder="+36 …" /></label>
          <label class="sf-field"><span>Irányítószám / város <small style="font-weight:600;color:var(--muted)">(opc.)</small></span><input id="b-city" type="text" placeholder="pl. 2083 Solymár" /></label>
        </div>

        <div id="compBox" class="sf-grid" hidden style="margin-top:18px">
          <label class="sf-field"><span>Cégnév</span><input id="b-cname" type="text" placeholder="Kft. / Zrt. …" /></label>
          <label class="sf-field"><span>Adószám</span><input id="b-tax" type="text" placeholder="pl. 12345678-2-13" /></label>
          <label class="sf-field"><span>Kapcsolattartó</span><input id="b-contact" type="text" placeholder="Név" /></label>
          <label class="sf-field"><span>E-mail</span><input id="b-cemail" type="email" placeholder="ceg@pelda.hu" /></label>
          <label class="sf-field"><span>Telefonszám</span><input id="b-cphone" type="tel" placeholder="+36 …" /></label>
          <label class="sf-field"><span>Székhely / város <small style="font-weight:600;color:var(--muted)">(opc.)</small></span><input id="b-caddr" type="text" placeholder="Irányítószám, város" /></label>
        </div>

        <p class="kw-note" style="margin-top:16px">Az adatok elküldésével felveszed velünk a kapcsolatot — a keresés ingyenes és nem kötelez semmire.</p>
      </div>

      <!-- NAV -->
      <div class="kw-nav">
        <button type="button" class="btn btn-ghost" id="kwPrev" style="visibility:hidden">← Vissza</button>
        <span class="kw-count" id="kwCount">1 / 5</span>
        <button type="button" class="btn btn-primary" id="kwNext">Tovább →</button>
        <button type="submit" class="btn btn-primary" id="kwSubmit" hidden>Elküldöm a keresést →</button>
      </div>
    </form>
  </div>
</section>

<style>
  .kw{max-width:960px;margin:34px auto 0}
  .kw-head{margin-bottom:26px}
  .kw-steps{display:flex;gap:6px;margin-bottom:14px}
  .kw-dot{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
  .kw-dot b{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:#EEF1F6;color:#9aa4b2;transition:.2s}
  .kw-dot i{font-style:normal;font-size:11.5px;font-weight:700;color:#9aa4b2;letter-spacing:.01em}
  .kw-dot.active b{background:var(--red);color:#fff}
  .kw-dot.active i{color:var(--ink)}
  .kw-dot.done b{background:#1a1d23;color:#fff}
  .kw-dot.done i{color:var(--muted)}
  .kw-bar{height:6px;background:#EEF1F6;border-radius:999px;overflow:hidden}
  .kw-bar>i{display:block;height:100%;background:var(--red);border-radius:999px;transition:width .3s ease}
  .kw-panel{animation:kwfade .25s ease}
  @keyframes kwfade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .kw-opts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .kw-opts-3{grid-template-columns:repeat(3,1fr)}
  .kw-opts-2{grid-template-columns:1fr 1fr;max-width:420px}
  .kw-opt{position:relative;display:flex;align-items:flex-start;gap:12px;background:#F7F9FC;border:1.5px solid var(--line);border-radius:14px;padding:16px;cursor:pointer;transition:.15s}
  .kw-opt:hover{border-color:#c9d2e0}
  .kw-opt input{margin-top:3px;accent-color:var(--red);width:18px;height:18px;flex:0 0 auto}
  .kw-opt-b{display:flex;flex-direction:column;gap:3px}
  .kw-opt-b b{font-size:15px;color:var(--ink)}
  .kw-opt-b small{font-size:13px;color:var(--muted);line-height:1.45}
  .kw-opt:has(input:checked){border-color:var(--red);background:#fff;box-shadow:0 0 0 3px rgba(226,0,26,.08)}
  .kw-compare{margin-top:22px;background:#0B0B0D;border-radius:16px;padding:20px 22px;color:#fff}
  .kw-compare-t{font-weight:800;font-size:15px;margin-bottom:14px}
  .kw-compare-links{display:flex;gap:12px;flex-wrap:wrap}
  .kw-cmp{display:inline-flex;align-items:center;gap:10px;background:#fff;color:#141519;font-weight:700;font-size:14px;text-decoration:none;padding:11px 16px;border-radius:11px}
  .kw-cmp img{height:18px;width:auto;border-radius:3px}
  .kw-cmp:hover{filter:brightness(.96)}
  .kw-note{font-size:12.5px;color:#9aa7b8;line-height:1.5;margin:14px 0 0}
  .kw-hint{font-size:13px;color:var(--muted);background:#F7F9FC;border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-top:16px}
  .kw-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}
  .kw-count{font-size:13px;font-weight:700;color:var(--muted)}
  .btn-ghost{background:#fff;border:1.5px solid var(--line);color:var(--ink)}
  .btn-ghost:hover{border-color:#c9d2e0}
  .kw-nav .btn{padding:13px 22px}
  @media(max-width:640px){
    .kw-dot i{display:none}
    .kw-opts,.kw-opts-3,.kw-opts-2{grid-template-columns:1fr;max-width:none}
    .kw-cmp{width:100%;justify-content:center}
  }
</style>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonld)}></script>

<script is:inline>
(function(){
  var SEARCH_ENDPOINT = "";
  var form = document.getElementById('buyForm');
  if(!form) return;
  var TOTAL = 5, step = 1;
  var val = function(id){ var e=document.getElementById(id); return e? (e.value||'').trim() : ''; };
  var radioVal = function(name){ var r=form.querySelector('input[name="'+name+'"]:checked'); return r? r.value : ''; };

  var slug = function(s){ return (s||'').toLowerCase()
    .replace(/á/g,'a').replace(/é/g,'e').replace(/í/g,'i').replace(/ó/g,'o').replace(/ö/g,'o').replace(/ő/g,'o').replace(/ú/g,'u').replace(/ü/g,'u').replace(/ű/g,'u').replace(/ä/g,'a')
    .replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,''); };

  var MODELS = {
    'Audi': {'A sorozat':['A1','A2','A3','A3 Sportback','A4','A4 Allroad','A5','A5 Sportback','A6','A6 Allroad','A7','A8'],'Q sorozat':['Q2','Q3','Q3 Sportback','Q4 e-tron','Q5','Q5 Sportback','Q7','Q8'],'Sport / elektromos':['TT','TTS','TT RS','R8','e-tron','e-tron GT','Q8 e-tron'],'S / RS':['S1','S3','S4','S5','S6','S7','S8','SQ5','SQ7','SQ8','RS3','RS4','RS5','RS6','RS7','RS Q3','RS Q8']},
    'BMW': {'1-es / 2-es':['114','116','118','120','123','125','128','130','135','M135','214','216','218','220','225','228','230','235','240','M235','M240'],'3-as / 4-es':['316','318','320','323','325','328','330','335','340','M340','418','420','425','428','430','435','440','M440'],'5-ös / 6-os':['518','520','523','525','528','530','535','540','545','550','M550','620','628','630','635','640','645','650'],'7-es / 8-as':['725','728','730','735','740','745','750','760','840','850','M850'],'X (SUV)':['X1','X2','X3','X4','X5','X6','X7','XM'],'Z / i / M':['Z1','Z3','Z4','Z8','i3','i4','i5','i7','i8','iX','iX1','iX3','M2','M3','M4','M5','M8','X3 M','X4 M','X5 M','X6 M']},
