---
// Új autó bérlése — same look as Egyedi autó rendelés (egl-mhero hero + egl-card cards), rental data.
// Data source: "új autó bérlés" sheet (44 models). Do not add models not in this list.
const MODELS = [
  { b:'bmw', m:'BMW M2 Coupe', k:5000, p2:1450, p3:1600, img:'/bmw/m2.webp' },
  { b:'bmw', m:'BMW 3-as Limuzin', k:5000, p2:1400, p3:1500, img:'/bmw/3er.webp' },
  { b:'bmw', m:'BMW 3-as Touring', k:5000, p2:1400, p3:1500, img:'/bmw/3ert.webp' },
  { b:'bmw', m:'BMW M3 Limuzin', k:7500, p2:1950, p3:2150, img:'/bmw/m3.webp' },
  { b:'bmw', m:'BMW M3 Touring', k:7500, p2:1950, p3:2150, img:'/bmw/m3t.webp' },
  { b:'bmw', m:'BMW 4-es Coupé', k:5000, p2:1550, p3:1790, img:'/bmw/4erc.webp' },
  { b:'bmw', m:'BMW M4 Coupé', k:7500, p2:2000, p3:2150, img:'/bmw/m4b.webp' },
  { b:'bmw', m:'BMW 5-ös Limuzin', k:7500, p2:1600, p3:1900, img:'/bmw/5erb.webp' },
  { b:'bmw', m:'BMW 5-ös Touring', k:7500, p2:1600, p3:1900, img:'/bmw/5ertb.webp' },
  { b:'bmw', m:'BMW M5 Limuzin', k:10000, p2:2100, p3:2300, img:'/bmw/m5.webp' },
  { b:'bmw', m:'BMW M5 Touring', k:10000, p2:2100, p3:2300, img:'/bmw/m5t.webp' },
  { b:'bmw', m:'BMW X1', k:3000, p2:1180, p3:1380, img:'/bmw/x1b.webp' },
  { b:'bmw', m:'BMW X3', k:5000, p2:1550, p3:1660, img:'/bmw/x3mw.webp' },
  { b:'bmw', m:'BMW X5', k:7500, p2:1790, p3:2020, img:'/bmw/x5.webp' },
  { b:'bmw', m:'BMW X6', k:7500, p2:1840, p3:2120, img:'/bmw/x6b.webp' },

  { b:'mini', m:'MINI Cooper 3 ajtós', k:3000, p2:1050, p3:1250, img:'/cooper-s.webp' },
  { b:'mini', m:'MINI Cooper 5 ajtós', k:3000, p2:1050, p3:1250, img:'/cooper.webp' },
  { b:'mini', m:'MINI Cooper Cabrio', k:3000, p2:1050, p3:1250, img:'/cooper-cabrio.webp' },
  { b:'mini', m:'MINI Countryman', k:3000, p2:1050, p3:1250, img:'/countryman.webp' },
  { b:'mini', m:'MINI John Cooper Works', k:3000, p2:1100, p3:1350, img:'/jcw-hatch.webp' },

  { b:'mercedes', m:'Mercedes A-osztály', k:3000, p2:1030, p3:1220, img:'/mb-a.webp' },
  { b:'mercedes', m:'Mercedes B-osztály', k:3000, p2:1100, p3:1350, img:'/mb-b.webp' },
  { b:'mercedes', m:'Mercedes C-osztály Limuzin', k:5000, p2:1200, p3:1430, img:'/mb-c.webp' },
  { b:'mercedes', m:'Mercedes-AMG C-osztály Limuzin', k:7500, p2:1680, p3:2010, img:'/mb-amg-c.webp' },
  { b:'mercedes', m:'Mercedes C-osztály T-modell', k:5000, p2:1200, p3:1430, img:'/mb-ct.webp' },
  { b:'mercedes', m:'Mercedes-AMG C-osztály T-modell', k:7500, p2:1680, p3:2010, img:'/mb-amg-ct.webp' },
  { b:'mercedes', m:'Mercedes CLE Cabrio', k:5000, p2:1300, p3:1400, img:'/mb-cle-cabrio.webp' },
  { b:'mercedes', m:'Mercedes CLE Coupé', k:5000, p2:1300, p3:1550, img:'/mb-cle-coupe.webp' },
  { b:'mercedes', m:'Mercedes-AMG CLE Coupé', k:7500, p2:1720, p3:2040, img:'/mb-amg-cle-coupe.webp' },
  { b:'mercedes', m:'Mercedes E-osztály Limuzin', k:7500, p2:1450, p3:1760, img:'/mb-e.webp' },
  { b:'mercedes', m:'Mercedes-AMG E-osztály Limuzin', k:10000, p2:1900, p3:2300, img:'/mb-amg-e.webp' },
  { b:'mercedes', m:'Mercedes E-osztály T-modell', k:7500, p2:1450, p3:1760, img:'/mb-et.webp' },
  { b:'mercedes', m:'Mercedes-AMG E-osztály T-modell', k:10000, p2:2100, p3:2500, img:'/mb-amg-et.webp' },
  { b:'mercedes', m:'Mercedes GLA', k:5000, p2:1300, p3:1500, img:'/mb-gla.webp' },
  { b:'mercedes', m:'Mercedes GLB', k:5000, p2:1300, p3:1550, img:'/mb-glb.webp' },
  { b:'mercedes', m:'Mercedes GLC', k:5000, p2:1450, p3:1760, img:'/mb-glc.webp' },
  { b:'mercedes', m:'Mercedes GLC Coupé', k:5000, p2:1650, p3:1900, img:'/mb-glc-coupe.webp' },
  { b:'mercedes', m:'Mercedes GLE', k:7500, p2:1720, p3:2040, img:'/mb-gle.webp' },
  { b:'mercedes', m:'Mercedes GLE Coupé', k:7500, p2:1720, p3:2040, img:'/mb-gle-coupe.webp' },
  { b:'mercedes', m:'Mercedes S-osztály', k:10000, p2:2400, p3:2650, img:'/mb-s.webp' },

  { b:'audi', m:'Audi A3', k:3000, p2:1150, p3:1350, img:'/audi/a3lim.webp' },
  { b:'audi', m:'Audi Q5', k:5000, p2:1720, p3:2040, img:'/audi/q5.webp' },
  { b:'audi', m:'Audi A6', k:7500, p2:1720, p3:2040, img:'/audi/a6lim.webp' },
  { b:'audi', m:'Audi Q7', k:7500, p2:2100, p3:2500, img:'/audi/q7.webp' },
];

const BRANDS = [
  { id:'bmw',      name:'BMW',      logo:'/bmw/bmw-logo.webp?v=2' },
  { id:'mini',     name:'MINI',     logo:'/mini-hero-logo.webp?v=3' },
  { id:'mercedes', name:'Mercedes', logo:'/mb-star.webp?v=1' },
  { id:'audi',     name:'Audi',     logo:'/audi/audi-logo.webp?v=4' },
];

const g = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const brandCount = (id) => MODELS.filter((x) => x.b === id).length;
const chevron = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>';
---

<section id="uab" class="uab uab-choose">
  <!-- ===== LANDING ===== -->
  <div id="uabLand" class="uab-land">
    <div class="egl-mhero">
      <video class="egl-mhero-vid" autoplay loop muted playsinline preload="auto" poster="/caradvance-hero-poster-hd.jpg">
        <source src="/caradvance-hero-hd.mp4" type="video/mp4" />
      </video>
      <div class="egl-mhero-ov"></div>
      <div class="egl-mhero-inner">
        <div class="egl-mhero-logos">
          {BRANDS.map((b) => (<img src={b.logo} alt={b.name} loading="lazy" />))}
        </div>
        <div class="egl-mhero-h1">Új autó bérlése</div>
        <p class="egl-mhero-sub">Válaszd ki a márkát — bérelj vadonatúj prémium autót, átlátható havidíjjal, egyszeri kaucióval, 2000 vagy 3000 km/hó futáskerettel.</p>
        <div class="egl-mhero-cta">
          <a class="egl-mhero-btn red" href="#uabBrands" onclick="var b=document.querySelector('#uabLand .uab-brands');if(b){b.scrollIntoView({behavior:'smooth',block:'center'});}return false;">Válassz márkát</a>
          <a class="egl-mhero-btn white" href="/berles-elonyei">Előnyök</a>
        </div>
      </div>
      <button class="egl-mhero-scroll" type="button" onclick="window.scrollBy({top:Math.round(window.innerHeight*0.72),behavior:'smooth'})">Görgess<span class="uab-chev" set:html={chevron}></span></button>
    </div>

    <div id="uabBrands" class="uab-brands">
      {BRANDS.map((b) => (
        <a class="uab-brand-tile" href={`/uj-auto-berlese?brand=${b.id}`} aria-label={`${b.name} bérelhető modellek`}>
          <img src={b.logo} alt={b.name} loading="lazy" />
          <span class="uab-brand-name">{b.name}</span>
          <span class="uab-brand-cta">{brandCount(b.id)} modell →</span>
        </a>
      ))}
    </div>

    <div class="uab-seo">
      <span class="uab-eyebrow">Jó tudni</span>
      <h2 class="uab-seo-h">Új autó bérlése — prémium autóbérlés hosszú távra</h2>
      <p>Az <strong>új autó bérlése</strong> a legrugalmasabb módja annak, hogy mindig friss, prémium autóval járj — vásárlás és a hosszú távú elköteleződés nélkül. Válaszd ki a márkát: <span class="kw">BMW, Mercedes, MINI és Audi</span> modellek közül, majd nézd meg az adott modell egyszeri kaucióját és a havi bérleti díjat 2000, illetve 3000 km/hó futáskerettel.</p>
      <p>A havidíj minden esetben tartalmazza a gondtalan használatot: te csak vezetsz, a többit mi intézzük. A pontos feltételekről, a kaucióról és a szabad kilométerkeret túllépéséről minden esetben előre, átláthatóan egyeztetünk.</p>
      <p>Nem találod a listában a kívánt modellt vagy hosszabb futásidőre lenne szükséged? Vedd fel velünk a kapcsolatot, és egyedi ajánlatot adunk.</p>
    </div>

    <div class="uab-faq2">
      <span class="uab-eyebrow">GYIK</span>
      <h2 class="uab-seo-h">Gyakori kérdések</h2>
      <details><summary>Mit tartalmaz a havi bérleti díj?<span class="pl">+</span></summary><p>A feltüntetett havidíj a választott modell bérletét jelenti a megadott futáskerettel (2000 vagy 3000 km/hó). A pontos, teljes körű feltételeket — biztosítás, szerviz, kilométer-túllépés — minden esetben előre, írásban egyeztetjük.</p></details>
      <details><summary>Mennyi a kaució?<span class="pl">+</span></summary><p>A kaució (egyszeri, visszatérítendő letét) modellenként eltér, és a kártyán fel van tüntetve. A bérlet végén — káresemény és rendkívüli kopás hiányában — visszajár.</p></details>
      <details><summary>Melyik márkákat lehet bérelni?<span class="pl">+</span></summary><p>Jelenleg BMW, Mercedes, MINI és Audi új modelleket kínálunk bérlésre. Válaszd ki a márkát fent, és nézd meg az elérhető modelleket és díjakat.</p></details>
      <details><summary>Mi a különbség a 2000 és a 3000 km/hó között?<span class="pl">+</span></summary><p>A havi szabad futáskeretet jelenti. Ha többet vezetsz, válaszd a 3000 km/hó csomagot; a keret túllépését előre egyeztetett km-díjjal számoljuk el.</p></details>
      <details><summary>Hogyan tudok bérelni?<span class="pl">+</span></summary><p>Válaszd ki a modellt, majd kattints a „Bérlés igénylése” gombra vagy vedd fel velünk a kapcsolatot. Egyeztetjük az elérhetőséget, a feltételeket és az átadás időpontját.</p></details>
    </div>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context':'https://schema.org','@type':'FAQPage','mainEntity':[
        {'@type':'Question','name':'Mit tartalmaz a havi bérleti díj?','acceptedAnswer':{'@type':'Answer','text':'A feltüntetett havidíj a választott modell bérletét jelenti a megadott futáskerettel (2000 vagy 3000 km/hó). A pontos, teljes körű feltételeket minden esetben előre, írásban egyeztetjük.'}},
        {'@type':'Question','name':'Mennyi a kaució?','acceptedAnswer':{'@type':'Answer','text':'A kaució modellenként eltér, és a kártyán fel van tüntetve. A bérlet végén — káresemény és rendkívüli kopás hiányában — visszajár.'}},
        {'@type':'Question','name':'Melyik márkákat lehet bérelni?','acceptedAnswer':{'@type':'Answer','text':'Jelenleg BMW, Mercedes, MINI és Audi új modelleket kínálunk bérlésre.'}},
        {'@type':'Question','name':'Mi a különbség a 2000 és a 3000 km/hó között?','acceptedAnswer':{'@type':'Answer','text':'A havi szabad futáskeretet jelenti. A keret túllépését előre egyeztetett km-díjjal számoljuk el.'}},
        {'@type':'Question','name':'Hogyan tudok bérelni?','acceptedAnswer':{'@type':'Answer','text':'Válaszd ki a modellt, majd kattints a Bérlés igénylése gombra vagy vedd fel velünk a kapcsolatot.'}}
      ]
    })} />
  </div>

  <!-- ===== PER-BRAND VIEWS ===== -->
  {BRANDS.map((br) => (
    <div class="uab-brandview" data-brand={br.id}>
      <div class="egl-mhero uab-bmhero">
        <div class="egl-mhero-ov"></div>
        <div class="egl-mhero-inner">
          <a class="uab-back" href="/uj-auto-berlese">← Összes márka</a>
          <div class="egl-mhero-logos"><img src={br.logo} alt={br.name} loading="lazy" /></div>
          <div class="egl-mhero-h1">{br.name} bérlés</div>
          <p class="egl-mhero-sub">Válaszd ki a modellt — kaució és havi bérleti díj 2000, illetve 3000 km/hó futáskerettel.</p>
        </div>
      </div>
      <div class="egl-grid">
        {MODELS.filter((x) => x.b === br.id).map((car) => (
          <article class="egl-card egl-card-mini">
            <div class="egl-media">
              <img src={car.img} alt={car.m} loading="lazy" />
              <div class="egl-fuels"><span class="egl-fuel uab-badge">Bérelhető</span></div>
            </div>
            <div class="egl-body">
              <div class="egl-meta">
                <span class="egl-brand"><img class="uab-cardlogo" src={br.logo} alt={br.name} /></span>
                <span class="egl-year">Új autó · Bérlés</span>
              </div>
              <div class="egl-name">{car.m}</div>
              <div class="egl-specs">Kaució: {g(car.k)} € · 3000 km/hó: {g(car.p3)} €</div>
              <div class="egl-price"><b>{g(car.p2)} €</b><span class="eur">/ hó</span><span class="tol">2000 km-től</span></div>
            </div>
            <div class="egl-actions">
              <a class="egl-order" href={`/kapcsolat/?berles=${encodeURIComponent(car.m)}`}>Bérlés igénylése</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}
</section>

<style is:global>
.uab{--red:#E2001A;--red-dark:#b80016;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1;--navy:#0F1B2D;max-width:1160px;margin:0 auto;padding:0 20px 26px}

/* ===== HERO (copied from Egyedi egl-mhero) ===== */
.uab .egl-mhero{position:relative;overflow:hidden;color:#fff;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:540px;padding:20px 24px 72px;border-radius:32px;width:calc(100vw - 32px);margin:calc(6px - var(--navh,80px) - 34px) 0 30px calc(50% - 50vw + 16px);background:linear-gradient(#17181c,#0b0b0d 62%,#060607)}
.uab .egl-mhero-vid{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover}
.uab .egl-mhero-ov{position:absolute;inset:0;z-index:1;background:radial-gradient(1100px 460px at 50% -10%,rgba(226,0,26,.18),transparent 60%),linear-gradient(rgba(8,8,10,.42),rgba(8,8,10,.48) 45%,rgba(8,8,10,.7))}
.uab .egl-mhero-inner{position:relative;z-index:2;max-width:1120px;margin:64px auto 0}
.uab .egl-mhero-logos{display:inline-flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;margin:0 0 22px}
.uab .egl-mhero-logos img{height:78px;width:auto;object-fit:contain;filter:drop-shadow(0 6px 18px rgba(0,0,0,.5))}
.uab .egl-mhero-h1{font-size:clamp(32px,5vw,56px);line-height:1.08;font-weight:800;letter-spacing:-.025em;margin:0 0 16px;text-shadow:0 2px 24px rgba(0,0,0,.35)}
.uab .egl-mhero-sub{font-size:clamp(16px,1.7vw,19px);line-height:1.5;color:#e7eaf0;max-width:600px;margin:0 auto 32px;text-shadow:0 1px 12px rgba(0,0,0,.4)}
.uab .egl-mhero-cta{display:flex;gap:18px;justify-content:center;flex-wrap:wrap}
.uab .egl-mhero-btn{display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;padding:15px 32px;border-radius:999px;text-decoration:none;transition:.15s;box-shadow:0 8px 22px rgba(0,0,0,.22)}
.uab .egl-mhero-btn.red{background:#E2001A;color:#fff}
.uab .egl-mhero-btn.red:hover{background:#c40017}
.uab .egl-mhero-btn.white{background:#fff;color:#0F1B2D}
.uab .egl-mhero-btn.white:hover{background:#eef0f4}
.uab .egl-mhero-scroll{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:4px;color:rgba(255,255,255,.82);background:none;border:0;cursor:pointer;letter-spacing:.05em;font-size:11px;text-transform:uppercase;font-family:inherit;animation:caScrollBob 1.9s ease-in-out infinite}
.uab .egl-mhero-scroll:hover{color:#fff}
.uab .uab-chev svg{width:26px;height:26px;display:block}
@keyframes caScrollBob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(6px)}}
/* compact brand-view hero */
.uab .uab-bmhero{min-height:360px;padding:20px 24px 40px}
.uab .uab-bmhero .egl-mhero-inner{margin:40px auto 0}
.uab .uab-bmhero .egl-mhero-logos img{height:64px}
.uab-back{position:absolute;left:calc(50% - 50vw + 34px);top:16px;z-index:4;color:rgba(255,255,255,.85);text-decoration:none;font-weight:700;font-size:14px}
.uab-back:hover{color:#fff}

/* brand tiles */
.uab-brands{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:6px 0 8px}
.uab-brand-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px 16px;text-decoration:none;color:var(--ink);box-shadow:0 10px 30px rgba(8,8,10,.06);transition:.16s;min-height:150px}
.uab-brand-tile:hover{transform:translateY(-3px);border-color:#c9d2df;box-shadow:0 18px 44px rgba(8,8,10,.12)}
.uab-brand-tile img{height:46px;width:auto;max-width:120px;object-fit:contain}
.uab-brand-name{font-weight:800;font-size:17px}
.uab-brand-cta{font-weight:800;font-size:13px;color:var(--red)}

/* ===== CARDS (copied from Egyedi egl-card) ===== */
.uab .egl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.uab .egl-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:visible;position:relative;display:flex;flex-direction:column;transition:.18s;text-decoration:none;color:inherit}
.uab .egl-card:hover{box-shadow:0 14px 34px rgba(15,27,45,.1);transform:translateY(-3px);z-index:30}
.uab .egl-media{position:relative;background:#fff;aspect-ratio:49/26;display:flex;align-items:flex-end;justify-content:center;padding:6px 4px 0;border-radius:20px 20px 0 0;overflow:hidden}
.uab .egl-media img{max-width:82%;max-height:90%;width:auto;height:auto;object-fit:contain;margin:0 auto;display:block}
.uab .egl-fuels{position:absolute;top:14px;right:14px;display:flex;gap:6px}
.uab .egl-fuel{color:#fff;font-size:12px;font-weight:700;padding:5px 12px;border-radius:100px;box-shadow:0 2px 6px rgba(0,0,0,.12)}
.uab .uab-badge{background:#0F8A3C}
.uab .egl-body{padding:16px 20px 12px}
.uab .egl-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.uab .egl-brand{display:inline-flex;align-items:center}
.uab .uab-cardlogo{height:22px;width:auto;max-width:70px;object-fit:contain}
.uab .egl-year{font-size:13.5px;color:var(--muted)}
.uab .egl-name{font-size:23px;font-weight:800;color:var(--navy);margin:0 0 8px;line-height:1.2}
.uab .egl-specs{font-size:14px;color:var(--muted);margin:0 0 14px}
.uab .egl-price{display:flex;align-items:baseline;gap:8px;margin-bottom:14px;flex-wrap:nowrap;white-space:nowrap}
.uab .egl-price b{font-size:23px;font-weight:800;color:var(--ink)}
.uab .egl-price .eur{font-size:14px;font-weight:700;color:var(--muted)}
.uab .egl-price .tol{font-size:13px;color:var(--muted);font-weight:600}
.uab .egl-actions{padding:0 20px 20px;display:flex;flex-direction:column;gap:8px}
.uab .egl-order{display:block;width:100%;text-align:center;background:#eef2f8;color:var(--navy);font-weight:700;font-size:15px;padding:14px;border:0;border-radius:12px;cursor:pointer;font-family:inherit;transition:.15s;text-decoration:none}
.uab .egl-card:hover .egl-order,.uab .egl-order:hover{background:var(--red);color:#fff}

/* SEO + FAQ */
.uab-seo{max-width:900px;margin:34px auto 0}
.uab-eyebrow{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:8px}
.uab-seo-h{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:6px 0 14px}
.uab-seo p{color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 14px}
.uab-seo strong{color:var(--ink)}
.uab-seo .kw{color:var(--red);font-weight:700}
.uab-faq2{max-width:900px;margin:30px auto 0;display:flex;flex-direction:column;gap:10px}
.uab-faq2 details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.uab-faq2 summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:15px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.uab-faq2 summary::-webkit-details-marker{display:none}
.uab-faq2 .pl{flex:0 0 auto;width:26px;height:26px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:700}
.uab-faq2 details[open] .pl{transform:rotate(45deg)}
.uab-faq2 p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 15px}

/* toggle */
.uab-brandview{display:none}
.uab.uab-choose .uab-brandview{display:none}
.uab.uab-choose #uabLand{display:block}
.uab:not(.uab-choose) #uabLand{display:none}
.uab:not(.uab-choose) .uab-brandview.is-active{display:block}

@media(max-width:900px){.uab .egl-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:820px){.uab-brands{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.uab .egl-grid{grid-template-columns:1fr}}
</style>

<script is:inline>
(function () {
  function apply() {
    var sec = document.getElementById('uab');
    if (!sec) return;
    var brand = new URLSearchParams(location.search).get('brand');
    var views = sec.querySelectorAll('.uab-brandview');
    views.forEach(function (v) { v.classList.remove('is-active'); });
    if (!brand) {
      sec.classList.add('uab-choose');
    } else {
      sec.classList.remove('uab-choose');
      var active = sec.querySelector('.uab-brandview[data-brand="' + brand + '"]');
      if (active) { active.classList.add('is-active'); }
      else { sec.classList.add('uab-choose'); }
    }
  }
  apply();
  window.addEventListener('popstate', apply);
})();
</script>
