---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const IMG = 'https://www.caradvance.hu/';
const benefits = [
{ t: '14× nagyobb választék', img: IMG + 'hatalmas-valasztek-vs.webp',
d: 'Minek beérni a maradékkal? A német mobile.de-n most 1 521 554 autó közül válogathatsz — több mint tizennégyszer annyi, mint a magyar használtautó.hu 105 254 hirdetése. Nálunk a teljes német kínálat a tiéd: pontosan azt a márkát, felszereltséget, színt és árat találjuk meg, amit megálmodtál — nem csak azt, ami épp itthon elérhető.' },
{ t: 'Jobb állapotú autók', img: IMG + 'piros-bmw-x6-m-premium-autoberles.webp',
d: 'A német autók jellemzően kevésbé koptatottak és gondozottabbak, mint az azonos korú hazai darabok. Rendszeres gondoskodás, minőségi üzemanyag és alkatrészek — az eredmény egy megbízhatóbb, hosszabb élettartamú autó, ugyanazért a pénzért.' },
{ t: 'Kiváló úthálózat', img: IMG + 'toyota-rav4-hybrid-hasznaltauto-eladas.webp',
d: 'A német utak minősége világszínvonalú, ami kíméli a futóművet, a gumikat és a karosszériát. Kevesebb kátyú és só, kevesebb rejtett kopás és rozsda — a behozott autók műszaki állapota ezért gyakran jobb, mint amit a kilométeróra sugallna.' },
{ t: 'Rendszeres karbantartás', img: IMG + 'bmw-m3-touring-premium-auto-eladas.webp',
d: 'Németországban erős a szervizkultúra: a tulajdonosok fegyelmezetten viszik átvizsgálásra és karbantartásra az autót, a márkaszervizek dokumentálnak minden beavatkozást. Ez átlátható, jól nyomon követhető műszaki előéletet jelent.' },
{ t: 'Alacsonyabb, valós futás', img: IMG + 'caradvance-hero-x5-poster.jpg',
d: 'Sok német autó kevesebbet és kíméletesebben futott a hazai átlagnál, a kilométeróra pedig ellenőrzött és hiteles. A kor mögött gyakran sokkal jobb valós állapot rejlik — mi pedig nemzetközi adatbázisból igazoljuk a tényleges futásteljesítményt.' },
{ t: 'Dokumentált, tiszta múlt', img: IMG + 'autoszallitas-autoimport-nemetorszagbol.webp',
d: 'Vezetett szervizkönyv, hiánytalan papírok és átlátható előélet — pontosan tudod, mit veszel, meglepetések nélkül. Minden általunk behozott autót leinformálunk és a helyszínen bevizsgálunk, mielőtt döntenél.' },
];

const faqs = [
['Miért érdemes Németországból autót hozni?', 'A német piac sokszorosa a hazainak, az autók jellemzően gondozottabbak, dokumentált előélettel — és magánszemélyként gyakran a 27% helyett csak 19% áfával vásárolhatsz a német Caradvance GmbH-tól. Nagyobb választék, jobb állapot, kedvezőbb ár.'],
['Tényleg jobb állapotúak a német autók?', 'Jellemzően igen: erősebb szervizkultúra, minőségi utak és fegyelmezett karbantartás áll mögöttük. Ettől függetlenül minden autót leinformálunk és a helyszínen bevizsgálunk — a valós állapotra és a hiteles futásra garanciát is vállalunk.'],
['Mennyivel nagyobb a választék?', 'A német online piactereken (mobile.de, AutoScout24) egyszerre több százezer autó érhető el — a hazai kínálat töredéke ennek. Így nemcsak több autóból választhatsz, hanem pontosan a te igényeidnek megfelelő darabot is nagyobb eséllyel találjuk meg.'],
['Nem lesz így drágább az autó?', 'Épp ellenkezőleg: a nagyobb kínálat lenyomja az árakat, a 19%-os német áfa pedig magánszemélyként jelentős megtakarítást jelent. Még a behozatal és a teljes ügyintézés díjával együtt is gyakran kedvezőbben jársz, mint a hazai piacon.'],
['Ti intézitek a behozatalt is?', 'Igen, kulcsrakészen: leinformálás, helyszíni bevizsgálás, szállítás, honosítás, műszaki vizsga és a teljes papírmunka — mindent mi vállalunk. Neked csak át kell venned a nevedre írt, forgalomba helyezett autót.'],
];
const faqJson = {
'@context': 'https://schema.org', '@type': 'FAQPage',
mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const serviceJson = {
'@context': 'https://schema.org', '@type': 'Service',
name: 'Autóimport Németországból — Caradvance',
serviceType: 'Prémium használt autók behozatala Németországból, kulcsrakészen',
areaServed: { '@type': 'Country', name: 'Magyarország' },
url: 'https://www.caradvance.hu/elonyok/',
provider: { '@type': 'AutoDealer', name: 'Caradvance Hungary (BH Group Zrt.)', telephone: '+36 30 233 6060', email: 'import@caradvance.de' },
};
---
<section class="el">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<div class="partners" style="display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap">
<img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" style="height:34px;width:auto;display:block;border-radius:6px" />
<img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" style="height:34px;width:auto;display:block;border-radius:6px" />
</div>
<h1>Miért a német piac? —<br /><span class="accent">az import előnyei</span></h1>
<p class="sub sub-wide" style="max-width:900px">Nagyobb választék, jobb állapotú autók és kedvezőbb ár — mutatjuk, miért éri meg Németországból hozni a következő autódat, és miért nyugodt szívvel bízhatod ránk a teljes&nbsp;folyamatot.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/auto-rendeles#rendeles">Autót rendelek</a>
<a class="btn btn-white" href="/beszerzesi-folyamat">Beszerzési folyamat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px">
<div class="wrap center">
<span class="eyebrow">Miért a német piac?</span>
<h2 class="sec-title">Nagyobb választék, jobb állapotú autók</h2>
<p class="sec-intro">A német piacon nemcsak több autó közül választhatsz, hanem jellemzően jobb állapotúak is — gondosabb karbantartás, kevesebb futott kilométer és kiváló utak állnak mögöttük.</p>
</div>
<div class="wrap el-wrap">
{benefits.map((b, i) => (
<div class={`zz${i % 2 ? ' flip' : ''}`}>
<div class="zz-media"><img src={b.img} alt={b.t} loading="lazy" onerror="this.closest('.zz-media').classList.add('noimg')" /></div>
<div class="zz-text">
<span class="zz-num">{String(i + 1).padStart(2, '0')}</span>
<h3>{b.t}</h3>
<p>{b.d}</p>
</div>
</div>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Készen állsz? Hozzuk haza álmaid autóját.</h2>
<p>Mondd el, mit keresel — a többit mi intézzük, kulcsrakészen.</p>
</div>
<a class="btn btn-white" href="/auto-rendeles#rendeles">Autót rendelek →</a>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap el-seo">
<span class="eyebrow">Jó tudni</span>
<h2 class="el-seo-h">Német használtautó vásárlás — miért éri meg?</h2>
<p>A <strong>német használtautó</strong> a magyar vásárlók egyik legkeresettebb választása, és nem véletlenül: a <span class="kw">legjobb német használtautó oldalakon</span> (mobile.de, AutoScout24) egyszerre több százezer autó érhető el — a hazai kínálat sokszorosa.</p>
<p>Egy <strong>német használtautó oldal magyarul</strong> önmagában keveset ér, ha a leinformálás, a bevizsgálás és a behozatal már rád marad. Mi a <span class="kw">német használtautó keresőktől</span> a kulcsrakész átadásig mindent elintézünk: a teljes piacot átnézzük helyetted, a helyszínen bevizsgáljuk az autót, és hitelesített, nemzetközi adatbázisból ellenőrizzük az előéletét.</p>
<p>Az eredmény jobb állapotú, dokumentált múltú autó, gyakran kedvezőbb áron — magánszemélyként akár 19%-os német áfával a müncheni Caradvance GmbH-tól.</p>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések</h2>
</div>
<div class="wrap el-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
<script type="application/ld+json" set:html={JSON.stringify(serviceJson)}></script>
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.el-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.zz{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0}
.zz:first-child{align-items:start}
.zz + .zz{border-top:1px solid var(--line)}
.zz.flip .zz-media{order:2}
.zz-media{border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(8,8,10,.12);background:linear-gradient(135deg,#1a1d23,#3a3f4a);aspect-ratio:16/10}
.zz-media img{width:100%;height:100%;object-fit:cover;display:block}
.zz-media.noimg{position:relative}
.zz-media.noimg::after{content:"CarAdvance";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;letter-spacing:.08em;opacity:.5}
.zz-num{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:0 12px;border-radius:12px;background:var(--red);color:#fff;font-weight:800;font-size:18px;letter-spacing:-.02em}
.zz-text h3{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:16px 0 12px;color:var(--ink)}
.zz-text p{color:var(--muted);font-size:16px;line-height:1.65;margin:0}
@media(max-width:820px){
.zz{grid-template-columns:1fr;gap:20px;padding:26px 0}
.zz.flip .zz-media{order:0}
}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
.el-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px;padding-bottom:20px}
.el-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.el-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.el-faq summary::-webkit-details-marker{display:none}
.el-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.el-faq details[open] .pl{transform:rotate(45deg)}
.el-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.el-seo{max-width:820px;margin:0 auto}
.el-seo-h{font-size:clamp(24px,3.4vw,34px);font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:10px 0 18px}
.el-seo p{color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 16px}
.el-seo strong{color:var(--ink);font-weight:700}
.el-seo .kw{color:var(--red);font-weight:700}
</style>
