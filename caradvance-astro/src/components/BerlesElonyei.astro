---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const IMG = 'https://www.caradvance.hu/';
const benefits = [
{ t: 'Kiváló bérleti díj — kedvező kaució', img: IMG + 'piros-bmw-x6-m-premium-autoberles.webp',
d: 'Az egyik legjobb ajánlat a piacon a bérleti díj és a kaució arányát tekintve. Nálunk nem kell az autó értékének 20%-át kaucióként letenned — sokkal kedvezőbb feltételekkel ülhetsz a volán mögé.' },
{ t: 'Német új vagy alig használt autók', img: IMG + 'berles-02-hero.webp', tall: true,
d: 'Kizárólag német, új vagy alig használt, kifogástalan állapotú prémium autókat kínálunk bérlésre. Gondozott, megbízható darabok — pontosan olyan, amilyet szeretnél.' },
{ t: 'Félévente új autó, a te választásod', img: IMG + 'bmw-m3-touring-premium-auto-eladas.webp',
d: 'Nem köt egyetlen modell sem: akár félévente új, általad választott autóba ülhetsz. Mindig friss modellek, mindig a saját ízlésed szerint — anélkül, hogy egy autóhoz lennél kötve.' },
{ t: 'Költséghatékony és elszámolható', img: IMG + 'toyota-rav4-hybrid-hasznaltauto-eladas.webp',
d: 'A bérleti díj a könyvelésben elszámolható költség — cégként jelentős pénzügyi előny. Nincs lekötött tőke az autóban, így a pénzed máshol dolgozhat helyetted.' },
{ t: 'Nincs továbbértékesítési gond', img: IMG + 'caradvance-hero-x5-poster.jpg',
d: 'A bérlet végén nem kell vevőt keresned és nem kell az értékesítéssel bajlódnod — egyszerűen visszaadod az autót. Semmi macera, és semmi kockázat a maradványértékkel.' },
{ t: 'Nincs szervizköltség és adó — a gumikat is mi adjuk', img: IMG + 'bmw-m3-touring-premium-auto-eladas.webp',
d: 'A szervizköltséget és az adókat mi álljuk, ráadásul a nyári és téli gumiszettet is tőlünk kapod. Neked csak vezetned kell — a többit intézzük.' },
];
---
<section class="el">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>A bérlés előnyei —<br /><span class="accent">prémium autó, gondtalanul</span></h1>
<p class="sub sub-wide" style="max-width:900px">Prémium német autók kedvező bérleti feltételekkel és alacsony kaucióval — akár félévente új modell, szervizköltség és adók nélkül. Mutatjuk, miért éri meg nálunk bérelni a következő autódat.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/berelheto">Bérelhető autóink</a>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px">
<div class="wrap center">
<span class="eyebrow">A bérlés előnyei</span>
<h2 class="sec-title">Miért érdemes tőlünk bérelni?</h2>
<p class="sec-intro">Alacsony kauciótól a gondtalan üzemeltetésig — hat ok, amiért a prémium autóbérlés nálunk a legjobb választás.</p>
</div>
<div class="wrap el-wrap">
{benefits.map((b, i) => (
<div class={`zz${i % 2 ? ' flip' : ''}${b.tall ? ' zz-tall' : ''}`}>
<div class="zz-media"><img src={b.img} alt={b.t} loading="lazy" onerror="this.closest('.zz-media').classList.add('noimg')" /></div>
<div class="zz-text">
<span class="zz-num">{String(i + 1).padStart(2, '0')}</span>
<h3>{b.t}</h3>
<p>{b.d}</p>
</div>
</div>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Készen állsz? Válaszd ki a következő autód.</h2>
<p>Nézd meg a bérelhető modelljeinket, vagy mondd el, mit keresel — a többit mi intézzük.</p>
</div>
<a class="btn btn-white" href="/berelheto">Bérelhető autóink →</a>
</div>
</div>
</section>
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.el-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.zz{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0}
.zz + .zz{border-top:1px solid var(--line)}
.zz.flip .zz-media{order:2}
.zz.zz-tall{align-items:stretch}
.zz.zz-tall .zz-text{display:flex;flex-direction:column;align-items:flex-start}
.zz.zz-tall .zz-text .zz-num{align-self:flex-start;margin-top:0}
.zz.zz-tall .zz-text p{margin-top:auto}
@media(max-width:820px){.zz.zz-tall .zz-text p{margin-top:12px}}
.zz-media{border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(8,8,10,.12);background:linear-gradient(135deg,#1a1d23,#3a3f4a);aspect-ratio:16/10}
.zz-media img{width:100%;height:100%;object-fit:cover;display:block}
.zz-media.noimg{position:relative}
.zz-media.noimg::after{content:"CarAdvance";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;letter-spacing:.08em;opacity:.5}
.zz-num{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:0 12px;border-radius:12px;background:var(--red);color:#fff;font-weight:800;font-size:18px;letter-spacing:-.02em}
.zz-text h3{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:16px 0 12px;color:var(--ink)}
.zz-text p{color:var(--muted);font-size:16px;line-height:1.65;margin:0}
@media(max-width:820px){
.zz{grid-template-columns:1fr;gap:20px;padding:26px 0}
.zz.flip .zz-media{order:0}
}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
</style>
