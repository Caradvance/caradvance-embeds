---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const IMG = 'https://www.caradvance.hu/';
const benefits = [
{ t: 'Kiváló bérleti díj — kedvező kaució', img: IMG + 'berles-01-kaucio.webp',
d: 'Az egyik legjobb ajánlat a piacon a bérleti díj és a kaució arányát tekintve. Nálunk nem kell az autó értékének akár 20%-át kaucióként letenned — sokkal kevesebb lekötött pénzzel, kedvezőbb feltételekkel ülhetsz a volán mögé. Így a tőkéd nagy része szabadon marad, és ott dolgozhat, ahol a legtöbbet hozza.' },
{ t: 'Német új vagy alig használt autók', img: IMG + 'berles-02-premium.webp',
d: 'Kizárólag német, új vagy alig használt, kifogástalan állapotú prémium autókat kínálunk bérlésre — Mercedes, BMW, Audi és társaik. Gondozott, megbízható, dokumentált előéletű darabok, nem idősebb, kopottabb kompromisszum. Pontosan olyan autóba ülhetsz, amilyet szeretnél, anélkül hogy a minőségből vagy a megbízhatóságból engedned kellene.' },
{ t: 'Félévente új autó, a te választásod', img: IMG + 'berles-03-valasztas.webp',
d: 'Nem köt egyetlen modell sem: akár félévente új, általad választott autóba ülhetsz. Mindig friss modellek, mindig a saját ízlésed és aktuális igényed szerint — ma egy elegáns limuzin, holnap egy tágas SUV. Teljes rugalmasság, semmi kötöttség, szemben azzal, ha évekre egyetlen autóhoz lennél láncolva.' },
{ t: 'Költséghatékony és elszámolható', img: IMG + 'berles-04-elszamolhato.webp',
d: 'A bérleti díj a könyvelésben teljes egészében elszámolható költség — cégként jelentős pénzügyi és adózási előny. Nincs lekötött tőke az autóban, nem áll a pénzed feleslegesen egyetlen eszközben: a szabad tőkéd máshol, a vállalkozásodban dolgozhat helyetted, miközben végig prémium autóval jársz.' },
{ t: 'Nincs továbbértékesítési gond', img: IMG + 'berles-05-visszaadod.webp',
d: 'A bérlet végén nem kell vevőt keresned, hirdetést feladnod, alkudoznod vagy az értékesítéssel bajlódnod — egyszerűen visszaadod az autót, és kész. Semmi macera, és semmi maradványérték-kockázat: nem téged terhel, ha közben esik a használt autók ára. Nyugodtan tervezhetsz, kiszámítható költségekkel.' },
{ t: 'Nincs szervizköltség és adó — a gumikat is mi adjuk', img: IMG + 'berles-06-koltsegek.webp',
d: 'A szervizköltséget és az adókat mi álljuk, ráadásul a nyári és téli gumiszettet is tőlünk kapod — minden benne van. Nálad nincsenek váratlan számlák, nem kell külön költségekkel bajlódnod. Neked gyakorlatilag csak vezetned kell, a többit intézzük — gondtalan, kiszámítható üzemeltetés.' },
];

const faqs = [
['Mennyi kauciót kell fizetni a bérléshez?', 'Nálunk a piaci átlagnál lényegesen kedvezőbb a kaució: nem kell az autó értékének akár 20%-át letenned. Így sokkal kevesebb lekötött pénzzel, kedvezőbb feltételekkel veheted át a prémium autót — a tőkéd nagy része szabadon marad.'],
['Mit tartalmaz a bérleti díj?', 'A bérleti díjban minden benne van, ami a gondtalan használathoz kell: a szervizköltséget és az adókat mi álljuk, és a nyári-téli gumiszettet is tőlünk kapod. Nincsenek váratlan számlák — neked gyakorlatilag csak vezetned kell.'],
['Cégként elszámolható a bérleti díj?', 'Igen. A bérleti díj a könyvelésben elszámolható költség, ami cégként jelentős pénzügyi és adózási előny. Nincs lekötött tőke az autóban, így a szabad tőkéd a vállalkozásodban dolgozhat, miközben végig prémium autóval jársz.'],
['Milyen autókat lehet bérelni, és válthatok modellt?', 'Kizárólag német, új vagy alig használt, kifogástalan állapotú prémium autókat kínálunk — Mercedes, BMW, Audi és társaik. Nem köt egyetlen modell sem: akár félévente új, általad választott autóba ülhetsz, mindig a saját igényed szerint.'],
['Mi történik a bérlet végén?', 'Semmi macera: a bérlet végén egyszerűen visszaadod az autót. Nem kell vevőt keresned, hirdetned vagy alkudoznod, és nem terhel a maradványérték-kockázat sem — nem téged érint, ha közben esik a használt autók ára.'],
];
const faqJson = {
'@context': 'https://schema.org', '@type': 'FAQPage',
mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const serviceJson = {
'@context': 'https://schema.org', '@type': 'Service',
name: 'Prémium autóbérlés — Caradvance',
serviceType: 'Prémium német autók bérlése kedvező kaucióval, all-inclusive feltételekkel',
areaServed: { '@type': 'Country', name: 'Magyarország' },
url: 'https://www.caradvance.hu/berles-elonyei/',
provider: { '@type': 'AutoRental', name: 'Caradvance Hungary (BH Group Zrt.)', telephone: '+36 30 233 6060', email: 'import@caradvance.de' },
};
---
<section class="el">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>A bérlés előnyei —<br /><span class="accent">prémium autó, gondtalanul</span></h1>
<p class="sub sub-wide" style="max-width:900px">Prémium német autók kedvező bérleti feltételekkel és alacsony kaucióval — akár félévente új modell, szervizköltség és adók nélkül. Mutatjuk, miért éri meg nálunk bérelni a következő&nbsp;autódat.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/berelheto">Bérelhető autóink</a>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px">
<div class="wrap center">
<span class="eyebrow">A bérlés előnyei</span>
<h2 class="sec-title">Miért érdemes tőlünk bérelni?</h2>
<p class="sec-intro">Alacsony kauciótól a gondtalan üzemeltetésig — hat ok, amiért a prémium autóbérlés nálunk a legjobb választás.</p>
</div>
<div class="wrap el-wrap">
{benefits.map((b, i) => (
<div class={`zz${i % 2 ? ' flip' : ''}`}>
<div class="zz-media"><img src={b.img} alt={b.t} loading="lazy" onerror="this.closest('.zz-media').classList.add('noimg')" /></div>
<div class="zz-text">
<span class="zz-num">{String(i + 1).padStart(2, '0')}</span>
<h3>{b.t}</h3>
<p>{b.d}</p>
</div>
</div>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Készen állsz? Válaszd ki a következő autód.</h2>
<p>Nézd meg a bérelhető modelljeinket, vagy mondd el, mit keresel — a többit mi intézzük.</p>
</div>
<a class="btn btn-white" href="/berelheto">Bérelhető autóink →</a>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap el-seo">
<span class="eyebrow">Jó tudni</span>
<h2 class="el-seo-h">Prémium autóbérlés Magyarországon — miért éri meg?</h2>
<p>A <strong>prémium autóbérlés</strong> egyre népszerűbb választás magánszemélyek és cégek körében egyaránt: a <span class="kw">tartós autóbérlés</span> révén úgy vezethetsz új, német prémium autót, hogy nem kötsz le rá nagy összeget, és nem visel a hosszú távú tulajdonlás minden terhe és kockázata.</p>
<p>Nálunk a <span class="kw">céges autóbérlés</span> különösen kifizetődő: a bérleti díj elszámolható költség, a szervizt, az adót és a nyári-téli gumit is mi álljuk, a kaució pedig kedvező — nincs az autóban feleslegesen lekötött tőke, és nincsenek váratlan számlák.</p>
<p>Akár félévente új, általad választott modellre válthatsz, a bérlet végén pedig egyszerűen visszaadod az autót — vevőkeresés, alku és maradványérték-kockázat nélkül. Ez a gondtalan, kiszámítható prémium autózás.</p>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések</h2>
</div>
<div class="wrap el-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
<script type="application/ld+json" set:html={JSON.stringify(serviceJson)}></script>
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.el-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.zz{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0}
.zz + .zz{border-top:1px solid var(--line)}
.zz.flip .zz-media{order:2}
.zz-media{border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(8,8,10,.12);background:linear-gradient(135deg,#1a1d23,#3a3f4a);aspect-ratio:16/9}
.zz-media img{width:100%;height:100%;object-fit:cover;display:block}
.zz-media.noimg{position:relative}
.zz-media.noimg::after{content:"CarAdvance";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;letter-spacing:.08em;opacity:.5}
.zz-num{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:0 12px;border-radius:12px;background:var(--red);color:#fff;font-weight:800;font-size:18px;letter-spacing:-.02em}
.zz-text h3{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:16px 0 12px;color:var(--ink)}
.zz-text p{color:var(--muted);font-size:16px;line-height:1.65;margin:0}
@media(max-width:820px){
.zz{grid-template-columns:1fr;gap:20px;padding:26px 0}
.zz.flip .zz-media{order:0}
}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
.el-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px;padding-bottom:20px}
.el-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.el-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.el-faq summary::-webkit-details-marker{display:none}
.el-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.el-faq details[open] .pl{transform:rotate(45deg)}
.el-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.el-seo{max-width:820px;margin:0 auto}
.el-seo-h{font-size:clamp(24px,3.4vw,34px);font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:10px 0 18px}
.el-seo p{color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 16px}
.el-seo strong{color:var(--ink);font-weight:700}
.el-seo .kw{color:var(--red);font-weight:700}
</style>
