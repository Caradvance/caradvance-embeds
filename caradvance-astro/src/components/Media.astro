---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

/* ─────────────────────────────────────────────────────────────
   KÖZÖSSÉGI OLDALAK LINKJEI — a "YOUR_..." részeket cseréld valósra
   ───────────────────────────────────────────────────────────── */
const SOCIAL = {
  facebook: 'https://www.facebook.com/share/19BfQsJxSk/',
  instagram: 'https://www.instagram.com/caradvance_hungary',
  tiktok: 'https://www.tiktok.com/@YOUR_HANDLE',
  youtube: 'https://www.youtube.com/@YOUR_CHANNEL',
  youtubeVideoId: '',          // opcionális: egy kiemelt YouTube-videó azonosítója
  googleReviewsUrl: 'https://www.google.com/maps/search/?api=1&query=Caradvance%20GmbH%20Autovermietung',  // Google értékelések / cégprofil
  googleRating: '5,0',
  googleReviewCount: '',       // pl. "48"
};
const real = (u: string) => !!u && u.indexOf('YOUR_') === -1 && u !== '#';
const tiktokHandle = (SOCIAL.tiktok.split('@')[1] || '').replace(/\/.*$/, '');
const fbEmbeddable = real(SOCIAL.facebook) && SOCIAL.facebook.indexOf('/share/') === -1;
const hasEmbeds = fbEmbeddable || (real(SOCIAL.youtube) && !!SOCIAL.youtubeVideoId) || (real(SOCIAL.tiktok) && !!tiktokHandle);

const GOOGLE_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.27c0-.82-.07-1.6-.2-2.36H12v4.47h6.45a5.5 5.5 0 0 1-2.39 3.6v3h3.86c2.26-2.08 3.58-5.15 3.58-8.71Z"/><path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.95-2.9l-3.86-3a7.2 7.2 0 0 1-4.09 1.16 7.19 7.19 0 0 1-6.76-4.97H1.24v3.09A12 12 0 0 0 12 24Z"/><path fill="#FBBC05" d="M5.24 14.29a7.14 7.14 0 0 1 0-4.58V6.62H1.24a12 12 0 0 0 0 10.76Z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42A11.98 11.98 0 0 0 12 0 12 12 0 0 0 1.24 6.62l4 3.09A7.19 7.19 0 0 1 12 4.75Z"/></svg>';
const FB_SVG = '<svg viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="11" fill="#1877F2"/><path fill="#fff" d="M27.6 26.5 28.4 22h-4.3v-2.9c0-1.23.6-2.43 2.54-2.43H28.6v-3.83s-1.63-.28-3.19-.28c-3.26 0-5.39 1.98-5.39 5.55V22H16.1v4.5h3.92V37.4c.79.12 1.6.19 2.42.19s1.63-.07 2.42-.19V26.5h3.6Z"/></svg>';
const TIKTOK_SVG = '<svg viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="11" fill="#010101"/><path fill="#fff" transform="translate(12 12)" d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03C3.23 21.77 1.81 19.59 1.6 17.25c-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.08-.14 1.62.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg>';
const YOUTUBE_SVG = '<svg viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="11" fill="#FF0000"/><path fill="#fff" d="M19 16.5 32 24l-13 7.5z"/></svg>';

const channels: any[] = [
  { name: 'Facebook', handle: 'CarAdvance', color: '#1877F2', url: SOCIAL.facebook, icon: '/facebook.webp', cta: 'Kövess a Facebookon' },
  { name: 'Instagram', handle: '@caradvance_hungary', color: '#E4405F', url: SOCIAL.instagram, icon: '/instagram.webp', cta: 'Kövess az Instagramon' },
  { name: 'TikTok', handle: '@caradvance', color: '#111111', url: SOCIAL.tiktok, icon: '/tiktok.webp', cta: 'Kövess a TikTokon' },
  { name: 'YouTube', handle: 'CarAdvance', color: '#FF0000', url: SOCIAL.youtube, icon: '/youtube.svg', cta: 'Iratkozz fel' },
];

const reviews = [
  { name: 'Alexandru Ion', initials: 'AI', color: '#D93025', when: '2 éve', text: 'Kiváló munka. Délelőtt 11-re érkeztem, és 14 órára, a fizetés után már vittem is az autót. Az ár stimmelt, az autó minden adata pontos volt. Köszönöm!' },
  { name: 'Ciccio Grifó', initials: 'CG', color: '#1E8E3E', when: '4 éve', text: 'Komoly, és főleg előzékeny, kedves munkatársak. A megkereséseket és e-maileket gyorsan megválaszolják.' },
  { name: 'Bad Martin', initials: 'BM', color: '#7B45D6', when: '2 éve', text: 'Nagyon kedves és hozzáértő munkatársak. Itt fel is veszik a telefont — és pontosan azt kapod, amit ígérnek.' },
];

const orgJson: any = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: 'CarAdvance', url: 'https://www.caradvance.hu/',
  logo: 'https://www.caradvance.hu/caradvance-logo.webp',
  sameAs: [SOCIAL.facebook, SOCIAL.instagram, SOCIAL.tiktok, SOCIAL.youtube].filter(real),
};
---
<section class="md">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>Media —<br /><span class="accent">kövess minket</span></h1>
<p class="sub sub-wide" style="max-width:820px">Friss autóink, németországi behozatalaink és a kulisszák mögötti tartalmak — nézd meg és kövess minket a közösségi csatornáinkon.</p>
<div class="cta-row">
<a class="btn btn-primary" href="#csatornak">Csatornáink</a>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<!-- Google értékelés + vélemények -->
<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap">
<a class="md-google" href={SOCIAL.googleReviewsUrl} target="_blank" rel="noopener noreferrer">
<span class="md-g-ico" set:html={GOOGLE_SVG}></span>
<span class="md-g-txt">
<b>{SOCIAL.googleRating} <span class="md-stars">★★★★★</span></b>
<span>Kiváló Google-értékelés{SOCIAL.googleReviewCount ? ` — ${SOCIAL.googleReviewCount} vélemény` : ''} és aktív közösségi média jelenlét</span>
</span>
<span class="md-g-link">Értékelések ↗</span>
</a>
</div>
<div class="wrap">
<div class="md-reviews" role="list">
{reviews.map((r) => (
<div class="md-rev" role="listitem">
<div class="md-rev-top">
<span class="md-avatar" style={`background:${r.color}`}>{r.initials}</span>
<span class="md-rev-id"><b>{r.name}</b><span>{r.when}</span></span>
<span class="md-rev-g" set:html={GOOGLE_SVG}></span>
</div>
<div class="md-rev-stars">★★★★★</div>
<p class="md-rev-text">{r.text}</p>
</div>
))}
</div>
<p class="md-rev-hint">← görgess a további Google-véleményekért →</p>
</div>
</section>

<!-- Csatornák -->
<section class="section" id="csatornak" style="padding-top:16px">
<div class="wrap center">
<span class="eyebrow">Közösségi csatornáink</span>
<h2 class="sec-title">Kövess minket a kedvenc platformodon</h2>
<p class="sec-intro">Napi frissítések a behozott és készleten lévő autókról, ügyfélsztorik és videós tartalmak.</p>
</div>
<div class="wrap md-cards">
{channels.map((c) => real(c.url) ? (
<a class="md-card" href={c.url} target="_blank" rel="noopener noreferrer" style={`--c:${c.color}`}>
<img class={c.name === 'YouTube' ? 'md-ico-img md-ico-yt' : 'md-ico-img'} src={c.icon} alt={c.name} loading="lazy" />
<span class="md-name">{c.name}</span>
<span class="md-handle">{c.handle}</span>
<span class="md-follow">{c.cta} ↗</span>
</a>
) : (
<div class="md-card md-card-soon" style={`--c:${c.color}`}>
<img class={c.name === 'YouTube' ? 'md-ico-img md-ico-yt' : 'md-ico-img'} src={c.icon} alt={c.name} loading="lazy" />
<span class="md-name">{c.name}</span>
<span class="md-handle">{c.handle}</span>
<span class="md-follow md-soon">Hamarosan</span>
</div>
))}
</div>
</section>

{hasEmbeds && (
<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Legfrissebb tartalom</span>
<h2 class="sec-title">Nézd meg, mi történik nálunk</h2>
</div>
<div class="wrap md-embeds">
{real(SOCIAL.youtube) && SOCIAL.youtubeVideoId && (
<div class="md-embed md-yt">
<div class="md-yt-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${SOCIAL.youtubeVideoId}`} title="CarAdvance YouTube" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
</div>
)}
{fbEmbeddable && (
<div class="md-embed">
<iframe class="md-fb" src={`https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(SOCIAL.facebook)}&tabs=timeline&width=380&height=520&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true`} width="380" height="520" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen={true} allow="clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
</div>
)}
{real(SOCIAL.tiktok) && tiktokHandle && (
<div class="md-embed">
<blockquote class="tiktok-embed" cite={SOCIAL.tiktok} data-unique-id={tiktokHandle} data-embed-type="creator" style="max-width:325px;min-width:288px"><section></section></blockquote>
<script async src="https://www.tiktok.com/embed.js"></script>
</div>
)}
</div>
</section>
)}

<!-- CTA -->
<section class="section">
<div class="wrap">
<div class="md-cta">
<div>
<h2>Ne maradj le semmiről.</h2>
<p>Kövess minket, és elsőként értesülsz a friss behozatalokról, akciókról és a legújabb autóinkról.</p>
</div>
<a class="btn btn-white" href="#csatornak">Csatornáink →</a>
</div>
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(orgJson)}></script>
</section>

<style>
.md{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.md .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
/* Google review bar */
.md-google{display:flex;align-items:center;gap:16px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 22px;text-decoration:none;color:inherit;box-shadow:0 10px 30px rgba(8,8,10,.05);transition:.15s}
.md-google:hover{box-shadow:0 16px 40px rgba(8,8,10,.12);transform:translateY(-2px)}
.md-g-ico{flex:0 0 auto;width:34px;height:34px}
.md-g-ico svg{width:34px;height:34px;display:block}
.md-g-txt{display:flex;flex-direction:column;gap:2px;flex:1}
.md-g-txt b{font-size:18px;font-weight:800;color:var(--ink);display:flex;align-items:center;gap:8px}
.md-stars{color:#F5A623;font-size:16px;letter-spacing:1px}
.md-g-txt span{color:var(--muted);font-size:13.5px;line-height:1.4}
.md-g-link{flex:0 0 auto;font-weight:800;font-size:14px;color:#4285F4}
@media(max-width:560px){.md-g-link{display:none}}
/* Reviews carousel */
.md-reviews{display:flex;gap:16px;overflow-x:auto;padding:16px 2px 14px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
.md-reviews::-webkit-scrollbar{height:8px}
.md-reviews::-webkit-scrollbar-track{background:transparent}
.md-reviews::-webkit-scrollbar-thumb{background:#d5dbe6;border-radius:999px}
.md-rev{flex:0 0 340px;max-width:340px;scroll-snap-align:start;background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
@media(max-width:480px){.md-rev{flex:0 0 82%}}
.md-rev-top{display:flex;align-items:center;gap:12px}
.md-avatar{flex:0 0 auto;width:44px;height:44px;border-radius:50%;color:#fff;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center}
.md-rev-id{display:flex;flex-direction:column;flex:1;min-width:0}
.md-rev-id b{font-size:15px;font-weight:800;color:var(--ink)}
.md-rev-id span{font-size:12.5px;color:var(--muted)}
.md-rev-g{flex:0 0 auto;width:20px;height:20px}
.md-rev-g svg{width:20px;height:20px;display:block}
.md-rev-stars{color:#F5A623;font-size:16px;letter-spacing:2px;margin:12px 0 8px}
.md-rev-text{color:var(--ink);font-size:14px;line-height:1.6;margin:0}
.md-rev-hint{color:var(--muted);font-size:12.5px;margin:2px 0 0;text-align:center}
/* Channel cards */
.md-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:22px}
@media(max-width:820px){.md-cards{grid-template-columns:1fr 1fr}}
@media(max-width:460px){.md-cards{grid-template-columns:1fr}}
.md-card{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px 18px;text-decoration:none;color:inherit;box-shadow:0 10px 30px rgba(8,8,10,.05);transition:.18s;position:relative;overflow:hidden}
.md-card::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:var(--c)}
.md-card:hover{transform:translateY(-4px);box-shadow:0 18px 44px rgba(8,8,10,.14);border-color:var(--c)}
.md-ico-img{width:52px;height:52px;object-fit:contain;border-radius:13px;margin-bottom:6px}
.md-ico-yt{width:66px;height:66px;border-radius:0}
.md-name{font-weight:800;font-size:18px;color:var(--ink)}
.md-handle{color:var(--muted);font-size:13.5px}
.md-follow{margin-top:8px;font-weight:800;font-size:13.5px;color:var(--c)}
.md-soon{color:var(--muted)}
/* Embeds */
.md-embeds{display:flex;flex-wrap:wrap;gap:20px;justify-content:center;margin-top:22px}
.md-embed{background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
.md-yt{flex:1 1 100%;max-width:760px}
.md-yt-frame{position:relative;width:100%;aspect-ratio:16/9;border-radius:12px;overflow:hidden}
.md-yt-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.md-fb{width:380px;max-width:100%}
/* CTA */
.md-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.md-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.md-cta p{color:#cfd6e2;margin:0;font-size:15px;max-width:560px}
</style>
