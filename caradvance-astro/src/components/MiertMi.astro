---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const IMG = 'https://www.caradvance.hu/';

const stats = [
  { n: '5,0★', l: 'Google-értékelés' },
  { n: 'München', l: 'németországi háttér' },
  { n: 'Kulcsrakész', l: 'teljes folyamat' },
  { n: 'Egy helyen', l: 'bérlés · vásárlás · lízing' },
];

const reasons = [
  { t: 'Németországi háttér, közvetlen piac', img: IMG + 'autoszallitas-autoimport-nemetorszagbol.webp',
    d: 'A müncheni Caradvance GmbH révén közvetlen rálátásunk van Európa egyik legnagyobb prémium használtautó-piacára. Ott nagyobb a választék, jobb a dokumentáltság és fegyelmezettebb a szervizkultúra — így a legjobb ár-érték arányú, megbízható autókat tudjuk kiválasztani neked.' },
  { t: 'Kulcsrakész folyamat — mindent mi intézünk', img: IMG + 'caradvance-hero-x5-poster.jpg',
    d: 'Keresés, helyszíni ellenőrzés, vásárlás, szállítás és honosítás — az egész utat végigvisszük. Neked csak a jó döntés marad, a papírmunkát, a logisztikát és a hivatali ügyintézést levesszük a válladról.' },
  { t: 'Átlátható árazás, meglepetések nélkül', img: IMG + 'bmw-m3-touring-premium-auto-eladas.webp',
    d: 'A „kapun belüli”, forgalomba helyezett árral kalkulálunk, előre rögzített feltételekkel — nincs rejtett költség. Magánszemélyként akár 19%-os német áfával vásárolhatsz a hazai 27% helyett, ami jelentős megtakarítás.' },
  { t: 'Kiváló Google-értékelés, valós vélemények', img: IMG + 'cover-caradvance-referenciak-vasarloi-tortenetek.webp',
    d: 'A Caradvance GmbH jelenleg 5,0-ös átlagértékelést tart a Google-on. A vásárlók visszatérő élménye: gyors ügyintézés, korrekt ár, pontos autóadatok — és hogy tényleg felvesszük a telefont. A valós véleményeket a Media oldalunkon olvashatod.' },
  { t: 'Teljes körű szolgáltatás egy helyen', img: IMG + 'piros-bmw-x6-m-premium-autoberles.webp',
    d: 'Prémium autóbérlés, vásárlás, németországi behozatal, finanszírozás és lízing, valamint bizományos értékesítés — mindent egy helyen, egy csapattal intézel. Nem kell több szolgáltatót összehangolnod.' },
  { t: 'Személyes, magyar nyelvű ügyintézés', img: IMG + 'toyota-rav4-hybrid-hasznaltauto-eladas.webp',
    d: 'Barátságos, hozzáértő és végig magyar nyelvű kiszolgálás — a legelső kérdéstől a kulcsátadásig, és utána is. Prémium szegmensben ez az emberi, kiszámítható törődés az, ami igazán számít.' },
];

const faqs = [
  { q: 'Miért a németországi háttér előny?', a: 'Közvetlen hozzáférést ad Európa egyik legnagyobb prémium használtautó-piacához, ahol nagyobb a választék és jobb a dokumentáltság — így jobb ár-érték arányú autót találunk, a behozatalt pedig kulcsrakészen intézzük.' },
  { q: 'Vásárolhatok magánszemélyként is?', a: 'Igen. A müncheni Caradvance GmbH-n keresztül magánszemélyként is vásárolhatsz, akár 19%-os német áfával a hazai 27% helyett.' },
  { q: 'Milyen szolgáltatásokat nyújtotok?', a: 'Prémium autóbérlés, vásárlás, németországi behozatal, finanszírozás/lízing és bizományos értékesítés — egy helyen, kulcsrakészen.' },
  { q: 'Hol olvashatom a valós véleményeket?', a: 'A Media oldalunkon összegyűjtöttük a Caradvance GmbH Google-értékeléseit, magyarra fordítva; az eredetieket a Google-profilon is megnézheted.' },
];

const pageJson = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: 'Miért a CarAdvance?',
  description: 'Miért válaszd a CarAdvance-t? Németországi háttér, kulcsrakész folyamat, átlátható árazás és kiváló 5,0-ös Google-értékelés — prémium autók bérlése, vásárlása, behozatala és finanszírozása egy helyen.',
  url: 'https://www.caradvance.hu/miert-mi/',
  inLanguage: 'hu-HU',
};
const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbJson = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kezdőlap', item: 'https://www.caradvance.hu/' },
    { '@type': 'ListItem', position: 2, name: 'Miért mi?', item: 'https://www.caradvance.hu/miert-mi/' },
  ],
};
const jsonLdAll = [pageJson, faqJson, breadcrumbJson];
---
<section class="el mm">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-x5-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>Miért a CarAdvance?<br /><span class="accent">A német háttér, ami előnyt ad.</span></h1>
<p class="sub sub-wide" style="max-width:900px">Prémium autók bérlése, vásárlása, németországi behozatala és finanszírozása — kulcsrakészen, átlátható áron, kiváló Google-értékeléssel. Mutatjuk, miért választanak minket újra és újra az ügyfeleink.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/egyedi-auto-rendeles">Autók böngészése</a>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap center">
<span class="eyebrow">Miért mi?</span>
<h2 class="sec-title">Hat ok, amiért jó kezekben vagy</h2>
<p class="sec-intro">Egy prémium autó vásárlása vagy behozatala bizalmi kérdés. Nem ígéretekkel győzünk meg, hanem a folyamattal és a valós visszajelzésekkel.</p>
</div>
<div class="wrap">
<div class="mm-stats">
{stats.map((s) => (
<div class="mm-stat"><span class="mm-stat-n">{s.n}</span><span class="mm-stat-l">{s.l}</span></div>
))}
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap el-wrap">
{reasons.map((b, i) => (
<div class={`zz${i % 2 ? ' flip' : ''}`}>
<div class="zz-media"><img src={b.img} alt={b.t} loading="lazy" onerror="this.closest('.zz-media').classList.add('noimg')" /></div>
<div class="zz-text">
<span class="zz-num">{String(i + 1).padStart(2, '0')}</span>
<h3>{b.t}</h3>
<p>{b.d}</p>
</div>
</div>
))}
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Gyakori kérdések</span>
<h2 class="sec-title">Amit gyakran kérdeznek</h2>
</div>
<div class="wrap mm-faqwrap">
{faqs.map((f) => (
<details class="mm-faq"><summary>{f.q}</summary><p>{f.a}</p></details>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Beszéljük meg, mit keresel.</h2>
<p>Mondd el, milyen autóban gondolkodsz — a többit mi intézzük, kulcsrakészen. Kérj személyre szabott ajánlatot.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Kapcsolatfelvétel →</a>
</div>
</div>
</section>
{jsonLdAll.map((j) => (<script type="application/ld+json" set:html={JSON.stringify(j)}></script>))}
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.el-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.zz{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0}
.zz + .zz{border-top:1px solid var(--line)}
.zz.flip .zz-media{order:2}
.zz-media{border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(8,8,10,.12);background:linear-gradient(135deg,#1a1d23,#3a3f4a);aspect-ratio:16/10}
.zz-media img{width:100%;height:100%;object-fit:cover;display:block}
.zz-media.noimg{position:relative}
.zz-media.noimg::after{content:"CarAdvance";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;letter-spacing:.08em;opacity:.5}
.zz-num{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:0 12px;border-radius:12px;background:var(--red);color:#fff;font-weight:800;font-size:18px;letter-spacing:-.02em}
.zz-text h3{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:16px 0 12px;color:var(--ink)}
.zz-text p{color:var(--muted);font-size:16px;line-height:1.65;margin:0}
@media(max-width:820px){
.zz{grid-template-columns:1fr;gap:20px;padding:26px 0}
.zz.flip .zz-media{order:0}
}
.mm-stats{max-width:1080px;margin:22px auto 0;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.mm-stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 20px;text-align:center;display:flex;flex-direction:column;gap:4px}
.mm-stat-n{font-size:clamp(20px,2.6vw,26px);font-weight:800;color:var(--red);letter-spacing:-.02em}
.mm-stat-l{color:var(--muted);font-size:14px;line-height:1.4}
@media(max-width:820px){.mm-stats{grid-template-columns:1fr 1fr}}
.mm-faqwrap{max-width:1080px;margin:8px auto 0;display:flex;flex-direction:column;gap:12px}
.mm-faq{background:#fff;border:1px solid var(--line);border-radius:14px;padding:2px 20px}
.mm-faq summary{cursor:pointer;font-weight:700;color:var(--ink);padding:16px 0;list-style:none}
.mm-faq summary::-webkit-details-marker{display:none}
.mm-faq[open] summary{color:var(--red)}
.mm-faq p{color:var(--muted);line-height:1.65;margin:0 0 16px}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
</style>
