---
/**
 * Miért mi? — /miert-mi/  (2026-10, SEO-átírás)
 * Fő kulcsszó: „megbízható autókereskedés” (Ahrefs HU: 350/hó, KD 51 — a top 10-ben DR 0–46 oldalak).
 * Másodlagos: autókereskedés budapest (300), autó németországból (150), autó tartós bérlet (200),
 *            használtautó kereskedés budapest (100), autó behozatal németországból (80), bizományos autó értékesítés (70).
 * Képek: /miert-mi-01-….webp … /miert-mi-09-….webp — ha még nincs feltöltve, a meglévő képre esik vissza.
 */
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const SITE = 'https://www.caradvance.hu';
const IMG = SITE + '/';

/* ikonok (24×24, vonalas) */
const ICON: Record<string, string> = {
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="M8.5 14.5l2.2 2.2 4.8-4.8"/>',
  car: '<path d="M5 16.5h14M3.5 16.5v-3.2l1.9-4.6a2 2 0 0 1 1.85-1.2h9.5a2 2 0 0 1 1.85 1.2l1.9 4.6v3.2"/><circle cx="7.5" cy="16.5" r="1.8"/><circle cx="16.5" cy="16.5" r="1.8"/><path d="M5.5 12.5h13"/>',
  star: '<path d="M12 3.2l2.7 5.5 6 .9-4.35 4.25 1 6L12 17l-5.35 2.85 1-6L3.3 9.6l6-.9z"/>',
  shield: '<path d="M12 2.8l7.5 3v6.1c0 4.6-3.2 8.2-7.5 9.3-4.3-1.1-7.5-4.7-7.5-9.3V5.8z"/><path d="M8.6 12.2l2.4 2.4 4.6-4.6"/>',
  percent: '<circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/><path d="M19 5L5 19"/>',
  heart: '<path d="M12 20.3s-7.8-4.6-7.8-10.4A4.4 4.4 0 0 1 12 7.4a4.4 4.4 0 0 1 7.8 2.5c0 5.8-7.8 10.4-7.8 10.4z"/>',
  building: '<path d="M4 21V5.5L12 3l8 2.5V21"/><path d="M9 21v-4h6v4M8 8.5h2M14 8.5h2M8 12.5h2M14 12.5h2M2.5 21h19"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/><path d="M8 10.5l1.8 1.8 3.4-3.4"/>',
  route: '<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H15a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h6.5"/>',
  receipt: '<path d="M6 2.8h12v18.4l-3-2-3 2-3-2-3 2z"/><path d="M9 7.5h6M9 11h6M9 14.5h3.5"/>',
  key: '<circle cx="8" cy="15" r="4.5"/><path d="M11.2 11.8L20 3M16.5 6.5l2.5 2.5M14.5 8.5l2 2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.7 3.2-6 6.5-6s5.9 2.3 6.5 6"/><circle cx="17.5" cy="9" r="2.6"/><path d="M17 14.2c2.5.2 4.2 2.1 4.5 5.3"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  x: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>',
};
const ico = (k: string, cls = 'mm-ico') => `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[k]}</svg>`;

const stats = [
  { i: 'calendar', n: '23 év', l: 'németországi háttér — 2003 óta' },
  { i: 'car', n: '5000+', l: 'eladott prémium autó' },
  { i: 'star', n: '5,0★', l: 'Google-értékelés' },
  { i: 'shield', n: '1 év', l: 'szavatosság minden autóra' },
  { i: 'percent', n: '19%', l: 'német áfa magánszemélyeknek' },
  { i: 'heart', n: '30%', l: 'jutalékunkból jótékony célra' },
];

const reasons = [
  { i: 'building', t: '23 év a német autópiacon — valódi céges háttér', img: 'miert-mi-01-nemet-hatter.webp', fb: 'autoszallitas-autoimport-nemetorszagbol.webp',
    d: 'A CarAdvance a <strong>Caradvance GmbH</strong> márkája, amely <strong>2003 óta</strong> működik a München melletti Geretsriedben. Magyarországon a <strong>BH Group Zrt.</strong> képvisel minket, Solymáron, Budapest mellett. A szerződést és a számlát egy német cégtől kapod, a hazai ügyintézést pedig egy magyar csapat viszi végig — egy megbízható autókereskedés nem ígéretekből, hanem évtizedes működésből épül.',
    link: ['Referenciáink', '/referenciak/'] },
  { i: 'search', t: 'Ellenőrzött autók, valós futással és előélettel', img: 'miert-mi-02-ellenorzott-autok.webp', fb: 'bmw-m3-touring-premium-auto-eladas.webp',
    d: 'A német piacon nagyjából <strong>14× nagyobb a választék</strong>, mint itthon (mobile.de, AutoScout24). Mi ebből válogatunk: leinformáljuk az autó előéletét, ellenőrizzük a szervizkönyvet és a futást, és a helyszínen bevizsgáljuk, mielőtt megvesszük. Csak új vagy alig használt, dokumentált autót hozunk be — rejtett hiba és visszatekert óra nélkül.',
    link: ['Miért a német piac?', '/elonyok/'] },
  { i: 'shield', t: '1 év szavatosság — kiállunk minden autóért', img: 'miert-mi-03-szavatossag.webp', fb: 'caradvance-hero-x5-poster.jpg',
    d: 'Importált és hazai autóinkra egyaránt <strong>1 év szavatosságot</strong> vállalunk. Ezt azért tehetjük meg, mert minden autót alaposan átvizsgálunk, mielőtt hozzád kerül. Ha bármi gond adódik, nem egy hirdetővel kell vitatkoznod: velünk, egy felelős céggel van dolgod, írásos szerződéssel.',
    link: ['Gyakori kérdések a vásárlásról', '/vasarlas-gyakori-kerdesek/'] },
  { i: 'route', t: 'Kulcsrakész autóbehozatal Németországból — 12 lépésben', img: 'miert-mi-04-kulcsrakesz-import.webp', fb: 'autoszallitas-autoimport-nemetorszagbol.webp',
    d: 'Kutatás, kiválasztás, ellenőrzés, ártárgyalás, szerződés, szállítás, honosítás, műszaki vizsga, forgalomba helyezés, biztosítás és <strong>kulcsrakész átadás</strong> — a teljes autó behozatalt Németországból mi intézzük. Neked csak a döntés marad; a papírmunkát, a logisztikát és a hivatali ügyintézést levesszük a válladról.',
    link: ['A beszerzési folyamat', '/beszerzesi-folyamat/'] },
  { i: 'receipt', t: 'Átlátható ár, akár 19%-os német áfával', img: 'miert-mi-05-atlathato-ar.webp', fb: 'bmw-m3-touring-premium-auto-eladas.webp',
    d: 'Tételes, előre rögzített ajánlatot adunk a forgalomba helyezett, „kapun belüli” árral — rejtett költségek nélkül. Magánszemélyként a Caradvance GmbH-tól <strong>19%-os német áfával</strong> vásárolhatsz a hazai 27% helyett, ami prémium autónál több százezer forint megtakarítás lehet. A regisztrációs adót a kalkulátorunkkal előre kiszámolhatod.',
    link: ['Honosítás kalkulátor', '/honositas-kalkulator/'] },
  { i: 'key', t: 'Prémium autó tartós bérlettel — már 6 hónaptól', img: 'miert-mi-06-tartos-berlet.webp', fb: 'piros-bmw-x6-m-premium-autoberles.webp',
    d: 'Új BMW, MINI, Mercedes-Benz, Audi, Volkswagen és CUPRA modellek <strong>tartós bérletben, minimum 6 hónapra</strong> — magánszemélyeknek és cégeknek. Német rendszámmal, egy fix havidíjban a szervizzel, a gépjárműadóval, a biztosítással és a nyári-téli gumikkal. Ha szeretnéd, félévente új modellre válthatsz, továbbértékesítési gond nélkül.',
    link: ['A tartós bérlet előnyei', '/berles-elonyei'] },
  { i: 'layers', t: 'Vásárlás, rendelés, finanszírozás, bizomány — egy helyen', img: 'miert-mi-07-egy-helyen.webp', fb: 'toyota-rav4-hybrid-hasznaltauto-eladas.webp',
    d: 'Készletről vagy <strong>egyedi rendeléssel</strong> gyárilag konfigurált új autót, finanszírozást és lízinget partnereinken (Euro Leasing, Merkantil Bank) keresztül, valamint <strong>bizományos autó értékesítést</strong> is kínálunk: a sávos jutalékot csak sikeres eladás után kell fizetni. Nem kell több szolgáltatót összehangolnod — egy csapattal, egy kapcsolattartóval intézel mindent.',
    link: ['Finanszírozás és lízing', '/finanszirozas-lizing/'] },
  { i: 'users', t: '5,0-ás Google-értékelés és személyes kapcsolattartó', img: 'miert-mi-08-ertekelesek.webp', fb: 'cover-caradvance-referenciak-vasarloi-tortenetek.webp',
    d: 'Ügyfeleink <strong>5,0-ás átlagértékelést</strong> adnak a Google-on. A visszatérő élmény: gyors ügyintézés, korrekt ár, pontos autóadatok — és hogy tényleg felvesszük a telefont. Magyarul, angolul, németül és franciául is segítünk, az első kérdéstől a kulcsátadásig és utána is.',
    link: ['Valós vélemények', '/referenciak/'] },
  { i: 'heart', t: 'Minden eladott autóval jót teszünk', img: 'miert-mi-09-jotekonysag.webp', fb: 'cover-caradvance-referenciak-vasarloi-tortenetek.webp',
    d: 'Minden eladás után a <strong>jutalékunk 30%-át</strong> magyar jótékony szervezeteknek ajánljuk fel — a te pénzedből semmit. Hogy hová kerüljön, arról az eladó és a vevő dönt hét szervezet közül, az SOS Gyermekfalutól a Rex Kutyaotthonig. Átláthatóan rögzítjük, és megmutatjuk, kihez jutott.',
    link: ['Jótékonysági programunk', '/jotekonysag/'] },
];

const compare = {
  head: ['', 'CarAdvance', 'Egyedül, magánszemélytől', 'Átlagos hazai kínálat'],
  rows: [
    ['Választék', 'a teljes német piac (≈14× nagyobb)', 'ami épp hirdetésben van', 'a kereskedés saját készlete'],
    ['Autó előélete', 'leinformált, helyszínen bevizsgált', 'neked kell kiderítened', 'változó'],
    ['Szavatosság', '1 év minden autóra', 'általában nincs', 'nem mindig'],
    ['Áfa magánszemélynek', 'akár 19% (német)', '—', '27%'],
    ['Ügyintézés', 'kulcsrakész, honosítással', 'mindent te intézel', 'részben'],
    ['Ár', 'tételes, előre rögzített', 'alku és kockázat', 'utólagos költségek lehetnek'],
  ],
};

const checklist = [
  ['Hosszú, ellenőrizhető múlt', 'Cégnév, székhely, cégjegyzék — a Caradvance GmbH 2003 óta működik, magyar képviselője a BH Group Zrt.'],
  ['Valós vélemények', 'Nézd meg a Google-értékeléseket: nálunk 5,0 az átlag, a véleményeket a Referenciák oldalon is összegyűjtöttük.'],
  ['Írásos szerződés és szavatosság', 'Megbízható autókereskedés szerződést ad, és felel az autóért — mi 1 év szavatosságot vállalunk.'],
  ['Dokumentált előélet', 'Szervizkönyv, valós futás, tiszta előélet: minden autót leinformálunk és bevizsgálunk.'],
  ['Átlátható árazás', 'Tételes ajánlat, rejtett költségek nélkül — a regisztrációs adót előre kiszámoljuk.'],
  ['Utógondozás', 'Az átadás után is számíthatsz ránk: szerviz, kérdések vagy a következő autód.'],
];

const faqs = [
  { q: 'Mitől megbízható egy autókereskedés?', a: 'Hosszú, ellenőrizhető céges múlttól, valós ügyfélvéleményektől, írásos szerződéstől és szavatosságtól, dokumentált autóktól és átlátható árazástól. A CarAdvance mögött a 2003 óta működő Caradvance GmbH áll, 5,0-ás Google-értékeléssel és több mint 5000 eladott prémium autóval; minden autóra 1 év szavatosságot vállalunk.' },
  { q: 'Ki áll a CarAdvance mögött?', a: 'A CarAdvance a Caradvance GmbH márkája (Geretsried, München mellett), amely 2003 óta a német autópiac szereplője. Magyarországon a BH Group Zrt. képvisel minket, irodánk Solymáron, Budapest mellett található.' },
  { q: 'Hol találom meg az irodátokat?', a: 'Magyarországi irodánk címe: 2083 Solymár, Ibolya utca 18. — Budapesttől néhány percre. Hétfőtől péntekig 9:00 és 17:00 között várunk, előzetes egyeztetés után.' },
  { q: 'Milyen szavatosságot adtok az autókra?', a: 'Importált és hazai autóinkra egyaránt 1 év szavatosságot vállalunk, írásos szerződéssel. Minden autót leinformálunk és bevizsgálunk, mielőtt átadjuk.' },
  { q: 'Vásárolhatok magánszemélyként 19%-os német áfával?', a: 'Igen. Magánszemélyként a Caradvance GmbH-tól vásárolhatsz, akár 19%-os német áfával a hazai 27% helyett. A szállítást, a honosítást és a forgalomba helyezést Magyarországon a BH Group Zrt. intézi.' },
  { q: 'Intézitek az autó behozatalát Németországból?', a: 'Igen, kulcsrakészen: kiválasztjuk és helyszínen bevizsgáljuk az autót, megvesszük, hazaszállítjuk, elvégezzük a honosítást, a műszaki vizsgát és a forgalomba helyezést — magyar rendszámmal és papírokkal adjuk át.' },
  { q: 'Bérelhetek autót tartósan, akár cégként is?', a: 'Igen. Tartós bérletünk minimum 6 hónapra szól, magánszemélyeknek és cégeknek egyaránt. Az autó német rendszámos, a havidíj tartalmazza a szervizt, az adót, a biztosítást és a nyári-téli gumikat.' },
  { q: 'Eladjátok helyettem az autómat?', a: 'Igen, bizományos értékesítéssel: profi fotó és videó, hirdetés több platformon, érdeklődők kezelése és teljes ügyintézés. Sávos jutalékot csak sikeres eladás után számolunk fel, és annak 30%-át jótékony célra ajánljuk fel.' },
];

/* ---- strukturált adatok ---- */
const sameAs = [
  'https://www.facebook.com/share/19BfQsJxSk/',
  'https://www.instagram.com/caradvance_hungary',
  'https://www.youtube.com/channel/UCbmogjjIDqVwFtFoA-h3jjw',
  'https://www.hasznaltauto.hu/partner/bh_group_zrt-20676',
];
const orgJson = {
  '@context': 'https://schema.org', '@type': 'AutoDealer', '@id': SITE + '/#autodealer',
  name: 'CarAdvance', url: SITE + '/', logo: SITE + '/caradvance-logo.webp', image: SITE + '/caradvance-hero-x5-poster.jpg',
  description: 'Megbízható autókereskedés német háttérrel: prémium autók tartós bérlete, vásárlása, egyedi rendelése, behozatala Németországból, finanszírozása és bizományos értékesítése.',
  telephone: '+36 30 233 6060', email: 'info@caradvance.hu',
  address: { '@type': 'PostalAddress', streetAddress: 'Ibolya utca 18.', postalCode: '2083', addressLocality: 'Solymár', addressCountry: 'HU' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' }],
  areaServed: { '@type': 'Country', name: 'Magyarország' },
  knowsLanguage: ['hu', 'en', 'de', 'fr'],
  brand: ['BMW', 'MINI', 'Mercedes-Benz', 'Audi', 'Volkswagen', 'CUPRA'].map((b) => ({ '@type': 'Brand', name: b })),
  parentOrganization: { '@type': 'Organization', name: 'Caradvance GmbH', foundingDate: '2003', address: { '@type': 'PostalAddress', addressLocality: 'Geretsried', addressCountry: 'DE' } },
  sameAs,
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Szolgáltatások', itemListElement: [
    ['Prémium autó tartós bérlet', '/berles-elonyei'], ['Autó behozatal Németországból', '/beszerzesi-folyamat/'], ['Egyedi autó rendelés', '/egyedi-auto-rendeles'],
    ['Autó finanszírozás és lízing', '/finanszirozas-lizing/'], ['Bizományos autó értékesítés', '/bizomanyos/'],
  ].map(([n, u]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n, url: SITE + u } })) },
};
const pageJson = {
  '@context': 'https://schema.org', '@type': 'AboutPage',
  name: 'Miért a CarAdvance? — megbízható autókereskedés német háttérrel',
  description: 'Kilenc ok, amiért a CarAdvance megbízható választás: 23 év német háttér, ellenőrzött autók, 1 év szavatosság, kulcsrakész behozatal, 19% német áfa, tartós bérlet, finanszírozás és bizományos értékesítés egy helyen.',
  url: SITE + '/miert-mi/', inLanguage: 'hu-HU',
  about: { '@id': SITE + '/#autodealer' },
  mainEntity: { '@type': 'ItemList', name: 'Kilenc ok a CarAdvance mellett', itemListElement: reasons.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.t })) },
};
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
};
const breadcrumbJson = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kezdőlap', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Miért mi?', item: SITE + '/miert-mi/' },
  ],
};
const jsonLdAll = [orgJson, pageJson, faqJson, breadcrumbJson];
---
<section class="el mm">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-x5-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>Megbízható autókereskedés<br /><span class="accent">német háttérrel, 2003 óta.</span></h1>
<p class="sub sub-wide" style="max-width:900px">Prémium autók tartós bérlete, vásárlása és behozatala Németországból — ellenőrzött autókkal, 1 év szavatossággal, átlátható áron és 5,0-ás Google-értékeléssel. Kilenc ok, amiért ügyfeleink újra és újra minket választanak.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/autoink/">Autóink böngészése</a>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap center">
<span class="eyebrow">Miért mi?</span>
<h2 class="sec-title">Miért a CarAdvance? Kilenc ok, amiért jó kezekben vagy</h2>
<p class="sec-intro">Egy prémium autó vásárlása, bérlése vagy behozatala bizalmi kérdés. Nem ígéretekkel győzünk meg, hanem számokkal, egy átlátható folyamattal és valós ügyfélvéleményekkel.</p>
</div>
<div class="wrap">
<div class="mm-stats">
{stats.map((s) => (
<div class="mm-stat"><span class="mm-stat-i" set:html={ico(s.i)}></span><span class="mm-stat-n">{s.n}</span><span class="mm-stat-l">{s.l}</span></div>
))}
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap el-wrap">
{reasons.map((b, i) => (
<div class={`zz${i % 2 ? ' flip' : ''}`}>
<div class="zz-media"><img src={IMG + b.img} alt={b.t} loading="lazy" onerror={`if(!this.dataset.fb){this.dataset.fb=1;this.src='${IMG + b.fb}'}else{this.closest('.zz-media').classList.add('noimg')}`} /></div>
<div class="zz-text">
<div class="zz-head"><span class="zz-num">{String(i + 1).padStart(2, '0')}</span><span class="zz-ico" set:html={ico(b.i)}></span></div>
<h3>{b.t}</h3>
<p set:html={b.d}></p>
<a class="zz-link" href={b.link[1]}>{b.link[0]} →</a>
</div>
</div>
))}
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Összehasonlítás</span>
<h2 class="sec-title">CarAdvance vagy egyedül? A különbség egy táblázatban</h2>
<p class="sec-intro">Ugyanaz az autó, egészen más kockázat. Így néz ki egy autó vásárlása velünk — és nélkülünk.</p>
</div>
<div class="wrap">
<div class="mm-cmp-wrap">
<table class="mm-cmp">
<thead><tr>{compare.head.map((h, i) => (<th class={i === 1 ? 'us' : ''}>{h}</th>))}</tr></thead>
<tbody>
{compare.rows.map((r) => (
<tr><th scope="row">{r[0]}</th><td class="us"><span set:html={ico('check', 'mm-ck')}></span>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>
))}
</tbody>
</table>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Jó tudni</span>
<h2 class="sec-title">Megbízható autókereskedés — így ismered fel</h2>
<p class="sec-intro">Akár autókereskedést keresel Budapesten, akár autót hoznál Németországból, ez a hat szempont segít eldönteni, kinek bízd a pénzed.</p>
</div>
<div class="wrap">
<div class="mm-check">
{checklist.map((c) => (
<div class="mm-check-i"><span class="mm-check-ic" set:html={ico('check', 'mm-ck')}></span><div><h3>{c[0]}</h3><p>{c[1]}</p></div></div>
))}
</div>
<div class="mm-seo">
<p>A <strong>megbízható autókereskedés</strong> ismérve, hogy vállalja a felelősséget az autóért: dokumentált előélettel, írásos szerződéssel és szavatossággal adja át. A CarAdvance ezt egy olyan kínálattal köti össze, amit egy hazai autókereskedés nem tud: a teljes német piacról választunk — így prémium használt vagy új <strong>autót Németországból</strong> hozhatsz haza, ellenőrzötten és kulcsrakészen.</p>
<p>Ha nem vásárolnál, <strong>tartós autóbérlettel</strong> is vezethetsz új prémium autót már 6 hónaptól, a meglévő autódat pedig <strong>bizományos értékesítéssel</strong> eladjuk helyetted. Irodánk Solymáron, Budapest mellett várja az ügyfeleket, de telefonon és e-mailben is gyorsan elérsz minket.</p>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Gyakori kérdések</span>
<h2 class="sec-title">Amit gyakran kérdeznek tőlünk</h2>
</div>
<div class="wrap mm-faqwrap">
{faqs.map((f) => (
<details class="mm-faq"><summary>{f.q}</summary><p>{f.a}</p></details>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Beszéljük meg, mit keresel.</h2>
<p>Vásárlás, tartós bérlet vagy behozatal Németországból — mondd el, milyen autóban gondolkodsz, és kérj személyre szabott ajánlatot.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Kapcsolatfelvétel →</a>
</div>
</div>
</section>
{jsonLdAll.map((j) => (<script type="application/ld+json" set:html={JSON.stringify(j)}></script>))}
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.el-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.zz{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0}
.zz + .zz{border-top:1px solid var(--line)}
.zz.flip .zz-media{order:2}
.zz-media{border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(8,8,10,.12);background:linear-gradient(135deg,#1a1d23,#3a3f4a);aspect-ratio:16/10}
.zz-media img{width:100%;height:100%;object-fit:cover;display:block}
.zz-media.noimg{position:relative}
.zz-media.noimg::after{content:"CarAdvance";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;letter-spacing:.08em;opacity:.5}
.zz-head{display:flex;align-items:center;gap:12px}
.zz-num{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:0 12px;border-radius:12px;background:var(--red);color:#fff;font-weight:800;font-size:18px;letter-spacing:-.02em}
.zz-ico{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:#FDECEE;color:var(--red)}
.zz-ico :global(svg){width:24px;height:24px}
.zz-text h3{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:16px 0 12px;color:var(--ink)}
.zz-text p{color:var(--muted);font-size:16px;line-height:1.65;margin:0}
.zz-text p :global(strong){color:var(--ink)}
.zz-link{display:inline-block;margin-top:14px;color:var(--red);font-weight:700;text-decoration:none}
.zz-link:hover{text-decoration:underline}
@media(max-width:820px){
.zz{grid-template-columns:1fr;gap:20px;padding:26px 0}
.zz.flip .zz-media{order:0}
}
.mm-stats{max-width:1080px;margin:22px auto 0;display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.mm-stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px}
.mm-stat-i{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:#FDECEE;color:var(--red);margin-bottom:6px}
.mm-stat-i :global(svg){width:24px;height:24px}
.mm-stat-n{font-size:clamp(20px,2.4vw,26px);font-weight:800;color:var(--red);letter-spacing:-.02em}
.mm-stat-l{color:var(--muted);font-size:13.5px;line-height:1.4}
@media(max-width:1000px){.mm-stats{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.mm-stats{grid-template-columns:1fr 1fr}}
.mm-cmp-wrap{max-width:1080px;margin:18px auto 0;overflow-x:auto;border-radius:18px;border:1px solid var(--line);background:#fff}
.mm-cmp{width:100%;border-collapse:collapse;font-size:15px;min-width:640px}
.mm-cmp th,.mm-cmp td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;color:var(--muted)}
.mm-cmp thead th{background:#0B0B0D;color:#fff;font-weight:700}
.mm-cmp thead th.us{background:var(--red)}
.mm-cmp tbody th{color:var(--ink);font-weight:700;white-space:nowrap}
.mm-cmp td.us{color:var(--ink);font-weight:700;background:#FFF5F6}
.mm-cmp tr:last-child th,.mm-cmp tr:last-child td{border-bottom:0}
:global(.mm-ck){width:18px;height:18px;color:#0E9F6E;vertical-align:-3px;margin-right:6px;flex:0 0 18px;display:inline-block}
.mm-check{max-width:1080px;margin:18px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.mm-check-i{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;gap:12px;align-items:flex-start}
.mm-check-ic{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:#E8F7F0;flex:0 0 34px}
.mm-check-ic :global(svg){margin:0}
.mm-check-i h3{font-size:16px;font-weight:800;color:var(--ink);margin:4px 0 6px}
.mm-check-i p{color:var(--muted);font-size:14.5px;line-height:1.55;margin:0}
@media(max-width:900px){.mm-check{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.mm-check{grid-template-columns:1fr}}
.mm-seo{max-width:1080px;margin:22px auto 0;background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px 26px}
.mm-seo p{color:var(--muted);font-size:15.5px;line-height:1.7;margin:0 0 12px}
.mm-seo p:last-child{margin:0}
.mm-seo strong{color:var(--ink)}
.mm-faqwrap{max-width:1080px;margin:8px auto 0;display:flex;flex-direction:column;gap:12px}
.mm-faq{background:#fff;border:1px solid var(--line);border-radius:14px;padding:2px 20px}
.mm-faq summary{cursor:pointer;font-weight:700;color:var(--ink);padding:16px 0;list-style:none}
.mm-faq summary::-webkit-details-marker{display:none}
.mm-faq[open] summary{color:var(--red)}
.mm-faq p{color:var(--muted);line-height:1.65;margin:0 0 16px}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
</style>
