---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const IMG = 'https://www.caradvance.hu/';
const benefits = [
{ t: 'A piac legjobb ára', img: IMG + 'elony-01-piac-ara.webp',
d: 'A német piacon egyszerre több százezer autó verseng a vevőkért, és ez a hatalmas kínálat folyamatosan lenyomja az árakat. Nálunk nem a szűkös hazai készletből kell választanod: a teljes német piacot átnézzük helyetted, összehasonlítjuk a hirdetéseket, és pontosan azt az autót szerezzük meg a lehető legjobb áron, amit kerestél. A behozatal, a vám és a teljes ügyintézés minden költségével együtt is gyakran kedvezőbben jársz, mint egy hasonló felszereltségű, hasonló korú autóval idehaza — ráadásul jobb állapotban és megbízhatóbb, dokumentált előélettel.' },
{ t: 'Német új vagy alig használt autók', img: IMG + 'elony-02-allapot.webp',
d: 'Kizárólag német, új vagy alig használt, kifogástalan állapotú autókat hozunk — semmi kompromisszum. A német autók mögött gondos karbantartás, minőségi utak, fegyelmezett szervizkultúra és átlátható, dokumentált előélet áll, így ugyanazért a pénzért lényegesen megbízhatóbb és hosszabb élettartamú autót kapsz. Minden darabot alaposan ellenőrzünk, mielőtt megvásároljuk, hogy makulátlan műszaki és esztétikai állapotban érkezzen hozzád. Nem a szerencsére bízzuk: pontosan tudjuk, mit veszünk, és pontosan azt kapod, amire számítasz — kellemetlen meglepetések és utólagos költségek nélkül.' },
{ t: 'Végigkísérünk — az átvétel után is', img: IMG + 'elony-03-vegigkiserunk.webp',
d: 'Az első beszélgetéstől a kulcsátadásig végig melletted állunk. Segítünk kiválasztani a hozzád és a költségvetésedhez illő autót, felkutatjuk a piacon, lebonyolítjuk a teljes vásárlást, intézzük a behozatalt, a vámot, a forgalomba helyezést és a teljes papírmunkát — neked gyakorlatilag csak a döntés marad. De a munkánk nem ér véget az átadással: az átvétel után is bármikor számíthatsz ránk, legyen szó szervizről, egy felmerülő kérdésről vagy a következő autóról. Egy hosszú távú partnert kapsz, nem csak egy egyszeri közvetítőt.' },
{ t: 'A sajátod — minden előnnyel, km-korlát nélkül', img: IMG + 'elony-04-km-korlat.webp',
d: 'Az autó teljes egészében a tiéd, minden tulajdonosi előnnyel és szabadsággal. Nincs kilométer-korlát, nincs havi limit, nincs büntetődíj a túlfutásért: annyit vezetsz vele, amennyit csak szeretnél, és oda mész, ahová akarsz. Nem kötnek bérleti feltételek, kötelező szervizhálózatok vagy visszaadási elvárások — te döntesz mindenről, az első naptól kezdve. Átalakíthatod, felszerelheted, kölcsönadhatod vagy épp továbbadhatod: a saját autódról szabadon rendelkezel. Ez a valódi tulajdonlás nyugalma, mindenféle rejtett megkötés nélkül.' },
{ t: 'Bármikor továbbértékesítheted', img: IMG + 'elony-05-eladhato.webp',
d: 'Mivel az autó a sajátod, bármikor eladhatod vagy továbbértékesítheted — nem köt hosszú távú bérleti vagy lízingszerződés, és nem kell a futamidő végét kivárnod. Ha változik az életed, az igényed vagy egyszerűen csak új autóra vágysz, szabadon léphetsz. Ráadásul a jó állapotú, dokumentált előéletű német autók a hazai piacon is keresettek és jól tartják az értéküket, így egy átgondolt vásárlás később komoly összeget hozhat vissza. Te döntesz az autód sorsáról — mi pedig a következő beszerzésben is szívesen segítünk.' },
{ t: '19% német áfa — magánszemélyként is', img: IMG + 'elony-06-afa.webp',
d: 'Magánszemélyként is vásárolhatsz tőlünk a müncheni Caradvance GmbH-n keresztül, akár 19%-os német áfával a hazai 27% helyett — ez önmagában több százezer forintos megtakarítást jelenthet. A teljes folyamatot mi bonyolítjuk le szabályosan és átláthatóan: a német számlázástól a magyar forgalomba helyezésig minden lépést intézünk, neked nem kell a bürokráciával bajlódnod. Így a kedvezőbb adótartalom nem elméleti lehetőség marad, hanem valós, forintban is érezhető előny — az autó pedig még kedvezőbb végösszegen lehet a tiéd.' },
];

const faqs = [
['Miért érdemes tőletek autót venni?', 'A teljes német piacot átnézzük helyetted, és a lehető legjobb áron szerezzük meg a kiválasztott autót — kizárólag kifogástalan állapotú, dokumentált előéletű darabokat. Az autó a sajátod lesz, minden tulajdonosi előnnyel, és magánszemélyként akár 19%-os német áfával vásárolhatsz. A behozatalt és a teljes papírmunkát kulcsrakészen intézzük.'],
['Tényleg kedvezőbb, mint itthon vásárolni?', 'Jellemzően igen: a hatalmas német kínálat lenyomja az árakat, a 19%-os német áfa pedig magánszemélyként is jelentős megtakarítás a hazai 27%-hoz képest. Még a behozatallal és a teljes ügyintézéssel együtt is gyakran kedvezőbben jársz, mint egy hasonló korú és felszereltségű autóval a hazai piacon — ráadásul jobb állapotban.'],
['Az autó tényleg a sajátom lesz?', 'Igen, teljes egészében a tiéd, minden tulajdonosi előnnyel. Nincs kilométer-korlát, nincs bérleti kötöttség: annyit vezetsz vele, amennyit csak szeretnél, és bármikor eladhatod vagy továbbértékesítheted. Szabadon rendelkezel az autódról az első naptól kezdve.'],
['Mit jelent a 19% német áfa?', 'Magánszemélyként is vásárolhatsz a müncheni Caradvance GmbH-n keresztül, így a hazai 27% helyett akár 19%-os német áfával juthatsz autóhoz. Ez a különbség több százezer forintos megtakarítást jelenthet — a teljes folyamatot szabályosan és átláthatóan mi bonyolítjuk le.'],
['Ti intézitek a behozatalt és a papírokat is?', 'Igen, kulcsrakészen: kiválasztás, helyszíni bevizsgálás, megvásárlás, szállítás, honosítás, műszaki vizsga és a teljes papírmunka — mindent mi vállalunk. Neked csak át kell venned a nevedre írt, forgalomba helyezett autót, és az átvétel után is bármikor számíthatsz ránk.'],
];
const faqJson = {
'@context': 'https://schema.org', '@type': 'FAQPage',
mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const serviceJson = {
'@context': 'https://schema.org', '@type': 'Service',
name: 'Prémium autó vásárlás Németországból — Caradvance',
serviceType: 'Prémium használt és új autók beszerzése Németországból, kulcsrakészen',
areaServed: { '@type': 'Country', name: 'Magyarország' },
url: 'https://www.caradvance.hu/vasarlas-elonyei/',
provider: { '@type': 'AutoDealer', name: 'Caradvance Hungary (BH Group Zrt.)', telephone: '+36 30 233 6060', email: 'import@caradvance.de' },
};
---
<section class="el">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<div class="partners" style="display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap">
<img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" style="height:34px;width:auto;display:block;border-radius:6px" />
<img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" style="height:34px;width:auto;display:block;border-radius:6px" />
</div>
<h1>A vásárlás előnyei —<br /><span class="accent">miért tőlünk vedd?</span></h1>
<p class="sub sub-wide" style="max-width:900px">Prémium német autók a legjobb piaci áron, kulcsrakész behozatallal — és a sajátodként, minden tulajdonosi előnnyel. Mutatjuk, miért éri meg tőlünk vásárolni a következő&nbsp;autódat.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/egyedi-auto-rendeles">Autók böngészése</a>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px">
<div class="wrap center">
<span class="eyebrow">A vásárlás előnyei</span>
<h2 class="sec-title">Miért érdemes tőlünk autót venni?</h2>
<p class="sec-intro">A legjobb ártól a kulcsrakész átadásig — hat ok, amiért nálunk jó kezekben van a következő autód.</p>
</div>
<div class="wrap el-wrap">
{benefits.map((b, i) => (
<div class={`zz${i % 2 ? ' flip' : ''}`}>
<div class="zz-media"><img src={b.img} alt={b.t} loading="lazy" onerror="this.closest('.zz-media').classList.add('noimg')" /></div>
<div class="zz-text">
<span class="zz-num">{String(i + 1).padStart(2, '0')}</span>
<h3>{b.t}</h3>
<p>{b.d}</p>
</div>
</div>
))}
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Készen állsz? Találjuk meg a tökéletes autót.</h2>
<p>Böngéssz a modellek között, vagy mondd el, mit keresel — a többit mi intézzük, kulcsrakészen.</p>
</div>
<a class="btn btn-white" href="/egyedi-auto-rendeles">Autók böngészése →</a>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap el-seo">
<span class="eyebrow">Jó tudni</span>
<h2 class="el-seo-h">Prémium autó vásárlás Németországból — miért éri meg?</h2>
<p>A <strong>német autó vásárlás</strong> a magyar vevők egyik legkedvezőbb választása: a <span class="kw">legnagyobb német piactereken</span> (mobile.de, AutoScout24) egyszerre több százezer autó érhető el, így pontosan azt a márkát, felszereltséget és színt találjuk meg, amit keresel — a lehető legjobb piaci áron.</p>
<p>Nálunk a <span class="kw">német autó behozatal</span> nem a te feladatod: a kiválasztástól a helyszíni bevizsgáláson át a magyar forgalomba helyezésig mindent kulcsrakészen intézünk. Az autó a sajátod lesz, kilométer-korlát nélkül, minden tulajdonosi előnnyel — és bármikor szabadon továbbértékesítheted.</p>
<p>Magánszemélyként akár 19%-os német áfával vásárolhatsz a müncheni Caradvance GmbH-tól a hazai 27% helyett — jobb állapotú, dokumentált előéletű autó, gyakran kedvezőbb végösszegen.</p>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések</h2>
</div>
<div class="wrap el-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
<script type="application/ld+json" set:html={JSON.stringify(serviceJson)}></script>
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.el-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.zz{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0}
.zz + .zz{border-top:1px solid var(--line)}
.zz.flip .zz-media{order:2}
.zz-media{border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(8,8,10,.12);background:linear-gradient(135deg,#1a1d23,#3a3f4a);aspect-ratio:16/10}
.zz-media img{width:100%;height:100%;object-fit:cover;display:block}
.zz-media.noimg{position:relative}
.zz-media.noimg::after{content:"CarAdvance";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;letter-spacing:.08em;opacity:.5}
.zz-num{display:inline-flex;align-items:center;justify-content:center;min-width:44px;height:44px;padding:0 12px;border-radius:12px;background:var(--red);color:#fff;font-weight:800;font-size:18px;letter-spacing:-.02em}
.zz-text h3{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:16px 0 12px;color:var(--ink)}
.zz-text p{color:var(--muted);font-size:16px;line-height:1.65;margin:0}
@media(max-width:820px){
.zz{grid-template-columns:1fr;gap:20px;padding:26px 0}
.zz.flip .zz-media{order:0}
}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
.el-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px;padding-bottom:20px}
.el-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.el-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.el-faq summary::-webkit-details-marker{display:none}
.el-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.el-faq details[open] .pl{transform:rotate(45deg)}
.el-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.el-seo{max-width:820px;margin:0 auto}
.el-seo-h{font-size:clamp(24px,3.4vw,34px);font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:10px 0 18px}
.el-seo p{color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 16px}
.el-seo strong{color:var(--ink);font-weight:700}
.el-seo .kw{color:var(--red);font-weight:700}
</style>
