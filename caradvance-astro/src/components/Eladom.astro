      'Mazda': ['2','3','5','6','323','626','MX-3','MX-5','MX-30','RX-8','CX-3','CX-30','CX-5','CX-7','CX-60','CX-9','Premacy','Tribute','BT-50'],
      'Nissan': ['Micra','Note','Leaf','Juke','Qashqai','Qashqai+2','X-Trail','Murano','Ariya','Pulsar','Almera','Primera','Maxima','370Z','350Z','GT-R','Navara','Pathfinder','Patrol','Townstar','NV200','Terrano','Pixo'],
      'Honda': ['Jazz','Civic','Accord','Insight','HR-V','CR-V','ZR-V','CR-Z','e','e:Ny1','Legend','Prelude','S2000','NSX','FR-V','Stream','Logo'],
      'Suzuki': ['Alto','Celerio','Swift','Splash','Ignis','Baleno','SX4','SX4 S-Cross','S-Cross','Vitara','Grand Vitara','Across','Jimny','Wagon R+','Liana','Kizashi','Samurai'],
      'Fiat': ['500','500C','500X','500L','500e','Panda','Punto','Grande Punto','Tipo','Bravo','Stilo','Doblo','Qubo','Fiorino','Freemont','Multipla','Sedici','Croma','Ducato','Talento','Scudo','Idea','Linea','Seicento','Marea'],
      'SEAT': ['Mii','Ibiza','Cordoba','Leon','Toledo','Arona','Ateca','Tarraco','Alhambra','Altea','Altea XL','Exeo'],
      'Cupra': ['Leon','Formentor','Born','Ateca','Tavascan','Terramar'],
      'Mini': ['One','Cooper','Cooper S','Clubman','Countryman','Paceman','Cabrio','Coupe','Roadster','Electric'],
      'Jaguar': ['XE','XF','XJ','XK','S-Type','X-Type','E-Pace','F-Pace','I-Pace','F-Type'],
      'Alfa Romeo': ['MiTo','Giulietta','147','156','159','166','Giulia','Brera','Spider','GT','GTV','Stelvio','Tonale','Junior','4C','8C'],
      'Dacia': ['Sandero','Logan','Duster','Jogger','Spring','Lodgy','Dokker','Nova'],
      'Abarth': ['500','595','695','124 Spider','Punto','Grande Punto'],
      'Aston Martin': ['DB7','DB9','DB11','DBS','Vantage','Vanquish','Rapide','DBX','Virage'],
      'Bentley': ['Continental','Continental GT','Flying Spur','Bentayga','Arnage','Mulsanne','Azure','Brooklands'],
      'BYD': ['Atto 3','Dolphin','Seal','Han','Tang','Seal U','Sealion 7'],
      'Cadillac': ['CTS','ATS','STS','SRX','Escalade','XT4','XT5','BLS','Eldorado','Seville'],
      'Chevrolet': ['Spark','Aveo','Cruze','Lacetti','Kalos','Captiva','Orlando','Trax','Camaro','Corvette','Malibu','Epica','Matiz','Tacuma','Trailblazer'],
      'Chrysler': ['300C','PT Cruiser','Voyager','Grand Voyager','Sebring','Crossfire','Pacifica','Neon','300M'],
      'Dodge': ['Nitro','Journey','Caliber','Charger','Challenger','Durango','RAM','Avenger','Viper'],
      'DS': ['DS 3','DS 3 Crossback','DS 4','DS 5','DS 7','DS 7 Crossback','DS 9'],
      'Ferrari': ['California','Portofino','Roma','488','458','F8','812','SF90','296','Purosangue','599','612','FF','F12','Testarossa'],
      'Infiniti': ['Q30','Q50','Q60','Q70','QX30','QX50','QX70','FX','EX','G37'],
      'Isuzu': ['D-Max','Trooper','Rodeo'],
      'Jeep': ['Renegade','Compass','Cherokee','Grand Cherokee','Wrangler','Avenger','Commander','Patriot','Gladiator'],
      'Lada': ['Niva','Vesta','Granta','Kalina','Priora','Samara','110','2107','Largus'],
      'Lamborghini': ['Huracán','Aventador','Gallardo','Urus','Murciélago','Revuelto','Countach'],
      'Lancia': ['Ypsilon','Delta','Musa','Thema','Thesis','Lybra','Phedra'],
      'Maserati': ['Ghibli','Quattroporte','Levante','GranTurismo','GranCabrio','Grecale','MC20','3200 GT','Coupé'],
      'MG': ['MG3','MG4','MG5','ZS','HS','Marvel R','Cyberster','TF','ZR','ZT'],
      'Mitsubishi': ['Colt','Lancer','Space Star','Mirage','ASX','Eclipse Cross','Outlander','Pajero','Pajero Pinin','L200','Grandis','Galant','Carisma','Space Runner','i-MiEV'],
      'Rover': ['25','45','75','200','400','600','Streetwise','City Rover'],
      'Saab': ['9-3','9-5','9000','900','9-4X','9-7X'],
      'Smart': ['ForTwo','ForFour','Roadster','Crossblade','#1','#3'],
      'SsangYong': ['Tivoli','Korando','Rexton','Musso','XLV','Kyron','Actyon','Rodius'],
      'Subaru': ['Impreza','Legacy','Outback','Forester','XV','Crosstrek','BRZ','Levorg','Justy','Tribeca','WRX','Trezia'],
    };
    const makeSel = document.getElementById('f-make');
    const modelSel = document.getElementById('f-model');
    const fillModels = () => {
      const data = MODELS[makeSel.value];
      const has = !!data && (Array.isArray(data) ? data.length : Object.keys(data).length);
      modelSel.innerHTML = '';
      const ph = document.createElement('option');
      ph.value = ''; ph.disabled = true; ph.selected = true;
      ph.textContent = has ? 'Válassz modellt…' : 'Nincs lista — írd a Típusjelbe';
      modelSel.appendChild(ph);
      const addOpt = (parent, m) => { const o = document.createElement('option'); o.textContent = m; parent.appendChild(o); };
      if (Array.isArray(data)) {
        data.forEach((m) => addOpt(modelSel, m));
      } else if (data) {
        Object.keys(data).forEach((grp) => {
          const og = document.createElement('optgroup'); og.label = grp;
          data[grp].forEach((m) => addOpt(og, m));
          modelSel.appendChild(og);
        });
      }
      const other = document.createElement('option'); other.textContent = 'Egyéb (nincs a listában)'; modelSel.appendChild(other);
      modelSel.disabled = false;
    };
    const updateCompare = () => {
      const mk = val('f-make');
      let md = val('f-model'); if (md.startsWith('Egyéb')) md = '';
      const hu = document.getElementById('cmp-hu');
      const mo = document.getElementById('cmp-mobile');
      if (hu && mk && mk !== 'Egyéb') {
        let u = 'https://www.hasznaltauto.hu/szemelyauto/' + slug(mk);
        if (md) u += '/' + slug(md);
        hu.href = u;
      }
      if (mo && (mk || md)) {
        mo.href = 'https://suchen.mobile.de/fahrzeuge/search.html?dam=false&isSearchRequest=true&ref=quickSearch&s=Car&sb=rel&vc=Car&q=' + encodeURIComponent(((mk === 'Egyéb' ? '' : mk) + ' ' + md).trim());
      }
    };
    makeSel?.addEventListener('change', () => { fillModels(); updateCompare(); });
    modelSel?.addEventListener('change', updateCompare);

    // Élő bizományi díj + jótékony felajánlás kalkulátor
    const fmt = (n) => Math.round(n).toLocaleString('hu-HU') + ' Ft';
    const priceEl = document.getElementById('f-price');
    const calc = document.getElementById('sfCalc');
    const feeEl = document.getElementById('calcFee');
    const ngoEl = document.getElementById('calcNgo');
    const noteEl = document.getElementById('calcNote');
    const updateCalc = () => {
      if (!calc) return;
      const p = parseInt((priceEl.value || '').replace(/\D/g, ''), 10) || 0;
      if (!p) { calc.hidden = true; return; }
      calc.hidden = false;
      noteEl.className = 'sf-calc-note';
      if (p < 4000000) {
        feeEl.textContent = '—'; ngoEl.textContent = '—';
        noteEl.className = 'sf-calc-note warn';
        noteEl.textContent = '4 millió Ft alatti autókkal jelenleg sajnos nem tudunk foglalkozni.';
        return;
      }
      if (p >= 15000000) {
        const lo = p * 0.03, hi = p * 0.04;
        feeEl.textContent = fmt(lo) + ' – ' + fmt(hi);
        ngoEl.textContent = fmt(lo * 0.3) + ' – ' + fmt(hi * 0.3);
        noteEl.textContent = 'Egyedi megállapodás (3–4%). A díj 30%-a a választott szervezetet támogatja.';
        return;
      }
      let fee, pct;
      if (p < 6000000) { fee = Math.max(p * 0.08, 390000); pct = '8% (min. 390 000 Ft)'; }
      else if (p < 10000000) { fee = p * 0.06; pct = '6%'; }
      else { fee = p * 0.05; pct = '5%'; }
      feeEl.textContent = fmt(fee) + ' · ' + pct;
      ngoEl.textContent = fmt(fee * 0.3);
      noteEl.textContent = 'A bizományi díjunk 30%-át a választott szervezetnek ajánljuk fel.';
    };
    const formatPrice = () => {
      const digits = (priceEl.value || '').replace(/\D/g, '');
      priceEl.value = digits ? digits.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : '';
      updateCalc();
    };
    priceEl?.addEventListener('input', formatPrice);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const rows = [
        ['Márka', val('f-make')], ['Modell', val('f-model')], ['Típusjel', val('f-type')], ['Évjárat', val('f-year')],
        ['Futásteljesítmény (km)', val('f-km')], ['Üzemanyag', val('f-fuel')], ['Szín', val('f-color')], ['Állapot', val('f-cond')],
        ['Megjegyzés', val('f-notes')],
        ['Kért ár (Ft)', val('f-price')], ['Ár rugalmassága', val('f-flex')], ['Sürgősség', val('f-urgency')],
        ['Támogatott szervezet', val('f-ngo')],
        ['Név', val('f-name')], ['E-mail', val('f-email')], ['Telefon', val('f-phone')],
      ].filter(([, v]) => v);
      const title = (val('f-make') + ' ' + val('f-model')).trim() + (val('f-year') ? ' (' + val('f-year') + ')' : '');
      const subject = 'Autó eladás – ' + (title || 'érdeklődés');
      const body = 'Szeretném eladni az autómat a CarAdvance-en keresztül. Az adataim:\n\n'
        + rows.map(([k, v]) => k + ': ' + v).join('\n')
        + '\n\nKérlek, küldjetek egy személyre szabott eladási ársávot. Köszönöm!';
      window.location.href = 'mailto:info@caradvance.hu?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  }
</script>
