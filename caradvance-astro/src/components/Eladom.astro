---
import '../styles/eladom.css';
import { useTranslations, type Locale } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';
import { eladomContent } from '../data/eladom';

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const c = eladomContent(lang);

const pills: { key: UIKey; href: string }[] = [
  { key: 'pill.charity', href: '#jotekonysag' },
  { key: 'pill.why', href: '#miert' },
  { key: 'pill.media', href: '#foto-video' },
  { key: 'pill.alone', href: '#egyedul' },
  { key: 'pill.how', href: '#folyamat' },
  { key: 'pill.team', href: '#csapat' },
  { key: 'pill.faq', href: '#gyik' },
];

const heart = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21z"/></svg>';
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>';
const cross = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6 6 18M6 6l12 12"/></svg>';
const play = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg>';
const chevL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6"/></svg>';
const chevR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18 15 12 9 6"/></svg>';

const ILLO: Record<string, string> = {
  house: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><circle cx="252" cy="40" r="22" fill="#fff" fill-opacity=".4"/><g fill="#fff"><circle cx="118" cy="98" r="15" fill-opacity=".32"/><rect x="115" y="98" width="6" height="28" fill-opacity=".32"/><circle cx="94" cy="106" r="11" fill-opacity=".28"/><rect x="91.5" y="106" width="5" height="22" fill-opacity=".28"/><rect x="166" y="82" width="76" height="54" rx="5" fill-opacity=".95"/><path d="M160 84 204 51 248 84Z"/></g><path d="M204 98c-3-3.6-8.6-2-8.6 2.4 0 3.5 5.3 6.7 8.6 8.7 3.3-2 8.6-5.2 8.6-8.7 0-4.4-5.6-6-8.6-2.4z" fill="#E2001A"/></svg>',
  food: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><g fill="#fff"><circle cx="196" cy="72" r="17" fill-opacity=".9"/><circle cx="228" cy="76" r="13" fill-opacity=".8"/><circle cx="245" cy="67" r="9" fill-opacity=".85"/><path d="M150 92h134a67 67 0 0 1-134 0z" fill-opacity=".95"/><ellipse cx="217" cy="92" rx="67" ry="9" fill-opacity=".6"/></g></svg>',
  tent: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><circle cx="256" cy="40" r="18" fill="#fff" fill-opacity=".45"/><g fill="#fff" fill-opacity=".85"><circle cx="120" cy="42" r="2.5"/><circle cx="152" cy="62" r="2"/><circle cx="292" cy="74" r="2"/></g><path d="M120 122 186 60 252 122Z" fill="#fff" fill-opacity=".22"/><path d="M198 132 242 74 286 132Z" fill="#fff" fill-opacity=".95"/></svg>',
  cross: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><path d="M220 30 272 47v36c0 32-21 55-52 65-31-10-52-33-52-65V47z" fill="#fff" fill-opacity=".95"/><g fill="#9c2b2b"><rect x="208" y="76" width="24" height="9" rx="1"/><rect x="215.5" y="68.5" width="9" height="24" rx="1"/></g></svg>',
  paw: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><g fill="#fff" fill-opacity=".9"><circle cx="196" cy="66" r="13"/><circle cx="226" cy="56" r="13"/><circle cx="256" cy="66" r="13"/><ellipse cx="226" cy="102" rx="28" ry="24"/></g></svg>',
  plus: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><circle cx="228" cy="80" r="46" fill="#fff" fill-opacity=".2"/><rect x="219" y="56" width="18" height="50" rx="6" fill="#fff" fill-opacity=".95"/><rect x="203" y="72" width="50" height="18" rx="6" fill="#fff" fill-opacity=".95"/></svg>',
  shield: '<svg viewBox="0 0 320 152" preserveAspectRatio="xMidYMid slice"><path d="M228 30 280 47v36c0 32-21 55-52 65-31-10-52-33-52-65V47z" fill="#fff" fill-opacity=".95"/><path d="M228 76c-4.5-5.5-14-3-14 4.4 0 6 8.6 11.4 14 14.6 5.4-3.2 14-8.6 14-14.6 0-7.4-9.5-9.9-14-4.4z" fill="#4b5563"/></svg>',
};

const FEATURE_ICONS: Record<string, string> = {
  video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>',
  reach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M5 12a7 7 0 0 1 7-7M12 19a7 7 0 0 0 7-7"/></svg>',
  price: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
  doc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13l2 2 4-4"/></svg>',
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  heart: heart,
};

const makes = ['Audi','BMW','Mercedes-Benz','Volkswagen','Porsche','Toyota','Ford','Opel','Škoda','Volvo','Land Rover','Range Rover','Lexus','Tesla','Hyundai','Kia','Renault','Peugeot','Citroën','Mazda','Nissan','Honda','Suzuki','Fiat','SEAT','Cupra','Mini','Jaguar','Alfa Romeo','Dacia','Egyéb'];
const years = Array.from({ length: 2026 - 1995 + 1 }, (_, i) => 2026 - i);
const fuels = ['Benzin','Dízel','Hibrid','Plug-in hibrid','Elektromos','LPG/Benzin'];
const gears = ['Manuális','Automata'];
const bodies = ['Ferdehátú','Sedan/Limuzin','Kombi','Coupé','Kabrió','SUV/Terepjáró','Egyterű','Pickup'];
const conds = ['Kiváló','Jó','Átlagos','Felújítandó'];
---
<!-- HERO -->
<section class="hero">
  <video autoplay muted loop playsinline preload="auto" poster="https://caradvance.hu/caradvance-hero-x5-poster.jpg">
    <source src="https://caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
  </video>
  <div class="scrim"></div>
  <div class="inner">
    <div class="partners">
      <img class="partner-strip" src="/partner-logos.png" alt="CarAdvance · Használtautó.hu · mobile.de" />
    </div>
    <h1>{t('eladom.title1')}<br /><span class="accent">{t('eladom.title2')}</span></h1>
    <p class="sub sub-wide">{t('eladom.sub')}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="mailto:info@caradvance.hu?subject=Auto%20eladas">{t('eladom.cta')}</a>
      <a class="btn btn-white" href="#folyamat">Hogyan működik?</a>
    </div>
  </div>
  <button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<!-- STATS + PLATFORMS -->
<section class="section" style="padding-top:24px">
  <div class="wrap">
    <div class="stats">
      {c.stats.map((s) => (
        <div class="stat"><div class="num">{s.num}<span>{s.unit}</span></div><div class="lbl">{s.label}</div></div>
      ))}
    </div>
    <div class="platforms">
      <div class="plabel">{c.platformsLabel}</div>
      <div class="row">
        <img src="https://caradvance.hu/caradvance-logo.webp" alt="CarAdvance" />
        <img src="https://caradvance.hu/hasznaltauto-hu.webp" alt="Használtautó.hu" />
        <img src="https://caradvance.hu/mobile-de.webp" alt="mobile.de" />
        <span class="divider"></span>
        <span class="socials">
          <img src="https://caradvance.hu/facebook.webp" alt="Facebook" />
          <img src="https://caradvance.hu/instagram.webp" alt="Instagram" />
          <img src="https://caradvance.hu/tiktok.webp" alt="TikTok" />
          <img src="https://caradvance.hu/youtube.webp" alt="YouTube" onerror="this.style.display='none'" />
        </span>
      </div>
    </div>
  </div>
</section>

<!-- ÉRTÉKBECSLÉS / ADATLAP -->
<section class="section" id="ertekbecsles" style="padding-top:12px">
  <div class="wrap center">
    <span class="eyebrow">Ingyenes &amp; kötelezettségmentes</span>
    <h2 class="sec-title">Mondd el, milyen autód van</h2>
    <p class="sec-intro">Add meg az autód főbb adatait, és személyre szabott, reális eladási ársávot küldünk — a Használtautó.hu és a mobile.de hasonló hirdetéseivel összevetve. Néhány adat is elég a kezdéshez.</p>
  </div>
  <div class="wrap">
    <form class="sf" id="sellForm">
      <div class="sf-grid">
        <label class="sf-field"><span>Márka</span>
          <select id="f-make" required>
            <option value="" disabled selected>Válassz…</option>
            {makes.map((m) => <option>{m}</option>)}
          </select>
        </label>
        <label class="sf-field"><span>Modell</span>
          <input id="f-model" type="text" placeholder="pl. X5, A4, Passat" />
        </label>
        <label class="sf-field"><span>Évjárat</span>
          <select id="f-year">
            <option value="" disabled selected>Válassz…</option>
            {years.map((y) => <option>{y}</option>)}
          </select>
        </label>
        <label class="sf-field"><span>Futásteljesítmény (km)</span>
          <input id="f-km" type="number" min="0" step="1000" placeholder="pl. 120000" />
        </label>
      </div>
      <div class="sf-grid">
        <label class="sf-field"><span>Mennyiért adnád el? (Ft)</span>
          <input id="f-price" type="number" min="0" step="50000" placeholder="pl. 8 500 000" />
        </label>
        <label class="sf-field"><span>Ár rugalmassága</span>
          <select id="f-flex">
            <option value="" disabled selected>Válassz…</option>
            <option>Fix ár</option>
            <option>Kis mértékben alkuképes</option>
            <option>Alkuképes</option>
            <option>Nincs elképzelésem — segítsetek</option>
          </select>
        </label>
      </div>

      <details class="sf-more">
        <summary><span>Részletes adatok megadása</span><span class="sf-chev">⌄</span></summary>
        <div class="sf-grid">
          <label class="sf-field"><span>Üzemanyag</span><select id="f-fuel"><option value="" disabled selected>Válassz…</option>{fuels.map((x) => <option>{x}</option>)}</select></label>
          <label class="sf-field"><span>Váltó</span><select id="f-gear"><option value="" disabled selected>Válassz…</option>{gears.map((x) => <option>{x}</option>)}</select></label>
          <label class="sf-field"><span>Teljesítmény (LE)</span><input id="f-power" type="number" min="0" placeholder="pl. 249" /></label>
          <label class="sf-field"><span>Karosszéria</span><select id="f-body"><option value="" disabled selected>Válassz…</option>{bodies.map((x) => <option>{x}</option>)}</select></label>
          <label class="sf-field"><span>Állapot</span><select id="f-cond"><option value="" disabled selected>Válassz…</option>{conds.map((x) => <option>{x}</option>)}</select></label>
          <label class="sf-field"><span>Szín</span><input id="f-color" type="text" placeholder="pl. metálszürke" /></label>
        </div>
        <label class="sf-field sf-full"><span>Megjegyzés, felszereltség, extrák</span><textarea id="f-notes" rows="3" placeholder="pl. vezetett szervizkönyv, téli-nyári gumi, tetőablak, sérülésmentes…"></textarea></label>
      </details>

      <div class="sf-compare">
        <div class="sf-compare-t">Nézd meg a hasonló autók árait</div>
        <div class="sf-compare-btns">
          <a id="cmp-hu" class="sf-cmp" href="https://www.hasznaltauto.hu/szemelyauto" target="_blank" rel="noopener">Hasonló autók a Használtautó.hu-n →</a>
          <a id="cmp-mobile" class="sf-cmp" href="https://www.mobile.de/s/auto?dam=false&vc=Car" target="_blank" rel="noopener">Hasonló autók a mobile.de-n →</a>
        </div>
        <p class="sf-note">Az adataid alapján a két legnagyobb piac (Használtautó.hu + mobile.de) aktuális hirdetéseivel összevetve küldünk egy reális eladási ársávot.</p>
      </div>

      <div class="sf-ngo">
        <div class="sf-ngo-head">
          <div class="sf-ngo-badge">30%</div>
          <div>
            <div class="sf-ngo-t">Válaszd ki, melyik ügyet támogatod</div>
            <div class="sf-ngo-s">A jutalékunk 30%-át a Te választott szervezetednek ajánljuk fel — minden sikeres eladás után.</div>
          </div>
        </div>
        <select id="f-ngo" class="sf-field-select">
          <option value="" disabled selected>Válassz szervezetet…</option>
          {c.charity.orgs.map((o) => <option>{o.name}</option>)}
          <option>Bízom a CarAdvance választásában</option>
        </select>
      </div>

      <div class="sf-grid" style="margin-top:20px">
        <label class="sf-field"><span>Neved</span><input id="f-name" type="text" placeholder="Teljes név" required /></label>
        <label class="sf-field"><span>E-mail</span><input id="f-email" type="email" placeholder="pelda@email.hu" required /></label>
        <label class="sf-field"><span>Telefonszám</span><input id="f-phone" type="tel" placeholder="+36 …" /></label>
      </div>

      <div class="sf-submit-row">
        <button type="submit" class="btn btn-primary" id="sellSubmit">Elküldöm az adatokat →</button>
        <span class="sf-submit-note">Kötelezettségmentes. Hamarosan jelentkezünk az ársávval.</span>
      </div>
    </form>
  </div>
</section>

<!-- JÓTÉKONYSÁG -->
<section class="section" id="jotekonysag" style="background:#F7F4F2">
  <div class="wrap center">
    <span class="eyebrow">{c.charity.eyebrow}</span>
    <h2 class="sec-title">{c.charity.title}</h2>
    <p class="sec-intro">{c.charity.intro}</p>
  </div>
  <div class="wrap">
    <div class="give-card">
      <div>
        <div class="big">{c.charity.bigNum}<span>{c.charity.bigUnit}</span></div>
        <div class="biglbl">{c.charity.bigLabel}</div>
      </div>
      <div>
        <h3>{c.charity.cardTitle}</h3>
        <p>{c.charity.cardText}</p>
        <a class="give-pill" href="#folyamat"><Fragment set:html={heart} /> {c.charity.cardCta}</a>
      </div>
    </div>
    <div class="charity-wrap">
      <button class="ch-arrow prev" type="button" aria-label="Előző"><Fragment set:html={chevL} /></button>
      <button class="ch-arrow next" type="button" aria-label="Következő"><Fragment set:html={chevR} /></button>
      <div class="charity-scroll" id="charityScroll">
        {c.charity.orgs.map((o) => (
          <div class="ch-card">
            <div class="ch-head" style={`background:${o.color}`}>
              <span class="ch-illo" set:html={ILLO[o.icon]}></span>
              <span class="ch-corner"><Fragment set:html={heart} /></span>
              <span class="ch-tag">{o.tag}</span>
            </div>
            <div class="ch-body"><div class="ch-logo"><img src={o.logo} alt={o.name} /></div><h4>{o.name}</h4><p>{o.text}</p></div>
            <div class="ch-foot">
              <div class="ch-support"><Fragment set:html={heart} /> {c.charity.supports}</div>
              <a class="ch-link" href="#">{c.charity.orgLink} <Fragment set:html={arrow} /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <p class="give-note">{c.charity.note}</p>
  </div>
</section>

<!-- MIÉRT VELÜNK -->
<section class="section" id="miert">
  <div class="wrap center">
    <span class="eyebrow">{c.why.eyebrow}</span>
    <h2 class="sec-title">{c.why.title}</h2>
    <p class="sec-intro">{c.why.intro}</p>
  </div>
  <div class="wrap">
    <div class="feat-grid">
      {c.why.features.map((f) => (
        <div class="feat">
          <div class="ico"><Fragment set:html={FEATURE_ICONS[f.icon]} /></div>
          <h4>{f.title}</h4><p>{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PROFI FOTÓ ÉS VIDEÓ -->
<section class="section photo" id="foto-video">
  <div class="wrap">
    <div class="photo-grid">
      <div>
        <span class="eyebrow">{c.photo.eyebrow}</span>
        <h2 class="sec-title">{c.photo.title}</h2>
        <p class="sec-intro" style="margin-bottom:0">{c.photo.intro}</p>
        <ul class="checklist">
          {c.photo.checks.map((ck) => (
            <li><span class="check"><Fragment set:html={check} /></span><div><b>{ck.title}</b><span>{ck.text}</span></div></li>
          ))}
        </ul>
        <a class="btn btn-primary" href="mailto:info@caradvance.hu?subject=Video">{c.photo.cta}</a>
      </div>
      <div class="video-card">
        <span class="vtag"><Fragment set:html={heart} /> {c.photo.videoTag}</span>
        <img src="https://caradvance.hu/bmw-m3-touring-premium-auto-eladas.webp" alt={c.photo.videoTitle} />
        <span class="play"><Fragment set:html={play} /></span>
        <span class="vmeta"><b>{c.photo.videoTitle}</b><span>{c.photo.videoBy}</span></span>
      </div>
    </div>
  </div>
</section>

<!-- VIDEÓINK -->
<section class="section videos">
  <div class="wrap center">
    <span class="eyebrow">{c.videos.eyebrow}</span>
    <h2 class="sec-title">{c.videos.title}</h2>
    <p class="sec-intro">{c.videos.intro}</p>
  </div>
  <div class="wrap">
    <div class="vgrid">
      {c.videos.items.map((v) => (
        <div class="vthumb"><span class="badge">{v.badge}</span><span class="play"><Fragment set:html={play} /></span><span class="cap">{v.caption}</span></div>
      ))}
    </div>
    <div class="follow-row">
      <a class="follow-btn" href="#"><img src="https://caradvance.hu/instagram.webp" alt="" />{c.videos.followIg}</a>
      <a class="follow-btn" href="#"><img src="https://caradvance.hu/tiktok.webp" alt="" />{c.videos.followTt}</a>
    </div>
  </div>
</section>

<!-- GALÉRIA -->
<section class="section" id="galeria">
  <div class="wrap center">
    <span class="eyebrow">{c.gallery.eyebrow}</span>
    <h2 class="sec-title">{c.gallery.title}</h2>
    <p class="sec-intro">{c.gallery.intro}</p>
  </div>
  <div class="wrap">
    <div class="gal-grid">
      {c.gallery.items.map((g) => (
        <div class="gal"><span class="ph">{g}</span><span class="lbl">{g}</span></div>
      ))}
    </div>
  </div>
</section>

<!-- EGYEDÜL VAGY VELÜNK -->
<section class="section compare" id="egyedul">
  <div class="wrap center">
    <span class="eyebrow">{c.compare.eyebrow}</span>
    <h2 class="sec-title">{c.compare.title}</h2>
    <p class="sec-intro">{c.compare.intro}</p>
  </div>
  <div class="wrap">
    <div class="ctable">
      <div class="crow chead">
        <div class="col-label">—</div>
        <div class="col-label">{c.compare.colAlone}</div>
        <div class="col-us">{c.compare.colUs}</div>
      </div>
      {c.compare.rows.map((r) => (
        <div class="crow">
          <div class="c-aspect">{r.aspect}</div>
          <div class="c-alone"><span class="mark x"><Fragment set:html={cross} /></span>{r.alone}</div>
          <div class="c-us"><span class="mark v"><Fragment set:html={check} /></span>{r.us}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- HÉT LÉPÉS -->
<section class="section steps" id="folyamat">
  <div class="wrap center">
    <span class="eyebrow">{c.steps.eyebrow}</span>
    <h2 class="sec-title">{c.steps.title}</h2>
    <p class="sec-intro">{c.steps.intro}</p>
  </div>
  <div class="wrap">
    <div class="step-grid">
      {c.steps.items.map((s, i) => (
        <div class={`step${s.highlight ? ' full' : ''}`}>
          <div class="n">{i + 1}</div>
          <div><h4>{s.title}</h4><p>{s.text}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ZÁRÓ CTA -->
<section class="close-cta">
  <h2>{c.closing.title}</h2>
  <p>{c.closing.text}</p>
  <a class="btn btn-primary" href="mailto:info@caradvance.hu?subject=Auto%20eladas">{c.closing.cta}</a>
</section>

<script>
  const sc = document.getElementById('charityScroll');
  if (sc) {
    const step = () => Math.min(sc.clientWidth * 0.85, 352);
    document.querySelector('.ch-arrow.prev')?.addEventListener('click', () => sc.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.querySelector('.ch-arrow.next')?.addEventListener('click', () => sc.scrollBy({ left: step(), behavior: 'smooth' }));
  }

  const form = document.getElementById('sellForm');
  if (form) {
    const val = (id) => (document.getElementById(id)?.value || '').trim();
    const slug = (s) => s.toLowerCase()
      .replace(/á/g, 'a').replace(/é/g, 'e').replace(/í/g, 'i').replace(/ó/g, 'o').replace(/ö/g, 'o').replace(/ő/g, 'o').replace(/ú/g, 'u').replace(/ü/g, 'u').replace(/ű/g, 'u').replace(/ä/g, 'a')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const updateCompare = () => {
      const mk = val('f-make'), md = val('f-model');
      const hu = document.getElementById('cmp-hu');
      const mo = document.getElementById('cmp-mobile');
      if (hu && mk && mk !== 'Egyéb') {
        let u = 'https://www.hasznaltauto.hu/szemelyauto/' + slug(mk);
        if (md) u += '/' + slug(md);
        hu.href = u;
      }
      if (mo && (mk || md)) {
        mo.href = 'https://suchen.mobile.de/fahrzeuge/search.html?dam=false&isSearchRequest=true&ref=quickSearch&s=Car&sb=rel&vc=Car&q=' + encodeURIComponent(((mk === 'Egyéb' ? '' : mk) + ' ' + md).trim());
      }
    };
    document.getElementById('f-make')?.addEventListener('change', updateCompare);
    document.getElementById('f-model')?.addEventListener('input', updateCompare);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const rows = [
        ['Márka', val('f-make')], ['Modell', val('f-model')], ['Évjárat', val('f-year')],
        ['Futásteljesítmény (km)', val('f-km')], ['Kért ár (Ft)', val('f-price')], ['Ár rugalmassága', val('f-flex')],
        ['Üzemanyag', val('f-fuel')], ['Váltó', val('f-gear')], ['Teljesítmény (LE)', val('f-power')],
        ['Karosszéria', val('f-body')], ['Állapot', val('f-cond')], ['Szín', val('f-color')],
        ['Megjegyzés', val('f-notes')], ['Támogatott szervezet', val('f-ngo')],
        ['Név', val('f-name')], ['E-mail', val('f-email')], ['Telefon', val('f-phone')],
      ].filter(([, v]) => v);
      const title = (val('f-make') + ' ' + val('f-model')).trim() + (val('f-year') ? ' (' + val('f-year') + ')' : '');
      const subject = 'Autó eladás – ' + (title || 'érdeklődés');
      const body = 'Szeretném eladni az autómat a CarAdvance-en keresztül. Az adataim:\n\n'
        + rows.map(([k, v]) => k + ': ' + v).join('\n')
        + '\n\nKérlek, küldjetek egy személyre szabott eladási ársávot. Köszönöm!';
      window.location.href = 'mailto:info@caradvance.hu?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  }
</script>
