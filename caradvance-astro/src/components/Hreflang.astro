---
import { liveLocales, defaultLang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
const { path = '/' } = Astro.props;
// Kanonikus alak: www + záró perjel (egyezik a canonical linkkel).
const site = 'https://www.caradvance.hu';
const slash = (p: string) => (p.endsWith('/') ? p : p + '/');
// Csak az élő (lefordított) nyelvek — fordítatlan vagy nem létező nyelvi oldalra nem mutatunk.
---
{liveLocales.map((loc) => (
  <link rel="alternate" hreflang={loc} href={site + slash(localizedPath(loc, path))} />
))}
<link rel="alternate" hreflang="x-default" href={site + slash(localizedPath(defaultLang, path))} />
