---
// /operativ-lizing/ — operatív lízing magyarázó + tartós bérlet alternatíva (adatvezérelt autólista)
import '../styles/eladom.css';
import { allRentals, fmt } from '../data/tartosBerlet';
const SITE = 'https://www.caradvance.hu';
const cars = allRentals();
const pick = ['bmw-x1', 'bmw-x3', 'mercedes-benz-glc', 'audi-q5-sportback', 'bmw-5-os-touring', 'mercedes-benz-c-osztaly', 'volkswagen-tiguan', 'audi-q4-sportback-e-tron'];
const top = pick.map((s) => cars.find((c) => c.slug === s)).filter(Boolean) as any[];
const min = cars.length ? cars[0].huf : 0;
const href = (c: any) => `/berelheto-auto/${c.slug}-berles/`;

const rows: [string, string, string, string][] = [
  ['Kinek szól?', 'főleg cégeknek, flottáknak', 'cégeknek és magánszemélyeknek', 'cégeknek és magánszemélyeknek'],
  ['Futamidő', 'jellemzően 24–60 hónap', 'jellemzően 12–84 hónap', 'nálunk már 6 hónaptól'],
  ['Önerő', 'gyakran van (vagy magasabb díj)', 'jellemzően 10–30%', 'nincs, csak visszajáró kaució'],
  ['Kié az autó?', 'a lízingcégé, a végén visszaadod', 'a végén a tiéd lehet', 'a bérbeadóé, a végén visszaadod'],
  ['Maradványérték-kockázat', 'a lízingcégé', 'nyíltvégűnél részben a tiéd', 'nincs'],
  ['Szerviz, gumi, biztosítás', 'full service konstrukcióban benne', 'külön fizeted', 'a díjban benne'],
  ['Futáskeret', 'évente rögzített, túlfutási díj', 'nincs korlát', 'havi 2 000–4 000 km (autótól függően)'],
  ['Korai kiszállás', 'jellemzően drága', 'előtörlesztéssel', 'rövid futamidő, kisebb kockázat'],
];

const faqs: [string, string][] = [
  ['Mi az operatív lízing?', 'Az operatív lízing bérleti jellegű konstrukció: a lízingcég megveszi az autót és meghatározott futamidőre (jellemzően 2–5 évre) használatba adja, havidíjért. Az autó végig a lízingcég tulajdonában marad, a futamidő végén visszaadod. Full service változatban a díj a szervizt, a gumit és a biztosítást is tartalmazza.'],
  ['Mi a különbség az operatív és a pénzügyi lízing között?', 'Pénzügyi lízingnél az autót gyakorlatilag részletre veszed meg: a futamidő végén a tiéd lehet (zártvégűnél automatikusan, nyíltvégűnél választásod szerint). Operatív lízingnél az autó soha nem lesz a tiéd — csak a használatért fizetsz, és a maradványérték kockázata a lízingcégé.'],
  ['Igénybe vehető operatív lízing magánszemélyként?', 'A legtöbb hazai szolgáltató elsősorban cégeknek kínálja. Magánszemélyeknek a tartós bérlet a hasonló, rugalmasabb megoldás — nálunk már 6 hónapos futamidőtől, önerő nélkül.'],
  ['Mi a különbség az operatív lízing és a tartós bérlet között?', 'A lényeg hasonló (használatért fizetsz, a végén visszaadod), de a tartós bérlet rövidebb kötöttséggel, önerő nélkül és rugalmasabb modellváltással működik. Az operatív lízing jellemzően hosszabb, 3–5 éves szerződés.'],
  ['Hogyan számolható ki az operatív lízing díja?', 'A havidíj fő elemei: az autó értékvesztése a futamidő alatt (beszerzési ár mínusz várható maradványérték), a finanszírozási költség, valamint full service esetén a szerviz, a gumi és a biztosítás. Tartós bérletnél ezt nem kell számolnod: a lenti kalkulátor fix, valós havidíjakkal mutatja a teljes költséget.'],
  ['Elszámolható a díj a cégben?', 'Az operatív lízing és a tartós bérlet díja is a vállalkozás költségei között számolható el. Személygépkocsinál az áfa levonhatósága korlátozott, és cégautóadó is felmerülhet — a pontos kezelésről egyeztess a könyvelőddel.'],
];
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const faqJson = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: strip(a) } })) };
const crumbJson = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Főoldal', item: SITE + '/' },
  { '@type': 'ListItem', position: 2, name: 'Operatív lízing', item: SITE + '/operativ-lizing/' }] };
const calc = cars.map((c) => ({ n: c.name, h: c.huf, d: c.depHuf, m: Math.min(...(c.months.length ? c.months : [6])) }));
---
<section class="ol">
<section class="hero">
<video autoplay muted loop playsinline preload="metadata" poster="/finanszirozas-hero-poster.jpg"><source src="/finanszirozas-hero.mp4" type="video/mp4" /></video>
<div class="scrim"></div>
<div class="inner">
<h1>Operatív lízing —<br /><span class="accent">vagy a rugalmasabb tartós bérlet?</span></h1>
<p class="sub sub-wide">Mi az operatív lízing, mennyibe kerül, kinek éri meg — és mikor jobb választás a tartós bérlet, ahol {fmt(min)} Ft/hó-tól, önerő nélkül, már 6 hónapra kapsz új autót.</p>
<div class="cta-row"><a class="btn btn-primary" href="#osszehasonlitas">Összehasonlítás</a><a class="btn btn-white" href="#kalkulator">Kalkulátor</a></div>
</div>
</section>

<section class="section"><div class="wrap ol-text">
<span class="eyebrow">Operatív lízing</span>
<h2>Mi az operatív lízing?</h2>
<p>Az <strong>operatív lízing</strong> egy bérleti jellegű finanszírozási forma: a lízingcég megvásárolja az autót, és meghatározott futamidőre — jellemzően 24–60 hónapra — havidíjért használatba adja. Az autó végig a lízingcég tulajdonában (és könyveiben) marad, a futamidő végén pedig visszaadod. A havidíj alapja az autó várható értékvesztése, ezért a maradványérték kockázatát a lízingcég viseli.</p>
<p>Gyakori a <strong>full service operatív lízing</strong>, ahol a díj a szervizt, a gumicserét és a biztosítást is tartalmazza. Cserébe hosszú a kötöttség, a futáskeret évente rögzített, és a szerződés idő előtti felbontása általában drága. Ezért a legtöbb szolgáltató elsősorban cégeknek és flottáknak kínálja.</p>
<h2>Operatív lízing, pénzügyi lízing vagy tartós bérlet?</h2>
<p>A <a href="/finanszirozas-lizing/">pénzügyi lízingnél</a> (nyíltvégű vagy zártvégű) az autó a futamidő végén a tiéd lehet — ez gyakorlatilag részletvásárlás. Az operatív lízing és a <a href="/tartos-berlet/">tartós bérlet</a> ezzel szemben használati díj: nem tulajdont szerzel, hanem mindig új autóval jársz. A különbség a rugalmasságban van:</p>
</div></section>

<section class="section" id="osszehasonlitas" style="padding-top:0"><div class="wrap ol-text">
<div class="ol-tw"><table class="ol-table">
<thead><tr><th></th><th>Operatív lízing</th><th>Pénzügyi lízing</th><th>Tartós bérlet (CarAdvance)</th></tr></thead>
<tbody>{rows.map(([a, b, c, d]) => (<tr><td>{a}</td><td>{b}</td><td>{c}</td><td class="hl">{d}</td></tr>))}</tbody>
</table></div>
<p class="ol-note">Általános, tájékoztató összevetés — a konkrét feltételek szolgáltatónként és szerződésenként eltérnek.</p>
<h2>Mikor melyiket válaszd?</h2>
<ul>
<li><strong>Operatív lízing</strong> — ha cégként 3–5 évre tervezel, nagyobb flottád van, és biztos vagy a futáskeretben.</li>
<li><strong>Pénzügyi lízing</strong> — ha az autót a futamidő végén a sajátodnak szeretnéd. Számold ki a <a href="/finanszirozas-lizing/">lízing kalkulátorral</a>.</li>
<li><strong>Tartós bérlet</strong> — ha rugalmasság kell: rövid kötöttség, nincs önerő, minden költség a díjban, és bármikor válthatsz modellt. Magánszemélyeknek is elérhető.</li>
</ul>
</div></section>

<section class="section" style="padding-top:0">
<div class="wrap center"><span class="eyebrow">Az operatív lízing alternatívája</span><h2 class="sec-title">Népszerű autók tartós bérletben</h2>
<p class="sec-intro">Valós nettó havidíjak, szervizzel, adóval, biztosítással és gumival — már 6 hónapos futamidőtől.</p></div>
<div class="wrap ol-grid">{top.map((c) => (
<a class="ol-card" href={href(c)}><img src={c.photo} alt={`${c.name} tartós bérlet`} loading="lazy" width="480" height="300" />
<div><b>{c.name}</b><span>{fmt(c.huf)} Ft/hó nettó-tól · kaució {fmt(c.dep)} €</span></div></a>))}
</div>
<div class="wrap center" style="margin-top:18px"><a class="btn btn-primary" href="/tartos-berlet/">Mind a {cars.length} bérelhető autó →</a></div>
</section>

<section class="section" id="kalkulator" style="padding-top:8px">
<div class="wrap center"><span class="eyebrow">Kalkulátor</span><h2 class="sec-title">Operatív lízing helyett: tartós bérlet kalkulátor</h2>
<p class="sec-intro">Fix, valós havidíjakkal — nincs maradványérték, nincs rejtett költség.</p></div>
<div class="wrap ol-calc">
<div class="ol-cf">
<label>Modell<select id="olm">{calc.map((c, i) => <option value={i}>{c.n} — {fmt(c.h)} Ft/hó</option>)}</select></label>
<label>Futamidő<select id="olt"><option value="6">6 hónap</option><option value="12">12 hónap</option><option value="24" selected>24 hónap</option><option value="36">36 hónap</option><option value="48">48 hónap</option></select></label>
<label>Bérlő<select id="olw"><option value="c">Cég (nettó)</option><option value="p">Magánszemély (19% áfával)</option></select></label>
</div>
<div class="ol-cr"><div><span>Havidíj</span><b id="olr1">—</b></div><div><span>Teljes díj</span><b id="olr2">—</b></div><div><span>Visszajáró kaució</span><b id="olr3">—</b></div></div>
<p class="ol-note">Tájékoztató számítás a jelenlegi havidíjakból. Hosszabb futamidőre egyedi ajánlatot adunk.</p>
<a class="btn btn-primary" href="/kapcsolat">Ajánlatot kérek</a>
</div>
<script type="application/json" id="oldata" set:html={JSON.stringify(calc)}></script>
<script is:inline>(function(){var d=JSON.parse(document.getElementById('oldata').textContent||'[]');var m=document.getElementById('olm'),t=document.getElementById('olt'),w=document.getElementById('olw');if(!m)return;function f(n){return Math.round(n).toLocaleString('hu-HU')+' Ft';}function r(){var c=d[+m.value];if(!c)return;var k=w.value==='p'?1.19:1,mo=Math.max(+t.value,c.m),h=Math.ceil(c.h*k/1000)*1000;document.getElementById('olr1').textContent=f(h);document.getElementById('olr2').textContent=f(h*mo)+' / '+mo+' hó';document.getElementById('olr3').textContent=f(c.d);}[m,t,w].forEach(function(x){x.addEventListener('change',r);});r();})();</script>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center"><span class="eyebrow">GYIK</span><h2 class="sec-title">Gyakori kérdések az operatív lízingről</h2></div>
<div class="wrap ol-faq">{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p set:html={a} /></details>))}</div>
<div class="wrap ol-rl">
<a href="/tartos-berlet/">Tartós bérlet →</a><a href="/tartos-berlet/#cegeknek">Tartós bérlet cégeknek →</a><a href="/tartos-berlet/#maganszemelyeknek">Magánszemélyeknek →</a>
<a href="/finanszirozas-lizing/">Autó lízing kalkulátor →</a><a href="/blog/zart-vegu-nyilt-vegu-lizing">Zártvégű vagy nyíltvégű lízing? →</a><a href="/blog/ceges-auto-operativ-lizing-tartos-berlet">Céges autó: lízing vagy bérlet →</a>
</div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
<script type="application/ld+json" set:html={JSON.stringify(crumbJson)}></script>
</section>

<style>
.ol{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.ol .wrap{max-width:1160px;margin:0 auto;padding:0 20px}
.ol-text{max-width:900px}
.ol-text p,.ol-text li{color:#3d4656;font-size:16px;line-height:1.7}
.ol-text p{margin:0 0 14px}.ol-text ul{padding-left:20px}
.ol-text h2{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:26px 0 12px}
.ol-text a,.ol-faq a{color:var(--red);font-weight:600}
.ol-tw{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:#fff}
.ol-table{width:100%;border-collapse:collapse;font-size:14.5px}
.ol-table th,.ol-table td{padding:11px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.ol-table th{background:#F6F7FA;font-size:13px;color:var(--muted)}
.ol-table td:first-child{font-weight:700;color:var(--ink)}
.ol-table .hl{background:#fff5f6;color:var(--ink);font-weight:600}
.ol-note{font-size:13px;color:#667}
.ol-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.ol-card{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit}
.ol-card img{width:100%;aspect-ratio:16/10;object-fit:cover;background:#F4F6FA;display:block}
.ol-card div{padding:12px 14px}.ol-card b{display:block;color:var(--ink)}.ol-card span{font-size:13px;color:var(--muted)}
.ol-calc{max-width:860px;background:#fff;border:1px solid var(--line);border-radius:22px;padding:22px}
.ol-cf{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}
.ol-cf label{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:700;color:var(--muted)}
.ol-cf select{height:46px;border:1px solid #dfe3ea;border-radius:12px;padding:0 12px;font:inherit;font-size:15px;background:#fff}
.ol-cr{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0}
.ol-cr div{background:#F6F7FA;border-radius:14px;padding:14px}.ol-cr span{display:block;font-size:12.5px;color:var(--muted)}.ol-cr b{font-size:18px;font-weight:800;color:var(--ink)}
.ol-faq{max-width:860px;display:flex;flex-direction:column;gap:10px}
.ol-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.ol-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.ol-faq summary::-webkit-details-marker{display:none}
.ol-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.ol-faq details[open] .pl{transform:rotate(45deg)}
.ol-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.ol-rl{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.ol-rl a{background:#fff;border:1px solid var(--line);border-radius:999px;padding:10px 16px;text-decoration:none;color:var(--ink);font-weight:700;font-size:14px}
.ol-rl a:hover{border-color:var(--red);color:var(--red)}
@media(max-width:820px){.ol-grid{grid-template-columns:repeat(2,1fr)}.ol-cf{grid-template-columns:1fr}.ol-cr{grid-template-columns:1fr}}
</style>
