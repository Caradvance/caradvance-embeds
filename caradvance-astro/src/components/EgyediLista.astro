          '<div class="egl-meta"><span class="egl-brand">'+logoHtml+'</span><span class="egl-year">2026 · Németország</span></div>'+
          '<div class="egl-name">'+c.name+'</div>'+
          '<div class="egl-specs">'+specLine(c)+'</div>'+
          '<div class="egl-price">'+priceHtml+'</div>'+
        '</div>'+
      '</a>'+
      '<div class="egl-actions">'+
        '<a class="egl-btn" href="'+href+'">Részletek</a>'+
        '<button class="egl-order" type="button" data-name="'+att(c.name)+'" data-img="'+att(img)+'" data-spec="'+att(specLine(c))+'" data-price="'+att(priceLine)+'" data-fuels="'+att(fuelList.join(','))+'">Autót rendelek</button>'+
      '</div>';
    return a;
  }

  var grid=document.getElementById('eglGrid');
  var q=document.getElementById('eglQ'), fb=document.getElementById('eglBody'), ff=document.getElementById('eglFuel'), fbr=document.getElementById('eglBrand'), fcls=document.getElementById('eglClass');

  var mhero=document.getElementById('eglMHero');
  var filtersEl=document.querySelector('.egl-filters');
  var filtersHomeParent=filtersEl?filtersEl.parentNode:null, filtersHomeNext=document.getElementById('eglCount');
  var textHeroEls=[document.querySelector('.egl-crumb'), document.getElementById('eglTitle'), document.getElementById('eglSub')];
  function setBrandHero(br){
    if(!mhero) return;
    var isMini=(br==='MINI'), isMB=(br==='MB'), isBMW=(br==='BMW');
    if(isMini||isMB||isBMW){
      var vid=mhero.querySelector('.egl-mhero-vid'), src=vid&&vid.querySelector('source');
      var logo=mhero.querySelector('.egl-mhero-logos img');
      var h1=mhero.querySelector('.egl-mhero-h1'), sub=mhero.querySelector('.egl-mhero-sub');
      if(isMB){
        if(src) src.setAttribute('src','/mercedes-hero.mp4'); if(vid) vid.removeAttribute('poster');
        if(logo){ logo.src='/mb-star.webp'; logo.alt='Mercedes-Benz'; }
        if(h1) h1.textContent='Egyedi Mercedes-Benz rendelés';
        if(sub) sub.textContent='Új Mercedes-Benz modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.';
        mhero.classList.add('egl-mhero-mb');
      } else if(isBMW){
        if(src) src.setAttribute('src','/caradvance-hero-x5.mp4'); if(vid) vid.setAttribute('poster','/caradvance-hero-x5-poster.jpg');
        if(logo){ logo.src='/bmw/bmw-logo.webp'; logo.alt='BMW'; }
        if(h1) h1.textContent='Egyedi BMW rendelés';
        if(sub) sub.textContent='Új BMW modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.';
        mhero.classList.remove('egl-mhero-mb');
      } else {
        if(src) src.setAttribute('src','/mini-JCW-family-video-wide.mp4'); if(vid) vid.setAttribute('poster','/mini-jcw-hero-poster.jpg');
        if(logo){ logo.src='/mini-hero-logo.webp'; logo.alt='Mini Cooper'; }
        if(h1) h1.textContent='Egyedi Mini Cooper rendelés';
        if(sub) sub.textContent='Új Mini Cooper és John Cooper Works modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.';
        mhero.classList.remove('egl-mhero-mb');
      }
      try{ if(vid){ vid.load(); var p=vid.play&&vid.play(); if(p&&p.catch) p.catch(function(){}); } }catch(e){}
      mhero.style.display='';
      textHeroEls.forEach(function(e){ if(e) e.style.display='none'; });
      if(filtersEl) filtersEl.style.display = isMini ? 'none' : '';
    } else {
      mhero.style.display='none';
      textHeroEls.forEach(function(e){ if(e) e.style.display=''; });
      if(filtersEl) filtersEl.style.display='';
    }
  }

  function mbClass(c){ var n=c.name;
    if(/S-osztály/.test(n))return'S-osztály'; if(/A-osztály/.test(n))return'A-osztály'; if(/B-osztály/.test(n))return'B-osztály';
    if(/C-osztály/.test(n))return'C-osztály'; if(/E-osztály/.test(n))return'E-osztály'; if(/CLE/.test(n))return'CLE';
    if(/GLA/.test(n))return'GLA'; if(/GLB/.test(n))return'GLB'; if(/GLC/.test(n))return'GLC'; if(/GLE/.test(n))return'GLE'; return'Egyéb'; }
  var MBORDER=['A-osztály','B-osztály','C-osztály','E-osztály','S-osztály','CLE','GLA','GLB','GLC','GLE'];
  function bmwSeries(c){ var n=c.name;
    if(/\b1-es\b/.test(n))return'1-es'; if(/\b2-es\b|\bM2\b/.test(n))return'2-es'; if(/\b3-as\b|\bM3\b/.test(n))return'3-as';
    if(/\b4-es\b|\bi4\b|\bM4\b/.test(n))return'4-es'; if(/\b5-ös\b|\bi5\b|\bM5\b/.test(n))return'5-ös'; if(/\b7-es\b|\bi7\b|M760/.test(n))return'7-es';
    if(/\bXM\b/.test(n))return'XM'; if(/iX1|X1\b/.test(n))return'X1'; if(/iX2|X2\b/.test(n))return'X2'; if(/iX3|X3\b/.test(n))return'X3';
    if(/iX5|X5\b/.test(n))return'X5'; if(/X6\b/.test(n))return'X6'; if(/X7\b/.test(n))return'X7'; if(/\biX\b/.test(n))return'iX';
    if(/\bi3\b/.test(n))return'3-as'; if(/Z4/.test(n))return'Z4'; return'Egyéb'; }
  var BMWORDER=['1-es','2-es','3-as','4-es','5-ös','7-es','iX','X1','X2','X3','X5','X6','X7','XM'];
  function isGrouped(br){ return br==='MB'||br==='BMW'; }
  function groupOf(c,br){ return br==='MB'?mbClass(c):(br==='BMW'?bmwSeries(c):''); }
  function groupOrder(br){ return br==='MB'?MBORDER:(br==='BMW'?BMWORDER:[]); }
  function classLabel(br){ return br==='MB'?'Minden osztály':(br==='BMW'?'Minden modell':''); }

  var HERO={
    'BMW':{crumb:'BMW',title:'Egyedi BMW rendelés',intro:'Új BMW modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'},
    'MINI':{crumb:'MINI',title:'Egyedi MINI rendelés',intro:'Új MINI modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'},
    'MB':{crumb:'Mercedes-Benz',title:'Egyedi Mercedes-Benz rendelés',intro:'Új Mercedes-Benz modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'},
    '':{crumb:'Egyedi autó rendelés',title:'Egyedi autó rendelés',intro:'Új BMW, MINI és Mercedes-Benz modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'}
  };
  var PH={'BMW':'Keresés (pl. X5, i4)…','MINI':'Keresés (pl. Cooper, Countryman)…','MB':'Keresés (pl. E-osztály, GLC)…','':'Keresés (pl. X5, Cooper)…'};
  function applyHero(br){
    var h=HERO[br]||HERO[''];
    var t=document.getElementById('eglTitle'); if(t) t.textContent=h.title;
    var c=document.getElementById('eglCrumbCur'); if(c) c.textContent=h.crumb;
    var fxEl=document.getElementById('eglFx'); var fx=fxEl?fxEl.textContent:'361';
    var s=document.getElementById('eglSub');
    if(s) s.innerHTML=h.intro+' Az árak tájékoztató német nettó listaárak, élő árfolyammal (1&nbsp;€ = <span id="eglFx">'+fx+'</span>&nbsp;Ft).';
    if(q) q.placeholder = PH[br]||PH[''];
    var bw=document.getElementById('eglBrandWrap'), cw=document.getElementById('eglClassWrap');
    if(isGrouped(br)){
      if(bw)bw.style.display='none'; if(cw)cw.style.display='';
      if(fcls){ var ord=groupOrder(br), html='<option value="">'+classLabel(br)+'</option>'; ord.forEach(function(g){ html+='<option>'+g+'</option>'; }); fcls.innerHTML=html; }
    } else { if(bw)bw.style.display=''; if(cw)cw.style.display='none'; if(fcls)fcls.value=''; }
    setBrandHero(br);
  }

  function render(){
    var qq=(q.value||'').toLowerCase(), b=fb.value, f=ff.value, br=fbr.value, cl=(fcls?fcls.value:'');
    var grouped=isGrouped(br);
    var list=CARS.filter(function(c){
      if(c.hide) return false;
      if(qq && c.name.toLowerCase().indexOf(qq)===-1) return false;
      if(b && c.body!==b) return false;
      if(f && (c.fuels||[c.fuel]).indexOf(f)===-1) return false;
      if(br && (c.brand||'BMW')!==br) return false;
      if(grouped && cl && groupOf(c,br)!==cl) return false;
      return true;
    });
    grid.innerHTML='';
    if(grouped){
      var dot=(br==='BMW')?'#0166b1':'#00a3e0';
      groupOrder(br).forEach(function(gr){
        var g=list.filter(function(c){return groupOf(c,br)===gr;});
        if(!g.length) return;
        var hh=document.createElement('div'); hh.className='egl-section';
        hh.innerHTML='<span class="dot" style="background:'+dot+'"></span>'+gr+' <span class="cnt">'+g.length+' modell</span>';
        grid.appendChild(hh);
        g.forEach(function(c){ grid.appendChild(card(c)); });
      });
      document.getElementById('eglCount').textContent = list.length + ' modell';
      return;
    }
    var minis=list.filter(function(c){return c.brand==='MINI';});
    if(minis.length){
      var mh=document.createElement('div');
      mh.className='egl-section';
      mh.innerHTML='<span class="dot" style="background:#1b1b1b"></span>MINI <span class="cnt">'+minis.length+' modell</span>';
      grid.appendChild(mh);
      minis.forEach(function(c){ grid.appendChild(card(c)); });
    }
    var mbs=list.filter(function(c){return c.brand==='MB';});
    if(mbs.length){
      var mbh=document.createElement('div');
      mbh.className='egl-section';
      mbh.innerHTML='<span class="dot" style="background:#00a3e0"></span>Mercedes-Benz <span class="cnt">'+mbs.length+' modell</span>';
      grid.appendChild(mbh);
      mbs.forEach(function(c){ grid.appendChild(card(c)); });
    }
    var order=['Elektromos','Hibrid','Benzin','Dízel'];
    order.forEach(function(fuel){
      var group=list.filter(function(c){var br2=(c.brand||'BMW'); return br2!=='MINI' && br2!=='MB' && c.fuel===fuel;});
      if(!group.length) return;
      var h=document.createElement('div');
      h.className='egl-section';
      h.innerHTML='<span class="dot" style="background:'+(FUELC[fuel]||'#5A6B82')+'"></span>'+fuel+' <span class="cnt">'+group.length+' modell</span>';
      grid.appendChild(h);
      group.forEach(function(c){ grid.appendChild(card(c)); });
    });
    document.getElementById('eglCount').textContent = list.length + ' modell';
  }
  [q,fb,ff,fbr,fcls].forEach(function(el){ if(el){ el.addEventListener('input',render); el.addEventListener('change',render); } });
  fbr.addEventListener('change',function(){ applyHero(fbr.value); });
  try{var _qb=new URLSearchParams(location.search).get('brand'); if(_qb){ var _map={bmw:'BMW',mini:'MINI',mercedes:'MB',mb:'MB'}; fbr.value=(_map[_qb.toLowerCase()]||_qb); }}catch(e){}
  applyHero(fbr.value);
  render();
  function loadFx(){ try{
    fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=HUF').then(function(r){return r.json();}).then(function(d){
      if(d&&d.rates&&d.rates.HUF){ FX=Math.round(d.rates.HUF); var e=document.getElementById('eglFx'); if(e)e.textContent=FX; render(); }
    }).catch(function(){});
  }catch(e){} }
  loadFx();
  setInterval(loadFx, 3600000);

  // ---- order modal ----
  var ORDER_API = 'https://caradvance-chatbot.flat-fire-7e25.workers.dev/api/order';
  var SALES_EMAIL = 'info@caradvance.hu';
  var modal=document.getElementById('eglOrder');
  var oForm=document.getElementById('eglOrderForm');
  var oMsg=document.getElementById('eglOrderMsg');
  function showMsg(kind,txt){ if(oMsg){ oMsg.className='egl-fmsg '+kind; oMsg.textContent=txt; } }
  function openOrder(d){
    if(oForm) oForm.reset();
    setBuyer('Magánszemély');
    var im=document.getElementById('eglOrderImg'); if(im){ im.src=d.img||''; im.alt=d.name||''; }
    var set=function(id,v){ var e=document.getElementById(id); if(e) e.textContent=v||''; };
    set('eglOrderTitle',d.name); set('eglOrderPrice',d.price);
    var cc=document.getElementById('eglOrderCar'); if(cc) cc.value=d.name||'';
    // price "-tól" + info tooltip (only when a real price is shown)
    var info=document.getElementById('eglOrderInfo'), tip=document.getElementById('eglOrderTip'), tol=document.getElementById('eglOrderTol');
    var hasPrice=/\d/.test(d.price||'') && (d.price||'').indexOf('Ft')>-1;
    if(tol) tol.style.display=hasPrice?'':'none';
    if(info && tip){
      if(hasPrice){
        tip.innerHTML='Az árak nettó árak, élő árfolyammal (1&nbsp;€ = '+FX+'&nbsp;Ft). A végleges ár a választott felszereltségtől és az adott kedvezménytől függ. A képek csak illusztrációk.';
        info.style.display='';
      } else { info.style.display='none'; }
    }
    // fuel picker (adapts to the car)
    var fb2=document.getElementById('eglFuelBlock');
    if(fb2){
      var fuels=(d.fuels||'').split(',').map(function(x){return x.trim();}).filter(Boolean);
      var h='<div class="egl-flabel">1. Üzemanyag</div><div class="egl-fuelpick">';
      if(!fuels.length) fuels=[''];
      fuels.forEach(function(fu,i){ h+='<label class="egl-fuelopt'+(i===0?' active':'')+'"><input type="radio" name="fuel" value="'+att(fu)+'"'+(i===0?' checked':'')+' />'+'<span>'+(fu||'—')+'</span></label>'; });
      h+='</div>';
      if(fuels.length===1) h+='<p class="egl-fhint" style="margin:10px 0 0">Ehhez a modellhez ez az egyetlen elérhető hajtás.</p>';
      fb2.innerHTML=h;
    }
    var fin=document.getElementById('eglFinancing'); if(fin) fin.style.display='none';
    showMsg('','');
    if(modal){ modal.setAttribute('aria-hidden','false'); document.documentElement.style.overflow='hidden'; }
  }
  function closeOrder(){ if(modal){ modal.setAttribute('aria-hidden','true'); document.documentElement.style.overflow=''; } }
  var tgls=modal?modal.querySelectorAll('.egl-tgl'):[];
  function setBuyer(v){
    var be=document.getElementById('eglBuyer'); if(be) be.value=v;
    [].forEach.call(tgls,function(t){ t.classList.toggle('active', t.getAttribute('data-buyer')===v); });
    var isCo=(v==='Cég');
    var comp=document.getElementById('eglCompanyFields'); if(comp) comp.style.display=isCo?'':'none';
    var m1=document.getElementById('eglMode1'), m1l=document.getElementById('eglMode1Label');
    if(m1 && m1l){
      var txt=isCo?'Nettó EUR-ban, Németországból (Caradvance GmbH)':'19% német áfával, Németországból (Caradvance GmbH)';
      m1.value=txt; m1l.textContent=txt;
    }
  }
  [].forEach.call(tgls,function(t){ t.addEventListener('click',function(){ setBuyer(t.getAttribute('data-buyer')); }); });
  var fuelBlock=document.getElementById('eglFuelBlock');
  if(fuelBlock){ fuelBlock.addEventListener('change',function(){
    [].forEach.call(fuelBlock.querySelectorAll('.egl-fuelopt'),function(o){ var r=o.querySelector('input'); o.classList.toggle('active', !!(r&&r.checked)); });
  }); }
  if(oForm){ oForm.addEventListener('change',function(e){
    if(e.target && e.target.name==='payment'){
      var fin=document.getElementById('eglFinancing'); if(fin) fin.style.display=(e.target.value==='Finanszírozással')?'':'none';
    }
  }); }
  if(grid){ grid.addEventListener('click',function(e){
    var b=e.target.closest?e.target.closest('.egl-order'):null;
    if(!b) return; e.preventDefault();
    openOrder({name:b.getAttribute('data-name'),img:b.getAttribute('data-img'),spec:b.getAttribute('data-spec'),price:b.getAttribute('data-price'),fuels:b.getAttribute('data-fuels')});
  }); }
  if(modal){ modal.addEventListener('click',function(e){ if(e.target && e.target.hasAttribute && e.target.hasAttribute('data-close')) closeOrder(); }); }
  document.addEventListener('keydown',function(e){ if(e.key==='Escape' && modal && modal.getAttribute('aria-hidden')==='false') closeOrder(); });
  if(oForm){ oForm.addEventListener('submit',function(e){
    e.preventDefault();
    var fd=new FormData(oForm);
    var last=(fd.get('lastname')||'').trim(), first=(fd.get('firstname')||'').trim();
    var name=(last+' '+first).trim();
    var email=(fd.get('email')||'').trim(), mode=fd.get('mode');
    var buyer=fd.get('buyer'), company=(fd.get('company')||'').trim();
    if(buyer==='Cég' && !company){ showMsg('err','Kérlek add meg a cég nevét.'); return; }
    if(!last || !first || !email){ showMsg('err','Kérlek add meg a vezeték- és keresztneved, valamint az e-mail címed.'); return; }
    if(!mode){ showMsg('err','Kérlek válaszd ki, hogyan szeretnéd megvásárolni az autót.'); return; }
    var payment=fd.get('payment');
    if(!payment){ showMsg('err','Kérlek válaszd ki a fizetés módját.'); return; }
    if(payment==='Finanszírozással' && !fd.get('financing')){ showMsg('err','Kérlek válaszd ki a finanszírozás módját.'); return; }
    if(!fd.get('consent')){ showMsg('err','Kérlek fogadd el az adatkezelési tájékoztatót.'); return; }
    var btn=oForm.querySelector('.egl-fsubmit'); btn.disabled=true; btn.textContent='Küldés…';
    fetch(ORDER_API,{method:'POST',body:fd}).then(function(r){ if(!r.ok) throw 0; }).then(function(){
      showMsg('ok','Köszönjük! Megkaptuk a rendelési igényed — hamarosan keresünk.');
      oForm.reset(); setBuyer('Magánszemély'); btn.disabled=false; btn.textContent='Rendelés elküldése';
    }).catch(function(){
      var body='Autó: '+(fd.get('car')||'')+'\nÜzemanyag: '+(fd.get('fuel')||'')+'\nVásárló típusa: '+(buyer||'')+'\nVásárlás módja: '+(mode||'')+'\nFizetés: '+(payment||'')+'\nFinanszírozás: '+(fd.get('financing')||'')+'\nNév: '+name+'\nE-mail: '+email+'\nTelefon: '+(fd.get('phone')||'')+'\nCég: '+company+'\nAdószám: '+(fd.get('taxid')||'')+'\nMegjegyzés: '+(fd.get('message')||'');
      window.location.href='mailto:'+SALES_EMAIL+'?subject='+encodeURIComponent('Autó rendelés – '+(fd.get('car')||''))+'&body='+encodeURIComponent(body);
      showMsg('ok','Megnyitottuk az e-mail vázlatot. Ha van specifikációs fájlod, csatold az e-mailhez.');
      btn.disabled=false; btn.textContent='Rendelés elküldése';
    });
  }); }
})();
</script>
