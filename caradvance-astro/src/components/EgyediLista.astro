    {key:'x2',name:'BMW X2',body:'SUV Coupé',fuel:'Dízel',from:49200},
    {key:'x1b',name:'BMW X1',body:'SUV',fuel:'Dízel',from:47700},
    {key:'7erb',name:'BMW 7-es',body:'Limuzin',fuel:'Dízel',from:111900},
    {key:'5erb',name:'BMW 5-ös',body:'Limuzin',fuel:'Dízel',from:62300},
    {key:'5ertd',name:'BMW 5-ös Touring',body:'Touring',fuel:'Dízel',from:64300},
    {key:'4erc',name:'BMW 4-es Coupé',body:'Coupé',fuel:'Dízel',from:56700},
    {key:'m4d',name:'BMW 4-es Coupé M',body:'Coupé',fuel:'Dízel',from:78600},
    {key:'4ergcd',name:'BMW 4-es Gran Coupé',body:'Gran Coupé',fuel:'Dízel',from:56800},
    {key:'4ercab',name:'BMW 4-es Cabrio',body:'Cabrio',fuel:'Dízel',from:64300},
    {key:'m4cabd',name:'BMW 4-es Cabrio M',body:'Cabrio',fuel:'Dízel',from:86200},
    {key:'3er',name:'BMW 3-as',body:'Limuzin',fuel:'Dízel',from:51500},
    {key:'m3d',name:'BMW 3-as M',body:'Limuzin',fuel:'Dízel',from:77500},
    {key:'3ert',name:'BMW 3-as Touring',body:'Touring',fuel:'Dízel',from:52800},
    {key:'m3td',name:'BMW 3-as Touring M',body:'Touring',fuel:'Dízel',from:78800},
    {key:'2ercb',name:'BMW 2-es Coupé',body:'Coupé',fuel:'Dízel',from:53400},
    {key:'2ergcd',name:'BMW 2-es Gran Coupé',body:'Gran Coupé',fuel:'Dízel',from:42850},
    {key:'2eratb',name:'BMW 2-es Active Tourer',body:'Egyterű',fuel:'Dízel',from:42450},
    {key:'1erb',name:'BMW 1-es',body:'Kompakt',fuel:'Dízel',from:39350}
  ]);

  var NEW=['ix5-elektromos','ix3-elektromos','i7-elektromos','i7m-elektromos','i3-elektromos','x5h-hibrid','x5m-hibrid','e750-hibrid','m760e-hibrid','x5-benzin','x3-benzin','7erb-benzin','x5-dizel','x3m-dizel','7erb-dizel'];
  function slug(c){ return c.key+'-'+({'Benzin':'benzin','Dízel':'dizel','Hibrid':'hibrid','Elektromos':'elektromos'}[c.fuel]); }
  function specLine(c){ return c.body + ' · Automata · ' + c.fuel; }
  function isM(c){ return /(^|\s)(M\d\w*|M)(\s|$)/.test(c.name); }
  function card(c){
    var isMini = (c.brand==='MINI');
    var isMB = (c.brand==='MB');
    var img = c.img ? c.img : '/bmw/'+c.key+'.webp?v=6';
    var logoHtml;
    if(isMB){
      var isAMG = /AMG/.test(c.name);
      logoHtml = '<img class="egl-mblogo" src="/mb-star.webp?v=1" alt="Mercedes-Benz"/>' + (isAMG ? '<img class="egl-amglogo" src="/mb-logo.webp?v=2" alt="Mercedes-AMG"/>' : '');
    } else if(isMini){
      logoHtml = '<img class="egl-minilogo" src="/mini-logo.webp?v=3" alt="MINI"/>' + (c.logo==='jcw' ? '<img class="egl-jcwlogo" src="/jcw-logo.webp?v=3" alt="John Cooper Works"/>' : '');
    } else {
      logoHtml = '<img class="egl-bmw" src="/bmw/bmw-logo.webp?v=2" alt="BMW"/>' + (isM(c) ? '<img class="egl-mlogo" src="/bmw/m-logo.webp?v=2" alt="M"/>' : '');
    }
    var priceHtml;
    if((isMini||isMB) && !c.from){
      priceHtml = '<span class="egl-soon">Ár kérésre</span>';
    } else if(!isMini && SOON.indexOf(slug(c))>-1){
      priceHtml = '<span class="egl-soon">Hamarosan</span>';
    } else {
      priceHtml = '<b>'+HUF(net(c.from))+'</b><span class="eur">'+EUR(net(c.from))+'</span><span class="tol">-tól</span><span class="egl-info" tabindex="0">i<span class="egl-tip">Az árak nettó árak. A végleges ár a választott felszereltségtől és az adott kedvezménytől függ. A képek csak illusztrációk.</span></span>';
    }
    var href = (isMini||isMB) ? '/kapcsolat' : '/egyedi-auto-rendeles/'+slug(c);
    var newBadge = (!isMini && !isMB && NEW.indexOf(slug(c))>-1) ? '<span class="egl-new">ÚJ</span>' : '';
    var a=document.createElement('a');
    a.className='egl-card'+((isMini||isMB)?' egl-card-mini':''); a.href=href;
    a.innerHTML =
      '<div class="egl-media">'+newBadge+'<img src="'+img+'" alt="'+c.name+'" loading="lazy"/>'+
        '<div class="egl-fuels"><span class="egl-fuel" style="background:'+(FUELC[c.fuel]||'#5A6B82')+'">'+c.fuel+'</span></div>'+'</div>'+
      '<div class="egl-body">'+
        '<div class="egl-meta"><span class="egl-brand">'+logoHtml+'</span><span class="egl-year">2026 · Németország</span></div>'+
        '<div class="egl-name">'+c.name+'</div>'+
        '<div class="egl-specs">'+specLine(c)+'</div>'+
        '<div class="egl-price">'+priceHtml+'</div>'+
        '<span class="egl-btn">Részletek</span>'+
      '</div>';
    return a;
  }

  var grid=document.getElementById('eglGrid');
  var q=document.getElementById('eglQ'), fb=document.getElementById('eglBody'), ff=document.getElementById('eglFuel'), fbr=document.getElementById('eglBrand'), fcls=document.getElementById('eglClass');

  function mbClass(c){ var n=c.name;
    if(/S-osztály/.test(n))return'S-osztály'; if(/A-osztály/.test(n))return'A-osztály'; if(/B-osztály/.test(n))return'B-osztály';
    if(/C-osztály/.test(n))return'C-osztály'; if(/E-osztály/.test(n))return'E-osztály'; if(/CLE/.test(n))return'CLE';
    if(/GLA/.test(n))return'GLA'; if(/GLB/.test(n))return'GLB'; if(/GLC/.test(n))return'GLC'; if(/GLE/.test(n))return'GLE'; return'Egyéb'; }
  var MBORDER=['A-osztály','B-osztály','C-osztály','E-osztály','S-osztály','CLE','GLA','GLB','GLC','GLE'];

  var HERO={
    'BMW':{crumb:'BMW',title:'Egyedi BMW rendelés',intro:'Új BMW modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'},
    'MINI':{crumb:'MINI',title:'Egyedi MINI rendelés',intro:'Új MINI modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'},
    'MB':{crumb:'Mercedes-Benz',title:'Egyedi Mercedes-Benz rendelés',intro:'Új Mercedes-Benz modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'},
    '':{crumb:'Egyedi autó rendelés',title:'Egyedi autó rendelés',intro:'Új BMW, MINI és Mercedes-Benz modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.'}
  };
  var PH={'BMW':'Keresés (pl. X5, i4)…','MINI':'Keresés (pl. Cooper, Countryman)…','MB':'Keresés (pl. E-osztály, GLC)…','':'Keresés (pl. X5, Cooper)…'};
  function applyHero(br){
    var h=HERO[br]||HERO[''];
    var t=document.getElementById('eglTitle'); if(t) t.textContent=h.title;
    var c=document.getElementById('eglCrumbCur'); if(c) c.textContent=h.crumb;
    var fxEl=document.getElementById('eglFx'); var fx=fxEl?fxEl.textContent:'361';
    var s=document.getElementById('eglSub');
    if(s) s.innerHTML=h.intro+' Az árak tájékoztató német nettó listaárak, élő árfolyammal (1&nbsp;€ = <span id="eglFx">'+fx+'</span>&nbsp;Ft).';
    if(q) q.placeholder = PH[br]||PH[''];
    var bw=document.getElementById('eglBrandWrap'), cw=document.getElementById('eglClassWrap');
    if(br==='MB'){ if(bw)bw.style.display='none'; if(cw)cw.style.display=''; }
    else { if(bw)bw.style.display=''; if(cw)cw.style.display='none'; if(fcls)fcls.value=''; }
  }

  function render(){
    var qq=(q.value||'').toLowerCase(), b=fb.value, f=ff.value, br=fbr.value, cl=(fcls?fcls.value:'');
    var isMB=(br==='MB');
    var list=CARS.filter(function(c){
      if(qq && c.name.toLowerCase().indexOf(qq)===-1) return false;
      if(b && c.body!==b) return false;
      if(f && c.fuel!==f) return false;
      if(br && (c.brand||'BMW')!==br) return false;
      if(isMB && cl && mbClass(c)!==cl) return false;
      return true;
    });
    grid.innerHTML='';
    if(isMB){
      MBORDER.forEach(function(cls){
        var g=list.filter(function(c){return mbClass(c)===cls;});
        if(!g.length) return;
        var hh=document.createElement('div'); hh.className='egl-section';
        hh.innerHTML='<span class="dot" style="background:#00a3e0"></span>'+cls+' <span class="cnt">'+g.length+' modell</span>';
        grid.appendChild(hh);
        g.forEach(function(c){ grid.appendChild(card(c)); });
      });
      document.getElementById('eglCount').textContent = list.length + ' modell';
      return;
    }
    var minis=list.filter(function(c){return c.brand==='MINI';});
    if(minis.length){
      var mh=document.createElement('div');
      mh.className='egl-section';
      mh.innerHTML='<span class="dot" style="background:#1b1b1b"></span>MINI <span class="cnt">'+minis.length+' modell</span>';
      grid.appendChild(mh);
      minis.forEach(function(c){ grid.appendChild(card(c)); });
    }
    var mbs=list.filter(function(c){return c.brand==='MB';});
    if(mbs.length){
      var mbh=document.createElement('div');
      mbh.className='egl-section';
      mbh.innerHTML='<span class="dot" style="background:#00a3e0"></span>Mercedes-Benz <span class="cnt">'+mbs.length+' modell</span>';
      grid.appendChild(mbh);
      mbs.forEach(function(c){ grid.appendChild(card(c)); });
    }
    var order=['Elektromos','Hibrid','Benzin','Dízel'];
    order.forEach(function(fuel){
      var group=list.filter(function(c){var br2=(c.brand||'BMW'); return br2!=='MINI' && br2!=='MB' && c.fuel===fuel;});
      if(!group.length) return;
      var h=document.createElement('div');
      h.className='egl-section';
      h.innerHTML='<span class="dot" style="background:'+(FUELC[fuel]||'#5A6B82')+'"></span>'+fuel+' <span class="cnt">'+group.length+' modell</span>';
      grid.appendChild(h);
      group.forEach(function(c){ grid.appendChild(card(c)); });
    });
    document.getElementById('eglCount').textContent = list.length + ' modell';
  }
  [q,fb,ff,fbr,fcls].forEach(function(el){ if(el){ el.addEventListener('input',render); el.addEventListener('change',render); } });
  fbr.addEventListener('change',function(){ applyHero(fbr.value); });
  try{var _qb=new URLSearchParams(location.search).get('brand'); if(_qb){ var _map={bmw:'BMW',mini:'MINI',mercedes:'MB',mb:'MB'}; fbr.value=(_map[_qb.toLowerCase()]||_qb); }}catch(e){}
  applyHero(fbr.value);
  render();
  try{
    fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=HUF').then(function(r){return r.json();}).then(function(d){
      if(d&&d.rates&&d.rates.HUF){ FX=Math.round(d.rates.HUF); var e=document.getElementById('eglFx'); if(e)e.textContent=FX; render(); }
    }).catch(function(){});
  }catch(e){}
})();
</script>
