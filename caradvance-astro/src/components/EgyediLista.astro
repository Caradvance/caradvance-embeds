---
const { lang = 'hu' } = Astro.props;
---
<section class="egl">
  <div class="egl-in">
    <nav class="egl-crumb"><a href="/">Főoldal</a> / <span>Egyedi autó rendelés</span></nav>
    <h1>Egyedi autó rendelés</h1>
    <p class="egl-sub">Új BMW modellek Németországból, egyedi konfigurációval, kulcsrakész behozatallal.
      Az árak tájékoztató német nettó listaárak, élő árfolyammal (1&nbsp;€ = <span id="eglFx">361</span>&nbsp;Ft).</p>

    <div class="egl-filters">
      <input type="text" id="eglQ" class="egl-search" placeholder="Keresés (pl. X5, iX)…" />
      <div class="egl-sel"><select id="eglBrand"><option value="">Minden márka</option><option>BMW</option></select></div>
      <div class="egl-sel"><select id="eglBody"><option value="">Minden karosszéria</option><option>SUV</option><option>Limuzin</option><option>Coupé</option></select></div>
      <div class="egl-sel"><select id="eglFuel"><option value="">Minden üzemanyag</option><option>Benzin</option><option>Dízel</option><option>Hibrid</option><option>Elektromos</option></select></div>
    </div>

    <div class="egl-count" id="eglCount">12 modell</div>
    <div class="egl-grid" id="eglGrid"></div>
  </div>
</section>

<style is:global>
  .egl{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1;--navy:#0F1B2D;--bg:#F4F7FB;
    background:var(--bg);padding:34px 20px 72px;
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:var(--ink);}
  .egl-in{max-width:1160px;margin:0 auto;}
  .egl-crumb{font-size:14px;color:var(--muted);margin-bottom:16px;}
  .egl-crumb a{color:var(--muted);text-decoration:none;}
  .egl-crumb span{color:var(--ink);font-weight:600;}
  .egl h1{font-size:40px;line-height:1.1;font-weight:800;color:var(--navy);margin:0 0 10px;}
  .egl-sub{font-size:17px;color:var(--muted);margin:0 0 24px;max-width:820px;line-height:1.5;}
  .egl-filters{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:22px;}
  .egl-search{flex:1;min-width:220px;background:#fff;border:1px solid var(--line);border-radius:12px;
    padding:14px 18px;font-size:15px;color:var(--ink);font-family:inherit;}
  .egl-search::placeholder{color:#9aa7ba;}
  .egl-search:focus{outline:none;border-color:#c9d3e3;}
  .egl-sel{position:relative;}
  .egl-sel select{appearance:none;-webkit-appearance:none;background:#fff;border:1px solid var(--line);
    border-radius:12px;padding:14px 42px 14px 18px;font-size:15px;color:var(--ink);font-family:inherit;cursor:pointer;min-width:180px;}
  .egl-sel::after{content:'⌄';position:absolute;right:16px;top:50%;transform:translateY(-60%);color:var(--muted);pointer-events:none;font-size:16px;}
  .egl-sel select:focus{outline:none;border-color:#c9d3e3;}
  .egl-count{font-size:14px;font-weight:700;color:var(--muted);margin-bottom:16px;}
  .egl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  @media (max-width:900px){.egl-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:600px){.egl-grid{grid-template-columns:1fr;}}
  .egl-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;
    display:flex;flex-direction:column;transition:.18s;text-decoration:none;color:inherit;}
  .egl-card:hover{box-shadow:0 14px 34px rgba(15,27,45,.10);transform:translateY(-3px);}
  .egl-media{position:relative;background:#fff;aspect-ratio:16/11;display:flex;align-items:center;justify-content:center;padding:10px;}
  .egl-media img{width:100%;height:100%;object-fit:contain;}
  .egl-badge{position:absolute;top:14px;right:14px;background:var(--red);color:#fff;font-size:12px;
    font-weight:700;padding:6px 14px;border-radius:100px;}
  .egl-body{padding:16px 20px 20px;}
  .egl-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
  .egl-pill{background:#eef2f8;color:var(--navy);font-size:12.5px;font-weight:600;padding:5px 12px;border-radius:100px;}
  .egl-year{font-size:13.5px;color:var(--muted);}
  .egl-name{font-size:19px;font-weight:800;color:var(--navy);margin:0 0 8px;line-height:1.2;}
  .egl-specs{font-size:14px;color:var(--muted);margin:0 0 14px;}
  .egl-price{display:flex;align-items:baseline;gap:9px;margin-bottom:16px;flex-wrap:wrap;}
  .egl-price b{font-size:23px;font-weight:800;color:var(--ink);}
  .egl-price .eur{font-size:14px;font-weight:600;color:var(--muted);}
  .egl-price .tol{font-size:13px;color:var(--muted);font-weight:600;}
  .egl-btn{display:block;text-align:center;background:#eef2f8;color:var(--navy);font-weight:700;
    font-size:15px;padding:14px;border-radius:12px;transition:.15s;}
  .egl-card:hover .egl-btn{background:var(--navy);color:#fff;}
</style>

<script is:inline>
(function(){
  var FX = 361;
  var HUF = function(eur){ return new Intl.NumberFormat('hu-HU').format(Math.round(eur*FX)) + ' Ft'; };
  var EUR = function(eur){ return new Intl.NumberFormat('de-DE').format(eur) + ' €'; };

  var MODELS = [
    { key:'x3', name:'BMW X3', body:'SUV',    fuels:['Benzin','Dízel','Hibrid'], from:57900 },
    { key:'x7', name:'BMW X7', body:'SUV',    fuels:['Dízel','Benzin'],          from:108900 },
    { key:'xm', name:'BMW XM', body:'SUV',    fuels:['Hibrid'],                  from:135500 },
    { key:'ix', name:'BMW iX', body:'SUV',    fuels:['Elektromos'],              from:83500 },
    { key:'ix2',name:'BMW iX2',body:'SUV',    fuels:['Elektromos'],              from:51000 },
    { key:'3er',name:'BMW 3-as',body:'Limuzin',fuels:['Benzin','Dízel','Hibrid'],from:52900 },
    { key:'5er',name:'BMW 5-ös',body:'Limuzin',fuels:['Benzin','Dízel','Hibrid'],from:57900 },
    { key:'m5', name:'BMW M5', body:'Limuzin',fuels:['Hibrid'],                  from:145200 },
    { key:'m3', name:'BMW M3', body:'Limuzin',fuels:['Benzin'],                  from:96500 },
    { key:'i5', name:'BMW i5', body:'Limuzin',fuels:['Elektromos'],              from:70900 },
    { key:'i7', name:'BMW i7', body:'Limuzin',fuels:['Elektromos'],              from:121400 },
    { key:'i4', name:'BMW i4', body:'Coupé',  fuels:['Elektromos'],              from:58200 }
  ];

  function specLine(m){ return m.body + ' · Automata · ' + m.fuels.join('/'); }
  function card(m){
    var a=document.createElement('a');
    a.className='egl-card'; a.href='/egyedi-auto-rendeles/'+m.key;
    var src='/bmw/'+m.key+'.webp';
    a.innerHTML =
      '<div class="egl-media"><img src="'+src+'" alt="'+m.name+'" loading="lazy"/></div>'+
      '<div class="egl-body">'+
        '<div class="egl-meta"><span class="egl-pill">Új autó</span><span class="egl-year">2026 · Németország</span></div>'+
        '<div class="egl-name">'+m.name+'</div>'+
        '<div class="egl-specs">'+specLine(m)+'</div>'+
        '<div class="egl-price"><b>'+HUF(m.from)+'</b><span class="eur">'+EUR(m.from)+'</span><span class="tol">-tól</span></div>'+
        '<span class="egl-btn">Részletek</span>'+
      '</div>';
    return a;
  }

  var grid=document.getElementById('eglGrid');
  var q=document.getElementById('eglQ'), fb=document.getElementById('eglBody'), ff=document.getElementById('eglFuel'), fbr=document.getElementById('eglBrand');
  function render(){
    var qq=(q.value||'').toLowerCase(), b=fb.value, f=ff.value, br=fbr.value;
    var list=MODELS.filter(function(m){
      if(qq && m.name.toLowerCase().indexOf(qq)===-1) return false;
      if(b && m.body!==b) return false;
      if(f && m.fuels.indexOf(f)===-1) return false;
      if(br && br!=='BMW') return false;
      return true;
    });
    grid.innerHTML='';
    list.forEach(function(m){ grid.appendChild(card(m)); });
    document.getElementById('eglCount').textContent = list.length + ' modell';
  }
  [q,fb,ff,fbr].forEach(function(el){ el.addEventListener('input',render); el.addEventListener('change',render); });
  render();
  try{
    fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=HUF').then(function(r){return r.json();}).then(function(d){
      if(d&&d.rates&&d.rates.HUF){ FX=Math.round(d.rates.HUF); var e=document.getElementById('eglFx'); if(e)e.textContent=FX; render(); }
    }).catch(function(){});
  }catch(e){}
})();
</script>
