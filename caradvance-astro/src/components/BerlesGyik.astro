---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const cats = [
{ id: 'mind', t: 'Mind' },
{ id: 'altalanos', t: 'A bérlésről' },
{ id: 'feltetel', t: 'Feltételek & kaució' },
{ id: 'koltseg', t: 'Költségek' },
{ id: 'autok', t: 'Autók & választás' },
{ id: 'ceges', t: 'Céges bérlés' },
{ id: 'folyamat', t: 'Folyamat' },
];

const faqs = [
{ c: 'altalanos', q: 'Mit jelent a prémium autóbérlés a CarAdvance-nél?', a: 'Új vagy alig használt, kifogástalan állapotú német prémium autót — Mercedes, BMW, Audi és társaik — bérelhetsz nálunk rugalmas feltételekkel. A szervizt, az adót és a nyári-téli gumit mi álljuk, a kaució pedig a piaci átlagnál kedvezőbb, így neked gyakorlatilag csak vezetned kell.' },
{ c: 'altalanos', q: 'Kinek éri meg bérelni vásárlás helyett?', a: 'Annak, aki mindig friss, prémium autót szeretne anélkül, hogy nagy összeget kötne le és viselné a tulajdonlás kockázatait. Cégeknek különösen előnyös: a bérleti díj elszámolható költség, a tőke pedig a vállalkozásban maradhat, ahol többet hoz.' },
{ c: 'altalanos', q: 'Mennyi időre lehet bérelni?', a: 'Rövid és hosszú távra egyaránt. Akár félévente új, általad választott autóra válthatsz — a pontos időtartamot és feltételeket mindig az igényeidhez igazítjuk.' },
{ c: 'feltetel', q: 'Mennyi a kaució?', a: 'A piaci átlagnál lényegesen kedvezőbb: nálunk nem kell az autó értékének akár 20%-át letenned, így sokkal kevesebb lekötött pénzzel veheted át a prémium autót. A pontos összeg a modelltől és a konstrukciótól függ, ezt előre, átláthatóan rögzítjük.' },
{ c: 'feltetel', q: 'Milyen feltételekkel bérelhetek?', a: 'Érvényes vezetői engedély és a bérléshez szükséges alapdokumentumok szükségesek. A konkrét feltételeket a kiválasztott autó és konstrukció függvényében egyeztetjük — segítünk gyorsan átlátni, pontosan mi vonatkozik rád.' },
{ c: 'feltetel', q: 'Kell magas önerő vagy előleg?', a: 'A kaución felül jellemzően nincs magas önerő. A fizetési ütemezést a bérleti szerződésben, előre, tételesen rögzítjük — nincs apró betű és nincs rejtett költség.' },
{ c: 'koltseg', q: 'Mit tartalmaz a bérleti díj?', a: 'Minden benne van, ami a gondtalan használathoz kell: a szervizköltséget és az adókat mi álljuk, a nyári és téli gumiszettet is tőlünk kapod. Nálad nincsenek váratlan számlák.' },
{ c: 'koltseg', q: 'Ki fizeti a szervizt, az adót és a gumikat?', a: 'Mi. A karbantartás, az adók és a szezonális gumik a mi dolgunk — neked ezekkel egyáltalán nem kell foglalkoznod, csak vezetned kell.' },
{ c: 'koltseg', q: 'Van kilométer-korlát?', a: 'A bérleti konstrukciótól függ. A várható éves futásodhoz igazítjuk a csomagot, hogy ne érjenek meglepetések — a részleteket előre, világosan rögzítjük a szerződésben.' },
{ c: 'autok', q: 'Milyen autókat lehet bérelni?', a: 'Kizárólag német, új vagy alig használt, kifogástalan állapotú prémium autókat — Mercedes, BMW, Audi és hasonló márkák. Az aktuális kínálatot a bérelhető autóink oldalon nézheted meg.' },
{ c: 'autok', q: 'Válthatok autót a bérlés alatt?', a: 'Igen. Nem köt egyetlen modell sem: akár félévente új, általad választott autóba ülhetsz, mindig a saját ízlésed és aktuális igényed szerint.' },
{ c: 'autok', q: 'Kérhetek konkrét modellt, felszereltséget vagy színt?', a: 'Igen. Mondd el, mit szeretnél, és a német piac teljes kínálatából megkeressük a hozzád illő darabot — pontosan azt a modellt, felszereltséget és színt, amire vágysz.' },
{ c: 'ceges', q: 'Cégként elszámolható a bérleti díj?', a: 'Igen, a bérleti díj a könyvelésben elszámolható költség — jelentős pénzügyi és adózási előny. Nincs lekötött tőke az autóban, így a szabad tőkéd a vállalkozásodban dolgozhat helyetted.' },
{ c: 'ceges', q: 'Adtok áfás számlát?', a: 'Igen, céges bérlésnél szabályos, áfás számlát állítunk ki, átlátható, tételes elszámolással.' },
{ c: 'ceges', q: 'Flottát is kezeltek?', a: 'Igen, több autóból álló céges flottát is összeállítunk és kezelünk. Írd meg, hány autóra és milyen konstrukcióra van szükséged, és személyre szabott ajánlatot adunk.' },
{ c: 'folyamat', q: 'Hogyan indul a bérlés?', a: 'Írj vagy hívj minket, és mondd el, milyen autót és konstrukciót keresel. Kiválasztjuk a megfelelő autót, egyeztetjük a feltételeket, aláírjuk a szerződést, és átadjuk a kulcsrakész autót — a többit intézzük.' },
{ c: 'folyamat', q: 'Mi történik a bérlet végén?', a: 'Egyszerűen visszaadod az autót — nem kell vevőt keresned, hirdetned vagy alkudoznod, és nem terhel a maradványérték-kockázat sem. Ha szeretnéd, rögtön válthatsz egy újabb modellre.' },
{ c: 'folyamat', q: 'Külföldre vihetem a bérelt autót?', a: 'A legtöbb esetben igen, előzetes egyeztetéssel. Írd meg, hová terveznél utazni, és elintézzük a szükséges engedélyeket és a biztosítási hátteret.' },
];

const faqJson = {
'@context': 'https://schema.org', '@type': 'FAQPage',
mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<section class="el">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>Gyakori kérdések —<br /><span class="accent">a prémium autóbérlésről</span></h1>
<p class="sub sub-wide" style="max-width:900px">Minden, amit a bérlésről tudni érdemes: kaució és feltételek, költségek, autóválasztás, céges bérlés és a folyamat. Keress rá a témára — és ha nem találod a választ, egy hívás vagy e-mail&nbsp;elég.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/berelheto">Bérelhető autóink</a>
<a class="btn btn-white" href="#gyik">Kérdések böngészése</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" id="gyik" style="padding-top:56px">
<div class="wrap center">
<span class="eyebrow">GY.I.K.</span>
<h2 class="sec-title">Miben segíthetünk?</h2>
<p class="sec-intro">Keress rá egy kulcsszóra, vagy válassz témát a fülek közül. A válaszok tájékoztató jellegűek; a pontos, egyedi részleteket mindig írásban, személyre szabottan rögzítjük.</p>
</div>
<div class="wrap gyik-wrap">
<input id="gyikSearch" class="gyik-search" type="search" placeholder="Keresés a kérdések között…" autocomplete="off" />
<div class="gyik-tabs">
{cats.map((c, i) => (<button class={`gyik-tab${i === 0 ? ' is-active' : ''}`} data-cat={c.id}>{c.t}</button>))}
</div>
<div class="gyik-list">
{faqs.map((f) => (
<details class="gyik-item" data-cat={f.c} data-text={(f.q + ' ' + f.a).toLowerCase()}>
<summary>{f.q}<span class="pl">+</span></summary>
<p>{f.a}</p>
</details>
))}
</div>
<p id="gyikEmpty" class="gyik-empty" hidden>Nincs a keresésnek megfelelő kérdés. Próbálj más kulcsszót, vagy írj nekünk: import@caradvance.de.</p>
</div>
</section>

<section class="section">
<div class="wrap">
<div class="el-cta">
<div>
<h2>Nem találod a választ?</h2>
<p>Írj vagy hívj minket — szívesen segítünk bármilyen kérdésben, kötelezettségmentesen.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Kapcsolat →</a>
</div>
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
</section>

<style>
.el{--red:#E2001A;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.gyik-wrap{max-width:820px;margin:0 auto;padding:0 20px}
.gyik-search{width:100%;box-sizing:border-box;border:1px solid var(--line);border-radius:14px;padding:14px 18px;font-size:16px;color:var(--ink);outline:none;background:#fff}
.gyik-search:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(226,0,26,.12)}
.gyik-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 20px}
.gyik-tab{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:999px;padding:8px 16px;font-size:14px;font-weight:700;cursor:pointer;transition:.15s}
.gyik-tab:hover{border-color:#c9d2df}
.gyik-tab.is-active{background:var(--red);border-color:var(--red);color:#fff}
.gyik-list{display:flex;flex-direction:column;gap:10px}
.gyik-item{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.gyik-item summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.gyik-item summary::-webkit-details-marker{display:none}
.gyik-item .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;transition:.15s}
.gyik-item[open] .pl{transform:rotate(45deg)}
.gyik-item p{color:var(--muted);font-size:15px;line-height:1.65;margin:0 0 16px}
.gyik-empty{color:var(--muted);font-size:15px;text-align:center;padding:20px 0}
.el-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.el-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.el-cta p{color:#cfd6e2;margin:0;font-size:15px}
</style>

<script is:inline>
(function(){
  var wrap=document.querySelector('.gyik-wrap'); if(!wrap) return;
  var items=[].slice.call(wrap.querySelectorAll('.gyik-item'));
  var tabs=[].slice.call(wrap.querySelectorAll('.gyik-tab'));
  var search=wrap.querySelector('#gyikSearch');
  var empty=wrap.querySelector('#gyikEmpty');
  var cat='mind';
  function apply(){
    var q=(search.value||'').trim().toLowerCase();
    var vis=0;
    items.forEach(function(it){
      var okCat = cat==='mind' || it.getAttribute('data-cat')===cat;
      var okQ = !q || it.getAttribute('data-text').indexOf(q)>-1;
      var show = okCat && okQ;
      it.hidden=!show; if(show) vis++; if(!show) it.open=false;
    });
    empty.hidden = vis>0;
  }
  tabs.forEach(function(t){ t.addEventListener('click',function(){ cat=t.getAttribute('data-cat'); tabs.forEach(function(x){ x.classList.toggle('is-active', x===t); }); apply(); }); });
  search.addEventListener('input', apply);
  apply();
})();
</script>
