---
// A 30% felajánlás megosztása: 15% az eladó, 15% a vevő döntése.
const { compact = false } = Astro.props as { compact?: boolean };
---
<div class={`splitg${compact ? ' splitg-compact' : ''}`}>
  <div class="sg-card sg-seller">
    <span class="sg-who">Az eladó dönt</span>
    <span class="sg-pct">15%</span>
    <span class="sg-txt">Te, aki eladod az autót, kiválasztod, melyik szervezet és projekt kapja meg a jutalékunk felét.</span>
  </div>
  <span class="sg-op">+</span>
  <div class="sg-card sg-buyer">
    <span class="sg-who">A vevő dönt</span>
    <span class="sg-pct">15%</span>
    <span class="sg-txt">Az autó új tulajdonosa dönt a másik 15%-ról — így ő is részese lesz a jó ügynek.</span>
  </div>
  <span class="sg-op sg-eq">=</span>
  <div class="sg-card sg-total">
    <span class="sg-who">Együtt</span>
    <span class="sg-pct">30%</span>
    <span class="sg-txt">jótékony célra — két döntéssel, dupla hatással.</span>
  </div>
</div>

<style>
  .splitg{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:stretch;gap:14px;max-width:960px;margin:34px auto 0}
  .sg-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px 22px;text-align:center;display:flex;flex-direction:column;align-items:center;box-shadow:0 12px 30px rgba(8,8,10,.06)}
  .sg-who{font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .sg-pct{font-size:52px;font-weight:800;line-height:1.05;letter-spacing:-.03em;margin:6px 0 8px}
  .sg-txt{font-size:14px;line-height:1.55;color:var(--muted)}
  .sg-op{align-self:center;font-size:30px;font-weight:700;color:var(--muted)}
  .sg-seller{border-top:4px solid var(--red)}
  .sg-seller .sg-pct{color:var(--red)}
  .sg-buyer{border-top:4px solid #1e3c72}
  .sg-buyer .sg-pct{color:#1e3c72}
  .sg-total{background:var(--navy);border-color:var(--navy);color:#fff}
  .sg-total .sg-who{color:rgba(255,255,255,.7)}
  .sg-total .sg-pct{color:#fff}
  .sg-total .sg-txt{color:rgba(255,255,255,.85)}
  @media(max-width:820px){
    .splitg{grid-template-columns:1fr;gap:10px}
    .sg-op{transform:rotate(90deg);font-size:24px}
    .sg-pct{font-size:44px}
  }
</style>
