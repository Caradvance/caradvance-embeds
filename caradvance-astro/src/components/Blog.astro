---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
import { SITE, POSTS, CATEGORIES, catOf, huDate } from '../data/posts';
const { lang } = Astro.props as { lang: Locale };

// Legfrissebb elöl
const posts = [...POSTS].sort((a, b) => (a.dateISO < b.dateISO ? 1 : -1));
const featured = posts[0];
const rest = posts.slice(1);

const countFor = (key: string) => POSTS.filter((p) => p.cat === key).length;

const blogJson = {
  '@context': 'https://schema.org', '@type': 'Blog',
  name: 'CarAdvance Magazin',
  description: 'Prémium autóbérlés, németországi autóbehozatal, lízing és bizományos értékesítés — útmutatók és tippek a CarAdvance szakértőitől.',
  url: SITE + '/blog/',
  inLanguage: 'hu-HU',
  publisher: { '@type': 'Organization', name: 'CarAdvance', logo: { '@type': 'ImageObject', url: SITE + '/caradvance-logo.webp' } },
  blogPost: POSTS.map((p) => ({
    '@type': 'BlogPosting', headline: p.title, url: `${SITE}/blog/${p.slug}/`,
    datePublished: p.dateISO, image: SITE + p.image, articleSection: catOf(p.cat).label,
  })),
};
const breadcrumbJson = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kezdőlap', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + '/blog/' },
  ],
};
const jsonLdAll = [blogJson, breadcrumbJson];
---
<section class="bl">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<h1>CarAdvance <span class="accent">Magazin</span></h1>
<p class="sub sub-wide" style="max-width:760px">Útmutatók, tippek és szakértői tudás autóbérlésről, németországi behozatalról, lízingről és bizományos értékesítésről — hogy magabiztosan dönts a következő autódról.</p>
<div class="cta-row">
<a class="btn btn-primary" href="#cikkek">Legfrissebb cikkek</a>
<a class="btn btn-white" href="#temak">Témák</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<!-- Kiemelt + legfrissebb cikkek -->
<section class="section" id="cikkek" style="padding-top:56px">
<div class="wrap">
<span class="eyebrow">Legfrissebb</span>
<h2 class="sec-title">Friss a magazinból</h2>

<a class="bl-feat" href={`/blog/${featured.slug}`}>
<span class="bl-featimg" style={`background-image:url(${featured.image})`}></span>
<span class="bl-featbody">
<span class="bl-cat">{catOf(featured.cat).label}</span>
<span class="bl-feattitle">{featured.title}</span>
<span class="bl-featexc">{featured.excerpt}</span>
<span class="bl-meta"><time datetime={featured.dateISO}>{huDate(featured.dateISO)}</time><span class="bl-dot">•</span>{featured.readingMin} perc olvasás</span>
<span class="bl-more">Elolvasom →</span>
</span>
</a>

<div class="bl-grid">
{rest.map((p) => (
<a class="bl-card" href={`/blog/${p.slug}`}>
<span class="bl-cardimg" style={`background-image:url(${p.image})`}></span>
<span class="bl-cardbody">
<span class="bl-cat">{catOf(p.cat).label}</span>
<span class="bl-cardtitle">{p.title}</span>
<span class="bl-cardexc">{p.excerpt}</span>
<span class="bl-meta"><time datetime={p.dateISO}>{huDate(p.dateISO)}</time><span class="bl-dot">•</span>{p.readingMin} perc</span>
</span>
</a>
))}
</div>
</div>
</section>

<!-- Témák / kategóriák -->
<section class="section" id="temak" style="padding-top:24px">
<div class="wrap">
<span class="eyebrow">Böngéssz téma szerint</span>
<h2 class="sec-title">Témák</h2>
<p class="sec-intro">A magazin a szolgáltatásaink köré épül — válaszd ki, ami most érdekel, és ugorj a kapcsolódó oldalra vagy cikkekre.</p>
<div class="bl-cats">
{CATEGORIES.map((c) => (
<a class="bl-cat-tile" href={c.service}>
<span class="bl-cat-label">{c.label}</span>
<span class="bl-cat-blurb">{c.blurb}</span>
<span class="bl-cat-foot">{countFor(c.key) > 0 ? `${countFor(c.key)} cikk` : 'Hamarosan'}<span class="bl-cat-arrow">→</span></span>
</a>
))}
</div>
</div>
</section>

<!-- Hírlevél / CTA -->
<section class="section" style="padding-top:8px;padding-bottom:72px">
<div class="wrap">
<div class="bl-news">
<div class="bl-news-txt">
<h2>Ne maradj le a friss autókról</h2>
<p>Új beszerzések, akciók és szakértői tartalmak — kövess minket a közösségi csatornáinkon, vagy vedd fel velünk a kapcsolatot egy személyes ajánlatért.</p>
</div>
<div class="bl-news-cta">
<a class="btn btn-primary" href="/kapcsolat">Kapcsolatfelvétel</a>
<a class="btn btn-white" href="/media">Kövess minket</a>
</div>
</div>
</div>
</section>

{jsonLdAll.map((j) => (<script type="application/ld+json" set:html={JSON.stringify(j)}></script>))}
</section>

<style>
  .bl{--ink:#111;--muted:#5b616e;--line:#e8e8ea;--red:#e2231a;}
  .bl .sec-intro{max-width:680px;}
  /* Featured */
  .bl-feat{display:grid;grid-template-columns:1.15fr 1fr;gap:0;background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;text-decoration:none;color:var(--ink);margin:22px 0 30px;transition:transform .18s ease,box-shadow .18s ease;}
  .bl-feat:hover{transform:translateY(-3px);box-shadow:0 20px 44px rgba(0,0,0,.10);}
  .bl-featimg{min-height:300px;background-size:cover;background-position:center;background-color:#e9ebef;}
  .bl-featbody{padding:30px 32px;display:flex;flex-direction:column;gap:12px;justify-content:center;}
  .bl-feattitle{font-size:1.55rem;line-height:1.2;font-weight:800;letter-spacing:-.01em;}
  .bl-featexc{color:var(--muted);line-height:1.6;}
  /* Grid */
  .bl-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  .bl-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;text-decoration:none;color:var(--ink);transition:transform .18s ease,box-shadow .18s ease;}
  .bl-card:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(0,0,0,.10);}
  .bl-cardimg{height:190px;background-size:cover;background-position:center;background-color:#e9ebef;}
  .bl-cardbody{padding:20px 22px 22px;display:flex;flex-direction:column;gap:9px;}
  .bl-cardtitle{font-size:1.14rem;line-height:1.32;font-weight:700;}
  .bl-cardexc{color:var(--muted);line-height:1.55;font-size:.98rem;}
  /* Shared meta / cat */
  .bl-cat{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--red);}
  .bl-meta{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:.88rem;margin-top:2px;}
  .bl-dot{opacity:.6;}
  .bl-more{font-weight:700;color:var(--red);margin-top:4px;}
  /* Category tiles */
  .bl-cats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px;}
  .bl-cat-tile{display:flex;flex-direction:column;gap:8px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 22px 18px;text-decoration:none;color:var(--ink);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;}
  .bl-cat-tile:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(0,0,0,.09);border-color:#dcdce0;}
  .bl-cat-label{font-size:1.18rem;font-weight:800;}
  .bl-cat-blurb{color:var(--muted);line-height:1.55;font-size:.96rem;flex:1;}
  .bl-cat-foot{display:flex;align-items:center;justify-content:space-between;font-weight:700;color:var(--red);font-size:.9rem;margin-top:6px;}
  .bl-cat-arrow{transition:transform .18s ease;}
  .bl-cat-tile:hover .bl-cat-arrow{transform:translateX(4px);}
  /* Newsletter */
  .bl-news{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;background:linear-gradient(135deg,#151821,#0c0e13);color:#fff;border-radius:20px;padding:34px 36px;}
  .bl-news-txt h2{font-size:1.5rem;font-weight:800;margin:0 0 8px;}
  .bl-news-txt p{opacity:.9;line-height:1.6;margin:0;max-width:560px;}
  .bl-news-cta{display:flex;gap:12px;flex-wrap:wrap;}
  @media (max-width:820px){
    .bl-feat{grid-template-columns:1fr;}
    .bl-featimg{min-height:210px;}
    .bl-grid{grid-template-columns:1fr;}
    .bl-cats{grid-template-columns:1fr;}
  }
</style>
