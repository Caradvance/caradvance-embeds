---
import '../styles/eladom.css';
import { SITE, POSTS, catOf, huDate } from '../data/posts';

interface Props {
  slug: string;
  title: string;
  lead: string;              // bevezető mondat a hero alatt (meta description-nek is jó)
  related?: string[];        // kapcsolódó cikkek slug-jai (ha üres, kategória alapján töltjük)
}
const { slug, title, lead, related = [] } = Astro.props as Props;

const post = POSTS.find((p) => p.slug === slug)!;
const cat = catOf(post.cat);
const url = `${SITE}/blog/${post.slug}/`;

// Kapcsolódó cikkek: megadott slug-ok, kiegészítve azonos kategóriás, majd bármely más cikkel
let rel = related.map((s) => POSTS.find((p) => p.slug === s)).filter(Boolean) as typeof POSTS;
if (rel.length < 2) {
  for (const p of POSTS) {
    if (p.slug !== post.slug && !rel.includes(p) && p.cat === post.cat) rel.push(p);
  }
}
for (const p of POSTS) {
  if (rel.length >= 2) break;
  if (p.slug !== post.slug && !rel.includes(p)) rel.push(p);
}
rel = rel.slice(0, 2);

const articleJson = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: title,
  description: lead,
  image: SITE + post.image,
  datePublished: post.dateISO,
  dateModified: post.dateISO,
  inLanguage: 'hu-HU',
  keywords: post.keywords,
  articleSection: cat.label,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Organization', name: 'CarAdvance', url: SITE + '/' },
  publisher: {
    '@type': 'Organization', name: 'CarAdvance',
    logo: { '@type': 'ImageObject', url: SITE + '/caradvance-logo.webp' },
  },
};
const breadcrumbJson = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kezdőlap', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + '/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
const jsonLdAll = [articleJson, breadcrumbJson];
---
<article class="bp">
<header class="bp-hero" style={`background-image:url(${post.image})`}>
<div class="bp-scrim"></div>
<div class="bp-hwrap">
<nav class="bp-crumb" aria-label="Morzsamenü">
<a href="/">Kezdőlap</a><span>›</span><a href="/blog">Blog</a><span>›</span><span class="bp-cur">{cat.label}</span>
</nav>
<span class="bp-chip">{cat.label}</span>
<h1>{title}</h1>
<p class="bp-lead">{lead}</p>
<div class="bp-meta">
<time datetime={post.dateISO}>{huDate(post.dateISO)}</time>
<span class="bp-dot">•</span>
<span>{post.readingMin} perc olvasás</span>
</div>
</div>
</header>

<div class="bp-shell">
<div class="bp-body">
<slot />
</div>
</div>

<!-- Konverziós CTA -->
<section class="bp-cta">
<div class="bp-ctacard">
<h2>Beszéljünk a következő autódról</h2>
<p>Akár bérlésről, németországi behozatalról vagy lízingről van szó — a CarAdvance csapata végigkíséri a teljes folyamatot. Kérj személyre szabott ajánlatot díjmentesen.</p>
<div class="bp-ctarow">
<a class="btn btn-primary" href="/kapcsolat">Ajánlatot kérek</a>
<a class="btn btn-white" href={cat.service}>{cat.label} →</a>
</div>
</div>
</section>

<!-- Kapcsolódó cikkek -->
<section class="bp-rel">
<div class="wrap">
<span class="eyebrow">Olvasd tovább</span>
<h2 class="sec-title">Kapcsolódó cikkek</h2>
<div class="bp-relgrid">
{rel.map((p) => (
<a class="bp-relcard" href={`/blog/${p.slug}`}>
<span class="bp-relimg" style={`background-image:url(${p.image})`}></span>
<span class="bp-relbody">
<span class="bp-relcat">{catOf(p.cat).label}</span>
<span class="bp-reltitle">{p.title}</span>
<span class="bp-relmore">Tovább →</span>
</span>
</a>
))}
</div>
<div class="bp-back"><a href="/blog">← Vissza a blogra</a></div>
</div>
</section>

{jsonLdAll.map((j) => (<script type="application/ld+json" set:html={JSON.stringify(j)}></script>))}
</article>

<style>
  .bp{--ink:#111;--muted:#5b616e;--line:#e8e8ea;--red:#e2231a;--bg:#fafafa;}
  /* Hero */
  .bp-hero{position:relative;background-size:cover;background-position:center;color:#fff;padding:132px 20px 40px;}
  .bp-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,12,16,.55),rgba(10,12,16,.82));}
  .bp-hwrap{position:relative;max-width:820px;margin:0 auto;}
  .bp-crumb{font-size:.86rem;opacity:.9;display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:18px;}
  .bp-crumb a{color:#fff;text-decoration:none;opacity:.92;}
  .bp-crumb a:hover{text-decoration:underline;}
  .bp-crumb span{opacity:.7;}
  .bp-crumb .bp-cur{opacity:.85;}
  .bp-chip{display:inline-block;background:var(--red);color:#fff;font-weight:700;font-size:.78rem;letter-spacing:.03em;text-transform:uppercase;padding:5px 11px;border-radius:999px;}
  .bp-hero h1{font-size:clamp(1.9rem,4.2vw,2.9rem);line-height:1.12;margin:14px 0 12px;font-weight:800;letter-spacing:-.01em;}
  .bp-lead{font-size:1.12rem;line-height:1.55;opacity:.95;max-width:720px;margin:0 0 16px;}
  .bp-meta{display:flex;align-items:center;gap:10px;font-size:.92rem;opacity:.9;}
  .bp-dot{opacity:.6;}
  /* Body */
  .bp-shell{background:var(--bg);}
  .bp-body{max-width:720px;margin:0 auto;padding:52px 20px 40px;color:var(--ink);font-size:1.08rem;line-height:1.75;}
  .bp-body h2{font-size:1.5rem;line-height:1.25;font-weight:800;margin:2.1em 0 .5em;letter-spacing:-.01em;}
  .bp-body h3{font-size:1.18rem;font-weight:700;margin:1.6em 0 .4em;}
  .bp-body p{margin:0 0 1.05em;}
  .bp-body a{color:var(--red);text-decoration:underline;text-underline-offset:2px;}
  .bp-body ul,.bp-body ol{margin:0 0 1.2em;padding-left:1.3em;}
  .bp-body li{margin:.35em 0;}
  .bp-body strong{font-weight:700;}
  .bp-body blockquote{margin:1.4em 0;padding:14px 20px;border-left:4px solid var(--red);background:#fff;border-radius:0 10px 10px 0;color:#333;font-style:italic;}
  .bp-body .bp-key{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin:1.6em 0;box-shadow:0 6px 20px rgba(0,0,0,.04);}
  .bp-body .bp-key h3{margin-top:0;}
  .bp-body .bp-tldr{background:#111;color:#fff;border-radius:16px;padding:22px 24px;margin:0 0 2em;}
  .bp-body .bp-tldr h3{margin:0 0 .5em;color:#fff;font-size:1.02rem;text-transform:uppercase;letter-spacing:.04em;opacity:.8;}
  .bp-body .bp-tldr p{margin:0;opacity:.96;}
  .bp-body table{width:100%;border-collapse:collapse;margin:1.4em 0;font-size:.98rem;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 6px 20px rgba(0,0,0,.05);}
  .bp-body th,.bp-body td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--line);}
  .bp-body th{background:#f2f3f5;font-weight:700;}
  .bp-body tr:last-child td{border-bottom:none;}
  .bp-body .bp-faq{margin:1em 0;border:1px solid var(--line);border-radius:12px;background:#fff;padding:6px 18px;}
  .bp-body .bp-faq summary{cursor:pointer;font-weight:700;padding:12px 0;list-style:none;}
  .bp-body .bp-faq summary::-webkit-details-marker{display:none;}
  .bp-body .bp-faq[open] summary{color:var(--red);}
  .bp-body .bp-faq p{padding:0 0 12px;margin:0;color:#333;}
  /* CTA */
  .bp-cta{background:var(--bg);padding:8px 20px 56px;}
  .bp-ctacard{max-width:720px;margin:0 auto;background:linear-gradient(135deg,#151821,#0c0e13);color:#fff;border-radius:20px;padding:34px 32px;}
  .bp-ctacard h2{font-size:1.5rem;font-weight:800;margin:0 0 8px;}
  .bp-ctacard p{opacity:.9;line-height:1.6;margin:0 0 18px;}
  .bp-ctarow{display:flex;gap:12px;flex-wrap:wrap;}
  /* Related */
  .bp-rel{padding:56px 20px 72px;}
  .bp-relgrid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px;}
  .bp-relcard{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:var(--ink);transition:transform .18s ease,box-shadow .18s ease;}
  .bp-relcard:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(0,0,0,.10);}
  .bp-relimg{height:150px;background-size:cover;background-position:center;background-color:#e9ebef;}
  .bp-relbody{padding:16px 18px 18px;display:flex;flex-direction:column;gap:7px;}
  .bp-relcat{font-size:.74rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--red);}
  .bp-reltitle{font-weight:700;line-height:1.32;font-size:1.04rem;}
  .bp-relmore{margin-top:auto;color:var(--muted);font-size:.9rem;}
  .bp-back{margin-top:28px;}
  .bp-back a{color:var(--muted);text-decoration:none;font-weight:600;}
  .bp-back a:hover{color:var(--red);}
  @media (max-width:640px){
    .bp-hero{padding-top:104px;}
    .bp-relgrid{grid-template-columns:1fr;}
  }
</style>
