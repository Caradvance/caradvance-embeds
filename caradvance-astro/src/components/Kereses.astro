---
import '../styles/eladom.css';
import KeresoForm from './KeresoForm.astro';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };
---

<!-- HERO -->
<section class="hero">
  <video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-x5-poster.jpg">
    <source src="https://www.caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
  </video>
  <div class="scrim"></div>
  <div class="inner">
    <div class="partners" style="display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap">
      <img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" style="height:34px;width:auto;display:block;border-radius:6px" />
      <img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" style="height:34px;width:auto;display:block;border-radius:6px" />
      <img src="https://www.caradvance.hu/heycar.webp" alt="heycar" style="height:34px;width:auto;display:block;border-radius:6px" />
    </div>
    <h1>Mondd el, milyen autót keresel —<br /><span class="accent">mi megkeressük neked</span></h1>
    <p class="sub sub-wide" style="max-width:900px">Add meg a paramétereket lépésről lépésre. A teljes német piacról (és itthonról) kikeressük a hozzád illő autót, leinformáljuk, bevizsgáljuk és kulcsrakészen&nbsp;átadjuk.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#rendeles">Kezdjük</a>
      <a class="btn btn-white" href="/auto-rendeles#folyamat">Hogyan működik?</a>
    </div>
  </div>
  <button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<KeresoForm lang={lang} />
