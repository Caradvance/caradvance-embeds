---
import '../styles/eladom.css';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

const steps = [
['Kutatás', 'Nálunk nincs időnyomás: annyi időt szánsz a keresésre és a döntésre, amennyi csak jólesik. Nézelődj nyugodtan a hatalmas német használtautó-piacon, hasonlítsd össze a márkákat, típusokat és felszereltségeket, és formáld meg magadban, pontosan milyen autóra vágysz — akár egy konkrét modell van a fejedben, akár egyelőre csak egy irány. Nincs siettetés, nincs nyomás: akkor lépsz tovább, amikor te készen állsz rá.'],
['Kiválasztás', 'Amikor megvan a kiszemelt autó — vagy legalább körvonalazódott, mit szeretnél —, itt az idő, hogy elindítsd a keresést. Nyisd meg az Autó kereső űrlapunkat, és add meg benne a márkát, típust, évjáratot, futásteljesítményt és minden fontos részletet, ami számít neked. Amint elküldted, megkapjuk a kérésedet, és onnantól mi visszük tovább a folyamatot.'],
['Ajánlatok', 'Végigpásztázzuk a partnerplatformjainkat — mobile.de és társai —, illetve az aktuális egyedi ajánlatainkat, és összeállítunk neked 5 találatot: a legolcsóbbat, egy átlagáras opciót és 3 továbbit, ami leginkább illik a kéréseidhez. A listát emailben küldjük, ahonnan az oldalunkon választhatsz 1-2 autót — vagy jelzed, ha egyik sem az igazi, és küldünk 5 újat.'],
['Ellenőrzés', 'Kapcsolatba lépünk az eladóval, és bekérünk minden szükséges információt, hogy leellenőrizzük az autó előéletét — a szervizkönyvét és esetleges sérüléseit.'],
['Ártárgyalás', 'Sok esetben a hirdetett ár már fix, és nincs mozgástér — de ahol van rá esély, ott anyanyelvi szinten, a piac ismeretében megpróbáljuk a legjobb árat és feltételeket kialkudni az eladóval.'],
['Árajánlat', 'Elkészítjük a végleges, tételes árajánlatot: az autó ára, regisztrációs adó, műszaki vizsga, eredetvizsga, vagyonszerzési illeték, forgalmi, rendszám és törzskönyv, valamint a szállítási és ügyintézési költség — minden tétel forintban, előre rögzítve, rejtett költségek nélkül.'],
['Szerződés és előleg', 'Elküldjük a szerződést, valamint a bankszámlaadatokat — attól függően, hogy a német vagy a magyar Caradvance céggel bonyolítod le a vásárlást. Ezt követően a vételár 30%-ának előlegét kérjük, a szerződésmintát pedig aláírás előtt előre megtekintheted.'],
['Logisztika és szállítás', 'Megvásároljuk az autót a kereskedőtől, elintézzük a szükséges dokumentációt, majd profi szállítópartnerünkkel és magas értékű biztosítással hazahozzuk Magyarországra — biztonságban, egészen az ajtódig.'],
['Megtekintés és egyenleg', 'Amikor az autó megérkezett, ha szeretnéd, nyugodtan megnézheted és leellenőrizheted mindenben — csak ezután kerül sor a vételár fennmaradó 70%-ának rendezésére, a végleges átadás pedig ezt követően történik.'],
['Honosítás és vizsgáztatás', 'A teljes hivatalos ügyintézést átvállaljuk: vám- és áfaügyintézés, eredetvizsga, műszaki vizsga, okmányiroda, honosítás — gyorsan és gördülékenyen.'],
['Biztosítás és garancia', 'Kötelező gépjármű-felelősségbiztosítás (KGFB), Casco és használtautó-garancia — összeállítjuk a megfelelő védelmet, hogy nyugodt szívvel ülj a volán mögé.'],
['Kulcsrakész átadás', 'Kulcsrakészen, minden papírral és a nevedre írt forgalmival adjuk át — onnantól már csak vezetned kell.'],
];
const inclLeft = steps.slice(0, 6).map(([t]) => t);
const inclRight = steps.slice(6, 12).map(([t]) => t);
const faqs = [
['Mennyi ideig tart a teljes folyamat?', 'A kiválasztástól a kulcsrakész átadásig jellemzően 10–21 nap, az adott autótól és az ügyintézéstől függően. Az igényed jelzése után azonnal munkába állunk, és végig tájékoztatunk a folyamat állásáról.'],
['Kell személyesen kimennem Németországba?', 'Nem. Mi felkutatjuk, leinformáljuk, a helyszínen bevizsgáljuk és haza is hozzuk az autót — neked csak át kell venned a nevedre írt, forgalomba helyezett járművet itthon.'],
['Mi történik, ha a bevizsgáláskor hibát találunk?', 'Ha az autó nem felel meg az elvárásoknak, nem vásároljuk meg — inkább keresünk egy jobb darabot. A helyszíni, szakértői ellenőrzés pontosan ezt a kockázatot zárja ki, még a döntés előtt.'],
['Milyen költségekkel kell számolnom?', 'Az autó ára mellett: regisztrációs adó, műszaki vizsga, eredetvizsga, vagyonszerzési illeték, forgalmi/rendszám/törzskönyv, szállítás és ügyintézési díj. Minden tételt előre, átláthatóan, egyedi ajánlatban rögzítünk — rejtett költségek nélkül.'],
['Mennyi előleget kell fizetni?', 'Az autó lefoglalásához általában előleg szükséges; a végleges, egyedi ajánlatban pontosan rögzítjük az összes feltételt és a fizetési ütemezést.'],
['Kapok garanciát a behozott autóra?', 'Igen — magánszemélyként kötelező 1 éves jótállást adunk, és a biztosítás (KGFB, Casco) megkötésében is segítünk.'],
];
const faqJson = {
'@context': 'https://schema.org', '@type': 'FAQPage',
mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const howToJson = {
'@context': 'https://schema.org', '@type': 'HowTo',
name: 'Autóimport Németországból — a beszerzési folyamat',
description: 'Hogyan hozunk haza kulcsrakészen egy prémium használt autót Németországból, lépésről lépésre.',
step: steps.map(([t, d], i) => ({ '@type': 'HowToStep', position: i + 1, name: t, text: d })),
};
const serviceJson = {
'@context': 'https://schema.org', '@type': 'Service',
name: 'Autóimport és beszerzés Németországból — Caradvance',
serviceType: 'Prémium használt autók kulcsrakész behozatala Németországból',
areaServed: { '@type': 'Country', name: 'Magyarország' },
url: 'https://www.caradvance.hu/beszerzesi-folyamat/',
provider: { '@type': 'AutoDealer', name: 'Caradvance Hungary (BH Group Zrt.)', telephone: '+36 30 214 6989', email: 'import@caradvance.de' },
};
---
<section class="pf">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-x5-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<div class="partners" style="display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap">
<img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" style="height:34px;width:auto;display:block;border-radius:6px" />
<img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" style="height:34px;width:auto;display:block;border-radius:6px" />
</div>
<h1>Hogyan működik az autóimport? —<br /><span class="accent">tizenkét lépés a tökéletes autóig</span></h1>
<p class="sub sub-wide" style="max-width:900px">Az igényed jelzésétől a kulcsrakész átadásig mindent mi intézünk — leinformálás, bevizsgálás, szállítás, honosítás és a teljes papírmunka. Te csak átveszed az&nbsp;autót.</p>
<div class="cta-row">
<a class="btn btn-primary" href="/auto-rendeles#rendeles">Autót rendelek</a>
<a class="btn btn-white" href="/elonyok">Az import előnyei</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<section class="section" style="padding-top:56px">
<div class="wrap center">
<span class="eyebrow">Hogyan működik az autó import?</span>
<h2 class="sec-title">A beszerzési folyamat, lépésről lépésre</h2>
<p class="sec-intro">Az igényed jelzését követően egy professzionális csapattagunk felveszi veled a kapcsolatot, és onnantól kulcsrakészen mindent intézünk.</p>
</div>
<div class="wrap pf-wrap">
<div class="pf-steps">
{steps.map(([t, d], i) => (
<div class="pf-step">
<div class="pf-n">{i + 1}</div>
<div class="pf-b">
<h3>{t}</h3>
<p>{d}</p>
{i === 1 && (
<a class="pf-cta" href="/auto-rendeles#rendeles">Autó kereső indítása →</a>
)}
{i === 2 && (
<div class="pf-partners">
<img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" />
<img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" />
</div>
)}
{i === 6 && (
<a class="pf-cta" href="#">Szerződésminta megtekintése →</a>
)}
</div>
</div>
))}
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Amit átvállalunk</span>
<h2 class="sec-title">Az egész folyamat — egy kézből</h2>
<p class="sec-intro">A keresestől a forgalomba helyezésig minden lépést mi kezelünk, hogy neked ne kelljen se utazgatnod, se hivatalt járnod.</p>
</div>
<div class="wrap pf-wrap">
<div class="pf-incl">
<div class="pf-inclcol">
{inclLeft.map((t, i) => (<div class="pf-inclitem"><span class="pf-inclnum">{i + 1}</span><span>{t}</span></div>))}
</div>
<div class="pf-inclcol">
{inclRight.map((t, i) => (<div class="pf-inclitem"><span class="pf-inclnum">{i + 7}</span><span>{t}</span></div>))}
</div>
</div>
<div class="pf-time">
<div><b>10–21 nap</b><span>a kiválasztástól a kulcsrakész átadásig — ez az általános időtartam, de sok tényezőtől függ: mennyire rugalmas a kereskedő, akitől az autót vesszük, a papírmunka és a jogi ügyintézés, maga a logisztika, valamint hogy a magyarországi hivatali ügyintézés mennyire gyorsan halad. A folyamat minden lépéséről tájékoztatunk.</span></div>
</div>
</div>
</section>

<section class="section">
<div class="wrap">
<div class="pf-cta">
<div>
<h2>Kezdjük el — mondd el, mit keresel.</h2>
<p>Ingyenes és kötelezettségmentes. Import igazgatónk, Tóth Károly, személyesen kíséri végig a behozatalod.</p>
</div>
<a class="btn btn-white" href="/auto-rendeles#rendeles">Autót rendelek →</a>
</div>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap pf-seo">
<span class="eyebrow">Jó tudni</span>
<h2 class="pf-seo-h">A német autó behozatal menete — mire számíts?</h2>
<p>Sokakban felmerül, pontosan hogyan zajlik az <strong>autó behozatal Németországból</strong>, és mekkora a <span class="kw">német autó behozatal költsége</span>. A folyamat tizenkét jól elkülöníthető lépésből áll: kutatás, kiválasztás, ajánlatok, ellenőrzés, ártárgyalás, árajánlat, szerződéskötés és előleg, szállítás, megtekintés és egyenlegrendezés, vám- és áfaügyintézés, honosítás és kulcsrakész átadás.</p>
<p>A <strong>német autó behozatal menete</strong> papíron egyszerűnek tűnik, de a részletek — regisztrációs adó, eredetvizsga, műszaki vizsga, okmányiroda — sok időt és utánajárást igényelnek. A teljes <span class="kw">külföldi autó behozatal ügyintézését</span> átvállaljuk, és minden költséget előre, tételesen rögzítünk.</p>
<p>Egy <strong>német autó behozatal kalkulátor</strong> csak becslést ad; mi konkrét, egyedi ajánlatot készítünk a kiválasztott autóra — az áron nincs meglepetés, a folyamat pedig jellemzően 10–21 nap alatt lezajlik.</p>
</div>
</section>

<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések a folyamatról</h2>
</div>
<div class="wrap pf-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(howToJson)}></script>
<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
<script type="application/ld+json" set:html={JSON.stringify(serviceJson)}></script>
</section>

<style>
.pf{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.pf-wrap{max-width:900px;margin:0 auto;padding:0 20px}
.pf-steps{display:flex;flex-direction:column;gap:0}
.pf-step{display:flex;gap:20px;position:relative;padding:0 0 26px}
.pf-step:not(:last-child)::before{content:"";position:absolute;left:21px;top:46px;bottom:0;width:2px;background:var(--line)}
.pf-n{flex:0 0 auto;width:44px;height:44px;border-radius:13px;background:var(--navy);color:#fff;font-weight:800;font-size:18px;display:flex;align-items:center;justify-content:center;position:relative;z-index:1}
.pf-step:last-child .pf-n{background:var(--red)}
.pf-b{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px 22px;flex:1;box-shadow:0 10px 30px rgba(8,8,10,.05)}
.pf-b h3{font-size:18px;font-weight:800;margin:0 0 6px;color:var(--ink)}
.pf-b p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0}
.pf-gap{position:absolute;left:21px;bottom:0;transform:translate(-50%,50%);z-index:2;background:#fff;border:1px solid var(--line);color:var(--navy);font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}
a.pf-cta{display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-weight:700;font-size:14px;color:#fff;background:var(--red);padding:8px 16px;border-radius:999px;text-decoration:none}
a.pf-cta:hover{opacity:.9}
.pf-partners{display:flex;align-items:center;gap:14px;margin-top:12px;flex-wrap:wrap}
.pf-partners img{height:28px;width:auto;display:block;border-radius:6px}
.pf-incl{display:grid;grid-template-columns:1fr 1fr;gap:24px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px}
@media(max-width:640px){.pf-incl{grid-template-columns:1fr}}
.pf-inclcol{display:flex;flex-direction:column;gap:12px}
.pf-inclitem{display:flex;align-items:flex-start;gap:10px;font-size:15px;font-weight:600;color:var(--ink)}
.pf-check{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:#e8f7ee;color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;margin-top:1px}
.pf-inclnum{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;margin-top:1px}
.pf-time{margin-top:16px}
.pf-time>div{background:#0B0B0D;color:#fff;border-radius:16px;padding:28px 32px;text-align:center;max-width:640px;margin:0 auto}
.pf-time b{display:block;font-size:26px;font-weight:800;color:#fff;margin-bottom:8px}
.pf-time span{color:#9aa7b8;font-size:14px;line-height:1.6}
.pf-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.pf-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.pf-cta p{color:#cfd6e2;margin:0;font-size:15px;max-width:560px}
.pf-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px;padding-bottom:20px}
.pf-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.pf-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.pf-faq summary::-webkit-details-marker{display:none}
.pf-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.pf-faq details[open] .pl{transform:rotate(45deg)}
.pf-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
.pf-seo{max-width:820px;margin:0 auto}
.pf-seo-h{font-size:clamp(24px,3.4vw,34px);font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:10px 0 18px}
.pf-seo p{color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 16px}
.pf-seo strong{color:var(--ink);font-weight:700}
.pf-seo .kw{color:var(--red);font-weight:700}
</style>
