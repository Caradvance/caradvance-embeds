---
import '../styles/eladom.css';
import LizingKalkulator from './LizingKalkulator.astro';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

// Finanszírozó / lízing partnereink
const partners = [
  {
    name: 'Euro Leasing',
    tag: 'MBH Bankcsoport',
    href: 'https://www.euroleasing.hu/konstrukciok/',
    accent: '#0a4d8c',
    logo: '/mbh-euroleasing-logo.svg',
    d: 'Nyíltvégű és zártvégű pénzügyi lízing magánszemélyeknek és vállalkozásoknak, forint és euró alapon, fix vagy változó kamatozással. Igazolt euró bevétel esetén kedvezőbb euró finanszírozás is elérhető.',
    points: ['Nyíltvégű és zártvégű pénzügyi lízing', 'HUF és EUR alapú konstrukció', 'Maradványértékkel csökkenő havi részlet', 'Beépített casco és GAP biztosítás'],
  },
  {
    name: 'Merkantil Bank',
    tag: 'OTP Bankcsoport',
    href: 'https://www.merkantil.hu/hu/Gepjarmulizing/Uj-ugyfeleknek',
    accent: '#0a7d3c',
    logo: '/merkantil-bank-logo-tr.png',
    d: 'Személyre szabott gépjárműlízing új és használt autóra egyaránt, gyors bírálattal és rugalmas futamidővel. Az igényléstől a folyósításig végig szakértői támogatással — akár közvetlenül magánszemélytől vásárolt autóra is elérhető.',
    points: ['Új és használt személyautó finanszírozása', 'Gyors, online kalkuláció és bírálat', 'Rugalmas futamidő és önerő', 'Kényelmes, akár helyszíni szerződéskötés'],
  },
];

const types = [
  {
    t: 'Nyíltvégű pénzügyi lízing',
    d: 'A futamidő végén te döntöd el, kire szálljon a tulajdonjog: megveszed, harmadik felet jelölsz ki, vagy visszaadod az autót. Maradványértékes konstrukció, így a havi részlet alacsonyabb. Vállalkozásként a lízingdíjak tőkerészének áfája – jogszabályi feltételekkel – visszaigényelhető.',
    tags: ['Alacsonyabb havi részlet', 'Rugalmas lezárás', 'Áfa-visszaigénylés (cégnek)'],
  },
  {
    t: 'Zártvégű pénzügyi lízing',
    d: 'A futamidő végén – az összes díj rendezése után – automatikusan a tiéd lesz az autó. Nincs maradványérték, a részlet a teljes finanszírozott összegre szól. Biztonságos forma: a futamidő alatt a finanszírozó a tulajdonos, így az autót nem terhelheti más jellegű tartozás.',
    tags: ['Automatikus tulajdonszerzés', 'Kiszámítható', 'Nincs záró nagyrészlet'],
  },
  {
    t: 'Euró finanszírozás',
    d: 'Euró árbevétellel rendelkező vállalkozásoknak — a forint kamatokhoz képest jellemzően jelentősen alacsonyabb kamatszinttel. Nyíltvégű és zártvégű formában egyaránt elérhető, fix vagy változó kamatozással. Kizárólag igazolt euró bevétel esetén igényelhető.',
    tags: ['Kedvezőbb kamatszint', 'Csak igazolt EUR bevétellel', 'Nyílt és zárt is'],
  },
];

const benefits = [
  'A lízingdíj kamatrésze vállalkozásoknál költségként elszámolható.',
  'Nyíltvégűnél a beszerzési ár áfája nem része a lízingtőkének, így a fizetendő kamat kevesebb, mint hasonló ütemezésű zártvégűnél.',
  'A lízingbevevő vállalkozások jogosultak az értékcsökkenés elszámolására.',
  'Maradványértékes konstrukcióval csökkenthető a havi törlesztőrészlet.',
  'Új és használt autó finanszírozására is igénybe vehető.',
  'Meghatározott feltételek mellett a szerződés akár biztosításmentesen is megköthető.',
];

const docs = [
  { g: 'Magánszemélyeknek', items: ['Kitöltött lízingkérelmi adatlap', 'Munkáltatói jövedelemigazolás vagy az utolsó 3 havi bankszámlakivonat', 'Személyi igazolvány'] },
  { g: 'Egyéni vállalkozók, őstermelők', items: ['Lízingkérelmi adatlap', '30 napnál nem régebbi NAV folyószámla-kivonat (köztartozásmentesnél nem szükséges)', 'Személyi igazolvány másolat'] },
  { g: 'Társas vállalkozások', items: ['Lízingkérelmi adatlap', '30 napnál nem régebbi NAV folyószámla-kivonat', 'Aláírási címpéldány'] },
];

const steps = [
  { t: 'Kiválasztod az autót', d: 'Kiválasztod a bérelhető vagy megvásárolható autóink közül a megfelelőt, vagy egyedi rendelést indítasz.' },
  { t: 'Kalkuláció és ajánlat', d: 'A kalkulátorral megbecsülöd a havi részletet, majd partnerünkön keresztül személyre szabott, pontos ajánlatot kérünk.' },
  { t: 'Bírálat és szerződés', d: 'A finanszírozó elvégzi a hitelbírálatot; ennek eredménye után aláírjátok a lízingszerződést.' },
  { t: 'Folyósítás és átvétel', d: 'A finanszírozó kifizeti a vételárat, mi pedig kulcsrakészen átadjuk az autót.' },
];

const faqs: [string, string][] = [
  ['Mit jelent az autó lízing?', 'Az autó lízing olyan finanszírozási forma, amelynél a lízingcég megveszi az általad kiválasztott autót, te pedig havi részletekben fizetsz a használatáért. Nyíltvégű lízingnél a futamidő végén te döntesz a tulajdonjogról, zártvégűnél a záró díj után automatikusan a tiéd lesz az autó.'],
  ['Igényelhető autó lízing magánszemélyként?', 'Igen, az autó lízing magánszemélyeknek és cégeknek egyaránt elérhető, új és használt személyautóra is. Magánszemélyként bruttó árral, vállalkozásként nettó alapon — áfa-visszaigénylési lehetőséggel — számolunk.'],
  ['Van autó lízing önerő nélkül vagy alacsony önerővel?', 'Az önerő mértéke a konstrukciótól és a hitelbírálattól függ. A lízingkalkulátorban 0%-tól szabadon állíthatod, és azonnal látod, hogyan változik tőle a havi részlet; a pontos elvárt önerőt az egyedi ajánlat rögzíti.'],
  ['Használt autóra is van lízing?', 'Igen. Mind az Euro Leasing, mind a Merkantil Bank finanszíroz új és használt autót is, típusonként eltérő korhatárokkal. A jármű kora és állapota befolyásolhatja a felajánlott kamatot.'],
  ['Mik az autó lízing feltételei?', 'Jellemzően magyarországi lakcím, igazolható jövedelem és pozitív hitelbírálat szükséges; vállalkozásoknál a cég adatai és a köztartozásmentesség számít. A pontos feltételeket a finanszírozó szabja meg.'],
  ['Autó lízing vagy autóhitel — mi a különbség?', 'Lízingnél a futamidő alatt a finanszírozó a tulajdonos, te üzembentartóként használod az autót; hitelnél rögtön a te tulajdonod. A lízing gyakran rugalmasabb önerőt és cégeknél áfa-előnyt kínál.'],
  ['Mi történik az autó lízing lejárta után?', 'Zártvégű lízingnél az utolsó díj rendezése után automatikusan a tiéd lesz az autó. Nyíltvégűnél megveheted a maradványértéken, harmadik felet jelölhetsz ki, vagy visszaadhatod az autót.'],
  ['Ki intézi a finanszírozást?', 'A finanszírozást finanszírozó és lízing partnereinken – az Euro Leasingen és a Merkantil Bankon – keresztül biztosítjuk. Segítünk kiválasztani a megfelelő konstrukciót és összekötünk a partnerrel; a hitelbírálatot és a szerződést a finanszírozó végzi.'],
  ['Forintban vagy euróban finanszírozhatok?', 'Mindkettő elérhető. A forint alapú lízing bárkinek nyitva áll; az euró alapú, jellemzően kedvezőbb kamatszintű finanszírozás igazolt euró bevétellel rendelkező vállalkozásoknak szól.'],
  ['Mennyire pontos a lízingkalkulátor?', 'A lízingkalkulátor az Euroleasing valós, futamidőnkénti kamat- és THM-táblázatára van kalibrálva, így a becsült havi részlet közel áll a tényleges ajánlathoz. A végleges THM-et (0,0%–30,25%) és a kamatot mindig az egyedi hitelbírálat rögzíti.'],
];
const SITE = 'https://www.caradvance.hu';
const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const breadcrumbJson = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kezdőlap', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Megvásárolható autóink', item: SITE + '/autoink/' },
    { '@type': 'ListItem', position: 3, name: 'Autó lízing és finanszírozás', item: SITE + '/finanszirozas-lizing/' },
  ],
};
const serviceJson = {
  '@context': 'https://schema.org', '@type': 'FinancialProduct',
  name: 'Autó lízing és finanszírozás',
  serviceType: 'Gépjárműlízing – nyíltvégű és zártvégű pénzügyi lízing',
  category: 'Autófinanszírozás',
  url: SITE + '/finanszirozas-lizing/',
  areaServed: { '@type': 'Country', name: 'Magyarország' },
  description: 'Autó lízing magánszemélyeknek és cégeknek, új és használt autóra — nyíltvégű és zártvégű pénzügyi lízing forint vagy euró alapon, az Euro Leasing és a Merkantil Bank feltételei alapján.',
  provider: { '@type': 'AutoDealer', name: 'CarAdvance (BH Group Zrt.)', url: SITE + '/', telephone: '+36 30 214 6989' },
};
const calcJson = {
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: 'Lízingkalkulátor – CarAdvance',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  url: SITE + '/finanszirozas-lizing/#kalkulator',
  description: 'Autó lízing kalkulátor: számold ki a becsült havi részletet, a THM-et és az ügyleti kamatot futamidő, önerő és konstrukció szerint.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'HUF' },
};
const jsonLdAll = [faqJson, breadcrumbJson, serviceJson, calcJson];
---
<section class="fl">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="/finanszirozas-hero-poster.jpg">
<source src="/finanszirozas-hero.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<div class="fl-herologos"><span class="fl-herobar">
<img class="fl-hl-logo" src="/mbh-euroleasing-logo.svg" alt="Euro Leasing" />
<span class="fl-hl-sep"></span>
<img class="fl-hl-logo" src="/merkantil-bank-logo-tr.png" alt="Merkantil Bank" />
</span></div>
<h1>Autó lízing és finanszírozás —<br /><span class="accent">a te ütemedben</span></h1>
<p class="sub sub-wide" style="max-width:840px">Autó lízing magánszemélyeknek és cégeknek, új és használt autóra — nyíltvégű és zártvégű pénzügyi lízing, forint vagy euró alapon. Számold ki a havi részleted a lízingkalkulátorral.</p>
<div class="cta-row">
<a class="btn btn-primary" href="#kalkulator">Havi részlet kiszámítása</a>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<!-- Partnerek -->
<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap center">
<span class="eyebrow">Finanszírozó partnereink</span>
<h2 class="sec-title">Rajtunk keresztül finanszírozáshoz juthatsz</h2>
<p class="sec-intro">Az autó lízinget és finanszírozást finanszírozó és lízing partnereinken keresztül biztosítjuk. Segítünk kiválasztani a megfelelő lízingkonstrukciót, és összekötünk a partnerrel — a hitelbírálatot és a szerződést a finanszírozó intézi.</p>
</div>
<div class="wrap fl-partners">
{partners.map((p) => (
<a class="fl-pcard" href={p.href} target="_blank" rel="noopener noreferrer" style={`--pa:${p.accent}`}>
<div class="fl-plogo"><img src={p.logo} alt={p.name} loading="lazy" onerror={`this.style.display='none';this.parentNode.classList.add('txt');this.parentNode.textContent='${p.name}'`} /></div>
<div class="fl-ptop">
<span class="fl-ptag">{p.tag}</span>
<h3>{p.name}</h3>
</div>
<p class="fl-pd">{p.d}</p>
<ul class="fl-plist">
{p.points.map((pt) => (<li>{pt}</li>))}
</ul>
<span class="fl-plink">Tovább a partner oldalára ↗</span>
</a>
))}
</div>
</section>

<!-- Lízingtípusok -->
<section class="section" style="padding-top:24px">
<div class="wrap center">
<span class="eyebrow">Konstrukciók</span>
<h2 class="sec-title">Milyen autó lízing típus közül választhatsz?</h2>
<p class="sec-intro">Az autó lízingnek két fő formája van. Mindkét pénzügyi lízing elérhető forint és euró alapon, fix vagy változó kamatozással, új és használt autóra egyaránt — magánszemélyeknek és cégeknek is.</p>
</div>
<div class="wrap fl-types">
{types.map((ty) => (
<div class="fl-tcard">
<h3>{ty.t}</h3>
<p>{ty.d}</p>
<div class="fl-tags">{ty.tags.map((x) => (<span>{x}</span>))}</div>
</div>
))}
</div>
<div class="wrap"><p class="fl-note">Az euró alapú finanszírozás a forint kamatokhoz képest jellemzően alacsonyabb kamatszintet kínál, de kizárólag igazolt euró bevétellel rendelkező vállalkozások számára elérhető.</p></div>
</section>

<!-- Kalkulátor -->
<section class="section" id="kalkulator" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Kalkulátor</span>
<h2 class="sec-title">Autó lízing kalkulátor — mennyi lesz a havi részlet?</h2>
<p class="sec-intro">Lízingkalkulátorunkban állítsd be az autó árát, az önerőt, a futamidőt és a konstrukciót — azonnal megmutatjuk a becsült havi részletet, a THM-et és az ügyleti kamatot.</p>
</div>
<div class="wrap">
<LizingKalkulator title="Lízingkalkulátor" rate={9.59} />
</div>
</section>

<!-- Előnyök -->
<section class="section" style="padding-top:16px">
<div class="wrap center">
<span class="eyebrow">Előnyök</span>
<h2 class="sec-title">Miért jó választás az autó lízing?</h2>
<p class="sec-intro">A pénzügyi lízing rugalmas és — főleg vállalkozásoknak — adóoptimális módja az autóvásárlásnak.</p>
</div>
<div class="wrap fl-benefits">
{benefits.map((b) => (<div class="fl-b"><span class="fl-check">✓</span><p>{b}</p></div>))}
</div>
</section>

<!-- Dokumentumok -->
<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Igénylés</span>
<h2 class="sec-title">Mire van szükség az autó lízing igényléséhez?</h2>
<p class="sec-intro">A pontos dokumentumlistát a finanszírozó adja meg — jellemzően az alábbiakra van szükség.</p>
</div>
<div class="wrap fl-docs">
{docs.map((d) => (
<div class="fl-doc">
<h3>{d.g}</h3>
<ul>{d.items.map((x) => (<li>{x}</li>))}</ul>
</div>
))}
</div>
</section>

<!-- Folyamat -->
<section class="section" style="padding-top:16px">
<div class="wrap center">
<span class="eyebrow">Hogyan zajlik?</span>
<h2 class="sec-title">Négy lépés a finanszírozásig</h2>
</div>
<div class="wrap fl-steps">
{steps.map((s, i) => (
<div class="fl-step">
<div class="fl-sn">{i + 1}</div>
<h3>{s.t}</h3>
<p>{s.d}</p>
</div>
))}
</div>
</section>

<!-- CTA -->
<section class="section">
<div class="wrap">
<div class="fl-cta">
<div>
<h2>Beszéljük át a finanszírozásodat.</h2>
<p>Mondd el, melyik autót nézed ki, és segítünk kiválasztani a hozzád illő lízingkonstrukciót — a becsléstől a kész ajánlatig.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek →</a>
</div>
</div>
</section>

<!-- GYIK -->
<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések a finanszírozásról</h2>
</div>
<div class="wrap fl-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
</section>

{jsonLdAll.map((j) => (<script type="application/ld+json" set:html={JSON.stringify(j)}></script>))}
</section>

<style>
.fl{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.fl .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
/* Hero partner logos — bare white marks above the title */
.fl-herologos{display:flex;justify-content:center;margin:0 0 22px}
.fl-herobar{display:inline-flex;align-items:center;gap:22px;background:#fff;border-radius:14px;padding:12px 22px;box-shadow:0 10px 26px rgba(0,0,0,.22)}
.fl-hl-logo{height:26px;width:auto;object-fit:contain;display:block}
.fl-hl-sep{width:1px;height:22px;background:#e2e6ee}
@media(max-width:560px){.fl-herobar{gap:14px;padding:10px 16px}.fl-hl-logo{height:22px}}
@media(max-width:560px){.fl-herologos{gap:16px}.fl-hl-logo{height:22px}}
/* Partner cards */
.fl-partners{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:24px}
@media(max-width:820px){.fl-partners{grid-template-columns:1fr}}
.fl-pcard{position:relative;display:block;background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px 26px 22px;text-decoration:none;color:inherit;box-shadow:0 12px 34px rgba(8,8,10,.05);transition:.18s;overflow:hidden}
.fl-pcard::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--pa)}
.fl-pcard:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(8,8,10,.12);border-color:var(--pa)}
.fl-plogo{display:flex;align-items:center;height:40px;margin-bottom:16px}
.fl-plogo img{max-height:38px;max-width:210px;width:auto;object-fit:contain;display:block}
.fl-plogo.txt{font-weight:800;font-size:20px;color:var(--pa);letter-spacing:-.01em}
.fl-ptag{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--pa)}
.fl-ptop h3{font-size:24px;font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:4px 0 0}
.fl-pd{color:var(--muted);font-size:14.5px;line-height:1.6;margin:12px 0 14px}
.fl-plist{list-style:none;margin:0 0 16px;padding:0;display:flex;flex-direction:column;gap:7px}
.fl-plist li{position:relative;padding-left:24px;color:var(--ink);font-size:14px;font-weight:600}
.fl-plist li::before{content:"✓";position:absolute;left:0;top:0;width:18px;height:18px;border-radius:50%;background:#e8f7ee;color:#16a34a;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center}
.fl-plink{font-weight:800;font-size:14.5px;color:var(--pa)}
/* Type cards */
.fl-types{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}
@media(max-width:900px){.fl-types{grid-template-columns:1fr}}
/* Benefits */
.fl-benefits{display:grid;grid-template-columns:1fr 1fr;gap:14px 24px;margin-top:22px}
@media(max-width:720px){.fl-benefits{grid-template-columns:1fr}}
.fl-b{display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.fl-check{flex:0 0 auto;width:24px;height:24px;border-radius:50%;background:#e8f7ee;color:#16a34a;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}
.fl-b p{color:var(--ink);font-size:14.5px;line-height:1.55;margin:0;font-weight:600}
/* Docs */
.fl-docs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
@media(max-width:900px){.fl-docs{grid-template-columns:1fr}}
.fl-doc{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 24px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
