---
import '../styles/eladom.css';
import LizingKalkulator from './LizingKalkulator.astro';
import type { Locale } from '../i18n/utils';
const { lang } = Astro.props as { lang: Locale };

// Finanszírozó / lízing partnereink
const partners = [
  {
    name: 'Euro Leasing',
    tag: 'MBH Bankcsoport',
    href: '/finanszirozas-lizing/euro-leasing',
    accent: '#0a4d8c',
    logo: '/mbh-euroleasing-logo.svg',
    d: 'Nyíltvégű és zártvégű pénzügyi lízing magánszemélyeknek és vállalkozásoknak, forint és euró alapon, fix vagy változó kamatozással. Igazolt euró bevétel esetén kedvezőbb euró finanszírozás is elérhető.',
    points: ['Nyíltvégű és zártvégű pénzügyi lízing', 'HUF és EUR alapú konstrukció', 'Maradványértékkel csökkenő havi részlet', 'Beépített casco és GAP biztosítás'],
  },
  {
    name: 'Merkantil Bank',
    tag: 'OTP Bankcsoport',
    href: '/finanszirozas-lizing/merkantil-bank',
    accent: '#0a7d3c',
    logo: '/merkantil-bank-logo-tr.png',
    d: 'Személyre szabott gépjárműlízing új és használt autóra egyaránt, gyors bírálattal és rugalmas futamidővel. Az igényléstől a folyósításig végig szakértői támogatással — akár közvetlenül magánszemélytől vásárolt autóra is elérhető.',
    points: ['Új és használt személyautó finanszírozása', 'Gyors, online kalkuláció és bírálat', 'Rugalmas futamidő és önerő', 'Kényelmes, akár helyszíni szerződéskötés'],
  },
];

const types = [
  {
    t: 'Nyíltvégű pénzügyi lízing',
    d: 'A futamidő végén te döntöd el, kire szálljon a tulajdonjog: megveszed, harmadik felet jelölsz ki, vagy visszaadod az autót. Maradványértékes konstrukció, így a havi részlet alacsonyabb. Vállalkozásként a lízingdíjak tőkerészének áfája – jogszabályi feltételekkel – visszaigényelhető.',
    tags: ['Alacsonyabb havi részlet', 'Rugalmas lezárás', 'Áfa-visszaigénylés (cégnek)'],
  },
  {
    t: 'Zártvégű pénzügyi lízing',
    d: 'A futamidő végén – az összes díj rendezése után – automatikusan a tiéd lesz az autó. Nincs maradványérték, a részlet a teljes finanszírozott összegre szól. Biztonságos forma: a futamidő alatt a finanszírozó a tulajdonos, így az autót nem terhelheti más jellegű tartozás.',
    tags: ['Automatikus tulajdonszerzés', 'Kiszámítható', 'Nincs záró nagyrészlet'],
  },
];

const steps = [
  { t: 'Kiválasztod az autót', d: 'Kiválasztod a bérelhető vagy megvásárolható autóink közül a megfelelőt, vagy egyedi rendelést indítasz.' },
  { t: 'Kalkuláció és ajánlat', d: 'A kalkulátorral megbecsülöd a havi részletet, majd partnerünkön keresztül személyre szabott, pontos ajánlatot kérünk.' },
  { t: 'Bírálat és szerződés', d: 'A finanszírozó elvégzi a hitelbírálatot; ennek eredménye után aláírjátok a lízingszerződést.' },
  { t: 'Folyósítás és átvétel', d: 'A finanszírozó kifizeti a vételárat, mi pedig kulcsrakészen átadjuk az autót.' },
];

const faqs: [string, string][] = [
  ['Ki intézi a finanszírozást?', 'A finanszírozást finanszírozó és lízing partnereinken – az Euro Leasingen és a Merkantil Bankon – keresztül tudjuk biztosítani. Mi segítünk kiválasztani a megfelelő konstrukciót, és összekötünk a partnerrel; a hitelbírálatot és a szerződést a finanszírozó végzi.'],
  ['Magánszemélyként is igényelhetek lízinget?', 'Igen. Nyíltvégű és zártvégű pénzügyi lízing egyaránt elérhető magánszemélyek számára is, személygépkocsi és motorkerékpár finanszírozására. Az euró alapú finanszírozás azonban csak igazolt euró bevétellel rendelkező vállalkozásoknak nyújtható.'],
  ['Mennyi önerő szükséges?', 'Az önerő mértéke a konstrukciótól és a hitelbírálattól függ. A kalkulátorban szabadon állíthatod, így látod, hogyan változik tőle a havi részlet. A pontos elvárt önerőt az egyedi ajánlat rögzíti.'],
  ['Forintban vagy euróban finanszírozhatok?', 'Mindkettő elérhető. A forint alapú konstrukció bárkinek nyitva áll; az euró alapú, jellemzően alacsonyabb kamatszintű finanszírozás igazolt euró bevétellel rendelkező vállalkozásoknak szól.'],
  ['Mennyire pontos a kalkulátor?', 'A kalkulátor tájékoztató jellegű becslést ad a valós, reprezentatív THM-példák alapján. A tényleges havi részletet, a THM-et (0,0%–30,25%) és a kamatot mindig az egyedi hitelbírálat és a finanszírozó ajánlata határozza meg.'],
];
const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<section class="fl">
<section class="hero">
<video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-beszerzesi-poster.jpg">
<source src="https://www.caradvance.hu/caradvance-hero-beszerzesi.mp4" type="video/mp4" />
</video>
<div class="scrim"></div>
<div class="inner">
<div class="fl-herologos">
<img class="fl-hl-logo" src="/mbh-euroleasing-logo.svg" alt="Euro Leasing" />
<span class="fl-hl-sep"></span>
<img class="fl-hl-logo" src="/merkantil-bank-logo-tr.png" alt="Merkantil Bank" />
</div>
<h1>Finanszírozás és lízing —<br /><span class="accent">a te ütemedben</span></h1>
<p class="sub sub-wide" style="max-width:760px">Nem kell egy összegben kifizetned az autót — finanszírozó és lízing partnereinken keresztül kulcsrakész lízinget intézünk, forint vagy euró alapon.</p>
<div class="cta-row">
<a class="btn btn-primary" href="#kalkulator">Havi részlet kiszámítása</a>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek</a>
</div>
</div>
<button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

<!-- Partnerek -->
<section class="section" style="padding-top:56px;padding-bottom:8px">
<div class="wrap center">
<span class="eyebrow">Finanszírozó partnereink</span>
<h2 class="sec-title">Rajtunk keresztül finanszírozáshoz juthatsz</h2>
<p class="sec-intro">Ezek a finanszírozó és lízing partnereink, akiken keresztül finanszírozást tudunk biztosítani neked. Segítünk kiválasztani a megfelelő konstrukciót, és összekötünk a partnerrel — a bírálatot és a szerződést a finanszírozó intézi.</p>
</div>
<div class="wrap fl-partners">
{partners.map((p) => (
<a class="fl-pcard" href={p.href} style={`--pa:${p.accent}`}>
<div class="fl-plogo"><img src={p.logo} alt={p.name} loading="lazy" onerror={`this.style.display='none';this.parentNode.classList.add('txt');this.parentNode.textContent='${p.name}'`} /></div>
<div class="fl-ptop">
<span class="fl-ptag">{p.tag}</span>
<h3>{p.name}</h3>
</div>
<p class="fl-pd">{p.d}</p>
<ul class="fl-plist">
{p.points.map((pt) => (<li>{pt}</li>))}
</ul>
<span class="fl-plink">Részletek és kalkulátor →</span>
</a>
))}
</div>
</section>

<!-- Lízingtípusok -->
<section class="section" style="padding-top:24px">
<div class="wrap center">
<span class="eyebrow">Konstrukciók</span>
<h2 class="sec-title">Milyen lízingtípus közül választhatsz?</h2>
<p class="sec-intro">Kétféle pénzügyi lízing közül választhatsz — mindkettő elérhető forint és euró alapon, fix vagy változó kamatozással.</p>
</div>
<div class="wrap fl-types">
{types.map((ty) => (
<div class="fl-tcard">
<h3>{ty.t}</h3>
<p>{ty.d}</p>
<div class="fl-tags">{ty.tags.map((x) => (<span>{x}</span>))}</div>
</div>
))}
</div>
<div class="wrap"><p class="fl-note">Az euró alapú finanszírozás a forint kamatokhoz képest jellemzően alacsonyabb kamatszintet kínál, de kizárólag igazolt euró bevétellel rendelkező vállalkozások számára elérhető.</p></div>
</section>

<!-- Kalkulátor -->
<section class="section" id="kalkulator" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">Kalkulátor</span>
<h2 class="sec-title">Mennyibe kerülne havonta?</h2>
<p class="sec-intro">Állítsd be az autó árát, az önerőt, a futamidőt és a konstrukciót — azonnal megmutatjuk a becsült havi részletet.</p>
</div>
<div class="wrap">
<LizingKalkulator title="Lízingkalkulátor" rate={9.59} />
</div>
</section>

<!-- Folyamat -->
<section class="section" style="padding-top:16px">
<div class="wrap center">
<span class="eyebrow">Hogyan zajlik?</span>
<h2 class="sec-title">Négy lépés a finanszírozásig</h2>
</div>
<div class="wrap fl-steps">
{steps.map((s, i) => (
<div class="fl-step">
<div class="fl-sn">{i + 1}</div>
<h3>{s.t}</h3>
<p>{s.d}</p>
</div>
))}
</div>
</section>

<!-- CTA -->
<section class="section">
<div class="wrap">
<div class="fl-cta">
<div>
<h2>Beszéljük át a finanszírozásodat.</h2>
<p>Mondd el, melyik autót nézed ki, és segítünk kiválasztani a hozzád illő lízingkonstrukciót — a becsléstől a kész ajánlatig.</p>
</div>
<a class="btn btn-white" href="/kapcsolat">Ajánlatot kérek →</a>
</div>
</div>
</section>

<!-- GYIK -->
<section class="section" style="padding-top:8px">
<div class="wrap center">
<span class="eyebrow">GYIK</span>
<h2 class="sec-title">Gyakori kérdések a finanszírozásról</h2>
</div>
<div class="wrap fl-faq">
{faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
</section>

<style>
.fl{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1}
.fl .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
/* Hero partner logos — bare white marks above the title */
.fl-herologos{display:flex;align-items:center;justify-content:center;gap:24px;margin:0 0 20px}
.fl-hl-logo{height:30px;width:auto;object-fit:contain;display:block;filter:drop-shadow(0 1px 6px rgba(0,0,0,.55));-webkit-filter:drop-shadow(0 1px 6px rgba(0,0,0,.55))}
.fl-hl-sep{width:1px;height:24px;background:rgba(255,255,255,.5)}
@media(max-width:560px){.fl-herologos{gap:16px}.fl-hl-logo{height:22px}}
/* Partner cards */
.fl-partners{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:24px}
@media(max-width:820px){.fl-partners{grid-template-columns:1fr}}
.fl-pcard{position:relative;display:block;background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px 26px 22px;text-decoration:none;color:inherit;box-shadow:0 12px 34px rgba(8,8,10,.05);transition:.18s;overflow:hidden}
.fl-pcard::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--pa)}
.fl-pcard:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(8,8,10,.12);border-color:var(--pa)}
.fl-plogo{display:flex;align-items:center;height:40px;margin-bottom:16px}
.fl-plogo img{max-height:38px;max-width:210px;width:auto;object-fit:contain;display:block}
.fl-plogo.txt{font-weight:800;font-size:20px;color:var(--pa);letter-spacing:-.01em}
.fl-ptag{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--pa)}
.fl-ptop h3{font-size:24px;font-weight:800;letter-spacing:-.02em;color:var(--ink);margin:4px 0 0}
.fl-pd{color:var(--muted);font-size:14.5px;line-height:1.6;margin:12px 0 14px}
.fl-plist{list-style:none;margin:0 0 16px;padding:0;display:flex;flex-direction:column;gap:7px}
.fl-plist li{position:relative;padding-left:24px;color:var(--ink);font-size:14px;font-weight:600}
.fl-plist li::before{content:"✓";position:absolute;left:0;top:0;width:18px;height:18px;border-radius:50%;background:#e8f7ee;color:#16a34a;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center}
.fl-plink{font-weight:800;font-size:14.5px;color:var(--pa)}
/* Type cards */
.fl-types{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px}
@media(max-width:820px){.fl-types{grid-template-columns:1fr}}
.fl-tcard{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(8,8,10,.05)}
.fl-tcard h3{font-size:19px;font-weight:800;color:var(--ink);margin:0 0 8px}
.fl-tcard p{color:var(--muted);font-size:14.5px;line-height:1.65;margin:0 0 14px}
.fl-tags{display:flex;flex-wrap:wrap;gap:8px}
.fl-tags span{background:#f1f4f9;color:var(--navy);font-size:12.5px;font-weight:700;padding:6px 11px;border-radius:999px}
.fl-note{max-width:1080px;margin:18px auto 0;background:#fbfcfe;border:1px dashed var(--line);border-radius:14px;padding:14px 18px;color:var(--muted);font-size:13.5px;line-height:1.6}
/* Steps */
.fl-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:22px}
@media(max-width:820px){.fl-steps{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.fl-steps{grid-template-columns:1fr}}
.fl-step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 8px 24px rgba(8,8,10,.04)}
.fl-sn{width:38px;height:38px;border-radius:11px;background:var(--navy);color:#fff;font-weight:800;font-size:16px;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.fl-step:last-child .fl-sn{background:var(--red)}
.fl-step h3{font-size:16px;font-weight:800;color:var(--ink);margin:0 0 6px}
.fl-step p{color:var(--muted);font-size:13.5px;line-height:1.55;margin:0}
/* CTA */
.fl-cta{max-width:1080px;margin:0 auto;background:#0B0B0D;color:#fff;border-radius:22px;padding:34px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.fl-cta h2{font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 6px;letter-spacing:-.02em}
.fl-cta p{color:#cfd6e2;margin:0;font-size:15px;max-width:560px}
/* FAQ */
.fl-faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px;padding-bottom:20px}
.fl-faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 18px}
.fl-faq summary{list-style:none;cursor:pointer;font-weight:800;font-size:16px;padding:16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--ink)}
.fl-faq summary::-webkit-details-marker{display:none}
.fl-faq .pl{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#fdeaec;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
.fl-faq details[open] .pl{transform:rotate(45deg)}
.fl-faq p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0 0 16px}
</style>
