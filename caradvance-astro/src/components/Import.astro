---
import { type Locale } from '../i18n/utils';
import '../styles/eladom.css';
const { lang } = Astro.props as { lang: Locale };

const benefits = [
  ['Hatalmas választék', 'Sokszorosa a hazai kínálatnak — a teljes német piactérből keresünk, így nagyobb az esély a tökéletes darabra.'],
  ['Jobb állapotú autók', 'A német autók jellemzően kevésbé koptatottak és gondozottabbak, mint az azonos korú hazai darabok.'],
  ['Kiváló úthálózat', 'A jó minőségű utak kímélik a futóművet és a karosszériát — kevesebb rejtett kopás, hosszabb élettartam.'],
  ['Rendszeres karbantartás', 'Erős szervizkultúra: a tulajdonosok gyakrabban viszik átvizsgálásra az autót, így a műszaki állapot is megbízhatóbb.'],
  ['Alacsonyabb futás', 'Sok autó kevesebbet és kíméletesebben futott a hazai átlagnál — a kor mögött gyakran sokkal jobb valós állapot van.'],
  ['Dokumentált múlt', 'Vezetett szervizkönyv és átlátható előélet — pontosan tudod, mit veszel, meglepetések nélkül.'],
];

const compare = [
  ['Keresés a német piacon', 'Órák böngészése, nyelvi akadály, megbízható szűrés nélkül', 'A teljes piacot átnézzük helyetted'],
  ['Az autó leinformálása', 'Rejtett kár vagy tekert km-óra kockázata', 'Nemzetközi adatbázisból ellenőrizzük'],
  ['Helyszíni bevizsgálás', 'Utazol Németországba, vagy látatlanban veszel', 'Szakértőnk a helyszínen átvizsgálja'],
  ['Tárgyalás, kommunikáció', 'Németül kell alkudnod, hátrányból', 'Helyetted tárgyalunk, anyanyelvi szinten'],
  ['Szállítás', 'Magadnak intézed, sokszor biztosítás nélkül', 'Profi speditőr, magas értékű biztosítással'],
  ['Honosítás és ügyintézés', 'Eredetvizsga, vizsga, okmányiroda — sorban állás, buktatók', 'A teljes hivatalos ügyintézést átvállaljuk'],
  ['Rejtett költségek', 'Váratlan tételek, árfolyamkockázat', 'Előre, tételesen látod a költségeket'],
  ['Garancia és jótállás', 'Probléma esetén egyedül, akár ügyvéddel a külföldi eladóval szemben', 'Kötelező 1 éves jótállást adunk, biztosításkötésben is segítünk'],
  ['Időráfordítás', 'Hetek, akár hónapok utánajárás', 'Mindössze 5–14 nap'],
];

const steps = [
  ['Kutatás és kiválasztás', 'Pontosan azt az autót keressük meg, amire vágysz — és ha még csak az irány van meg, abban is segítünk eligazodni a hatalmas német kínálatban.'],
  ['Leinformálás', 'Nemzetközi adatbázisokból ellenőrzünk minden részletet, hogy biztosan tiszta múltú, megbízható autót vegyél — meglepetések nélkül.'],
  ['Helyszíni bevizsgálás', 'Szakértő kollégánk személyesen, a helyszínen nézi át a kiszemelt autót, és minden lényeges részletről egyeztet veled, mielőtt döntenél.'],
  ['Logisztika és szállítás', 'Profi szállítópartnerünkkel és magas értékű biztosítással hozzuk haza az autót — biztonságban, egészen az ajtódig.'],
  ['Honosítás és vizsgáztatás', 'A teljes hivatalos ügyintézést átvállaljuk: műszaki vizsga, okmányiroda, honosítás — gyorsan és gördülékenyen.'],
  ['Biztosítás és garancia', 'KGFB, Casco és használtautó-garancia — összeállítjuk a megfelelő védelmet, hogy nyugodt szívvel ülj a volán mögé.'],
  ['Kulcsrakész átadás', 'Kulcsrakészen, minden papírral és a nevedre írt forgalmival adjuk át — onnantól már csak vezetned kell.'],
];

const faqs = [
  ['Hogyan indul el az importfolyamat?', 'Töltsd ki az „Autó rendelés” űrlapot, vagy írj nekünk — felvesszük veled a kapcsolatot, pontosítjuk az igényt, és megkezdjük a keresést a német piacon.'],
  ['Mi van, ha még nincs konkrét autó a fejemben?', 'Nem gond — elég, ha a márka, típus, keret vagy a felhasználási cél megvan. Segítünk eligazodni és több konkrét ajánlatot mutatunk.'],
  ['Mennyi előleget kell fizetni?', 'Az autó lefoglalásához általában előleg szükséges, a végleges egyedi ajánlatban pontosan rögzítjük az összes feltételt.'],
  ['Mennyi ideig tart a teljes folyamat?', 'A kiválasztástól a kulcsrakész átadásig jellemzően 5–14 nap, az adott autótól és ügyintézéstől függően.'],
  ['Milyen ügyintézés tartozik a behozatalhoz?', 'A teljes folyamat: szállítás, vám- és áfaügyintézés, eredetvizsga, műszaki vizsga, honosítás, okmányiroda, forgalomba helyezés — mindent mi intézünk.'],
  ['Milyen költségekkel kell számolnom?', 'Az autó ára mellett: regisztrációs adó, műszaki vizsga, eredetvizsga, vagyonszerzési illeték, forgalmi/rendszám/törzskönyv, szállítás és ügyintézési díj. A kalkulátorunkban tételesen látod.'],
  ['Kapok garanciát a behozott autóra?', 'Igen — magánszemélyként kötelező 1 éves jótállást adunk, és a biztosítás (KGFB, Casco) megkötésében is segítünk.'],
];

const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<section class="imp">
  <section class="hero">
  <video autoplay muted loop playsinline preload="auto" poster="https://www.caradvance.hu/caradvance-hero-x5-poster.jpg">
    <source src="https://www.caradvance.hu/caradvance-hero-x5.mp4" type="video/mp4" />
  </video>
  <div class="scrim"></div>
  <div class="inner">
    <div class="partners" style="display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap"><img src="https://www.caradvance.hu/mobile-de.webp" alt="mobile.de" style="height:34px;width:auto;display:block;border-radius:6px" /><img src="https://www.caradvance.hu/autoscout24.webp" alt="AutoScout24" style="height:34px;width:auto;display:block;border-radius:6px" /><img src="https://www.caradvance.hu/heycar.webp" alt="heycar" style="height:34px;width:auto;display:block;border-radius:6px" /></div>
    <h1>Hozd haza álmaid autóját —<br /><span class="accent">mi mindent elintézünk</span></h1>
    <p class="sub sub-wide" style="max-width:900px">Nagyobb választék, jobb állapotú autók és kedvezőbb ár a német piacról — mi megkeressük, behozzuk és kulcsrakészen, a nevedre írt forgalmival adjuk&nbsp;át.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#rendeles">Autót rendelek</a>
      <a class="btn btn-white" href="#folyamat">Hogyan működik?</a>
    </div>
  </div>
  <button class="scrolldown" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
</section>

  <div class="imp-wrap">
    <div class="imp-head"><span class="imp-tag">Miért a német piac?</span><h2>Nagyobb választék, jobb állapotú autók</h2><p>A német piacon nemcsak több autó közül választhatsz, hanem jellemzően jobb állapotúak is: gondosabb karbantartás, kevesebb futott kilométer és kiváló utak állnak mögöttük.</p></div>
    <div class="imp-grid3">
      {benefits.map(([t, d]) => (<div class="imp-card"><h3>{t}</h3><p>{d}</p></div>))}
    </div>

    <div class="imp-head" id="kalkulator"><span class="imp-tag">Import kalkulátor</span><h2>Számold ki az importált autó árát</h2><p>Add meg az autó német (bruttó) árát és a szállítási távolságot — megmutatjuk a magyarországi forgalomba helyezéssel együtt fizetendő, tájékoztató végösszeget, tételesen.</p></div>
    <div class="imp-calc">
      <div class="imp-calc-in">
        <label>Autó ára Németországban (bruttó, €)<input id="c-eur" type="text" inputmode="numeric" value="19790"></label>
        <label>Szállítási távolság (km)<input id="c-km" type="text" inputmode="numeric" value="1100"></label>
        <label>EUR/HUF árfolyam<input id="c-rate" type="text" inputmode="numeric" value="365"></label>
      </div>
      <div class="imp-calc-out">
        <div class="imp-row"><span>Gépjármű ára (magyar áfás ár)</span><b id="o-car">–</b></div>
        <div class="imp-row"><span>Regisztrációs adó</span><b id="o-reg">–</b></div>
        <div class="imp-row"><span>Műszaki vizsga (gyorsított)</span><b id="o-mv">–</b></div>
        <div class="imp-row"><span>Eredetvizsga</span><b id="o-ev">–</b></div>
        <div class="imp-row"><span>Vagyonszerzési illeték</span><b id="o-ill">–</b></div>
        <div class="imp-row"><span>Forgalmi, rendszám, törzskönyv</span><b id="o-forg">–</b></div>
        <div class="imp-row"><span>Szállítási költség</span><b id="o-sz">–</b></div>
        <div class="imp-row"><span>Ügyintézési díj</span><b id="o-ugy">–</b></div>
        <div class="imp-row total"><span>Forgalomba helyezéssel, összesen</span><b id="o-total">–</b></div>
        <p class="imp-note">Tájékoztató kalkuláció magánszemély részére, az érvényben lévő hatósági díjakkal. A regisztrációs adó és az illeték az autó korától és teljesítményétől függ — a pontos összeget egyedi ajánlatban adjuk meg. Új gépjármű behozatalánál a 27% magyar áfa fizetendő.</p>
      </div>
    </div>

    <div class="imp-head"><span class="imp-tag">Mennyit spórolhatsz?</span><h2>27% helyett csak 19% áfa</h2><p>Magánszemélyként a németországi Caradvance GmbH-tól 19% német áfával vásárolsz — a 27% magyar áfa helyett. Még a szolgáltatási díjunkkal együtt is sokat spórolsz.</p></div>
    <div class="imp-afa">
      <div class="imp-afa-h"><div class="car">Példa: BMW 320d Touring<small>2022 · automata · ~40 000 km</small></div></div>
      <table>
        <thead><tr><th>Tétel</th><th>🇭🇺 27% Magyarországon</th><th class="hl">🇩🇪 19% Caradvance GmbH-tól</th></tr></thead>
        <tbody>
          <tr><td>Nettó autóár</td><td>10 945 000 Ft</td><td class="hl">9 000 000 Ft</td></tr>
          <tr><td>Forgalmi adó</td><td>+2 955 000 Ft</td><td class="hl">+1 710 000 Ft</td></tr>
          <tr><td>Bruttó vételár</td><td>13 900 000 Ft</td><td class="hl">10 710 000 Ft</td></tr>
          <tr><td>Caradvance szolgáltatás (behozatal, teljes ügyintézés)</td><td>—</td><td class="hl">+550 000 Ft</td></tr>
          <tr class="tot"><td>Amit ténylegesen fizetsz</td><td>13 900 000 Ft</td><td class="hl">11 260 000 Ft</td></tr>
        </tbody>
      </table>
      <div class="imp-save">A Te megtakarításod ezen az autón<b>2 640 000 Ft <small>≈ 19%</small></b></div>
    </div>

    <div class="imp-head"><span class="imp-tag">Egyedül vagy velünk?</span><h2>Miért ne vágj bele egyedül?</h2><p>Németországból autót hozni egyedül időigényes és tele van buktatóval. Így néz ki a kettő egymás mellett — a kockázatoktól a nyugodt végeredményig.</p></div>
    <div class="imp-cmp">
      <div class="imp-cmp-h"><span>Szempont</span><span>Ha egyedül vágsz bele</span><span class="hl">A Caradvance-szel</span></div>
      {compare.map(([s, a, b]) => (<div class="imp-cmp-r"><span class="s">{s}</span><span class="a">✕ {a}</span><span class="b">✓ {b}</span></div>))}
    </div>

    <div class="imp-head" id="folyamat"><span class="imp-tag">Hogyan működik az autó import?</span><h2>Hét lépés a tökéletes autóig</h2><p>Az igényed jelzését követően egy professzionális csapattagunk felveszi veled a kapcsolatot, és onnantól mindent intézünk.</p></div>
    <div class="imp-steps">
      {steps.map(([t, d], i) => (<div class="imp-step"><span class="n">{i + 1}</span><div><h3>{t}</h3><p>{d}</p></div></div>))}
    </div>

    <div class="imp-head"><span class="imp-tag">Csapatunk</span><h2>Ismerd meg, kik intézik a behozatalod</h2><p>Nem egy űrlappal beszélsz, hanem valódi szakemberekkel, akik végigkísérnek a teljes folyamaton — a kiválasztástól a kulcsátadásig.</p></div>
    <div class="imp-team">
      <div class="imp-team-card">
        <span class="role">Import igazgató</span>
        <h3>Tóth Károly</h3>
        <p>Károly irányítja a teljes importfolyamatot, és ő tartja a napi kapcsolatot német partnerünkkel, a Caradvance GmbH-val. Több évtizedes autós tapasztalattal vigyáz arra, hogy minden behozatal gördülékenyen menjen.</p>
        <div class="imp-team-c"><a href="mailto:import@caradvance.de">✉ import@caradvance.de</a><a href="tel:+36302146989">☎ +36 30 214 6989</a></div>
      </div>
      <div class="imp-team-note"><b>Mögöttünk a németországi Caradvance GmbH 10 fős csapata 🇩🇪</b><span>Német kollégáink közvetlen hozzáférést biztosítanak a piac teljes kínálatához és a helyi ügyintézéshez — így minden behozatal a forrásnál, helyben indul.</span></div>
    </div>

    <div class="imp-head" id="rendeles"><span class="imp-tag">Ingyenes &amp; kötelezettségmentes</span><h2>Autó rendelés — mondd el, mit keresel</h2><p>Add meg, milyen autót szeretnél behozatni. Csapatunk felveszi veled a kapcsolatot, és személyre szabott ajánlatot ad — árral és várható idővel.</p></div>
    <form class="imp-form" id="importForm">
      <div class="imp-f-grid">
        <label>Márka<input name="marka" placeholder="pl. BMW, Volkswagen"></label>
        <label>Modell<input name="modell" placeholder="pl. 320d Touring, Caddy"></label>
        <label>Évjárat (-tól)<input name="evjarat" placeholder="pl. 2021"></label>
        <label>Üzemanyag<select name="uzemanyag"><option value="">Válassz…</option><option>Benzin</option><option>Dízel</option><option>Hibrid</option><option>Elektromos</option></select></label>
        <label>Max. futásteljesítmény (km)<input name="km" inputmode="numeric" placeholder="pl. 100000"></label>
        <label>Keret (€ vagy Ft)<input name="keret" placeholder="pl. 25 000 € / 10 000 000 Ft"></label>
      </div>
      <label class="full">Megjegyzés, kívánságok (felszereltség, szín, extrák)<textarea name="megjegyzes" rows="3" placeholder="pl. automata, vonóhorog, tolatókamera, világos belső…"></textarea></label>
      <div class="imp-f-grid">
        <label>Neved<input name="nev" placeholder="Teljes név"></label>
        <label>Telefon<input name="telefon" placeholder="+36…"></label>
        <label>E-mail<input name="email" type="email" placeholder="nev@pelda.hu"></label>
      </div>
      <button type="submit" class="imp-btn red big">Elküldöm a rendelést →</button>
      <p class="imp-note">Az adatok elküldésével felveszed velünk a kapcsolatot — az ajánlatkérés ingyenes és nem kötelez semmire.</p>
    </form>

    <div class="imp-head" id="gyik"><span class="imp-tag">GYIK</span><h2>Gyakori kérdések</h2><p>A leggyakoribb kérdések a németországi autóimportról — a megrendeléstől az átadásig.</p></div>
    <div class="imp-faq">
      {faqs.map(([q, a]) => (<details><summary>{q}<span class="pl">+</span></summary><p>{a}</p></details>))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
</section>

<style>
  .imp{--red:#E2001A;--navy:#1a1d23;--ink:#141519;--muted:#5A6B82;--line:#E6EAF1;--bg:#F4F7FB}
  .imp-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
  .imp-hero{background:#0B0B0D;color:#fff;padding:120px 0 72px;position:relative;text-align:center;overflow:hidden}
  .imp-hero-vid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .imp-partners-img{height:46px;width:auto;display:block;margin:0 auto 26px;filter:drop-shadow(0 2px 10px rgba(0,0,0,.35))}
  .imp-scroll{display:inline-flex;flex-direction:column;align-items:center;gap:1px;margin-top:32px;color:#cfd6e2;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;text-decoration:none}
  .imp-scroll span{font-size:20px;line-height:1}
  .imp-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(11,11,13,.55),rgba(11,11,13,.8))}
  .imp-hero .imp-wrap{position:relative;z-index:2}
  .imp-partners{display:flex;align-items:center;justify-content:center;gap:26px;flex-wrap:wrap;margin-bottom:26px;opacity:.95}
  .imp-partners img{height:26px;width:auto;filter:brightness(0) invert(1);opacity:.9}
  .imp-partners img.imp-lg{height:30px;filter:none}
  .imp-eyebrow{display:inline-block;background:rgba(226,0,26,.16);color:#ff8a97;font-weight:800;font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:6px 15px;border-radius:999px}
  .imp-hero h1{font-size:clamp(32px,5vw,52px);font-weight:800;line-height:1.08;margin:16px auto 14px;max-width:900px;letter-spacing:-.02em}
  .imp-hero h1 span{color:var(--red)}
  .imp-lead{color:#cfd6e2;font-size:17px;line-height:1.6;max-width:720px;margin:0 auto 26px}
  .imp-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .imp-btn{display:inline-flex;align-items:center;gap:8px;font-weight:800;font-size:15px;padding:14px 24px;border-radius:999px;text-decoration:none;cursor:pointer;border:0}
  .imp-btn.red{background:var(--red);color:#fff}.imp-btn.red:hover{filter:brightness(.94)}
  .imp-btn.ghost{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.5)}
  .imp-btn.big{width:100%;justify-content:center;font-size:16px;padding:16px}
  .imp-head{text-align:center;max-width:760px;margin:72px auto 30px}
  .imp-tag{display:inline-block;background:#fdeaec;color:var(--red);font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:14px}
  .imp-head h2{font-size:clamp(26px,3.6vw,38px);font-weight:800;letter-spacing:-.02em;margin:0 0 12px;color:var(--ink)}
  .imp-head p{color:var(--muted);font-size:16px;line-height:1.6;margin:0}
  .imp-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  @media(max-width:820px){.imp-grid3{grid-template-columns:1fr}}
  .imp-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px}
  .imp-card h3{font-size:17px;font-weight:800;margin:0 0 8px}
  .imp-card p{color:var(--muted);font-size:14px;line-height:1.55;margin:0}
  .imp-calc{display:grid;grid-template-columns:340px 1fr;gap:20px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px}
  @media(max-width:820px){.imp-calc{grid-template-columns:1fr}}
  .imp-calc-in{display:flex;flex-direction:column;gap:14px}
  .imp-calc-in label{font-size:13px;font-weight:700;color:var(--muted);display:flex;flex-direction:column;gap:6px}
  .imp-calc-in input{font:inherit;font-size:16px;font-weight:700;color:var(--ink);padding:12px 14px;border:1px solid var(--line);border-radius:11px;outline:none}
  .imp-calc-in input:focus{border-color:var(--red)}
  .imp-calc-out{background:var(--bg);border-radius:14px;padding:16px 18px}
  .imp-row{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px dashed var(--line);font-size:14px;color:var(--muted)}
  .imp-row b{color:var(--ink);font-weight:700;white-space:nowrap}
  .imp-row.total{border-bottom:0;border-top:2px solid var(--ink);margin-top:6px;padding-top:14px;font-size:16px;color:var(--ink);font-weight:800}
  .imp-row.total b{color:var(--red);font-size:20px}
  .imp-note{font-size:12px;color:var(--muted);line-height:1.5;margin:12px 0 0}
  .imp-afa{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden}
  .imp-afa-h{padding:18px 20px;border-bottom:1px solid var(--line)}
  .imp-afa-h .car{font-weight:800;font-size:18px}
  .imp-afa-h .car small{display:block;color:var(--muted);font-weight:600;font-size:13px;margin-top:3px}
  .imp-afa table{width:100%;border-collapse:collapse}
  .imp-afa th,.imp-afa td{text-align:right;padding:13px 20px;font-size:14px;border-bottom:1px solid var(--line)}
