<script is:inline>
(function(){
  var IMPORT_ENDPOINT = "";
  function ft(n){ return Math.round(n).toLocaleString('hu-HU') + ' Ft'; }
  function num(id){ var v=(document.getElementById(id).value||'').replace(/[^0-9]/g,''); return v?parseInt(v,10):0; }
  var FEES = { reg:67500, mv:100000, ev:25000, ill:58500, forg:24000, ugy:400000, kmft:317.5 };
  function calc(){
    var eur=num('c-eur'), km=num('c-km'), rate=num('c-rate')||365;
    var car=eur*rate, sz=Math.round(km*FEES.kmft);
    var total=car+FEES.reg+FEES.mv+FEES.ev+FEES.ill+FEES.forg+sz+FEES.ugy;
    var set=function(id,v){ var el=document.getElementById(id); if(el) el.textContent=ft(v); };
    set('o-car',car); set('o-reg',FEES.reg); set('o-mv',FEES.mv); set('o-ev',FEES.ev);
    set('o-ill',FEES.ill); set('o-forg',FEES.forg); set('o-sz',sz); set('o-ugy',FEES.ugy); set('o-total',total);
  }
  ['c-eur','c-km','c-rate'].forEach(function(id){ var el=document.getElementById(id); if(el) el.addEventListener('input',calc); });
  calc();
  var form=document.getElementById('importForm');
  if(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var d={}; [].slice.call(form.querySelectorAll('input,select,textarea')).forEach(function(el){ if(el.name) d[el.name]=el.value; });
      if(IMPORT_ENDPOINT){
        fetch(IMPORT_ENDPOINT,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(d)})
          .then(function(){ alert('Köszönjük! A rendelésed megérkezett — hamarosan jelentkezünk.'); form.reset(); })
          .catch(function(){ alert('Küldés sikertelen — kérjük írj a import@caradvance.de címre.'); });
        return;
      }
      var body='Autó rendelés (import):%0D%0A'
        +'Márka: '+encodeURIComponent(d.marka||'')+'%0D%0A'
        +'Modell: '+encodeURIComponent(d.modell||'')+'%0D%0A'
        +'Évjárattól: '+encodeURIComponent(d.evjarat||'')+'%0D%0A'
        +'Üzemanyag: '+encodeURIComponent(d.uzemanyag||'')+'%0D%0A'
        +'Max km: '+encodeURIComponent(d.km||'')+'%0D%0A'
        +'Keret: '+encodeURIComponent(d.keret||'')+'%0D%0A'
        +'Megjegyzés: '+encodeURIComponent(d.megjegyzes||'')+'%0D%0A%0D%0A'
        +'Név: '+encodeURIComponent(d.nev||'')+'%0D%0A'
        +'Telefon: '+encodeURIComponent(d.telefon||'')+'%0D%0A'
        +'E-mail: '+encodeURIComponent(d.email||'');
      window.location.href='mailto:import@caradvance.de?subject='+encodeURIComponent('Autó rendelés – '+(d.marka||'')+' '+(d.modell||''))+'&body='+body;
    });
  }
})();
</script>
