---
// TESZT-változat (noindex, nincs menüben): az élő /auto-osszehasonlitas/ másolata, ahol 5 autó
// a gyári konfigurátorok képeivel jelenik meg (különböző színekben). A többi autó a régi képekkel.
import Base from '../layouts/Base.astro';
import AutoOsszehasonlitas from '../components/AutoOsszehasonlitas.astro';
import PHOTO_META from '../data/comparePhotos.json';
import KONFIG from '../data/comparePhotosKonfig.json';
const photoMeta = { ...(PHOTO_META as any), ...(KONFIG as any) };
const note = '<b>TESZT-változat</b> – gyári konfigurátor-képek 5 autóval: <b>BMW X3</b> (kék), <b>Mercedes GLC</b> (zöldesszürke), <b>VW Tiguan</b> (ezüst), <b>Volvo XC40</b> (fekete), <b>Audi A6 Avant</b> (piros, kültéri fotóból kivágva). A többi autó még a régi képekkel látszik.';
---
<Base lang="hu" path="/auto-osszehasonlitas-teszt" title="Autó összehasonlítás – TESZT | CarAdvance" description="Teszt-változat: autó-összehasonlító gyári konfigurátor-képekkel.">
  <AutoOsszehasonlitas photoMeta={photoMeta} note={note} colorGhost={true} />
</Base>
