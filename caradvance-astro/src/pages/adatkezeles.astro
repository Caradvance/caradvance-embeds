---
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';
const lang = 'hu';
const toc = [
  { id: 'adatkezelo', t: 'Az adatkezelő és a képviselő' },
  { id: 'fogalmak', t: 'Alapelvek, jogszabályok' },
  { id: 'celok', t: 'Milyen adatot, mire, meddig' },
  { id: 'urlapok', t: 'Űrlapok és ajánlatkérés' },
  { id: 'cookie', t: 'Sütik (cookie-k)' },
  { id: 'feldolgozok', t: 'Adatfeldolgozók, címzettek' },
  { id: 'harmadik-orszag', t: 'Adattovábbítás EU-n kívülre' },
  { id: 'biztonsag', t: 'Adatbiztonság' },
  { id: 'jogok', t: 'Az Ön jogai' },
  { id: 'jogorvoslat', t: 'Panasz és jogorvoslat' },
  { id: 'modositas', t: 'Módosítás' },
];
---
<Base lang={lang} path="/adatkezeles" title="Adatkezelési tájékoztató (GDPR) — CarAdvance" description="Hogyan kezeli a Caradvance GmbH és magyarországi képviselője, a BH Group Zrt. a személyes adatokat: ajánlatkérés, bérlés, vásárlás, autóeladás, szállítás, chat, sütik, megőrzési idők és az Ön jogai.">
  <LegalPage title="Adatkezelési tájékoztató" toc={toc}>
