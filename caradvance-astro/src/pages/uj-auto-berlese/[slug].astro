<script is:inline>
(function(){
  // hero videó indítása
  var v=document.querySelector('.cd-hero .cd-vid');
  if(v){try{v.muted=true;v.setAttribute('muted','');}catch(e){} var kick=function(){var p=v.play();if(p&&p.catch)p.catch(function(){});}; kick(); v.addEventListener('loadedmetadata',kick); v.addEventListener('canplay',kick);}
  // sticky subnav CTA megjelenítése görgetéskor
  var nav=document.querySelector('.cd-nav'), hero=document.querySelector('.cd-hero');
  if(nav&&hero){var onScroll=function(){ if(window.scrollY> (hero.offsetTop+hero.offsetHeight)) nav.classList.add('show-cta'); else nav.classList.remove('show-cta'); }; window.addEventListener('scroll',onScroll,{passive:true}); onScroll();}
  // élő EUR→HUF árfolyam
  try{
    fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=HUF').then(function(r){return r.json();}).then(function(d){
      if(d&&d.rates&&d.rates.HUF){
        var fx=Math.round(d.rates.HUF), fxEl=document.getElementById('rtFx'); if(fxEl) fxEl.textContent=fx;
        document.querySelectorAll('[data-eur]').forEach(function(el){ var eur=Number(el.getAttribute('data-eur')||0); if(eur) el.textContent=new Intl.NumberFormat('hu-HU').format(Math.round(eur*fx))+' Ft'; });
      }
    }).catch(function(){});
  }catch(e){}
})();
