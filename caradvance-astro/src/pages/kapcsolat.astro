---
import Base from '../layouts/Base.astro';
const lang = 'hu';
---
<Base lang={lang} path="/kapcsolat" title="Kapcsolat — CarAdvance" description="Lépj kapcsolatba a CarAdvance csapatával. Válaszd ki a megyédet a térképen, és megmutatjuk, ki a személyes kapcsolattartód. Iroda: 2083 Solymár, Ibolya utca 12.">
<div class="kap">
  <div class="kap-head">
    <h1>Kapcsolat</h1>
    <p>Válaszd ki a megyédet a térképen — megmutatjuk, ki a kapcsolattartód.</p>
  </div>

  <div class="kap-office" id="kap-office"></div>

  <div class="kap-hero">
    <div class="kap-mapwrap">
      <div class="kap-maptitle">Magyarország — kattints a megyédre</div>
      <div class="kap-hoverlbl" id="kap-hoverlbl"></div>
      <svg class="kap-map" id="kap-map" viewBox="10 40 1025 650" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Magyarország megyetérkép"></svg>
      <div class="kap-legend">
        <span><span class="kap-dot" style="background:#2563EB"></span>Bajzáth Balázs — nyugati régió</span>
        <span><span class="kap-dot" style="background:#E2001A"></span>Vadnai Zsombor — keleti régió</span>
      </div>
    </div>
    <div class="kap-panel" id="kap-panel"></div>
  </div>

  <div class="kap-sec-title">A csapat</div>
  <p class="kap-sec-sub">Bárkit közvetlenül is elérhetsz.</p>
  <div class="kap-team-scroll"><div class="kap-team" id="kap-team"></div></div>
  <div class="kap-team-scroll" style="margin-top:6px"><div class="kap-team" id="kap-team2"></div></div>
</div>

<style is:inline>
.kap{max-width:1180px;margin:0 auto;padding:40px 20px 64px;color:#141519;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Roboto,Arial,sans-serif}
.kap *{box-sizing:border-box}
.kap-head{text-align:center;margin-bottom:26px}
.kap-head h1{font-size:38px;margin:0 0 8px;letter-spacing:-.02em}
.kap-head p{margin:0;color:#5A6B82;font-size:17px}
.kap-hero{display:grid;grid-template-columns:1.25fr .95fr;gap:26px;align-items:start;background:#F4F7FB;border:1px solid #E6EAF1;border-radius:22px;padding:22px}
.kap-mapwrap{position:relative}
.kap-maptitle{font-weight:700;font-size:15px;margin:2px 4px 10px;color:#5A6B82}
.kap-map{width:100%;height:auto;display:block}
.kap-map .county{stroke:#fff;stroke-width:1.1;cursor:pointer;transition:fill .12s}
.kap-map .county[data-rep="balazs"]{fill:#DCE7FB}
.kap-map .county[data-rep="zsombor"]{fill:#FBDCDF}
.kap-map .county[data-rep="balazs"]:hover{fill:#9FBEF5}
.kap-map .county[data-rep="zsombor"]:hover{fill:#F3A6AD}
.kap-map .county.sel[data-rep="balazs"]{fill:#2563EB}
.kap-map .county.sel[data-rep="zsombor"]{fill:#E2001A}
.kap-map .county.sel{stroke:#fff;stroke-width:1.6}
.kap-legend{display:flex;gap:18px;justify-content:center;margin-top:8px;flex-wrap:wrap}
.kap-legend span{display:inline-flex;align-items:center;gap:7px;font-size:13px;color:#5A6B82;font-weight:600}
.kap-dot{width:13px;height:13px;border-radius:50%}
.kap-hoverlbl{position:absolute;top:8px;right:8px;background:#fff;border:1px solid #E6EAF1;border-radius:999px;padding:5px 12px;font-size:13px;font-weight:700;box-shadow:0 4px 14px rgba(20,21,25,.08);opacity:0;transition:opacity .12s;pointer-events:none}
.kap-hoverlbl.on{opacity:1}
.kap-panel{background:#fff;border:1px solid #E6EAF1;border-radius:18px;padding:22px;min-height:340px;box-shadow:0 10px 30px rgba(20,21,25,.05)}
.kap-panel .kap-kicker{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#5A6B82}
.kap-avatar{width:74px;height:74px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:26px;flex-shrink:0;overflow:hidden}
.kap-avatar img{width:100%;height:100%;object-fit:cover}
.kap-prow{display:flex;gap:16px;align-items:center;margin:14px 0 4px}
.kap-pname{font-size:22px;font-weight:800;line-height:1.1}
.kap-prole{font-weight:800;font-size:13px;letter-spacing:.05em;text-transform:uppercase;margin-top:3px}
.kap-region-badge{display:inline-block;margin:14px 0 6px;font-size:14px;color:#5A6B82}
.kap-region-badge b{color:#141519}
.kap-chips{display:flex;flex-direction:column;gap:9px;margin-top:14px}
.kap-chip{display:inline-flex;align-items:center;gap:9px;background:#EEF3F9;border:1px solid #E6EAF1;border-radius:12px;padding:10px 13px;font-size:14.5px;font-weight:600;text-decoration:none;color:#141519;width:fit-content}
.kap-chip .ic{opacity:.7}
.kap-langs{margin-top:12px;font-size:20px;letter-spacing:2px}
.kap-default .mini{display:flex;gap:12px;margin-top:16px}
.kap-mini{flex:1;background:#EEF3F9;border:1px solid #E6EAF1;border-radius:14px;padding:12px;text-align:center}
.kap-mini .a{width:44px;height:44px;border-radius:50%;margin:0 auto 8px;color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center}
.kap-mini .n{font-weight:800;font-size:14px;color:#141519}
.kap-mini .r{font-size:12px;color:#5A6B82}
.kap-sec-title{text-align:center;font-size:26px;font-weight:800;margin:52px 0 6px;letter-spacing:-.01em}
.kap-sec-sub{text-align:center;color:#5A6B82;margin:0 0 26px}
.kap-office{display:grid;grid-template-columns:300px 1fr;background:#fff;border:1px solid #E6EAF1;border-radius:18px;overflow:hidden;box-shadow:0 8px 24px rgba(20,21,25,.05);margin:0 0 34px}
.kap-office-photo{background:linear-gradient(135deg,#eef2f8,#e2e8f2);overflow:hidden;min-height:230px}
.kap-office-photo img{width:100%;height:100%;object-fit:cover}
.kap-office-body{padding:26px 30px}
.kap-office-name{font-size:22px;font-weight:800}
.kap-office-role{font-weight:800;font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;color:#E2001A;margin:6px 0 12px}
.kap-office-bio{color:#5A6B82;font-size:15px;line-height:1.55;margin:0 0 16px}
.kap-office-chips{display:flex;flex-wrap:wrap;gap:8px}
.kap-team-scroll{overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:0 -20px;padding:4px 20px 12px}
.kap-team-scroll::-webkit-scrollbar{display:none}
.kap-team{display:flex;gap:20px;width:max-content}
.kap-card{flex:0 0 300px;scroll-snap-align:start;background:#fff;border:1px solid #E6EAF1;border-radius:18px;overflow:hidden;box-shadow:0 8px 24px rgba(20,21,25,.05);display:flex;flex-direction:column}
.kap-photo{aspect-ratio:4/5;background:linear-gradient(135deg,#eef2f8,#e2e8f2);display:flex;align-items:center;justify-content:center;overflow:hidden}
.kap-photo img{width:100%;height:100%;object-fit:cover;object-position:center top}
.kap-photo .ph{width:96px;height:96px;border-radius:50%;color:#fff;font-weight:800;font-size:34px;display:flex;align-items:center;justify-content:center}
.kap-card .body{padding:20px;display:flex;flex-direction:column;flex:1}
.kap-card .nm{font-size:20px;font-weight:800;text-align:center}
.kap-card .rl{text-align:center;font-weight:800;font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;color:#E2001A;margin:6px 0 12px}
.kap-card .bio{color:#5A6B82;text-align:center;font-size:14.5px;line-height:1.5;flex:1}
.kap-card .cc{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:16px}
.kap-flags{margin-left:6px;display:inline-flex;align-items:center;gap:4px;vertical-align:middle}
.kap-rflag{width:20px;height:20px;border-radius:50%;background-size:cover;background-position:center;display:inline-block;vertical-align:middle;box-shadow:0 0 0 1px rgba(20,21,25,.10)}
.kap-langs{margin-top:12px;display:flex;gap:8px;align-items:center}
.kap-langs .kap-rflag{width:26px;height:26px}
.kap-chip.kap-wa{background:#E7F9EF;border-color:#BFE9CF;color:#0B7A43}
@media(max-width:900px){.kap-hero{grid-template-columns:1fr}.kap-office{grid-template-columns:1fr}.kap-head h1{font-size:30px}}
</style>

