function repOf(id){return REGION.balazs.indexOf(id)>=0?"balazs":"zsombor";}
function FL(codes){return (codes||'').split(/ +/).filter(Boolean).map(function(c){return '<span class="kap-rflag" style="background-image:url(https://flagcdn.com/w40/'+c+'.png)"></span>';}).join('');}
