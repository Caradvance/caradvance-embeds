---
import Base from '../../layouts/Base.astro';
import Eladom from '../../components/Eladom.astro';
import { useTranslations, type Locale } from '../../i18n/utils';
import { localeList, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return localeList.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---
<Base lang={lang} path="/eladom" title={`${t('eladom.title1')} ${t('eladom.title2')} — CarAdvance`} description={t('eladom.sub')}>
  <Eladom lang={lang} />
</Base>
