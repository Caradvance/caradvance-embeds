---
import Base from '../../layouts/Base.astro';
import Jotekonysag from '../../components/Jotekonysag.astro';
import { type Locale } from '../../i18n/utils';
import { localeList, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return localeList.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---
<Base lang={lang} path="/jotekonysag" title="Jótékonyság — autóeladás egy jó ügyért | CarAdvance" description="A CarAdvance minden autóeladás jutalékának jelentős részét magyar jótékony szervezeteknek ajánlja fel: SOS Gyermekfalvak, Magyar Élelmiszerbank, Bátor Tábor, Máltai Szeretetszolgálat, Rex Kutyaotthon, Heim Pál és PATENT. Ismerd meg a támogatott szervezeteket és a céljainkat.">
  <Jotekonysag lang={lang} />
</Base>
