---
import Base from '../../layouts/Base.astro';
import Jotekonysag from '../../components/Jotekonysag.astro';
import { type Locale } from '../../i18n/utils';
import { localeList, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return localeList.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---
<Base lang={lang} path="/jotekonysag" title="Miért adunk vissza? — Jótékonyság — CarAdvance" description="Miért ajánljuk fel a jutalékunk egy részét magyar jótékony szervezeteknek — a Caradvance jótékonysági programja.">
  <Jotekonysag lang={lang} />
</Base>
