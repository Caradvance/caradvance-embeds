---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import IntlPage from '../../components/IntlPage.astro';
import { useTranslations, type Locale } from '../../i18n/utils';
import { localeList, defaultLang } from '../../i18n/ui';
import { contentFor } from '../../i18n/intl/index';

export function getStaticPaths() {
  return localeList.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const C = contentFor(lang);
---
{C ? (
  <Base lang={lang} path="/" title={C.pages.home.title} description={C.pages.home.desc}>
    <IntlPage lang={lang} pageKey="home" />
  </Base>
) : (
  <Base lang={lang} path="/" title={`CarAdvance — ${t('home.title')}`} description={t('home.sub')}>
    <Home lang={lang} />
  </Base>
)}
