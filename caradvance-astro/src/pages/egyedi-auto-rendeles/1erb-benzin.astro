  .cd-sub{font-size:clamp(16px,1.7vw,19px);line-height:1.5;color:#e7eaf0;max-width:600px;margin:0 auto 32px;text-shadow:0 1px 12px rgba(0,0,0,.4);}
  .cd-cta{display:flex;gap:18px;justify-content:center;flex-wrap:wrap;}
  .cd-scroll{position:absolute;left:50%;bottom:22px;transform:translate(-50%,0);z-index:3;background:none;border:0;color:rgba(255,255,255,.82);font-size:11px;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px;font-family:inherit;animation:cdbob 1.9s ease-in-out infinite;}
  .cd-scroll svg{width:22px;height:22px;}
  @keyframes cdbob{0%,100%{transform:translate(-50%,0);}50%{transform:translate(-50%,8px);}}
  /* mobil: pontosan a kezdőlap hero mérete/pozíciója */
  @media(max-width:640px){.cd-hero{margin:8px;margin-top:calc(8px - var(--navh));border-radius:22px;padding:84px 18px 72px;min-height:480px;}.cd-brandlogo{height:56px;margin-bottom:16px;}.cd-inner{margin-top:12px;}}

  /* placeholders */
