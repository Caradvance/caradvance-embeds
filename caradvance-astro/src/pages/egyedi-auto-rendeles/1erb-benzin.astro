---
// BMW 1-es — egyedi autó részletes oldal (pilot, új dizájn)
// Önálló statikus útvonal: /egyedi-auto-rendeles/1erb-benzin
// Nem érinti az Audi [slug].astro oldalt. A képek helye jelölve (később töltöd fel):
//   háttérvideó: /bmw/1erb-hero.mp4 · főkép + galéria: /bmw/1erb-*.webp
import Base from '../../layouts/Base.astro';

const FX = 361;                       // tájékoztató árfolyam; élőben frissül
const net = 28782;                    // nettó EUR
const eur = new Intl.NumberFormat('de-DE').format(net) + ' €';
const huf = new Intl.NumberFormat('hu-HU').format(net * FX) + ' Ft';

const title = 'BMW 1-es (F70) — új autó Németországból, egyedi rendelés | CarAdvance';
const description = 'Új BMW 1-es (116, 118, 120) egyedi rendelése Németországból, kulcsrakész behozatallal és akár 19% német áfával. Ár, felszereltség, műszaki adatok és tartós bérlet egy helyen.';

const imgBase = 'https://www.caradvance.hu/bmw/';
const carImages = [
  imgBase + 'bmw-1es-m-sport-elolnezet.webp',
  imgBase + 'bmw-1es-m-sport-kulso.webp',
  imgBase + 'bmw-1es-menet-kozben.webp',
  imgBase + 'bmw-1es-hegyi-uton.webp',
  imgBase + 'bmw-1es-oldalnezet.webp',
  imgBase + 'bmw-1es-belso-ter-curved-display.webp',
  imgBase + 'bmw-1es-muszerfal.webp',
  imgBase + 'bmw-1es-sport-ulesek.webp',
  imgBase + 'bmw-1es-m-felni-feknyereg.webp',
  imgBase + 'bmw-118-elolnezet.webp'
];
const carJson = {
  '@context':'https://schema.org','@type':'Car', name:'BMW 1-es', brand:{'@type':'Brand',name:'BMW'},
  bodyType:'Kompakt', vehicleTransmission:'Automata',
  image: carImages,
  offers:{'@type':'Offer', price:net, priceCurrency:'EUR', availability:'https://schema.org/InStock', seller:{'@type':'Organization',name:'CarAdvance'}}
};
const faqJson = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
  {'@type':'Question',name:'Mennyibe kerül egy új BMW 1-es Németországból?',acceptedAnswer:{'@type':'Answer',text:'A BMW 118 nettó listaára 28.782 €-tól (kb. 10,4 millió Ft) indul, a felszereltségtől függően. Magánszemélyként akár 19% német áfával rendelheted a müncheni Caradvance GmbH-n keresztül.'}},
  {'@type':'Question',name:'Melyik BMW 1-es kivitelt válasszam — 116, 118 vagy 120?',acceptedAnswer:{'@type':'Answer',text:'A BMW 116 a belépő benzines, a 118 a legkiegyensúlyozottabb választás, a 120 a legdinamikusabb; dízel is rendelhető. Segítünk kiválasztani a hozzád illő motorizációt és felszereltséget.'}},
  {'@type':'Question',name:'Bérelhető is a BMW 1-es?',acceptedAnswer:{'@type':'Answer',text:'Igen, a BMW 1-es tartós bérletben is elérhető, egyetlen kiszámítható havi díjjal, amiben a szerviz és a biztosítás is benne lehet.'}},
  {'@type':'Question',name:'Mennyi idő a behozatal?',acceptedAnswer:{'@type':'Answer',text:'A kiválasztott konfigurációtól függ, jellemzően néhány hét. A beszerzést, a honosítást és a forgalomba helyezést mi intézzük.'}}
]};
const crumbJson = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Főoldal',item:'https://www.caradvance.hu/'},
  {'@type':'ListItem',position:2,name:'Egyedi BMW rendelés',item:'https://www.caradvance.hu/egyedi-auto-rendeles?brand=bmw'},
  {'@type':'ListItem',position:3,name:'BMW 1-es',item:'https://www.caradvance.hu/egyedi-auto-rendeles/1erb-benzin'}
]};
---
<Base lang="hu" path="/egyedi-auto-rendeles/1erb-benzin" title={title} description={description}>
<div class="cd">

  <!-- ===== HERO (homepage-mintájú) ===== -->
  <section class="cd-hero">
    <video class="cd-vid" autoplay muted loop playsinline preload="auto" poster="/bmw/1erb-hero-poster.jpg">
      <source src="/bmw/1erb-hero.mp4" type="video/mp4" />
    </video>
    <div class="cd-ov"></div>
    <div class="cd-inner">
      <img class="cd-brandlogo" src="/bmw-hero-logo.png" alt="BMW" width="120" height="120" />
      <h1>BMW 1-es</h1>
      <p class="cd-sub">Prémium kompakt Németországból — sportos vezetés, digitális belső tér, új autóként, egyedi konfigurációval.</p>
      <div class="cd-cta">
        <a class="cd-btn cd-btn-red" href="/egyedi-auto-rendeles?brand=bmw&amp;order=1erb" data-egl-order data-name="BMW 1-es" data-img="/bmw/bmw-1es-m-sport-elolnezet.webp" data-price="10 476 648 Ft · 28.782 €" data-fuels="Benzin,Dízel">Autót rendelek</a>
        <a class="cd-btn cd-btn-white" href="/kapcsolat">Ajánlatot kérek</a>
      </div>
    </div>
    <button class="cd-scroll" aria-label="Görgess lejjebb" onclick="window.scrollBy({top:Math.round(innerHeight*0.9),behavior:'smooth'})">Görgess<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
  </section>

  <script is:inline>
  (function(){var v=document.querySelector('.cd-hero .cd-vid');if(!v)return;try{v.muted=true;v.setAttribute('muted','');}catch(e){}
    var kick=function(){var p=v.play();if(p&&p.catch)p.catch(function(){});};
    kick(); v.addEventListener('loadedmetadata',kick); v.addEventListener('canplay',kick);
    if(document.readyState!=='loading')kick(); else document.addEventListener('DOMContentLoaded',kick);
  })();
  </script>

  <!-- ===== INTRO: info left, car right ===== -->
  <section class="cd-intro">
    <div class="cd-w">
      <nav class="cd-crumb"><a href="/">Főoldal</a> / <a href="/egyedi-auto-rendeles?brand=bmw">Egyedi BMW rendelés</a> / <b>BMW 1-es</b></nav>
      <div class="cd-intro-grid">
        <div class="cd-info">
          <div class="cd-chips"><span class="cd-chip">Kompakt</span><span class="cd-chip">Benzin</span><span class="cd-chip">Dízel</span><span class="cd-chip">Automata</span><span class="cd-chip cd-chip-year">2026 · Németország</span></div>
          <div class="cd-price"><span class="cd-huf" id="cdHuf" data-net={net}>{huf}</span><span class="cd-eur">{eur} nettó -tól</span></div>
          <p class="cd-note">Tájékoztató német nettó listaár, élő árfolyammal (1&nbsp;€&nbsp;=&nbsp;<span id="cdFx">{FX}</span>&nbsp;Ft). A végleges ár a felszereltségtől és kedvezménytől függ.</p>
          <div class="cd-cta2"><a class="cd-btn cd-btn-red" href="/egyedi-auto-rendeles?brand=bmw&amp;order=1erb" data-egl-order data-name="BMW 1-es" data-img="/bmw/bmw-1es-m-sport-elolnezet.webp" data-price="10 476 648 Ft · 28.782 €" data-fuels="Benzin,Dízel">Autót rendelek</a><a class="cd-btn cd-btn-dark" href="/kapcsolat">Ajánlatot kérek</a></div>
          <div class="cd-trust">
            <span><i></i> akár 19% német áfával</span>
            <span><i></i> kulcsrakész behozatal</span>
            <span><i></i> 2003 óta a német piacon</span>
          </div>
        </div>
        <div class="cd-photo">
          <img class="cd-hero-car" src="/bmw/bmw-1es-m-sport-elolnezet.webp" alt="BMW 1-es M Sport – új autó Németországból, egyedi rendelés" width="1150" height="662" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STICKY SUBNAV ===== -->
  <div class="cd-nav">
    <div class="cd-w cd-nav-in">
      <div class="cd-nav-links">
        <a href="#attekintes">Áttekintés</a>
        <a href="#elonyok">Miért ez a modell</a>
        <a href="#adatok">Műszaki adatok</a>
        <a href="#szolg">Bérlés &amp; import</a>
        <a href="#gyik">GYIK</a>
      </div>
      <div class="cd-nav-price">{huf}-tól</div>
    </div>
  </div>

  <!-- ===== OVERVIEW ===== -->
  <section class="cd-sec" id="attekintes">
    <div class="cd-w">
      <span class="cd-eyebrow">Áttekintés</span>
      <h2 class="cd-h2">Új BMW 1-es Németországból, egyedi rendelésre</h2>
      <p class="cd-lead">A <strong>BMW 1-es</strong> (BMW 1 Series) a márka belépő prémium kompaktja: feszes futómű, letisztult, digitális utastér és a jól ismert BMW vezetési élmény. A CarAdvance-nél pontosan azt a <strong>BMW 116</strong>, <strong>BMW 118</strong> vagy <strong>BMW 120</strong> kivitelt rendeljük meg neked, amit szeretnél — új autóként, gyári felszereltséggel, <a href="/beszerzesi-folyamat">Németországból, kulcsrakész behozatallal</a>. Nem szeretnél venni? A 1-es <a href="/uj-auto-berlese?brand=bmw">tartós bérletben</a> is elérhető.</p>
    </div>
  </section>

  <!-- ===== HIGHLIGHTS ===== -->
  <section class="cd-sec cd-soft" id="elonyok">
    <div class="cd-w">
      <span class="cd-eyebrow">Miért a BMW 1-es</span>
      <h2 class="cd-h2">Amiért szeretni fogod</h2>
      <div class="cd-hl">
        <div class="cd-c"><div class="cd-i">◈</div><h3>Sportos vezetés</h3><p>Feszes futómű és pontos kormányzás — a kompakt kategória vezetési etalonja.</p></div>
        <div class="cd-c"><div class="cd-i">▦</div><h3>Digitális utastér</h3><p>BMW Curved Display és a legújabb iDrive — modern, letisztult vezérlés.</p></div>
        <div class="cd-c"><div class="cd-i">🛡</div><h3>Biztonság</h3><p>Fejlett vezetéstámogató rendszerek és a BMW ismert felépítési minősége.</p></div>
        <div class="cd-c"><div class="cd-i">€</div><h3>Kedvező német ár</h3><p>Magánszemélyként akár 19% német áfával — több százezer forint megtakarítás.</p></div>
      </div>
    </div>
  </section>

  <!-- ===== EDITORIAL ===== -->
  <section class="cd-sec">
    <div class="cd-w">
      <div class="cd-edi">
        <div class="cd-txt">
          <span class="cd-eyebrow">Dizájn</span>
          <h3 class="cd-h3">Karakteres megjelenés, prémium részletek</h3>
          <p>A BMW 1-es önmagáért beszél: markáns veserács, letisztult vonalvezetés és minőségi anyaghasználat. Az M Sport csomaggal a kompakt sportos karaktert kap — pontosan úgy konfigurálva, ahogy te szeretnéd.</p>
          <ul><li>M Sport és Sport Line kivitel</li><li>LED / adaptív fényszórók</li><li>17–19&quot; könnyűfém keréktárcsák</li></ul>
        </div>
        <img class="cd-shot cd-shot-edi" src="/bmw/bmw-1es-m-sport-kulso.webp" alt="BMW 1-es M Sport külső – markáns veserács, LED fényszórók" width="1200" height="900" loading="lazy" />
      </div>
      <div class="cd-edi cd-rev">
        <div class="cd-txt">
          <span class="cd-eyebrow">Belső tér</span>
          <h3 class="cd-h3">Digitális, tágas, kényelmes</h3>
          <p>A BMW Curved Display, a hangulatvilágítás és a minőségi kárpitok prémium környezetet teremtenek. A megnövelt utastér és csomagtér a kompakt méret ellenére is praktikus a mindennapokra.</p>
          <ul><li>BMW Curved Display + iDrive</li><li>Ülésfűtés, kétzónás klíma</li><li>Vezeték nélküli Apple CarPlay / Android Auto</li></ul>
        </div>
        <img class="cd-shot cd-shot-edi" src="/bmw/bmw-1es-belso-ter-curved-display.webp" alt="BMW 1-es belső tér – BMW Curved Display és iDrive" width="1200" height="900" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ===== VARIANTS + SPECS ===== -->
  <section class="cd-sec cd-soft" id="adatok">
    <div class="cd-w">
      <span class="cd-eyebrow">Változatok</span>
      <h2 class="cd-h2">Változatok és műszaki adatok</h2>
      <div class="cd-varsel"><button class="on">BMW 118</button><button>BMW 120</button><button>BMW 116d (dízel)</button></div>
      <div class="cd-specwrap">
        <div class="cd-stage"><img class="cd-shot cd-shot-stage" src="/bmw/bmw-118-elolnezet.webp" alt="BMW 118 – kompakt prémium, elölnézet" width="1200" height="750" loading="lazy" /></div>
        <div class="cd-spec">
          <div class="r"><span class="k">Karosszéria</span><span class="v">5 ajtós kompakt</span></div>
          <div class="r"><span class="k">Üzemanyag</span><span class="v">Benzin (mild-hybrid)</span></div>
          <div class="r"><span class="k">Max. teljesítmény</span><span class="v">~156 LE</span></div>
          <div class="r"><span class="k">Hajtás</span><span class="v">Első / 7 fok. DKG</span></div>
          <div class="r"><span class="k">Gyorsulás (0–100)</span><span class="v">~8,5 mp</span></div>
          <div class="r"><span class="k">Végsebesség</span><span class="v">~216 km/h</span></div>
          <div class="r"><span class="k">Fogyasztás (WLTP)</span><span class="v">~5,5 l/100 km</span></div>
          <div class="r"><span class="k">Csomagtér</span><span class="v">380 liter</span></div>
          <div class="r"><span class="k">Nettó ár -tól</span><span class="v">{eur} · {huf}</span></div>
        </div>
      </div>
      <p class="cd-specnote">Az adatok tájékoztató jellegűek, a konkrét konfigurációtól függően eltérhetnek. A végleges specifikációt a rendeléskor rögzítjük.</p>
    </div>
  </section>

  <!-- ===== SERVICES / INTERNAL LINKS ===== -->
  <section class="cd-sec" id="szolg">
    <div class="cd-w">
      <span class="cd-eyebrow">Ahogy neked a legjobb</span>
      <h2 class="cd-h2">Vedd meg, béreld, vagy hozasd be — mi mindent intézünk</h2>
      <div class="cd-svc">
        <a href="/uj-auto-berlese?brand=bmw"><h3>BMW 1-es tartós bérlet</h3><p>Nem szeretnél venni? A 1-es <strong>tartós bérletben</strong> is a tiéd lehet, egyetlen havi díjjal — szerviz és biztosítás beépítve.</p><span class="go">Bérlési ajánlatok →</span></a>
        <a href="/blog/auto-behozatal-nemetorszagbol"><h3>Autó behozatal Németországból</h3><p>Regisztrációs adó, áfa, honosítás, szállítás — nézd meg, hogyan zajlik a <strong>német autó behozatal</strong> lépésről lépésre.</p><span class="go">Import útmutató →</span></a>
        <a href="/egyedi-auto-rendeles?brand=bmw"><h3>BMW konfigurátor</h3><p>Állítsd össze a saját BMW-det a <strong>BMW konfigurátorban</strong>, a kész specifikációt pedig bízd ránk.</p><span class="go">Összes BMW modell →</span></a>
        <a href="/finanszirozas-lizing"><h3>Finanszírozás &amp; lízing</h3><p>Kiszámítható havi díj: nézd meg a <strong>BMW 1-es lízing</strong> lehetőségeket és a kalkulátort.</p><span class="go">Lízing kalkulátor →</span></a>
        <a href="/blog/nemet-hasznaltauto-vasarlas"><h3>Német használtautó?</h3><p>Ha alig használt darabot keresel, mutatjuk, hogyan válaszd ki és ellenőrizd a <strong>német használtautót</strong>.</p><span class="go">Vásárlási tippek →</span></a>
        <a href="/kapcsolat"><h3>Személyes ajánlat</h3><p>Mondd el, milyen 1-est szeretnél — díjmentes, személyre szabott ajánlatot adunk.</p><span class="go">Kapcsolatfelvétel →</span></a>
      </div>
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section class="cd-sec cd-soft">
    <div class="cd-w">
      <span class="cd-eyebrow">Galéria</span>
      <h2 class="cd-h2">BMW 1-es képek</h2>
      <div class="cd-gal"><img class="cd-shot" src="/bmw/bmw-1es-menet-kozben.webp" alt="BMW 1-es menet közben, hegyi úton" width="900" height="675" loading="lazy" /><img class="cd-shot" src="/bmw/bmw-1es-hegyi-uton.webp" alt="BMW 1-es dinamikus vezetés hegyi környezetben" width="900" height="675" loading="lazy" /><img class="cd-shot" src="/bmw/bmw-1es-oldalnezet.webp" alt="BMW 1-es M Sport oldalnézet" width="900" height="675" loading="lazy" /><img class="cd-shot" src="/bmw/bmw-1es-m-felni-feknyereg.webp" alt="BMW 1-es M könnyűfém keréktárcsa, piros féknyereg" width="900" height="675" loading="lazy" /><img class="cd-shot" src="/bmw/bmw-1es-muszerfal.webp" alt="BMW 1-es utastér – BMW Curved Display" width="900" height="675" loading="lazy" /><img class="cd-shot" src="/bmw/bmw-1es-sport-ulesek.webp" alt="BMW 1-es sport ülések" width="900" height="675" loading="lazy" /></div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="cd-sec" id="gyik">
    <div class="cd-w cd-faqwrap">
      <span class="cd-eyebrow">GYIK</span>
      <h2 class="cd-h2">Gyakori kérdések a BMW 1-esről</h2>
      <details open><summary>Mennyibe kerül egy új BMW 1-es Németországból?</summary><p>A BMW 118 nettó listaára {eur}-tól (kb. {huf}) indul, a felszereltségtől függően. Magánszemélyként akár 19% német áfával rendelheted a müncheni Caradvance GmbH-n keresztül.</p></details>
      <details><summary>Melyik BMW 1-es kivitelt válasszam — 116, 118 vagy 120?</summary><p>A BMW 116 a belépő benzines, a 118 a legkiegyensúlyozottabb választás, a 120 a legdinamikusabb. Dízelt is rendelhetsz. Segítünk kiválasztani a hozzád illő motorizációt és felszereltséget.</p></details>
      <details><summary>Bérelhető is a BMW 1-es?</summary><p>Igen — a 1-es <a href="/uj-auto-berlese?brand=bmw">tartós bérletben</a> is elérhető, egyetlen, kiszámítható havi díjjal, amiben a szerviz és a biztosítás is benne lehet.</p></details>
      <details><summary>Mennyi idő a behozatal?</summary><p>A kiválasztott konfigurációtól függ, jellemzően néhány hét. A <a href="/beszerzesi-folyamat">beszerzési folyamat</a> minden lépését mi intézzük, a honosítással és forgalomba helyezéssel együtt.</p></details>
    </div>
  </section>

  <!-- ===== RELATED ===== -->
  <section class="cd-sec cd-soft">
    <div class="cd-w">
      <span class="cd-eyebrow">Kapcsolódó modellek</span>
      <h2 class="cd-h2">Hasonló BMW modellek</h2>
      <div class="cd-rel">
        <a class="cd-relc" href="/egyedi-auto-rendeles?brand=bmw"><div class="cd-ph"><span>BMW 2-es</span></div><div class="b"><div class="n">BMW 2-es Gran Coupé</div></div></a>
        <a class="cd-relc" href="/egyedi-auto-rendeles?brand=bmw"><div class="cd-ph"><span>BMW X1</span></div><div class="b"><div class="n">BMW X1</div></div></a>
        <a class="cd-relc" href="/egyedi-auto-rendeles?brand=bmw"><div class="cd-ph"><span>BMW X2</span></div><div class="b"><div class="n">BMW X2</div></div></a>
        <a class="cd-relc" href="/egyedi-auto-rendeles?brand=bmw"><div class="cd-ph"><span>BMW i4</span></div><div class="b"><div class="n">BMW i4 (elektromos)</div></div></a>
      </div>
