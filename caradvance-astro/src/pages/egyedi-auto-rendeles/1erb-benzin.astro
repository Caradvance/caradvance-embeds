  .cd a.cd-btn-red{background:var(--red);color:#fff;} .cd a.cd-btn-red:hover{filter:brightness(1.07);}
  .cd a.cd-btn-dark{background:var(--navy);color:#fff;} .cd a.cd-btn-dark:hover{filter:brightness(1.25);}
  .cd a.cd-btn-white{background:#fff;color:var(--navy);}

  /* HERO — homepage clone */
