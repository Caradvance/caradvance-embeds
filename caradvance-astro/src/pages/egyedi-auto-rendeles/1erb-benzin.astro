    <div class="cd-w cd-sticky-in">
      <div class="cd-sinfo"><div class="n">BMW 1-es</div><div class="p">{huf} · {eur} nettó-tól</div></div>
      <div class="cd-sbtns"><a class="cd-btn cd-btn-dark" href="/kapcsolat">Ajánlatot kérek</a><a class="cd-btn cd-btn-red" href="/egyedi-auto-rendeles?brand=bmw&amp;order=1erb" data-egl-order data-name="BMW 1-es" data-img="/bmw/bmw-1es-m-sport-elolnezet.webp" data-price="10 476 648 Ft · 28.782 €" data-fuels="Benzin,Dízel">Autót rendelek</a></div>
    </div>
  </div>

  <!-- ===== ORDER MODAL (in-place, same form + backend as the listing) ===== -->
