  .cd-vid{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;}
  .cd-ov{position:absolute;inset:0;z-index:1;background:radial-gradient(1100px 460px at 50% -10%,rgba(226,0,26,.18),transparent 60%),linear-gradient(rgba(8,8,10,.42),rgba(8,8,10,.48) 45%,rgba(8,8,10,.7));}
