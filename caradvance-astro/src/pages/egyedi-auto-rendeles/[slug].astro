---
// Egyedi rendelés (eladás) Részletek-oldal — /egyedi-auto-rendeles/<slug>
// Minden, az /egyedi-auto-rendeles listában szereplő modellhez (BMW, MINI, Mercedes, Audi) automatikusan
// készül oldal a CarDetail sablonnal. Lista: src/data/egyediCars.ts · Tartalom: src/data/saleContent.ts
// (saleBMW / saleMINI / saleMercedes / saleAudi) · Összeállítás: src/data/salePage.ts
// A saját .astro fájllal rendelkező modellek (pl. 1erb-benzin.astro) kimaradnak (own: true).
import Base from '../../layouts/Base.astro';
import CarDetail from '../../components/CarDetail.astro';
import { EGYEDI_CARS } from '../../data/egyediCars';
import { SALE } from '../../data/saleContent';
import { buildSaleModel } from '../../data/salePage';

export function getStaticPaths() {
  return EGYEDI_CARS.filter((c) => !c.own && SALE[c.slug]).map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}
const { slug } = Astro.props as any;
const car = EGYEDI_CARS.find((c) => c.slug === slug)!;
const m: any = buildSaleModel(car, SALE[slug]);
---
<Base lang="hu" path={`/egyedi-auto-rendeles/${m.slug}`} title={m.title} description={m.description}>
  <CarDetail model={m} />
</Base>
