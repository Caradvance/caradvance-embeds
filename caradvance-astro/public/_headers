# Cloudflare Pages – cache rules for caradvance.hu
# Cél: ne mutasson régi tartalmat. A gyakran frissülő, nem hash-elt fájlok
# mindig újratöltődnek; az Astro hash-elt assetjei (/_astro/...) továbbra is
# gyorsan, sokáig cache-elve maradnak.

# Site-wide script – mindig a legfrissebb verzió töltődjön
/caradvance-chat.js
  Cache-Control: no-cache, must-revalidate

# HTML oldalak – minden betöltéskor ellenőrizze a frissességet
/*.html
  Cache-Control: no-cache, must-revalidate

# "Szép" URL-ek (pl. /, /finanszirozas-lizing/) – szintén ne cache-elődjenek sokáig
/
  Cache-Control: no-cache, must-revalidate

# Egyéb, nem hash-elt statikus fájlok a public mappából (biztonság kedvéért rövid TTL)
/*.js
  Cache-Control: public, max-age=300, must-revalidate

# Astro hash-elt assetek — a fájlnév változik minden módosításkor, így örökre cache-elhetők
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Képek, videók, betűk (nem hash-eltek, de ritkán változnak) — 7 nap
/*.webp
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.mp4
  Cache-Control: public, max-age=604800
/*.woff2
  Cache-Control: public, max-age=2592000

# Elektronikus aláírás oldala — nem keretezhető, nincs referrer, nincs cache
/alairas/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
