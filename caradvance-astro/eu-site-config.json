    "fr": "$1T={\"lbl\": \"7. À partir de quand souhaitez-vous louer ?\", \"tip\": \"Il faut au moins 10 jours entre la commande et la remise. Pour les voitures disponibles plus tard, la date la plus proche est le premier jour du mois concerné.\", \"note\": \"Remise au plus tôt : \", \"err\": \"Veuillez choisir à partir de quand vous souhaitez louer la voiture.\", \"errMin\": \"Début au plus tôt : \"};nice=function(s){try{return new Date(s+'T12:00:00').toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'});}catch(e){return s;}};",
    "it": "$1T={\"lbl\": \"7. Da quando desidera noleggiare?\", \"tip\": \"Dall’ordine alla consegna servono almeno 10 giorni. Per le auto disponibili più tardi, la data più vicina è il primo giorno del mese di disponibilità.\", \"note\": \"Consegna al più presto: \", \"err\": \"Scelga da quando desidera noleggiare l’auto.\", \"errMin\": \"Inizio al più presto: \"};nice=function(s){try{return new Date(s+'T12:00:00').toLocaleDateString('it-IT',{day:'numeric',month:'long',year:'numeric'});}catch(e){return s;}};",
    "es": "$1T={\"lbl\": \"7. ¿Desde cuándo desea el renting?\", \"tip\": \"Desde el pedido hasta la entrega pasan al menos 10 días. Para los coches disponibles más tarde, la fecha más próxima es el primer día del mes correspondiente.\", \"note\": \"Entrega lo antes posible: \", \"err\": \"Elija desde cuándo desea alquilar el coche.\", \"errMin\": \"Inicio lo antes posible: \"};nice=function(s){try{return new Date(s+'T12:00:00').toLocaleDateString('es-ES',{day:'numeric',month:'long',year:'numeric'});}catch(e){return s;}};"
